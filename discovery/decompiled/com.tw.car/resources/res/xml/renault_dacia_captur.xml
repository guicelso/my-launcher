<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <ListPreference
        android:persistent="false"
        android:entries="@array/renault_dacia_captur"
        android:title="@string/vehicle_configuration"
        android:key="renault_vehicle_selection"
        android:entryValues="@array/carsettings_0123_entryValues"/>
    <ListPreference
        android:persistent="false"
        android:entries="@array/renault_Language_captur"
        android:title="@string/vw_golf7_Language_title"
        android:key="renault_language"
        android:entryValues="@array/ford2012_Headlight_adjustment_values"/>
    <ListPreference
        android:persistent="false"
        android:entries="@array/carsettings_onoff_entries"
        android:title="@string/C4L_Parking_assist_title"
        android:key="renault_parking_auxiliary"
        android:entryValues="@array/carsettings_onoff_entryValues"/>
    <PreferenceScreen
        android:title="@string/fuelmileage"
        android:key="fuel_mileage_key"/>
    <PreferenceScreen
        android:title="@string/sound_control"
        android:key="sound_control"/>
    <SwitchPreference
        android:title="@string/car_configuration_autodoorlock_when_driving"
        android:key="car_configuration_autodoorlock_when_driving"
        android:defaultValue="false"
        android:summaryOn="@string/on"
        android:summaryOff="@string/off"/>
    <SwitchPreference
        android:title="@string/car_configuration_hands_freekeyfunctions"
        android:key="car_configuration_hands_freekeyfunctions"
        android:defaultValue="false"
        android:summaryOn="@string/on"
        android:summaryOff="@string/off"/>
    <SwitchPreference
        android:title="@string/car_configuration_approach_unlocking"
        android:key="car_configuration_approach_unlocking"
        android:defaultValue="false"
        android:summaryOn="@string/on"
        android:summaryOff="@string/off"/>
    <SwitchPreference
        android:title="@string/car_configuration_walkaway_cdosing_sound"
        android:key="car_configuration_walkaway_cdosing_sound"
        android:defaultValue="false"
        android:summaryOn="@string/on"
        android:summaryOff="@string/off"/>
</PreferenceScreen>
