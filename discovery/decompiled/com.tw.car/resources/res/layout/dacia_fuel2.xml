<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/p_driving"
            android:layout_width="@dimen/fuel_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_centerInParent="true">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/fuel_data_height">
                <TextView
                    android:textSize="@dimen/fuel_data_text"
                    android:textColor="#00b2de"
                    android:layout_width="@dimen/fuel_data_width1"
                    android:layout_height="wrap_content"
                    android:text="@string/rafe"/>
                <TextView
                    android:textSize="@dimen/fuel_data_text"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/rafe_fuel"
                    android:layout_width="@dimen/fuel_data_width1"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/fuel_data_text"
                    android:textColor="#00b2de"
                    android:gravity="right"
                    android:id="@+id/rafe_unit"
                    android:paddingRight="10dp"
                    android:layout_width="@dimen/fuel_data_width2"
                    android:layout_height="wrap_content"
                    android:text="@string/l_100km"/>
            </LinearLayout>
            <View
                android:background="@drawable/t_line"
                android:layout_width="wrap_content"
                android:layout_height="1dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/fuel_data_height">
                <TextView
                    android:textSize="@dimen/fuel_data_text"
                    android:textColor="#00b2de"
                    android:paddingRight="10dp"
                    android:layout_width="@dimen/fuel_data_width1"
                    android:layout_height="wrap_content"
                    android:text="@string/range"/>
                <TextView
                    android:textSize="@dimen/fuel_data_text"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/tt_mile"
                    android:layout_width="@dimen/fuel_data_width1"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/fuel_data_text"
                    android:textColor="#00b2de"
                    android:gravity="right"
                    android:id="@+id/range_unit"
                    android:paddingRight="10dp"
                    android:layout_width="@dimen/fuel_data_width2"
                    android:layout_height="wrap_content"
                    android:text="@string/km"/>
            </LinearLayout>
            <View
                android:background="@drawable/t_line"
                android:layout_width="wrap_content"
                android:layout_height="1dp"/>
            <LinearLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="@dimen/fuel_data_height">
                <TextView
                    android:textSize="@dimen/fuel_data_text"
                    android:textColor="#00b2de"
                    android:paddingRight="10dp"
                    android:layout_width="@dimen/fuel_data_width1"
                    android:layout_height="wrap_content"
                    android:text="@string/driving_fuel"/>
                <TextView
                    android:textSize="@dimen/fuel_data_text"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/lift_mile"
                    android:layout_width="@dimen/fuel_data_width1"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/fuel_data_text"
                    android:textColor="#00b2de"
                    android:gravity="right"
                    android:id="@+id/driving_fuel_unit"
                    android:paddingRight="10dp"
                    android:layout_width="@dimen/fuel_data_width2"
                    android:layout_height="wrap_content"
                    android:text="@string/l"/>
            </LinearLayout>
            <View
                android:background="@drawable/t_line"
                android:layout_width="wrap_content"
                android:layout_height="1dp"/>
            <LinearLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="@dimen/fuel_data_height">
                <TextView
                    android:textSize="@dimen/fuel_data_text"
                    android:textColor="#00b2de"
                    android:paddingRight="10dp"
                    android:layout_width="@dimen/fuel_data_width1"
                    android:layout_height="wrap_content"
                    android:text="@string/average_speed"/>
                <TextView
                    android:textSize="@dimen/fuel_data_text"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/xfy_speed"
                    android:layout_width="@dimen/fuel_data_width1"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/fuel_data_text"
                    android:textColor="#00b2de"
                    android:gravity="right"
                    android:paddingRight="10dp"
                    android:layout_width="@dimen/fuel_data_width2"
                    android:layout_height="wrap_content"
                    android:text="@string/km_h"/>
            </LinearLayout>
        </LinearLayout>
        <Button
            android:textSize="@dimen/fuel_data_text"
            android:id="@+id/fuel_bt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reset_fuel"
            android:layout_below="@+id/p_driving"
            android:layout_alignRight="@+id/p_driving"
            android:onClick="onClick"/>
    </RelativeLayout>
</LinearLayout>
