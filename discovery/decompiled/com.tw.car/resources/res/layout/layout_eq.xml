<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
    <ScrollView
        android:scrollbars="none"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:layout_weight="15"
        android:layout_centerHorizontal="true">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/tw_dp_h20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tw_dp_h20">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout style="@style/style_LinearLayout_left">
                    <TextView
                        android:text="@string/sound_balance"
                        style="@style/style_TextView_left_title"/>
                    <TextView
                        android:id="@+id/balance"
                        style="@style/style_TextView_left_value"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/balance_less"
                    style="@style/style_TextView_right_less"/>
                <SeekBar
                    android:enabled="false"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/balance_progress"
                    android:paddingLeft="@dimen/tw_dp_w20"
                    android:paddingRight="@dimen/tw_dp_w20"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:progress="50"
                    android:progressDrawable="@drawable/eq_seekbar_0_bg"
                    android:thumb="@drawable/eq_seekbar_thumb"
                    android:layout_weight="4"
                    style="?android:attr/progressBarStyleHorizontal"/>
                <TextView
                    android:id="@+id/balance_add"
                    style="@style/style_TextView_right_add"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout style="@style/style_LinearLayout_left">
                    <TextView
                        android:text="@string/sound_fader"
                        style="@style/style_TextView_left_title"/>
                    <TextView
                        android:id="@+id/fader"
                        style="@style/style_TextView_left_value"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/fader_less"
                    style="@style/style_TextView_right_less"/>
                <SeekBar
                    android:enabled="false"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/fader_progress"
                    android:paddingLeft="@dimen/tw_dp_w20"
                    android:paddingRight="@dimen/tw_dp_w20"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:progress="50"
                    android:progressDrawable="@drawable/eq_seekbar_0_bg"
                    android:thumb="@drawable/eq_seekbar_thumb"
                    android:layout_weight="4"
                    style="?android:attr/progressBarStyleHorizontal"/>
                <TextView
                    android:id="@+id/fader_add"
                    style="@style/style_TextView_right_add"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout style="@style/style_LinearLayout_left">
                    <TextView
                        android:text="@string/sound_bass"
                        style="@style/style_TextView_left_title"/>
                    <TextView
                        android:id="@+id/bass"
                        style="@style/style_TextView_left_value"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/bass_less"
                    style="@style/style_TextView_right_less"/>
                <SeekBar
                    android:layout_gravity="center_vertical"
                    android:id="@+id/bass_progress"
                    android:paddingLeft="@dimen/tw_dp_w20"
                    android:paddingRight="@dimen/tw_dp_w20"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:progress="50"
                    android:progressDrawable="@drawable/eq_seekbar_0_bg"
                    android:thumb="@drawable/eq_seekbar_thumb"
                    android:layout_weight="4"
                    style="?android:attr/progressBarStyleHorizontal"/>
                <TextView
                    android:id="@+id/bass_add"
                    style="@style/style_TextView_right_add"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout style="@style/style_LinearLayout_left">
                    <TextView
                        android:text="@string/sound_treblr"
                        style="@style/style_TextView_left_title"/>
                    <TextView
                        android:id="@+id/treblr"
                        style="@style/style_TextView_left_value"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/treblr_less"
                    style="@style/style_TextView_right_less"/>
                <SeekBar
                    android:enabled="false"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/treblr_progress"
                    android:paddingLeft="@dimen/tw_dp_w20"
                    android:paddingRight="@dimen/tw_dp_w20"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:progress="50"
                    android:progressDrawable="@drawable/eq_seekbar_0_bg"
                    android:thumb="@drawable/eq_seekbar_thumb"
                    android:layout_weight="4"
                    style="?android:attr/progressBarStyleHorizontal"/>
                <TextView
                    android:id="@+id/treblr_add"
                    style="@style/style_TextView_right_add"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout style="@style/style_LinearLayout_left">
                    <TextView
                        android:text="@string/sound_volume"
                        style="@style/style_TextView_left_title"/>
                    <TextView
                        android:id="@+id/volume"
                        style="@style/style_TextView_left_value"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/v_less"
                    style="@style/style_TextView_right_vol_less"/>
                <ProgressBar
                    android:layout_gravity="center_vertical"
                    android:id="@+id/volume_progress"
                    android:paddingLeft="@dimen/tw_dp_w20"
                    android:paddingRight="@dimen/tw_dp_w20"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:progressDrawable="@drawable/eq_seekbar"
                    android:layout_weight="4"
                    style="?android:attr/progressBarStyleHorizontal"/>
                <TextView
                    android:id="@+id/v_add"
                    style="@style/style_TextView_right_vol_add"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout style="@style/style_LinearLayout_left">
                    <TextView
                        android:text="@string/sound_eq_have"
                        style="@style/style_TextView_left_title"/>
                </LinearLayout>
                <TextView
                    android:layout_gravity="center_vertical"
                    android:layout_width="@dimen/tw_dp_w50"
                    android:layout_height="@dimen/tw_dp_w50"
                    android:layout_marginLeft="@dimen/tw_dp_w30"/>
                <LinearLayout
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="4">
                    <TextView
                        android:id="@+id/sound_eq_have_off"
                        android:clickable="false"
                        android:text="@string/sound_eq_have_without"
                        style="@style/style_eq_btn"/>
                    <TextView
                        android:id="@+id/sound_eq_have_on"
                        android:clickable="false"
                        android:text="@string/sound_eq_have_with"
                        style="@style/style_eq_btn"/>
                </LinearLayout>
                <TextView
                    android:layout_gravity="center_vertical"
                    android:layout_width="@dimen/tw_dp_w50"
                    android:layout_height="@dimen/tw_dp_w50"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout style="@style/style_LinearLayout_left">
                    <TextView
                        android:text="@string/sound_b_f_mode"
                        style="@style/style_TextView_left_title"/>
                </LinearLayout>
                <TextView
                    android:layout_gravity="center_vertical"
                    android:layout_width="@dimen/tw_dp_w50"
                    android:layout_height="@dimen/tw_dp_w50"
                    android:layout_marginLeft="@dimen/tw_dp_w30"/>
                <LinearLayout
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="4">
                    <TextView
                        android:id="@+id/sound_b_f_mode_0"
                        android:text="@string/sound_b_f_mode_0"
                        style="@style/style_eq_btn"/>
                    <TextView
                        android:id="@+id/sound_b_f_mode_1"
                        android:text="@string/sound_b_f_mode_1"
                        style="@style/style_eq_btn"/>
                    <TextView
                        android:id="@+id/sound_b_f_mode_2"
                        android:text="@string/sound_b_f_mode_2"
                        style="@style/style_eq_btn"/>
                    <TextView
                        android:id="@+id/sound_b_f_mode_3"
                        android:text="@string/sound_b_f_mode_3"
                        style="@style/style_eq_btn"/>
                </LinearLayout>
                <TextView
                    android:layout_gravity="center_vertical"
                    android:layout_width="@dimen/tw_dp_w50"
                    android:layout_height="@dimen/tw_dp_w50"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <View
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
</LinearLayout>
