                            android:layout_width="@dimen/tw_dp_w83"
                            android:layout_height="@dimen/tw_dp_w28"
                            android:src="@drawable/air_wind_left"
                            android:scaleType="centerInside"/>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"/>
                        <ImageView
                            android:id="@+id/air_wind_right"
                            android:layout_width="@dimen/tw_dp_w83"
                            android:layout_height="@dimen/tw_dp_w28"
                            android:src="@drawable/air_wind_right"
                            android:scaleType="centerInside"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">
                    <ImageView
                        android:id="@+id/air_wind_down2"
                        android:layout_width="@dimen/tw_dp_w30"
                        android:layout_height="@dimen/tw_dp_w78"
                        android:src="@drawable/air_wind_down"
                        android:scaleType="centerInside"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="top"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">
                    <ImageView
                        android:id="@+id/air_wind_up2"
                        android:layout_width="@dimen/tw_dp_w89"
                        android:layout_height="@dimen/tw_dp_w60"
                        android:layout_marginTop="@dimen/tw_dp_w30"
                        android:src="@drawable/air_wind_up"
                        android:scaleType="centerInside"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/air_heat_seat"
                android:background="@drawable/air_c_bg"
                android:visibility="invisible"
                android:layout_width="@dimen/tw_dp_w451"
                android:layout_height="@dimen/tw_dp_w228"
                android:layout_centerInParent="true">
                <ImageView
                    android:layout_width="@dimen/tw_dp_w307"
                    android:layout_height="@dimen/tw_dp_w135"
                    android:layout_marginBottom="@dimen/tw_dp_w12"
                    android:src="@drawable/air_heat_seat"
                    android:scaleType="centerInside"/>
                <LinearLayout
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tw_dp_w12">
                    <ImageView
                        android:id="@+id/air_heat_left_1"
                        android:layout_width="@dimen/tw_dp_w43"
                        android:layout_height="@dimen/tw_dp_h13"
                        android:layout_marginLeft="@dimen/tw_dp_w6"
                        android:layout_marginRight="@dimen/tw_dp_w6"
                        android:src="@drawable/air_heat"
                        android:scaleType="centerInside"/>
                    <ImageView
                        android:id="@+id/air_heat_left_2"
                        android:layout_width="@dimen/tw_dp_w43"
                        android:layout_height="@dimen/tw_dp_h13"
                        android:layout_marginLeft="@dimen/tw_dp_w6"
                        android:layout_marginRight="@dimen/tw_dp_w6"
                        android:src="@drawable/air_heat"
                        android:scaleType="centerInside"/>
                    <ImageView
                        android:id="@+id/air_heat_left_3"
                        android:layout_width="@dimen/tw_dp_w43"
                        android:layout_height="@dimen/tw_dp_w13"
                        android:layout_marginLeft="@dimen/tw_dp_w6"
                        android:layout_marginRight="@dimen/tw_dp_w32"
                        android:src="@drawable/air_heat"
                        android:scaleType="centerInside"/>
                    <ImageView
                        android:id="@+id/air_heat_right_1"
                        android:layout_width="@dimen/tw_dp_w43"
                        android:layout_height="@dimen/tw_dp_w13"
                        android:layout_marginLeft="@dimen/tw_dp_w32"
                        android:layout_marginRight="@dimen/tw_dp_w6"
                        android:src="@drawable/air_heat"
                        android:scaleType="centerInside"/>
                    <ImageView
                        android:id="@+id/air_heat_right_2"
                        android:layout_width="@dimen/tw_dp_w43"
                        android:layout_height="@dimen/tw_dp_w13"
                        android:layout_marginLeft="@dimen/tw_dp_w6"
                        android:layout_marginRight="@dimen/tw_dp_w6"
                        android:src="@drawable/air_heat"
                        android:scaleType="centerInside"/>
                    <ImageView
                        android:id="@+id/air_heat_right_3"
                        android:layout_width="@dimen/tw_dp_w43"
                        android:layout_height="@dimen/tw_dp_w13"
                        android:layout_marginLeft="@dimen/tw_dp_w6"
                        android:layout_marginRight="@dimen/tw_dp_w6"
                        android:src="@drawable/air_heat"
                        android:scaleType="centerInside"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tw_dp_h12">
                    <ImageView
                        android:id="@+id/air_heat_left_4"
                        android:layout_width="@dimen/tw_dp_w43"
                        android:layout_height="@dimen/tw_dp_w13"
                        android:layout_marginLeft="@dimen/tw_dp_w6"
                        android:layout_marginRight="@dimen/tw_dp_w6"
                        android:src="@drawable/air_heat"
                        android:scaleType="centerInside"/>
                    <ImageView
                        android:id="@+id/air_heat_left_5"
                        android:layout_width="@dimen/tw_dp_w43"
                        android:layout_height="@dimen/tw_dp_w13"
                        android:layout_marginLeft="@dimen/tw_dp_w6"
                        android:layout_marginRight="@dimen/tw_dp_w6"
                        android:src="@drawable/air_heat"
                        android:scaleType="centerInside"/>
                    <ImageView
                        android:id="@+id/air_heat_left_6"
                        android:layout_width="@dimen/tw_dp_w43"
                        android:layout_height="@dimen/tw_dp_w13"
                        android:layout_marginLeft="@dimen/tw_dp_w6"
                        android:layout_marginRight="@dimen/tw_dp_w32"
                        android:src="@drawable/air_heat"
                        android:scaleType="centerInside"/>
                    <ImageView
                        android:id="@+id/air_heat_right_4"
                        android:layout_width="@dimen/tw_dp_w43"
                        android:layout_height="@dimen/tw_dp_w13"
                        android:layout_marginLeft="@dimen/tw_dp_w32"
                        android:layout_marginRight="@dimen/tw_dp_w6"
                        android:src="@drawable/air_heat"
                        android:scaleType="centerInside"/>
                    <ImageView
                        android:id="@+id/air_heat_right_5"
                        android:layout_width="@dimen/tw_dp_w43"
                        android:layout_height="@dimen/tw_dp_w13"
                        android:layout_marginLeft="@dimen/tw_dp_w6"
                        android:layout_marginRight="@dimen/tw_dp_w6"
                        android:src="@drawable/air_heat"
                        android:scaleType="centerInside"/>
                    <ImageView
