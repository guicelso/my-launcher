            android:layout_marginRight="@dimen/tw_dp_w6"
            android:src="@drawable/air_wind_large"
            android:scaleType="centerInside"/>
        <ImageView
            android:id="@+id/air_wind_small"
            android:layout_width="@dimen/tw_dp_w131"
            android:layout_height="@dimen/tw_dp_w34"
            android:layout_marginLeft="@dimen/tw_dp_w6"
            android:layout_marginRight="@dimen/tw_dp_w6"
            android:src="@drawable/air_wind_small"
            android:scaleType="centerInside"/>
        <ImageView
            android:id="@+id/air_dual"
            android:layout_width="@dimen/tw_dp_w99"
            android:layout_height="@dimen/tw_dp_w34"
            android:layout_marginLeft="@dimen/tw_dp_w6"
            android:layout_marginRight="@dimen/tw_dp_w6"
            android:src="@drawable/air_dual"
            android:scaleType="centerInside"/>
        <ImageView
            android:id="@+id/air_max_fornt"
            android:layout_width="@dimen/tw_dp_w142"
            android:layout_height="@dimen/tw_dp_w34"
            android:layout_marginLeft="@dimen/tw_dp_w6"
            android:layout_marginRight="@dimen/tw_dp_w6"
            android:src="@drawable/air_max_fornt"
            android:scaleType="centerInside"/>
        <ImageView
            android:id="@+id/air_rear"
            android:layout_width="@dimen/tw_dp_w48"
            android:layout_height="@dimen/tw_dp_w34"
            android:layout_marginLeft="@dimen/tw_dp_w6"
            android:layout_marginRight="@dimen/tw_dp_w6"
