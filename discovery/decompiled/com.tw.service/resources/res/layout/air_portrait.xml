<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/air_bg"
    android:layout_width="@dimen/tw_dp_w1075"
    android:layout_height="@dimen/tw_dp_w528">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tw_dp_w90"
        android:layout_marginLeft="@dimen/tw_dp_w12"
        android:layout_marginTop="@dimen/tw_dp_w12"
        android:layout_marginRight="@dimen/tw_dp_w12">
        <ImageView
            android:id="@+id/air_ac"
            android:layout_width="@dimen/tw_dp_w51"
            android:layout_height="@dimen/tw_dp_w34"
            android:layout_marginLeft="@dimen/tw_dp_w6"
            android:layout_marginRight="@dimen/tw_dp_w6"
            android:src="@drawable/air_ac"
            android:scaleType="centerInside"/>
        <ImageView
            android:id="@+id/air_inner_loop"
            android:layout_width="@dimen/tw_dp_w94"
            android:layout_height="@dimen/tw_dp_w34"
            android:layout_marginLeft="@dimen/tw_dp_w6"
            android:layout_marginRight="@dimen/tw_dp_w6"
