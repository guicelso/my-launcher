            android:id="@+id/air_lt"
            android:layout_width="@dimen/tw_dp_w197"
            android:layout_height="match_parent"
            android:layout_marginRight="@dimen/tw_dp_w1"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/air_wind_layout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/tw_dp_w1"
            android:layout_marginRight="@dimen/tw_dp_w1"
            android:layout_weight="1">
            <ImageView
                android:layout_width="@dimen/tw_dp_w49"
                android:layout_height="@dimen/tw_dp_w46"
                android:layout_marginLeft="@dimen/tw_dp_w12"
                android:layout_marginRight="@dimen/tw_dp_w12"
                android:src="@drawable/air_wind_min"
                android:scaleType="centerInside"/>
            <ImageView
                android:id="@+id/air_wind_1"
                android:layout_width="@dimen/tw_dp_w51"
                android:layout_height="@dimen/tw_dp_w19"
                android:layout_marginLeft="@dimen/tw_dp_w6"
                android:layout_marginRight="@dimen/tw_dp_w6"
                android:src="@drawable/air_wind"
                android:scaleType="centerInside"/>
            <ImageView
                android:id="@+id/air_wind_2"
                android:layout_width="@dimen/tw_dp_w51"
                android:layout_height="@dimen/tw_dp_w19"
                android:layout_marginLeft="@dimen/tw_dp_w6"
                android:layout_marginRight="@dimen/tw_dp_w6"
                android:src="@drawable/air_wind"
                android:scaleType="centerInside"/>
            <ImageView
                android:id="@+id/air_wind_3"
                android:layout_width="@dimen/tw_dp_w51"
                android:layout_height="@dimen/tw_dp_w19"
                android:layout_marginLeft="@dimen/tw_dp_w6"
                android:layout_marginRight="@dimen/tw_dp_w6"
                android:src="@drawable/air_wind"
                android:scaleType="centerInside"/>
            <ImageView
                android:id="@+id/air_wind_4"
                android:layout_width="@dimen/tw_dp_w51"
                android:layout_height="@dimen/tw_dp_w19"
                android:layout_marginLeft="@dimen/tw_dp_w6"
                android:layout_marginRight="@dimen/tw_dp_w6"
                android:src="@drawable/air_wind"
                android:scaleType="centerInside"/>
            <ImageView
                android:id="@+id/air_wind_5"
                android:layout_width="@dimen/tw_dp_w51"
                android:layout_height="@dimen/tw_dp_w19"
                android:layout_marginLeft="@dimen/tw_dp_w6"
                android:layout_marginRight="@dimen/tw_dp_w6"
                android:src="@drawable/air_wind"
                android:scaleType="centerInside"/>
            <ImageView
                android:id="@+id/air_wind_6"
                android:layout_width="@dimen/tw_dp_w51"
                android:layout_height="@dimen/tw_dp_w19"
                android:layout_marginLeft="@dimen/tw_dp_w6"
                android:layout_marginRight="@dimen/tw_dp_w6"
                android:src="@drawable/air_wind"
                android:scaleType="centerInside"/>
            <ImageView
                android:id="@+id/air_wind_7"
                android:layout_width="@dimen/tw_dp_w51"
                android:layout_height="@dimen/tw_dp_w19"
                android:layout_marginLeft="@dimen/tw_dp_w6"
                android:layout_marginRight="@dimen/tw_dp_w6"
                android:src="@drawable/air_wind"
                android:scaleType="centerInside"/>
            <ImageView
                android:id="@+id/air_wind_8"
                android:visibility="gone"
                android:layout_width="@dimen/tw_dp_w51"
                android:layout_height="@dimen/tw_dp_w19"
                android:layout_marginLeft="@dimen/tw_dp_w6"
                android:layout_marginRight="@dimen/tw_dp_w6"
                android:src="@drawable/air_wind"
                android:scaleType="centerInside"/>
            <ImageView
                android:layout_width="@dimen/tw_dp_w49"
                android:layout_height="@dimen/tw_dp_w46"
                android:layout_marginLeft="@dimen/tw_dp_w12"
                android:layout_marginRight="@dimen/tw_dp_w12"
                android:src="@drawable/air_wind_max"
                android:scaleType="centerInside"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/tw_dp_w35"
            android:textStyle="normal"
            android:textColor="#ebebeb"
            android:gravity="center"
            android:id="@+id/air_rt"
            android:layout_width="@dimen/tw_dp_w197"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/tw_dp_w1"/>
    </LinearLayout>
</LinearLayout>
