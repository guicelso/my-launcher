        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/tw_dp_w12"
        android:layout_marginRight="@dimen/tw_dp_w12"
        android:layout_weight="1">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/tw_dp_w33"
                android:textColor="#ebebeb"
                android:id="@+id/air_wind_left_value"
                android:visibility="gone"
                android:layout_width="@dimen/tw_dp_w85"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/tw_dp_w40"
                android:drawableLeft="@drawable/fengshan"
                android:layout_centerVertical="true"/>
            <ImageView
                android:layout_gravity="top"
                android:id="@+id/air_auto_left"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/tw_dp_w200"
                android:layout_marginTop="@dimen/tw_dp_w40"
                android:src="@drawable/auto"/>
            <ImageView
                android:layout_gravity="top"
                android:id="@+id/air_auto_right"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tw_dp_w40"
                android:layout_marginRight="@dimen/tw_dp_w200"
                android:src="@drawable/auto"
                android:layout_alignParentRight="true"/>
            <TextView
