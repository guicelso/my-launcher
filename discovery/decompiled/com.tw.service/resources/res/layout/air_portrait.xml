            android:scaleType="centerInside"/>
        <ImageView
            android:id="@+id/air_inner_loop_a"
            android:layout_width="@dimen/tw_dp_w116"
            android:layout_height="@dimen/tw_dp_w34"
            android:layout_marginLeft="@dimen/tw_dp_w6"
            android:layout_marginRight="@dimen/tw_dp_w6"
            android:src="@drawable/air_inner_loop_a"
            android:scaleType="centerInside"/>
        <ImageView
            android:id="@+id/air_rear_lock"
            android:layout_width="@dimen/tw_dp_w129"
            android:layout_height="@dimen/tw_dp_w37"
            android:layout_marginLeft="@dimen/tw_dp_w6"
            android:layout_marginRight="@dimen/tw_dp_w6"
            android:src="@drawable/air_rear_lock"
            android:scaleType="centerInside"/>
        <ImageView
            android:id="@+id/air_ac_max"
            android:layout_width="@dimen/tw_dp_w113"
            android:layout_height="@dimen/tw_dp_w34"
            android:layout_marginLeft="@dimen/tw_dp_w6"
            android:layout_marginRight="@dimen/tw_dp_w6"
            android:src="@drawable/air_ac_max"
            android:scaleType="centerInside"/>
        <ImageView
            android:id="@+id/air_eco"
            android:layout_width="@dimen/tw_dp_w89"
            android:layout_height="@dimen/tw_dp_w34"
            android:layout_marginLeft="@dimen/tw_dp_w6"
            android:layout_marginRight="@dimen/tw_dp_w6"
            android:src="@drawable/air_eco"
            android:scaleType="centerInside"/>
    </LinearLayout>
    <RelativeLayout
