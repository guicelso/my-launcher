                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center"
                android:id="@+id/air_wind_seat"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:gravity="top"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">
                    <ImageView
                        android:id="@+id/air_wind_up1"
                        android:layout_width="@dimen/tw_dp_w89"
                        android:layout_height="@dimen/tw_dp_w60"
                        android:layout_marginTop="@dimen/tw_dp_w30"
                        android:src="@drawable/air_wind_up"
                        android:scaleType="centerInside"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">
                    <ImageView
                        android:id="@+id/air_wind_down1"
                        android:layout_width="@dimen/tw_dp_w30"
                        android:layout_height="@dimen/tw_dp_w78"
                        android:src="@drawable/air_wind_down"
                        android:scaleType="centerInside"/>
                </LinearLayout>
                <LinearLayout
                    android:background="@drawable/air_wind_seat"
                    android:layout_width="@dimen/tw_dp_w547"
                    android:layout_height="@dimen/tw_dp_w220">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/tw_dp_w30">
                        <ImageView
