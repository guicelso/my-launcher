<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="700dp"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:background="@drawable/panel_background2"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/other_stream_icon"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:src="@drawable/btn_volum"/>
        <SeekBar
            android:id="@+id/level"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:layout_width="500dp"
            android:layout_height="wrap_content"
            android:maxHeight="12dp"
            android:progressDrawable="@drawable/seekbar_progress_drawable"
            android:minHeight="12dp"
            android:thumb="@drawable/ic_circle"
            android:layout_weight="1"
            style="?android:attr/progressBarStyleHorizontal"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textSize="30dp"
            android:textColor="#fff"
            android:id="@+id/message"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:singleLine="true"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:id="@+id/additional_message"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/ringer_stream_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
