<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/door_left_41f"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/door_b_41f"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/car_l"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/door_fl_41f"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/car_l_frontdoor"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/door_bl_41f"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/car_l_backdoor"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/door_fr_41f"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/car_l_r_frontdoor"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/door_br_41f"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/car_l_r_backdoor"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/door_tr_41f"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/car_l_reartrunk"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/door_cover_41f"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/car_l_cover"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/door_right_41f"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/door_b_r_41f"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/car_r"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/door_fr_r_41f"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/car_r_frontdoor"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/door_br_r_41f"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/car_r_backdoor"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/door_fl_r_41f"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/car_r_r_frontdoor"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/door_bl_r_41f"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/car_r_r_backdoor"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/door_tr_r_41f"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/car_r_reartrunk"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/door_cover_r_41f"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/car_r_cover"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</RelativeLayout>
