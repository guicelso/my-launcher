<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:background="@drawable/door_bg"
    android:layout_width="316dp"
    android:layout_height="316dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/door_b"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/door_b"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/door_br"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/door_br"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/door_bl"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/door_bl"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/door_fr"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/door_fr"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/door_fl"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/door_fl"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</LinearLayout>
