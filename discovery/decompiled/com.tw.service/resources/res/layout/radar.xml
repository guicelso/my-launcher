<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:radar="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:background="@drawable/radar_b_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.tw.service.RadarView
            android:id="@+id/radar_rv"
            android:layout_width="660dp"
            android:layout_height="396dp"
            android:layout_centerInParent="true"
            radar:orientation="horizontal"
            radar:src="@drawable/radar_f_bg"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="119dp"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true">
            <ImageView
                android:id="@+id/radar_back"
                android:background="@drawable/radar_rb_bg"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:src="@drawable/radar_back"
                android:scaleType="center"/>
            <ImageView
                android:background="@drawable/radar_rb_bg"
                android:visibility="invisible"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:scaleType="center"/>
            <ImageView
                android:background="@drawable/radar_rb_bg"
                android:visibility="invisible"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:scaleType="center"/>
            <ImageView
                android:background="@drawable/radar_rb_bg"
                android:visibility="invisible"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:scaleType="center"/>
            <ImageView
                android:background="@drawable/radar_rb_bg"
                android:visibility="invisible"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:scaleType="center"/>
            <ImageView
                android:id="@+id/radar_voice"
                android:background="@drawable/radar_rb_bg"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:src="@drawable/radar_voice"
                android:scaleType="center"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
