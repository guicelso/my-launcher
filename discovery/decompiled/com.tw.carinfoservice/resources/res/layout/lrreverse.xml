<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <SurfaceView
        android:id="@+id/surface_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:id="@+id/hb"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <ImageView
            android:id="@+id/back"
            android:background="@drawable/b_c_fg"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_back"
            android:scaleType="center"
            android:layout_alignParentLeft="true"
            android:onClick="onClick"/>
        <ImageView
            android:id="@+id/camera_settings"
            android:background="@drawable/b_c_fg"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_settings"
            android:scaleType="center"
            android:layout_alignParentRight="true"
            android:onClick="onClick"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/warning_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true">
        <TextView
            android:textSize="36dp"
            android:textColor="#000"
            android:gravity="center"
            android:id="@+id/warning_no_signal"
            android:background="@drawable/warning_novideosignal"
            android:visibility="gone"
            android:layout_width="380dp"
            android:layout_height="144dp"
            android:text="@string/warning_signal_t"
            android:layout_centerInParent="true"/>
        <TextView
            android:textSize="22dp"
            android:textColor="#000"
            android:gravity="center"
            android:id="@+id/warning_driving"
            android:background="@drawable/warning_driving"
            android:paddingLeft="112dp"
            android:paddingRight="12dp"
            android:visibility="gone"
            android:layout_width="380dp"
            android:layout_height="144dp"
            android:text="@string/warning_driving_t"
            android:includeFontPadding="false"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</RelativeLayout>
