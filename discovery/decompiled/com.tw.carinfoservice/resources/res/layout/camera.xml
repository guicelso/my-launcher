<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#b2000000"
    android:layout_width="@dimen/camera_view_width"
    android:layout_height="@dimen/camera_view_height">
    <LinearLayout
        android:gravity="center"
        android:id="@+id/ll_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/camera_view_title_height"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="@dimen/camera_view_title_text_size"
            android:textColor="@color/camera_title_white"
            android:gravity="center"
            android:id="@+id/tv_layout_frame"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/camera_frame"
            android:drawableBottom="@drawable/lev_camera_title_line"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/camera_view_title_text_size"
            android:textColor="@color/camera_title_white"
            android:gravity="center"
            android:id="@+id/tv_layout_camera"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/camera_title_camera"
            android:drawableBottom="@drawable/lev_camera_title_line"
            android:layout_weight="1"/>
    </LinearLayout>
    <ScrollView
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/scrollViewCamera"
        android:paddingLeft="@dimen/camera_view_padding_left"
        android:paddingRight="@dimen/camera_view_padding_right"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/tw_dp_h4"
        android:layout_below="@+id/ll_title">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/camera_view_title_height">
                <TextView
                    android:textSize="@dimen/camera_settings_textsize"
                    android:textColor="#ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tw_dp_h8"
                    android:layout_marginBottom="@dimen/tw_dp_h8"
                    android:text="@string/camera_title_settings"/>
                <TextView
                    android:textSize="@dimen/reverse_textsize"
                    android:textColor="@color/blue"
                    android:gravity="right"
                    android:id="@+id/reverse_ahd"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tw_dp_h8"
                    android:layout_marginBottom="@dimen/tw_dp_h8"
                    android:text="@string/reverse_ahd_auto"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/lev_arrow"
                    android:background="@drawable/button_jiantou"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/tw_dp_w28"
                    android:layout_marginRight="@dimen/tw_dp_w8"
                    android:src="@drawable/lev_arrow"
                    android:scaleType="centerInside"/>
            </LinearLayout>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/title_xian"
                android:contentDescription="@string/camera_title_settings"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/layout_camera"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="@dimen/reverse_textsize"
                    android:textColor="#ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/reverse_tip_top_bottom"
                    android:layout_marginBottom="@dimen/reverse_tip_top_bottom"
                    android:text="@string/reverse_tip"/>
                <RadioGroup
                    android:orientation="vertical"
                    android:id="@+id/ahd_check"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TableRow
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/tw_dp_h18"
                        android:paddingBottom="@dimen/tw_dp_h12"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <RadioButton
                            android:id="@+id/ahd_auto"
                            android:text="@string/reverse_ahd_auto"
                            style="@style/cus_rb_480dp"/>
                        <View
                            android:id="@+id/ahd_auto_view"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/tw_dp_h2"
                            android:layout_weight="1"/>
                        <RadioButton
                            android:id="@+id/ahd_ntsc"
                            android:text="@string/reverse_ahd_ntsc"
                            style="@style/cus_rb_480dp"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="@dimen/tw_dp_h2"
                            android:layout_weight="1"/>
                        <RadioButton
                            android:id="@+id/ahd_pal"
                            android:text="@string/reverse_ahd_pal"
                            style="@style/cus_rb_480dp"/>
                    </TableRow>
                    <TableRow
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/tw_dp_h6"
                        android:paddingBottom="@dimen/tw_dp_h12"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <RadioButton
                            android:id="@+id/ahd_25f"
                            android:text="@string/reverse_ahd_25f"
                            style="@style/cus_rb_480dp"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="@dimen/tw_dp_h2"
                            android:layout_weight="1"/>
                        <RadioButton
                            android:id="@+id/ahd_30f"
                            android:text="@string/reverse_ahd_30f"
                            style="@style/cus_rb_480dp"/>
                    </TableRow>
                    <TableRow
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/tw_dp_h6"
                        android:paddingBottom="@dimen/tw_dp_h18"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <RadioButton
                            android:id="@+id/ahd_1080p_25f"
                            android:text="@string/reverse_ahd_1080p_25f"
                            style="@style/cus_rb_480dp"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="@dimen/tw_dp_h2"
                            android:layout_weight="1"/>
                        <RadioButton
                            android:id="@+id/ahd_1080p_30f"
                            android:text="@string/reverse_ahd_1080p_30f"
                            style="@style/cus_rb_480dp"/>
                    </TableRow>
                    <TableRow
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/tw_dp_h6"
                        android:paddingBottom="@dimen/tw_dp_h18"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <RadioButton
                            android:id="@+id/tvi_25f"
                            android:text="@string/reverse_tvi_25f"
                            style="@style/cus_rb_480dp"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="@dimen/tw_dp_h2"
                            android:layout_weight="1"/>
                        <RadioButton
                            android:id="@+id/tvi_30f"
                            android:text="@string/reverse_tvi_30f"
                            style="@style/cus_rb_480dp"/>
                    </TableRow>
                    <TableRow
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/tw_dp_h6"
                        android:paddingBottom="@dimen/tw_dp_h18"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <RadioButton
                            android:id="@+id/tvi_1080p_25f"
                            android:text="@string/reverse_tvi_1080p_25f"
                            style="@style/cus_rb_480dp"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="@dimen/tw_dp_h2"
                            android:layout_weight="1"/>
                        <RadioButton
                            android:id="@+id/tvi_1080p_30f"
                            android:text="@string/reverse_tvi_1080p_30f"
                            style="@style/cus_rb_480dp"/>
                    </TableRow>
                </RadioGroup>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <ScrollView
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/scrollViewFrame"
        android:paddingLeft="@dimen/camera_view_padding_left"
        android:paddingRight="@dimen/camera_view_padding_right"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/tw_dp_h20"
        android:layout_below="@+id/ll_title">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/layout_frame"
            android:paddingLeft="@dimen/camera_view_padding_left"
            android:paddingRight="@dimen/camera_view_padding_right"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/tw_dp_h20"
            android:layout_below="@+id/ll_title">
            <TextView
                android:textSize="@dimen/seekbar_title_textsize"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/brightness_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tw_dp_h5"
                android:text="@string/brightness"/>
            <LinearLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="@dimen/seekbar_layout_height">
                <ImageView
                    android:id="@+id/brightness_down"
                    android:layout_width="@dimen/button_add_reduce_width"
                    android:layout_height="@dimen/button_add_reduce_height"
                    android:src="@drawable/btn_down"
                    android:scaleType="centerInside"
                    android:text="@string/down"/>
                <SeekBar
                    android:id="@+id/brightness_level"
                    android:paddingLeft="@dimen/tw_dp_w10"
                    android:paddingRight="@dimen/tw_dp_w10"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:maxHeight="@dimen/seekbar_max_height"
                    android:progressDrawable="@drawable/progressdrawable"
                    android:thumb="@drawable/thumb"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/brightness_up"
                    android:layout_width="@dimen/button_add_reduce_width"
                    android:layout_height="@dimen/button_add_reduce_height"
                    android:src="@drawable/btn_up"
                    android:scaleType="centerInside"
                    android:text="@string/up"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/seekbar_title_textsize"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/contrast_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tw_dp_h5"
                android:text="@string/contrast"/>
            <LinearLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="@dimen/seekbar_layout_height">
                <ImageView
                    android:id="@+id/contrast_down"
                    android:layout_width="@dimen/button_add_reduce_width"
                    android:layout_height="@dimen/button_add_reduce_height"
                    android:src="@drawable/btn_down"
                    android:scaleType="centerInside"
                    android:text="@string/down"/>
                <SeekBar
                    android:id="@+id/contrast_level"
                    android:paddingLeft="@dimen/tw_dp_w10"
                    android:paddingRight="@dimen/tw_dp_w10"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:maxHeight="@dimen/seekbar_max_height"
                    android:progressDrawable="@drawable/progressdrawable"
                    android:thumb="@drawable/thumb"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/contrast_up"
                    android:layout_width="@dimen/button_add_reduce_width"
                    android:layout_height="@dimen/button_add_reduce_height"
                    android:src="@drawable/btn_up"
                    android:scaleType="centerInside"
                    android:text="@string/up"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/seekbar_title_textsize"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/saturation_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tw_dp_h5"
                android:text="@string/saturation"/>
            <LinearLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="@dimen/seekbar_layout_height">
                <ImageView
                    android:id="@+id/saturation_down"
                    android:layout_width="@dimen/button_add_reduce_width"
                    android:layout_height="@dimen/button_add_reduce_height"
                    android:src="@drawable/btn_down"
                    android:scaleType="centerInside"
                    android:text="@string/down"/>
                <SeekBar
                    android:id="@+id/saturation_level"
                    android:paddingLeft="@dimen/tw_dp_w10"
                    android:paddingRight="@dimen/tw_dp_w10"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:maxHeight="@dimen/seekbar_max_height"
                    android:progressDrawable="@drawable/progressdrawable"
                    android:thumb="@drawable/thumb"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/saturation_up"
                    android:layout_width="@dimen/button_add_reduce_width"
                    android:layout_height="@dimen/button_add_reduce_height"
                    android:src="@drawable/btn_up"
                    android:scaleType="centerInside"
                    android:text="@string/up"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/tw_dp_h18"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/offset_title"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tw_dp_h5"
                android:text="@string/offset"/>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/offset_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/seekbar_layout_height">
                <ImageView
                    android:id="@+id/offset_down"
                    android:layout_width="@dimen/button_add_reduce_width"
                    android:layout_height="@dimen/button_add_reduce_height"
                    android:src="@drawable/btn_down"
                    android:scaleType="centerInside"
                    android:text="@string/down"/>
                <SeekBar
                    android:id="@+id/offset_level"
                    android:paddingLeft="@dimen/tw_dp_w10"
                    android:paddingRight="@dimen/tw_dp_w10"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:maxHeight="@dimen/tw_dp_h9"
                    android:progressDrawable="@drawable/progressdrawable"
                    android:thumb="@drawable/thumb"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/offset_up"
                    android:layout_width="@dimen/button_add_reduce_width"
                    android:layout_height="@dimen/button_add_reduce_height"
                    android:src="@drawable/btn_up"
                    android:scaleType="centerInside"
                    android:text="@string/up"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/camera_reset_button_textg_size"
                android:textColor="#fff"
                android:gravity="center"
                android:id="@+id/tv_camera_reset"
                android:background="@drawable/btn_camera_alarm_user"
                android:clickable="true"
                android:layout_width="@dimen/camera_reset_button_width"
                android:layout_height="@dimen/camera_reset_button_height"
                android:layout_marginTop="@dimen/tw_dp_h20"
                android:text="@string/camera_reset"/>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
