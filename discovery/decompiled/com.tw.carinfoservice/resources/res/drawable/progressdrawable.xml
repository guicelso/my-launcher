<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="15dp"/>
            <gradient
                android:startColor="#a09d9e9d"
                android:endColor="#a0747674"
                android:angle="270"
                android:centerY="2"
                android:centerColor="#a05a5d5a"/>
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape>
                <corners android:radius="15dp"/>
                <gradient
                    android:startColor="#80ffd300"
                    android:endColor="#a0ffcb00"
                    android:angle="270"
                    android:centerY="2"
                    android:centerColor="#80ffb600"/>
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="15dp"/>
                <gradient
                    android:startColor="#ff2cbaff"
                    android:endColor="#ff2cbaff"
                    android:angle="270"
                    android:centerY="2"
                    android:centerColor="#ff2cbaff"/>
            </shape>
        </clip>
    </item>
</layer-list>
