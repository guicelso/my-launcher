<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/pop5"
    android:padding="@dimen/tw_dp_w20"
    android:layout_width="@dimen/tw_dp_w749"
    android:layout_height="@dimen/tw_dp_h472"
    android:baselineAligned="false">
    <LinearLayout
        android:id="@+id/re_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_title_height">
        <TextView
            android:textSize="@dimen/title_text_size"
            android:textColor="@color/text_color_normal"
            android:gravity="center"
            android:id="@+id/tv_dialog_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/iv_dialog_close"
            android:clickable="true"
            android:layout_width="@dimen/dialog_btn_close_size"
            android:layout_height="@dimen/dialog_btn_close_size"
            android:src="@drawable/select_btn_close"
            android:scaleType="centerInside"/>
    </LinearLayout>
    <View
        android:background="@drawable/dialog_title_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tw_dp_h3"
        android:layout_marginBottom="@dimen/tw_dp_h8"/>
    <TextView
        android:textSize="@dimen/normal_text_size"
        android:textColor="@color/text_color_normal"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/about_mcu_info_t"/>
    <TextView
        android:textSize="@dimen/normal_text_size"
        android:textColor="@color/text_color_normal"
        android:gravity="center"
        android:id="@+id/mcu_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="@dimen/normal_text_size"
        android:textColor="@color/text_color_normal"
        android:gravity="center"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tw_dp_h15"
        android:text="@string/about_system_info_t"/>
    <TextView
        android:textSize="@dimen/normal_text_size"
        android:textColor="@color/text_color_normal"
        android:gravity="center"
        android:id="@+id/tv_sn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="bottom|center_horizontal"
        android:id="@+id/ll_qr_clode"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/tw_dp_h5"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_qr_ccid"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/system_info"
                android:layout_width="@dimen/dialog_mcu_version_img_size"
                android:layout_height="@dimen/dialog_mcu_version_img_size"
                android:scaleType="centerInside"/>
            <TextView
                android:textSize="@dimen/normal_text_size"
                android:textColor="@color/text_color_normal"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tw_dp_h5"
                android:text="Device No"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_qr_imei_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/iv_imei_1"
                android:layout_width="@dimen/dialog_mcu_version_img_size"
                android:layout_height="@dimen/dialog_mcu_version_img_size"
                android:scaleType="centerInside"/>
            <TextView
                android:textSize="@dimen/normal_text_size"
                android:textColor="@color/text_color_normal"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tw_dp_h5"
                android:text="IMEI1"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_qr_imei_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/iv_imei_2"
                android:layout_width="@dimen/dialog_mcu_version_img_size"
                android:layout_height="@dimen/dialog_mcu_version_img_size"
                android:scaleType="centerInside"/>
            <TextView
                android:textSize="@dimen/normal_text_size"
                android:textColor="@color/text_color_normal"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tw_dp_h5"
                android:text="IMEI2"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
