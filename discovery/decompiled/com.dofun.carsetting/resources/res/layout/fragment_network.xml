<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/fragment_root_style">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_wifi"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:text="@string/wifi"
                style="@style/fragmen_title_style"/>
            <LinearLayout style="@style/fragment_linearlayout_style">
                <com.dofun.carsetting.widget.SwitchPreference
                    android:id="@+id/sp_wifi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="pref_wifi"
                    app:title="@string/wifi_net"/>
                <com.dofun.carsetting.widget.InfoPreference
                    android:id="@+id/ip_wifi_connect_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="pref_current_wifi"
                    app:pref_value="005"
                    app:pref_value_icon="@drawable/ic_wifi4"
                    app:title="@string/wifi_connected"/>
                <com.dofun.carsetting.widget.InfoPreference
                    android:id="@+id/ip_wifi_more_setting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="pref_wifi_more"
                    app:show_divider="false"
                    app:title="@string/key_more"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_mobile"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tw_dp_h24">
            <TextView
                android:textSize="@dimen/title_text_size"
                android:textColor="@color/text_color_normal"
                android:paddingLeft="@dimen/tw_dp_w8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mobile_network"
                android:maxLines="1"/>
            <LinearLayout style="@style/fragment_linearlayout_style">
                <com.dofun.carsetting.widget.SwitchPreference
                    android:id="@+id/sp_mobile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="pref_mobile"
                    app:title="@string/mobile_data"/>
                <com.dofun.carsetting.widget.InfoPreference
                    android:id="@+id/ip_data_use"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="pref_mobile_data_use"
                    app:pref_value="80.59G"
                    app:show_right_icon="false"
                    app:summary="7月31~8月31"
                    app:title="@string/data_used_info"/>
                <com.dofun.carsetting.widget.InfoPreference
                    android:id="@+id/ip_mobile_more_setting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="pref_mobile_more"
                    app:show_divider="false"
                    app:title="@string/key_more"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_network_more"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tw_dp_h16">
            <TextView
                android:textSize="@dimen/title_text_size"
                android:textColor="@color/text_color_normal"
                android:paddingLeft="@dimen/tw_dp_w8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/network_more_setting"
                android:maxLines="1"/>
            <LinearLayout style="@style/fragment_linearlayout_style">
                <RelativeLayout style="@style/fragment_relativeLayout_style">
                    <TextView
                        android:id="@+id/system_sound_priority"
                        android:text="@string/hostpot"
                        style="@style/FragmentFacilitySoundButton"/>
                    <TextView
                        android:id="@+id/rd_party_sound_priority"
                        android:text="@string/vpn"
                        android:layout_centerHorizontal="true"
                        style="@style/FragmentFacilitySoundButton"/>
                    <TextView
                        android:id="@+id/intelligent_priority"
                        android:text="@string/airplane_mode"
                        android:layout_alignParentRight="true"
                        style="@style/FragmentFacilitySoundButton"/>
                    <View
                        android:background="@drawable/tl_list_divider2"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/tw_dp_h2"
                        android:layout_alignParentBottom="true"/>
                </RelativeLayout>
                <com.dofun.carsetting.widget.InfoPreference
                    android:id="@+id/ip_sim_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="pref_mobile_more"
                    app:show_divider="false"
                    app:title="@string/sim_info"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
