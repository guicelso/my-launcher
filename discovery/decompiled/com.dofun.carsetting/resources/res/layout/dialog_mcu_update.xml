<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/pop5"
    android:padding="@dimen/tw_dp_w5"
    android:layout_width="@dimen/tw_dp_w520"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/re_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_title_height"
        android:layout_marginTop="@dimen/tw_dp_h3">
        <TextView
            android:textSize="@dimen/title_text_size"
            android:textColor="@color/text_color_normal"
            android:gravity="center"
            android:id="@+id/tv_dialog_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:layout_weight="1"
            android:paddingStart="@dimen/tw_dp_w24"
            android:paddingEnd="@dimen/tw_dp_w32"/>
        <ImageView
            android:id="@+id/iv_dialog_close"
            android:clickable="true"
            android:layout_width="@dimen/dialog_btn_close_size"
            android:layout_height="@dimen/dialog_btn_close_size"
            android:layout_marginRight="@dimen/tw_dp_w24"
            android:src="@drawable/select_btn_close"
            android:scaleType="centerInside"/>
    </LinearLayout>
    <View
        android:id="@+id/view_divider"
        android:background="@drawable/dialog_title_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tw_dp_h3"
        android:layout_below="@+id/re_title"/>
    <ListView
        android:id="@+id/item_list"
        android:paddingLeft="@dimen/tw_dp_w24"
        android:paddingRight="@dimen/tw_dp_w24"
        android:fadingEdge="none"
        android:fadingEdgeLength="0dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:listSelector="#00000000"
        android:cacheColorHint="#00000000"
        android:divider="@null"
        android:layout_above="@+id/ll_update_tv"
        android:layout_below="@+id/view_divider"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_update_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/tw_dp_w24"
        android:layout_marginRight="@dimen/tw_dp_w24"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="@dimen/normal_text_size"
            android:textColor="@color/mcu_update_tv_color"
            android:ellipsize="marquee"
            android:gravity="center"
            android:id="@+id/update_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/tw_dp_w8"
            android:layout_marginRight="@dimen/tw_dp_w8"
            android:maxLines="2"
            android:marqueeRepeatLimit="marquee_forever"/>
        <SeekBar
            android:id="@+id/update_progress"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tw_dp_h44"
            android:layout_marginLeft="@dimen/tw_dp_w26"
            android:layout_marginRight="@dimen/tw_dp_w26"
            android:layout_below="@+id/ll_update_tv"/>
    </LinearLayout>
</RelativeLayout>
