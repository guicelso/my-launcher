<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/fragment_root_style">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:text="@string/system_info"
            style="@style/fragmen_title_style"/>
        <LinearLayout style="@style/fragment_linearlayout_style">
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/apk_update_string_entries"
                android:id="@+id/backup_apk"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/apk_update_string_values"
                app:save_data="false"
                app:show_divider="true"
                app:title="@string/backup_apk"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/about_the_machine"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="about_the_machine"
                app:show_divider="true"
                app:title="@string/about"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/mcu_update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="mcu_update"
                app:show_divider="true"
                app:title="@string/mcu_update"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/system_update_string_entries"
                android:id="@+id/system_update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/close_open_entries_value"
                app:key="system_update"
                app:show_divider="true"
                app:title="@string/system_update"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/time_and_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="time_and_date"
                app:show_divider="true"
                app:title="@string/time_and_date"/>
            <com.dofun.carsetting.widget.EditTextPreference
                android:id="@+id/developer_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hint="@string/enter_your_pin"
                app:input_password="true"
                app:input_type="@integer/TYPE_CLASS_NUMBER"
                app:key="developer_options"
                app:show_divider="true"
                app:title="@string/developer_options"/>
            <com.dofun.carsetting.widget.EditTextPreference
                android:id="@+id/restore_factory_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hint="@string/enter_your_pin"
                app:input_password="true"
                app:input_type="@integer/TYPE_CLASS_NUMBER"
                app:key="restore_factory_settings"
                app:show_divider="false"
                app:title="@string/reset_factory_title"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
