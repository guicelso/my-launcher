<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/pop5"
    android:layout_width="@dimen/tw_dp_w500"
    android:layout_height="@dimen/tw_dp_h300">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_title_height">
        <TextView
            android:textSize="@dimen/normal_text_size"
            android:textColor="@color/text_color_normal"
            android:gravity="center"
            android:id="@+id/tv_dialog_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:layout_weight="1"
            android:paddingStart="@dimen/tw_dp_w24"
            android:paddingEnd="@dimen/tw_dp_w32"/>
        <ImageView
            android:id="@+id/iv_dialog_close"
            android:clickable="true"
            android:layout_width="@dimen/dialog_btn_close_size"
            android:layout_height="@dimen/dialog_btn_close_size"
            android:layout_marginRight="@dimen/tw_dp_w24"
            android:src="@drawable/select_btn_close"
            android:scaleType="centerInside"/>
    </LinearLayout>
    <View
        android:background="@drawable/tl_list_divider2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tw_dp_h2"
        android:layout_marginLeft="@dimen/tw_dp_w24"
        android:layout_marginRight="@dimen/tw_dp_w24"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tw_dp_h60"
        android:layout_marginLeft="@dimen/tw_dp_w24"
        android:layout_marginTop="@dimen/tw_dp_h10"
        android:layout_marginRight="@dimen/tw_dp_w24">
        <TextView
            android:textSize="@dimen/normal_text_size"
            android:textColor="@color/text_color_normal"
            android:gravity="center_vertical"
            android:layout_width="@dimen/dialog_backlight_adjust_minmax_width"
            android:layout_height="wrap_content"
            android:text="@string/minimum_value"/>
        <SeekBar
            android:id="@+id/min_SeekBar"
            android:max="45"
            style="@style/CustomSeekbarStyle"/>
        <TextView
            android:textSize="@dimen/normal_text_size"
            android:textColor="@color/text_color_normal"
            android:gravity="center_vertical"
            android:id="@+id/min_text"
            android:layout_width="@dimen/dialog_backlight_adjust_minmax_value"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tw_dp_h60"
        android:layout_marginLeft="@dimen/tw_dp_w24"
        android:layout_marginTop="@dimen/tw_dp_h10"
        android:layout_marginRight="@dimen/tw_dp_w24">
        <TextView
            android:textSize="@dimen/normal_text_size"
            android:textColor="@color/text_color_normal"
            android:gravity="center_vertical"
            android:layout_width="@dimen/dialog_backlight_adjust_minmax_width"
            android:layout_height="wrap_content"
            android:text="@string/maximum_value"/>
        <SeekBar
            android:id="@+id/max_SeekBar"
            android:max="67"
            style="@style/CustomSeekbarStyle"/>
        <TextView
            android:textSize="@dimen/normal_text_size"
            android:textColor="@color/text_color_normal"
            android:gravity="center_vertical"
            android:id="@+id/max_text"
            android:layout_width="@dimen/dialog_backlight_adjust_minmax_value"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
