<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/install_main"
    android:clipChildren="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/current_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/controllLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <Button
                android:textSize="@dimen/normal_text_size"
                android:id="@+id/defaultPathButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cd_sdcard"
                android:onClick="onClick"/>
            <Button
                android:textSize="@dimen/normal_text_size"
                android:id="@+id/defaultPathButton2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cd_extsd0"
                android:onClick="onClick"/>
            <Button
                android:textSize="@dimen/normal_text_size"
                android:id="@+id/defaultPathButton3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cd_extsd1"
                android:onClick="onClick"/>
            <Button
                android:textSize="@dimen/normal_text_size"
                android:id="@+id/defaultPathButton4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cd_usb0"
                android:onClick="onClick"/>
            <Button
                android:textSize="@dimen/normal_text_size"
                android:id="@+id/defaultPathButton5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cd_usb1"
                android:onClick="onClick"/>
            <Button
                android:textSize="@dimen/normal_text_size"
                android:id="@+id/defaultPathButton6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cd_usb2"
                android:onClick="onClick"/>
            <Button
                android:textSize="@dimen/normal_text_size"
                android:id="@+id/parentPathButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cd_parent_path"
                android:onClick="onClick"/>
            <Button
                android:textSize="@dimen/normal_text_size"
                android:id="@+id/cpButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cp2inand"
                android:onClick="onClick"/>
        </LinearLayout>
    </HorizontalScrollView>
    <ListView
        android:id="@+id/file_listview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:listSelector="@android:color/darker_gray"/>
</LinearLayout>
