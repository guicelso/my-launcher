<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/fragment_root_style">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:visibility="gone"
            layout="@layout/layout_top_content"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_voice_wakeup_sen"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:text="@string/voice_wakeup_sen"
                style="@style/fragmen_title_style"/>
            <LinearLayout style="@style/fragment_linearlayout_style">
                <com.dofun.carsetting.widget.InfoPreference
                    android:id="@+id/voice_wakeup_sen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="voice_wakeup_sen"
                    app:pref_value="@string/voice_hello"
                    app:show_divider="false"
                    app:show_value="true"
                    app:title="@string/voice_wakeup_sen_now"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_wake_up_control"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:text="@string/swc_voice_mode_title"
                style="@style/fragmen_title_style"/>
            <LinearLayout style="@style/fragment_linearlayout_style">
                <com.dofun.carsetting.widget.InfoPreference
                    android:entries="@array/voice_btn_wake_up_entries"
                    android:id="@+id/voice_btn_wake_up_setting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:entryValues="@array/voice_btn_wake_up_values"
                    app:key="voice_btn_wake_up_setting"
                    app:show_divider="false"
                    app:show_right_icon="true"
                    app:title="@string/voice_key_mode_choose"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_voice_app"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tw_dp_h16">
                <TextView
                    android:text="@string/speed_app_select_title"
                    style="@style/fragmen_title_style"/>
                <LinearLayout style="@style/fragment_linearlayout_style">
                    <android.support.v7.widget.RecyclerView
                        android:scrollbarSize="@dimen/tw_dp_w3"
                        android:scrollbarThumbVertical="@color/gray"
                        android:id="@+id/rv_voice_app"
                        android:scrollbars="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fastScrollEnabled="true"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_voice_sensitive"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tw_dp_h24">
                <TextView
                    android:text="@string/voice_sensitive_adjust"
                    style="@style/fragmen_title_style"/>
                <LinearLayout
                    android:orientation="horizontal"
                    style="@style/fragment_linearlayout_style">
                    <SeekBar
                        android:id="@+id/sb_voice_sensitive"
                        style="@style/CustomSeekbarStyle"/>
                    <TextView
                        android:textSize="@dimen/title_text_size"
                        android:textColor="@color/text_color_normal"
                        android:gravity="center_vertical"
                        android:id="@+id/tv_voice_sensitive"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_voice_speed"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tw_dp_h24">
                <TextView
                    android:text="@string/voice_play_speech"
                    style="@style/fragmen_title_style"/>
                <RadioGroup
                    android:orientation="horizontal"
                    android:id="@+id/rg_voice_speed"
                    style="@style/fragment_linearlayout_style">
                    <RadioButton
                        android:id="@+id/rb_less_20"
                        android:text="@string/voice_minus_two"
                        style="@style/voice_speed_item_style"/>
                    <RadioButton
                        android:id="@+id/rb_less_15"
                        android:text="@string/voice_minus_one"
                        style="@style/voice_speed_item_style"/>
                    <RadioButton
                        android:id="@+id/rb_normal"
                        android:button="@null"
                        android:text="@string/normal"
                        style="@style/voice_speed_item_style"/>
                    <RadioButton
                        android:id="@+id/rb_more_15"
                        android:button="@null"
                        android:text="@string/voice_one"
                        style="@style/voice_speed_item_style"/>
                    <RadioButton
                        android:id="@+id/rb_more_20"
                        android:button="@null"
                        android:text="@string/voice_two"
                        style="@style/voice_speed_item_style"/>
                </RadioGroup>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_default_app"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tw_dp_h24">
                <TextView
                    android:text="@string/default_app_select"
                    style="@style/fragmen_title_style"/>
                <LinearLayout style="@style/fragment_linearlayout_style">
                    <com.dofun.carsetting.widget.InfoPreference
                        android:id="@+id/ip_default_navi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:key="pref_current_wifi"
                        app:pref_value="@string/no_default_navi_app"
                        app:show_value="true"
                        app:title="@string/default_navi_app_title"/>
                    <com.dofun.carsetting.widget.InfoPreference
                        android:id="@+id/ip_default_music"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:key="pref_current_wifi"
                        app:pref_value="@string/guide_no_default_music"
                        app:show_value="true"
                        app:title="@string/default_music_app_title"/>
                    <com.dofun.carsetting.widget.InfoPreference
                        android:id="@+id/ip_default_radio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:key="pref_current_wifi"
                        app:pref_value="@string/no_default_radio_app"
                        app:show_divider="false"
                        app:show_value="true"
                        app:title="@string/default_radio_app_title"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_control_more"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tw_dp_h24">
                <TextView
                    android:text="@string/voice_assist_setting"
                    style="@style/fragmen_title_style"/>
                <LinearLayout style="@style/fragment_linearlayout_style">
                    <com.dofun.carsetting.widget.InfoPreference
                        android:id="@+id/ip_float_icon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:key="pref_mobile_data_use"
                        app:pref_value="@string/speed_normal_icon"
                        app:pref_value_icon="@drawable/icon_voice_std"
                        app:show_value="true"
                        app:title="@string/float_icon"/>
                    <com.dofun.carsetting.widget.SwitchPreference
                        android:id="@+id/sp_voice_icon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:key="pref_mobile"
                        app:title="@string/show_icon"/>
                    <com.dofun.carsetting.widget.SwitchPreference
                        android:id="@+id/sp_screen_control"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:key="sp_screen_control"
                        app:title="@string/screen_control"/>
                    <com.dofun.carsetting.widget.SwitchPreference
                        android:id="@+id/sp_voice_wake_up"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:key="pref_mobile"
                        app:title="@string/voice_wakeup"/>
                    <com.dofun.carsetting.widget.SwitchPreference
                        android:id="@+id/sp_quick_wake_up"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:key="pref_mobile"
                        app:show_divider="false"
                        app:title="@string/quick_wake_up"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_voice_help"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tw_dp_h24">
                <TextView
                    android:text="@string/voice_help"
                    style="@style/fragmen_title_style"/>
                <LinearLayout style="@style/fragment_linearlayout_style">
                    <TextView
                        android:background="@drawable/icon_focus_wechat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="10dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
