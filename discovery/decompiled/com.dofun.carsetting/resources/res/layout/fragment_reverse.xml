<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/fragment_root_style">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/tv_reverse_title"
            android:text="@string/reverse_setting"
            style="@style/fragmen_title_style"/>
        <LinearLayout style="@style/fragment_linearlayout_style">
            <com.dofun.carsetting.widget.SwitchPreference
                android:id="@+id/system_mirror"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="reverse_mirror"
                app:summary="@string/reverse_mirror_tip1"
                app:title="@string/left_right_mirror"/>
            <com.dofun.carsetting.widget.SwitchPreference
                android:id="@+id/system_mirror_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="system_mirror_vertical"
                app:summary="@string/reverse_mirror_tip2"
                app:title="@string/top_bottom_mirror"/>
            <com.dofun.carsetting.widget.SwitchPreference
                android:id="@+id/system_fradar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="reverse_radar"
                app:title="@string/reverse_radar"/>
            <com.dofun.carsetting.widget.SwitchPreference
                android:id="@+id/system_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="system_line"
                app:title="@string/reverse_track"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/track_direction_entries"
                android:id="@+id/system_line_direction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/track_direction_values"
                app:key="system_line_direction"
                app:title="@string/reverse_track_direction"/>
            <com.dofun.carsetting.widget.SwitchPreference
                android:id="@+id/reverse_scale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="reverse_scale"
                app:title="@string/reverse_scale"/>
            <com.dofun.carsetting.widget.SwitchPreference
                android:id="@+id/reverse_valive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="reverse_valive"
                app:title="@string/reverse_valive"/>
            <com.dofun.carsetting.widget.SwitchPreference
                android:id="@+id/reverse_double_flash"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="reverse_double_flash"
                app:title="@string/reverse_double_flash"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/reverse_delay_entries"
                android:id="@+id/reverse_delay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/reverse_delay_values"
                app:key="reverse_delay"
                app:title="@string/reverse_delay_title"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/ts9_ahd360_entries"
                android:id="@+id/reverse_camera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/ts9_ahd360_values"
                app:key="reverse_camera"
                app:title="@string/reverse_ahd1"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/forward_looking_entries"
                android:id="@+id/forward_looking_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/forward_looking_value"
                app:key="forward_looking_switch"
                app:show_divider="false"
                app:title="@string/forward_looking_switch"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/setting_360"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="setting_360"
                app:title="@string/setting_360"/>
            <com.dofun.carsetting.widget.SwitchPreference
                android:entries="@array/close_open_entries"
                android:id="@+id/boot_360"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/close_open_entries_value"
                app:key="system_360"
                app:title="@string/boot_360_title"/>
            <com.dofun.carsetting.widget.SwitchPreference
                android:id="@+id/float_360"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="float_360"
                app:show_divider="false"
                app:title="@string/floating_btn_360_title"/>
            <com.dofun.carsetting.widget.SwitchPreference
                android:id="@+id/remote_monitoring"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="remote_monitoring"
                app:summary="@string/low_voltage_protection_summary"
                app:title="@string/remote_monitoring"/>
        </LinearLayout>
        <TextView
            android:id="@+id/tv_reverse_voice_control"
            android:text="@string/reverse_voice_control"
            style="@style/fragmen_title_style"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_reverse_voice_control"
            android:layout_width="match_parent"
            style="@style/fragment_linearlayout_style">
            <ImageView
                android:id="@+id/tv_reverse_mute"
                android:background="@drawable/lev_reverse_mute"
                android:layout_width="@dimen/tw_dp_h60"
                android:layout_height="@dimen/tw_dp_h60"
                android:layout_marginLeft="@dimen/tw_dp_w20"
                android:layout_marginRight="@dimen/tw_dp_w10"/>
            <SeekBar
                android:id="@+id/reverse_mute_seek_bar"
                style="@style/CustomSeekbarStyle"/>
        </LinearLayout>
        <com.dofun.carsetting.widget.SwitchPreference
            android:id="@+id/reverse_mute"
            android:background="@drawable/category_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tw_dp_h21"
            app:key="reverse_voice_mute"
            app:show_divider="false"
            app:title="@string/reverse_voice_mute"/>
    </LinearLayout>
</ScrollView>
