<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/fragment_root_style">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include layout="@layout/layout_top_content"/>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/ic_config_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/tw_dp_h24"
                android:layout_marginStart="@dimen/tw_dp_w24"
                android:layout_marginEnd="@dimen/tw_dp_w24">
                <LinearLayout
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:text="@string/bt_music_volume"
                        style="@style/fragment_hint_style2"/>
                    <SeekBar
                        android:id="@+id/bt_music_volume_seek_bar"
                        style="@style/CustomSeekbarStyle2"/>
                    <TextView
                        android:textSize="@dimen/normal_text_size"
                        android:textColor="@color/text_color_normal"
                        android:gravity="center"
                        android:id="@+id/bt_music_volume_value"
                        style="@style/FragmentFacilitySeekbarView"/>
                </LinearLayout>
                <View style="@style/fragment_divider_View_style"/>
                <LinearLayout
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:text="@string/bt_call_volume"
                        style="@style/fragment_hint_style2"/>
                    <SeekBar
                        android:id="@+id/bt_call_volume_seek_bar"
                        style="@style/CustomSeekbarStyle2"/>
                    <TextView
                        android:textSize="@dimen/normal_text_size"
                        android:textColor="@color/text_color_normal"
                        android:gravity="center"
                        android:id="@+id/bt_call_volume_value"
                        style="@style/FragmentFacilitySeekbarView"/>
                </LinearLayout>
                <View style="@style/fragment_divider_View_style"/>
                <LinearLayout
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:text="@string/system_audio_and_video_volume"
                        style="@style/fragment_hint_style2"/>
                    <SeekBar
                        android:id="@+id/system_audio_and_video_volume_seek_bar"
                        style="@style/CustomSeekbarStyle2"/>
                    <TextView
                        android:textSize="@dimen/normal_text_size"
                        android:textColor="@color/text_color_normal"
                        android:gravity="center"
                        android:id="@+id/system_audio_and_video_volume_value"
                        style="@style/FragmentFacilitySeekbarView"/>
                </LinearLayout>
                <View style="@style/fragment_divider_View_style"/>
                <LinearLayout
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:text="@string/radio_volume"
                        style="@style/fragment_hint_style2"/>
                    <SeekBar
                        android:id="@+id/radio_volume_seek_bar"
                        style="@style/CustomSeekbarStyle2"/>
                    <TextView
                        android:textSize="@dimen/normal_text_size"
                        android:textColor="@color/text_color_normal"
                        android:gravity="center"
                        android:id="@+id/radio_volume_value"
                        style="@style/FragmentFacilitySeekbarView"/>
                </LinearLayout>
                <View style="@style/fragment_divider_View_style"/>
                <LinearLayout
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:text="@string/key_aux"
                        style="@style/fragment_hint_style2"/>
                    <SeekBar
                        android:id="@+id/aux_volume_seek_bar"
                        style="@style/CustomSeekbarStyle2"/>
                    <TextView
                        android:textSize="@dimen/normal_text_size"
                        android:textColor="@color/text_color_normal"
                        android:gravity="center"
                        android:id="@+id/aux_volume_value"
                        style="@style/FragmentFacilitySeekbarView"/>
                </LinearLayout>
                <View style="@style/fragment_divider_View_style"/>
                <LinearLayout
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:text="@string/key_tv"
                        style="@style/fragment_hint_style2"/>
                    <SeekBar
                        android:id="@+id/tv_volume_seek_bar"
                        style="@style/CustomSeekbarStyle2"/>
                    <TextView
                        android:textSize="@dimen/normal_text_size"
                        android:textColor="@color/text_color_normal"
                        android:gravity="center"
                        android:id="@+id/tv_volume_value"
                        style="@style/FragmentFacilitySeekbarView"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
