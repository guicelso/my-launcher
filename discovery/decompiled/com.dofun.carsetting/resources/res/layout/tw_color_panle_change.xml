<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="#90000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="@dimen/normal_text_size"
            android:textColor="#fff"
            android:id="@+id/txt_greed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vcom"/>
        <LinearLayout
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/color_greed_reduce"
                android:src="@drawable/tw_btn_color_reduce"
                style="@style/FragmentFacilityColorGreedReduce"/>
            <SeekBar
                android:id="@+id/color_greed"
                android:layout_width="@dimen/tw_dp_w360"
                android:layout_height="wrap_content"
                android:max="30"/>
            <ImageView
                android:id="@+id/color_greed_add"
                android:src="@drawable/tw_btn_color_add"
                style="@style/FragmentFacilityColorGreedReduce"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/normal_text_size"
            android:textColor="#fff"
            android:id="@+id/txt_blue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tw_dp_h18"
            android:text="@string/avdd"/>
        <LinearLayout
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/color_bule_reduce"
                android:src="@drawable/tw_btn_color_reduce"
                style="@style/FragmentFacilityColorGreedReduce"/>
            <SeekBar
                android:id="@+id/color_bule"
                android:layout_width="@dimen/tw_dp_w360"
                android:layout_height="wrap_content"
                android:max="13"/>
            <ImageView
                android:id="@+id/color_bule_add"
                android:src="@drawable/tw_btn_color_add"
                style="@style/FragmentFacilityColorGreedReduce"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/normal_text_size"
            android:textColor="#fff"
            android:id="@+id/txt_red"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/color_red_reduce"
                android:src="@drawable/tw_btn_color_reduce"
                style="@style/FragmentFacilityColorGreedReduce"/>
            <SeekBar
                android:id="@+id/color_red"
                android:layout_width="@dimen/tw_dp_w360"
                android:layout_height="wrap_content"
                android:max="1"/>
            <ImageView
                android:id="@+id/color_red_add"
                android:src="@drawable/tw_btn_color_add"
                style="@style/FragmentFacilityColorGreedReduce"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/normal_text_size"
            android:textColor="#fff"
            android:id="@+id/txt_gamma"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/lin_gamma"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/color_gamma_reduce"
                android:src="@drawable/tw_btn_color_reduce"
                style="@style/FragmentFacilityColorGreedReduce"/>
            <SeekBar
                android:id="@+id/color_gamma"
                android:layout_width="@dimen/tw_dp_w360"
                android:layout_height="wrap_content"
                android:max="6"/>
            <ImageView
                android:id="@+id/color_gamma_add"
                android:src="@drawable/tw_btn_color_add"
                style="@style/FragmentFacilityColorGreedReduce"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/normal_text_size"
            android:textColor="#fff"
            android:id="@+id/txt_brightness"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bright"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/lin_bright"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/color_brightness_reduce"
                android:src="@drawable/tw_btn_color_reduce"
                style="@style/FragmentFacilityColorGreedReduce"/>
            <SeekBar
                android:id="@+id/color_brightness"
                android:layout_width="@dimen/tw_dp_w360"
                android:layout_height="wrap_content"
                android:max="100"/>
            <ImageView
                android:id="@+id/color_brightness_add"
                android:src="@drawable/tw_btn_color_add"
                style="@style/FragmentFacilityColorGreedReduce"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/normal_text_size"
            android:textColor="#fff"
            android:id="@+id/txt_contrast"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/contrast"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/lin_contrast"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/color_contrast_reduce"
                android:src="@drawable/tw_btn_color_reduce"
                style="@style/FragmentFacilityColorGreedReduce"/>
            <SeekBar
                android:id="@+id/color_contrast"
                android:layout_width="@dimen/tw_dp_w360"
                android:layout_height="wrap_content"
                android:max="100"/>
            <ImageView
                android:id="@+id/color_contrast_add"
                android:src="@drawable/tw_btn_color_add"
                style="@style/FragmentFacilityColorGreedReduce"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/normal_text_size"
            android:textColor="#fff"
            android:id="@+id/txt_saturation"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/saturation"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/lin_saturation"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/color_saturation_reduce"
                android:src="@drawable/tw_btn_color_reduce"
                style="@style/FragmentFacilityColorGreedReduce"/>
            <SeekBar
                android:id="@+id/color_saturation"
                android:layout_width="@dimen/tw_dp_w360"
                android:layout_height="wrap_content"
                android:max="100"/>
            <ImageView
                android:id="@+id/color_saturation_add"
                android:src="@drawable/tw_btn_color_add"
                style="@style/FragmentFacilityColorGreedReduce"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/normal_text_size"
            android:textColor="#fff"
            android:id="@+id/txt_colortemp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/colortemp"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/lin_colortemp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/tw_dp_h50">
            <ImageView
                android:id="@+id/color_colortemp_reduce"
                android:src="@drawable/tw_btn_color_reduce"
                style="@style/FragmentFacilityColorGreedReduce"/>
            <SeekBar
                android:id="@+id/color_colortemp"
                android:layout_width="@dimen/tw_dp_w360"
                android:layout_height="wrap_content"
                android:max="50"/>
            <ImageView
                android:id="@+id/color_colortemp_add"
                android:src="@drawable/tw_btn_color_add"
                style="@style/FragmentFacilityColorGreedReduce"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
