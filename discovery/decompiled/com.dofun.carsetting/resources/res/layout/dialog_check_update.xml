<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/pop_7"
    android:padding="@dimen/tw_dp_w20"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false">
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/re_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_title_height">
        <TextView
            android:textSize="@dimen/title_text_size"
            android:textColor="@color/text_color_normal"
            android:gravity="center"
            android:id="@+id/tv_dialog_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/iv_dialog_close"
            android:clickable="true"
            android:layout_width="@dimen/dialog_btn_close_size"
            android:layout_height="@dimen/dialog_btn_close_size"
            android:src="@drawable/select_btn_close"
            android:scaleType="centerInside"/>
    </LinearLayout>
    <View
        android:id="@+id/view_divider"
        android:background="@drawable/dialog_title_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tw_dp_h3"
        android:layout_marginBottom="@dimen/tw_dp_h8"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_online_system_update"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="@dimen/normal_text_size"
                    android:textColor="@color/text_color_normal"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/tw_dp_h5"
                    android:text="@string/system_update"/>
                <TextView
                    android:textSize="@dimen/normal_text_size"
                    android:textColor="@color/text_color_normal"
                    android:gravity="center"
                    android:id="@+id/about_system2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/tw_dp_h5"
                    android:text="@string/about_system_info1"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/normal_text_size"
                        android:textColor="@color/red_color"
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/tw_dp_h5"
                        android:text="@string/system_update_prompt"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="@dimen/normal_text_size"
                        android:textColor="@color/text_color_checkupdate"
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/tv_detection_update_system"
                        android:background="@drawable/tr_b_bg"
                        android:paddingLeft="@dimen/tw_dp_w16"
                        android:paddingRight="@dimen/tw_dp_w16"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/about_info_icon_size"
                        android:layout_margin="@dimen/tw_dp_h5"
                        android:text="@string/about_detection_update"
                        android:onClick="onClick"/>
                </LinearLayout>
                <View
                    android:background="@drawable/pop_7_xian"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="@dimen/tw_dp_h10"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_mcu_online_update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tw_dp_h40">
                <TextView
                    android:textSize="@dimen/normal_text_size"
                    android:textColor="@color/text_color_normal"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/tw_dp_h5"
                    android:text="@string/mcu_update"/>
                <TextView
                    android:textSize="@dimen/normal_text_size"
                    android:textColor="@color/text_color_normal"
                    android:gravity="center"
                    android:id="@+id/about_mcu2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/tw_dp_h5"
                    android:text="@string/about_mcu_info"/>
                <TextView
                    android:textSize="@dimen/normal_text_size"
                    android:textColor="@color/text_color_checkupdate"
                    android:gravity="center"
                    android:layout_gravity="right"
                    android:id="@+id/tv_detection_update_mcu"
                    android:background="@drawable/tr_b_bg"
                    android:paddingLeft="@dimen/tw_dp_w16"
                    android:paddingRight="@dimen/tw_dp_w16"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/about_info_icon_size"
                    android:layout_margin="@dimen/tw_dp_h5"
                    android:text="@string/about_detection_update"
                    android:onClick="onClick"/>
                <View
                    android:background="@drawable/pop_7_xian"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="@dimen/tw_dp_h10"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/tv_can_update"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tw_dp_h40">
                <TextView
                    android:textSize="@dimen/normal_text_size"
                    android:textColor="@color/text_color_normal"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/tw_dp_h5"
                    android:text="@string/canbox_update"/>
                <TextView
                    android:textSize="@dimen/normal_text_size"
                    android:textColor="@color/text_color_normal"
                    android:gravity="center"
                    android:id="@+id/about_can2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/tw_dp_h5"
                    android:text="@string/about_can_info"/>
                <TextView
                    android:textSize="@dimen/normal_text_size"
                    android:textColor="@color/text_color_checkupdate"
                    android:gravity="center"
                    android:layout_gravity="right"
                    android:id="@+id/tv_detection_update_can"
                    android:background="@drawable/tr_b_bg"
                    android:paddingLeft="@dimen/tw_dp_w16"
                    android:paddingRight="@dimen/tw_dp_w16"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/about_info_icon_size"
                    android:layout_margin="@dimen/tw_dp_h5"
                    android:text="@string/about_detection_update"
                    android:onClick="onClick"/>
                <View
                    android:background="@drawable/pop_7_xian"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="@dimen/tw_dp_h10"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_tlink_update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tw_dp_h40">
                <TextView
                    android:textSize="@dimen/normal_text_size"
                    android:textColor="@color/text_color_normal"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/tw_dp_h5"
                    android:text="@string/tlink_update"/>
                <TextView
                    android:textSize="@dimen/normal_text_size"
                    android:textColor="@color/text_color_normal"
                    android:gravity="center"
                    android:id="@+id/about_tlink2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/tw_dp_h5"
                    android:text="@string/about_tlink_info"/>
                <TextView
                    android:textSize="@dimen/normal_text_size"
                    android:textColor="@color/text_color_checkupdate"
                    android:gravity="center"
                    android:layout_gravity="right"
                    android:id="@+id/tv_detection_update_tlink"
                    android:background="@drawable/tr_b_bg"
                    android:paddingLeft="@dimen/tw_dp_w16"
                    android:paddingRight="@dimen/tw_dp_w16"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/about_info_icon_size"
                    android:layout_margin="@dimen/tw_dp_h5"
                    android:text="@string/about_detection_update"
                    android:onClick="onClick"/>
                <View
                    android:background="@drawable/pop_7_xian"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="@dimen/tw_dp_h10"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
