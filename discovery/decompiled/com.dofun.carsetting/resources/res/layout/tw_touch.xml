<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TableLayout
        android:background="#404040"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TableRow
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <TextView
                android:id="@+id/key_1"
                android:text="@string/key_reserve"
                style="@style/KeypadText.Key"/>
            <TextView
                android:id="@+id/key_2"
                android:text="@string/key_reserve"
                style="@style/KeypadText.Key"/>
            <TextView
                android:id="@+id/key_3"
                android:text="@string/key_reserve"
                style="@style/KeypadText.Key"/>
            <TextView
                android:id="@+id/key_4"
                android:text="@string/key_reserve"
                style="@style/KeypadText.Key"/>
        </TableRow>
        <TableRow
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <TextView
                android:id="@+id/key_5"
                android:text="@string/key_reserve"
                style="@style/KeypadText.Key"/>
            <TextView
                android:id="@+id/key_6"
                android:text="@string/key_reserve"
                style="@style/KeypadText.Key"/>
            <TextView
                android:id="@+id/key_7"
                android:text="@string/key_reserve"
                style="@style/KeypadText.Key"/>
            <TextView
                android:id="@+id/key_8"
                android:text="@string/key_reserve"
                style="@style/KeypadText.Key"/>
        </TableRow>
        <TableRow
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <TextView
                android:id="@+id/key_9"
                android:text="@string/key_reserve"
                style="@style/KeypadText.Key"/>
            <TextView
                android:id="@+id/key_10"
                android:text="@string/key_reserve"
                style="@style/KeypadText.Key"/>
            <TextView
                android:id="@+id/key_11"
                android:text="@string/key_reserve"
                style="@style/KeypadText.Key"/>
            <TextView
                android:id="@+id/key_12"
                android:text="@string/key_reserve"
                style="@style/KeypadText.Key"/>
        </TableRow>
        <TableRow
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <TextView
                android:id="@+id/key_start"
                android:text="@string/key_start"
                style="@style/KeypadText.Key"/>
            <TextView
                android:id="@+id/key_cfg"
                android:text="@string/key_config"
                style="@style/KeypadText.Key"/>
            <TextView
                android:id="@+id/key_pos"
                android:text="@string/key_position"
                style="@style/KeypadText.Key"/>
            <TextView
                android:id="@+id/key_clear"
                android:text="@string/key_clear"
                style="@style/KeypadText.Key"/>
        </TableRow>
    </TableLayout>
    <com.dofun.carsetting.widget.CalibrationView
        android:id="@+id/calibration"
        android:background="#404040"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
