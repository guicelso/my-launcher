<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/fragment_root_style">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:text="@string/app_name"
            style="@style/fragmen_title_style"/>
        <LinearLayout style="@style/fragment_linearlayout_style">
            <com.dofun.carsetting.widget.MultiCheckPreference
                android:entries="@array/door_info_string_values"
                android:id="@+id/door_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/door_info_string_entries"
                app:key="door_info"
                app:show_divider="true"
                app:title="@string/door_info"/>
            <com.dofun.carsetting.widget.SwitchPreference
                android:id="@+id/swap_last_next"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="swap_last_next"
                app:title="@string/swap_last_next"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/global_key_values"
                android:id="@+id/global_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/global_key_entries"
                app:key="global_key"
                app:title="@string/global_key_title"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/canboxupdate"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="canboxupdate"
                app:show_divider="false"
                app:title="@string/canbox_update"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/logo_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="logo_settings"
                app:title="@string/logo_settings_title"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/log2file"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="log2file"
                app:save_data="false"
                app:title="@string/cfg_export_log"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/key_wheel_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="key_wheel_title"
                app:title="@string/key_wheel_title"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/getspeed_mode_entries"
                android:id="@+id/getspeed_mode"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/getspeed_mode_values"
                app:key="getspeed_mode"
                app:title="@string/getspeed_mode_title"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/shortcut_360_entries"
                android:id="@+id/shortcut_360"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/shortcut_360_values"
                app:key="shortcut_360"
                app:title="@string/shortcut_360_title"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/left_right_seat_entries"
                android:id="@+id/left_right_seat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/close_open_entries_value"
                app:key="left_right_seat"
                app:title="@string/left_right_seat_title"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/ampvol_entries"
                android:id="@+id/ampvol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/ampvol_value"
                app:key="ampvol"
                app:title="@string/ampvol"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/btn_car_choose"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/car_update_title"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/brake_mode_string_entries"
                android:id="@+id/brake_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/brake_mode_string_values"
                app:key="brake_mode"
                app:title="@string/brake_mode_title"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/echo_delay_param_entries"
                android:id="@+id/echo_delay_param"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/echo_delay_param_value"
                app:key="echo_delay_param"
                app:title="@string/echo_delay_param"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/ip_video_out_setting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="video_out_setting"
                app:title="@string/video_out_settings"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/force_pip_entries"
                android:id="@+id/ip_multi_screen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/force_pip_value"
                app:key="ip_multi_screen"
                app:title="@string/force_pip"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/btn_sleep_white_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="btn_sleep_white_list"
                app:summary="@string/sleep_white_list_title_summary"
                app:title="@string/sleep_white_list_title"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/btn_auto_play_app_list"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="btn_auto_play_app_list"
                app:title="@string/autoplay"/>
            <com.dofun.carsetting.widget.SwitchPreference
                android:id="@+id/system_usb11"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="system_usb11"
                app:title="@string/f_usb11_title"/>
            <com.dofun.carsetting.widget.SwitchPreference
                android:id="@+id/system_usbhub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="system_usbhub"
                app:title="USB HUB"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/tv_mode_DVB_entries"
                android:id="@+id/tv_mode_title"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/tv_mode_values"
                app:key="tv_mode"
                app:title="@string/tv_mode_title"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/tv_norm_entries"
                android:id="@+id/tv_norm"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/tv_norm_values"
                app:key="tv_norm"
                app:title="@string/tv_norm_title"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/es_file_manager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="es_file_manager"
                app:title="@string/es_file_manager_title"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/mic_mode_entries"
                android:id="@+id/mic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/mic_mode_values"
                app:key="mic"
                app:title="@string/mic_choose"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/ll_screen_casting_code_rate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/tw_dp_w16"
                android:paddingEnd="@dimen/tw_dp_w16">
                <TextView
                    android:textSize="@dimen/preference_title_text_size"
                    android:textColor="@color/text_color_normal"
                    android:gravity="center"
                    android:paddingTop="@dimen/tw_dp_h8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/screen_casting_code_rate_title"
                    android:maxLines="1"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingBottom="@dimen/tw_dp_h8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <View style="@style/FragmentFacilitySeekbarView"/>
                    <SeekBar
                        android:id="@+id/sb_screen_casting_code_rate"
                        style="@style/CustomSeekbarStyle"/>
                    <TextView
                        android:textSize="@dimen/normal_text_size"
                        android:textColor="@color/text_color_normal"
                        android:gravity="center"
                        android:id="@+id/tv_screen_casting_code_rate_value"
                        android:text="@string/key_0"
                        style="@style/FragmentFacilitySeekbarView"/>
                </LinearLayout>
                <View
                    android:background="@drawable/tl_list_divider2"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/tw_dp_h2"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/ll_lcd_clk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/tw_dp_w16"
                android:paddingEnd="@dimen/tw_dp_w16">
                <TextView
                    android:textSize="@dimen/preference_title_text_size"
                    android:textColor="@color/text_color_normal"
                    android:gravity="center"
                    android:paddingTop="@dimen/tw_dp_h8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/clk_title"
                    android:maxLines="1"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingBottom="@dimen/tw_dp_h8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <View style="@style/FragmentFacilitySeekbarView"/>
                    <SeekBar
                        android:id="@+id/sb_lcd_clk"
                        style="@style/CustomSeekbarStyle"/>
                    <TextView
                        android:textSize="@dimen/normal_text_size"
                        android:textColor="@color/text_color_normal"
                        android:gravity="center"
                        android:id="@+id/tv_lcd_clk_value"
                        android:text="@string/key_0"
                        style="@style/FragmentFacilitySeekbarView"/>
                </LinearLayout>
                <View
                    android:background="@drawable/tl_list_divider2"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/tw_dp_h2"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
