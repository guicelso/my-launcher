<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/pop5"
    android:paddingTop="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_title_height"
        android:layout_marginTop="@dimen/tw_dp_h3">
        <TextView
            android:textSize="@dimen/title_text_size"
            android:textColor="@color/text_color_normal"
            android:gravity="center"
            android:id="@+id/tv_dialog_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/multi_touch_action"
            android:maxLines="1"
            android:layout_weight="1"
            android:paddingStart="@dimen/tw_dp_w24"
            android:paddingEnd="@dimen/tw_dp_w32"/>
        <ToggleButton
            android:id="@+id/tg_enable_gesture"
            android:background="@drawable/select_pref_switch"
            android:layout_width="@dimen/preference_toggle_icon_width"
            android:layout_height="@dimen/preference_toggle_icon_height"
            android:layout_marginRight="24dp"
            android:button="@null"
            android:textOn=""
            android:textOff=""
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </LinearLayout>
    <View
        android:background="@drawable/dialog_title_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tw_dp_h3"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/iv_prev_tip"
                android:clickable="true"
                android:layout_width="@dimen/dialog_btn_close_size"
                android:layout_height="@dimen/dialog_btn_close_size"
                android:layout_marginLeft="24dp"
                android:layout_marginRight="32dp"
                android:src="@drawable/select_btn_left"
                android:scaleType="centerInside"/>
            <ImageView
                android:id="@+id/iv_tip_icon"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/iv_next_tip"
                android:clickable="true"
                android:layout_width="@dimen/dialog_btn_close_size"
                android:layout_height="@dimen/dialog_btn_close_size"
                android:layout_marginLeft="32dp"
                android:layout_marginRight="24dp"
                android:src="@drawable/select_btn_right"
                android:scaleType="centerInside"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_tip_indicate"
            android:paddingLeft="32dp"
            android:paddingRight="32dp"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginBottom="8dp"/>
        <TextView
            android:textSize="@dimen/sub_title_text_size"
            android:textColor="@color/text_color_normal"
            android:gravity="center"
            android:id="@+id/tv_tip"
            android:paddingLeft="32dp"
            android:paddingRight="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp"/>
    </LinearLayout>
    <View
        android:background="@drawable/dialog_title_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tw_dp_h3"/>
    <Button
        android:textSize="@dimen/title_text_size"
        android:textColor="@color/text_color_normal"
        android:id="@+id/btn_close"
        android:background="@drawable/select_btn_gesture_close"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:text="@string/close"/>
</LinearLayout>
