<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/main_layout_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/main_sv_bg"
        android:background="@drawable/tl_bg"
        android:paddingTop="@dimen/tw_dp_h2"
        android:paddingRight="@dimen/tw_dp_w2"
        android:scrollbars="none"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:maxWidth="@dimen/main_radio_group_max_width"
        android:minWidth="@dimen/main_radio_group_min_width"
        android:fillViewport="true">
        <RadioGroup
            android:orientation="vertical"
            android:id="@+id/rg_setting_item"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:minWidth="@dimen/main_radio_group_min_width">
            <com.dofun.carsetting.widget.MyRadioButton
                android:id="@+id/rb_internet"
                android:text="@string/internet"
                android:drawableLeft="@drawable/rb_internet_bg"
                app:compoundDrawables_height="@dimen/main_radio_btn_drawable_size"
                app:compoundDrawables_width="@dimen/main_radio_btn_drawable_size"
                style="@style/rb_stytle"/>
            <com.dofun.carsetting.widget.MyRadioButton
                android:id="@+id/rb_devices"
                android:text="@string/display"
                android:drawableLeft="@drawable/rb_devices_bg"
                app:compoundDrawables_height="@dimen/main_radio_btn_drawable_size"
                app:compoundDrawables_width="@dimen/main_radio_btn_drawable_size"
                style="@style/rb_stytle"/>
            <com.dofun.carsetting.widget.MyRadioButton
                android:id="@+id/rb_sound"
                android:text="@string/sound_setting"
                android:drawableLeft="@drawable/rb_sound_bg"
                app:compoundDrawables_height="@dimen/main_radio_btn_drawable_size"
                app:compoundDrawables_width="@dimen/main_radio_btn_drawable_size"
                style="@style/rb_stytle"/>
            <com.dofun.carsetting.widget.MyRadioButton
                android:id="@+id/rb_general"
                android:text="@string/general"
                android:drawableLeft="@drawable/rb_general_bg"
                app:compoundDrawables_height="@dimen/main_radio_btn_drawable_size"
                app:compoundDrawables_width="@dimen/main_radio_btn_drawable_size"
                style="@style/rb_stytle"/>
            <com.dofun.carsetting.widget.MyRadioButton
                android:id="@+id/rb_original"
                android:text="@string/original"
                android:drawableLeft="@drawable/rb_original_bg"
                app:compoundDrawables_height="@dimen/main_radio_btn_drawable_size"
                app:compoundDrawables_width="@dimen/main_radio_btn_drawable_size"
                style="@style/rb_stytle"/>
            <com.dofun.carsetting.widget.MyRadioButton
                android:id="@+id/rb_reverse"
                android:text="@string/reverse"
                android:drawableLeft="@drawable/rb_reverse_bg"
                app:compoundDrawables_height="@dimen/main_radio_btn_drawable_size"
                app:compoundDrawables_width="@dimen/main_radio_btn_drawable_size"
                style="@style/rb_stytle"/>
            <com.dofun.carsetting.widget.MyRadioButton
                android:id="@+id/rb_voice"
                android:text="@string/voice"
                android:drawableLeft="@drawable/rb_voice_bg"
                app:compoundDrawables_height="@dimen/main_radio_btn_drawable_size"
                app:compoundDrawables_width="@dimen/main_radio_btn_drawable_size"
                style="@style/rb_stytle"/>
            <com.dofun.carsetting.widget.MyRadioButton
                android:id="@+id/rb_personal"
                android:text="@string/personal"
                android:drawableLeft="@drawable/rb_personal_bg"
                app:compoundDrawables_height="@dimen/main_radio_btn_drawable_size"
                app:compoundDrawables_width="@dimen/main_radio_btn_drawable_size"
                style="@style/rb_stytle"/>
            <com.dofun.carsetting.widget.MyRadioButton
                android:id="@+id/rb_system"
                android:text="@string/system"
                android:drawableLeft="@drawable/rb_system_bg"
                app:compoundDrawables_height="@dimen/main_radio_btn_drawable_size"
                app:compoundDrawables_width="@dimen/main_radio_btn_drawable_size"
                style="@style/rb_stytle"/>
            <com.dofun.carsetting.widget.MyRadioButton
                android:id="@+id/rb_factory"
                android:text="@string/factory"
                android:drawableLeft="@drawable/rb_factory_bg"
                app:compoundDrawables_height="@dimen/main_radio_btn_drawable_size"
                app:compoundDrawables_width="@dimen/main_radio_btn_drawable_size"
                style="@style/rb_stytle"/>
            <com.dofun.carsetting.widget.MyRadioButton
                android:id="@+id/rb_setting"
                android:text="@string/key_more"
                android:drawableLeft="@drawable/rb_setting_bg"
                app:compoundDrawables_height="@dimen/main_radio_btn_drawable_size"
                app:compoundDrawables_width="@dimen/main_radio_btn_drawable_size"
                style="@style/rb_stytle"/>
            <com.dofun.carsetting.widget.MyRadioButton
                android:id="@+id/rb_devices_info"
                android:text="@string/about"
                android:drawableLeft="@drawable/rb_about_bg"
                app:compoundDrawables_height="@dimen/main_radio_btn_drawable_size"
                app:compoundDrawables_width="@dimen/main_radio_btn_drawable_size"
                style="@style/rb_stytle"/>
        </RadioGroup>
    </ScrollView>
    <FrameLayout
        android:id="@+id/main_frame_layout"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginTop="0dp"
        android:layout_weight="1"/>
</LinearLayout>
