<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/fragment_root_style">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:text="@string/basic_inf"
            style="@style/fragmen_title_style"/>
        <LinearLayout style="@style/fragment_linearlayout_style">
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/navigation_bar_entries"
                android:id="@+id/navbar_setting"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/navigation_bar_values"
                app:key="navbar_setting"
                app:title="@string/navigation_bar"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/netmusic_setting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="netmusic_setting"
                app:title="@string/netmusic_title"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/netvideo_setting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="netvideo_setting"
                app:title="@string/netvideo_title"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/sleep_string_entries_normal"
                android:id="@+id/sleep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/sleepn_string_values_normal"
                app:key="sleep"
                app:title="@string/light_sleep"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/sleep_mode_entries"
                android:id="@+id/sleep_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/sleep_mode_values"
                app:key="sleep_mode"
                app:title="@string/light_sleep_mode"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/shutdown_delay_entries2"
                android:id="@+id/ip_shutdown_delay"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/shutdown_delay_values2"
                app:key="shutdown_delay"
                app:summary="@string/shutdown_delay_summary"
                app:title="@string/shutdown_delay_title"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/panel_light_entries1"
                android:id="@+id/panel_light"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/close_open_entries_value2"
                app:key="panel_light"
                app:title="@string/panel_light_title"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/front_view_entries"
                android:id="@+id/front_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/front_in_aux_tv"
                app:key="front_view"
                app:title="@string/forward_looking_channel"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/close_open_entries"
                android:id="@+id/front_view_mirror"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/close_open_entries_value"
                app:key="front_view_mirror"
                app:title="@string/front_view_mirror_title"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/navi_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="navi_settings"
                app:title="@string/navi_settings_title1"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/ip_pip_function"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="ip_pip_function"
                app:title="@string/window_setting"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/pip_app_settings"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="pip_app_settings"
                app:title="@string/custom_window_selection"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/recorder_setting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="recorder_setting"
                app:title="@string/recorder_setting"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/ktv_setting"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="ktv_setting"
                app:title="@string/ktv_setting"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/gps_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="gps_settings"
                app:title="@string/gps"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/location_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="location_settings"
                app:title="@string/location"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/app_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="app_info"
                app:title="@string/app_info_title"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/amplifier_control_entries"
                android:id="@+id/amplifier_control"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/amplifier_control_values"
                app:key="amplifier_control"
                app:title="@string/amplifier_control_title"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/shutdown_delay_entries3"
                android:id="@+id/shutdown_monitor"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/shutdown_delay_values3"
                app:key="shutdown_monitor"
                app:summary="@string/shutdown_delay_summary1"
                app:title="@string/shutdown_delay_title1"/>
            <com.dofun.carsetting.widget.SwitchPreference
                android:entries="@array/close_open_entries"
                android:id="@+id/system_floatvideo"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/close_open_entries_value"
                app:key="system_floatvideo"
                app:title="@string/video_suspension_window"/>
            <com.dofun.carsetting.widget.SwitchPreference
                android:entries="@array/close_open_entries"
                android:id="@+id/navi_autostart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/close_open_entries_value"
                app:key="navi_autostart"
                app:title="@string/navi_autostart_title"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/app_autostart"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="app_autostart"
                app:title="@string/app_autostart_title"/>
            <com.dofun.carsetting.widget.SwitchPreference
                android:entries="@array/close_open_entries"
                android:id="@+id/sleep_display_boot_animation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/close_open_entries_value"
                app:key="sleep_display_boot_animation"
                app:title="@string/sleep_display_boot_animation"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/the_voltage_display_entries"
                android:id="@+id/voltage_display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/the_voltage_display_values"
                app:key="voltage_display"
                app:summary="@string/the_voltage_summary"
                app:title="@string/the_voltage_display"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/bt_battery_entries"
                android:id="@+id/phone_battery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/bt_battery_value"
                app:key="phone_battery"
                app:summary="@string/bt_battery_summary"
                app:title="@string/bt_battery_title"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/btn_sleep_white_list"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:summary="@string/sleep_white_list_title_summary"
                app:title="@string/sleep_white_list_title"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/log2file"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="log2file"
                app:save_data="false"
                app:title="@string/cfg_export_log"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/key_update_entries"
                android:id="@+id/key_update"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/key_update_values"
                app:key="key_update"
                app:title="@string/key_update_title"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/logo_settings"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="logo_settings"
                app:title="@string/logo_settings_title"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/brake_mode_string_entries"
                android:id="@+id/brake_mode"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/brake_mode_string_values"
                app:key="brake_mode"
                app:title="@string/brake_mode_title"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/radio_region_string_entries"
                android:id="@+id/radio_region"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/radio_region_string_values"
                app:key="radio_region"
                app:title="@string/radio_region_title"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/ampvol_entries"
                android:id="@+id/ampvol"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/ampvol_value"
                app:key="ampvol"
                app:title="@string/ampvol"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/system_ta_entries"
                android:id="@+id/system_ta"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/system_ta_values"
                app:key="system_ta"
                app:title="@string/system_ta_title"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/temp_mode_values"
                android:id="@+id/temp_mode"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:summary="@string/tv_mode_summary"
                android:entryValues="@array/temp_mode_entries"
                app:key="temp_mode"
                app:title="@string/temp_mode_title"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/ip_video_out_setting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="video_out_setting"
                app:title="@string/video_out_settings"/>
            <com.dofun.carsetting.widget.SwitchPreference
                android:id="@+id/gesture_recognition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="gesture_recognition"
                app:title="@string/gesture_recognition"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/low_voltage_protection_entries"
                android:id="@+id/low_voltage_protection"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/low_voltage_protection_values"
                app:key="low_voltage_protection"
                app:title="@string/low_voltage_protection_title"/>
        </LinearLayout>
        <TextView
            android:id="@+id/suspension_button_title"
            android:text="@string/suspension_button"
            style="@style/fragmen_title_style"/>
        <LinearLayout
            android:id="@+id/ll_suspension_button"
            style="@style/fragment_linearlayout_style">
            <com.dofun.carsetting.widget.SwitchPreference
                android:id="@+id/floating_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="floating_switch"
                app:title="@string/suspension_switch"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/floating_style_entries"
                android:id="@+id/setting_floating"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/floating_style_value"
                app:key="floating_style"
                app:title="@string/floating_style"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
