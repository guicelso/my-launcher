<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/selectable_item_bg"
    android:layout_width="match_parent"
    android:layout_height="@dimen/item_app_list_height">
    <ImageView
        android:id="@+id/iv_left_icon"
        android:layout_width="@dimen/tw_dp_h60"
        android:layout_height="@dimen/tw_dp_h60"
        android:scaleType="centerInside"/>
    <TextView
        android:textSize="@dimen/normal_text_size"
        android:gravity="center"
        android:id="@+id/tv_text"
        android:paddingLeft="@dimen/tw_dp_w16"
        android:paddingRight="@dimen/tw_dp_w16"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:maxLines="1"
        android:layout_weight="1"/>
    <TextView
        android:textSize="@dimen/normal_text_size"
        android:gravity="center"
        android:id="@+id/tv_tip"
        android:paddingLeft="@dimen/tw_dp_w16"
        android:paddingRight="@dimen/tw_dp_w16"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:maxLines="1"/>
    <ImageView
        android:id="@+id/iv_right_icon"
        android:layout_width="@dimen/tw_dp_h60"
        android:layout_height="@dimen/tw_dp_h60"
        android:scaleType="centerInside"/>
</LinearLayout>
