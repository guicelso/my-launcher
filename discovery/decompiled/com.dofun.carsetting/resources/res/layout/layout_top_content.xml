<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/iv_back"
    android:layout_width="match_parent"
    android:layout_height="@dimen/top_bar_height">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ImageView
            android:layout_width="@dimen/top_bar_btn_back_size"
            android:layout_height="@dimen/top_bar_btn_back_size"
            android:src="@drawable/select_btn_back"/>
        <TextView
            android:textSize="@dimen/normal_text_size"
            android:textColor="@color/text_color_title"
            android:gravity="center_vertical"
            android:id="@+id/tv_content"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/key_back"/>
    </LinearLayout>
    <View
        android:id="@+id/view_divider"
        android:background="@drawable/tl_list_divider2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tw_dp_h2"
        android:layout_marginLeft="@dimen/tw_dp_w16"
        android:layout_marginRight="@dimen/tw_dp_w16"
        android:layout_alignParentBottom="true"/>
</LinearLayout>
