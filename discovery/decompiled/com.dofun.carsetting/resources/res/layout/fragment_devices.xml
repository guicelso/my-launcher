<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/fragment_root_style">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:text="@string/display_open"
            style="@style/fragmen_title_style"/>
        <LinearLayout style="@style/fragment_linearlayout_style">
            <TextView
                android:text="@string/light_set"
                style="@style/fragment_hint_style"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/device_brightness_item_height">
                <ImageView
                    android:background="@drawable/sunny"
                    android:layout_width="@dimen/tw_dp_h33"
                    android:layout_height="@dimen/tw_dp_h33"
                    android:layout_marginLeft="@dimen/tw_dp_w20"
                    android:layout_marginRight="@dimen/tw_dp_w10"/>
                <SeekBar
                    android:id="@+id/light_seek_bar"
                    style="@style/CustomSeekbarStyle"/>
                <TextView
                    android:textSize="@dimen/normal_text_size"
                    android:textColor="@color/text_color_normal"
                    android:gravity="center"
                    android:id="@+id/tv_light_num"
                    android:layout_width="@dimen/tw_dp_h45"
                    android:layout_height="@dimen/tw_dp_h50"
                    android:layout_marginRight="@dimen/tw_dp_w20"
                    android:text="@string/key_0"/>
            </LinearLayout>
            <View style="@style/fragment_divider_View_style"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/brightness_mode_entries"
                android:id="@+id/ip_brightness_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/brightness_mode_values"
                app:key="brightness_mode"
                app:show_divider="true"
                app:title="@string/light_mode"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/wallpaper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="wallpaper"
                app:title="@string/wallpaper_settings_title"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/night_display_title"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="night_display_title"
                app:title="@string/night_display_title"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/title_font_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="title_font_size"
                app:title="@string/title_font_size"/>
            <com.dofun.carsetting.widget.SwitchPreference
                android:entries="@array/dark_ui_mode_entries"
                android:id="@+id/keywords_systemui_theme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="keywords_systemui_theme"
                app:title="@string/keywords_systemui_theme"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/dropdown_menu_background_entries"
                android:id="@+id/ip_dropdown_menu_background"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/dropdown_menu_background_values"
                app:key="ip_dropdown_menu_background"
                app:title="@string/dropdown_menu_background"/>
            <android.support.v7.widget.RecyclerView
                android:id="@+id/rv_wallpaper"
                android:paddingLeft="@dimen/tw_dp_w8"
                android:paddingTop="@dimen/tw_dp_h8"
                android:paddingRight="@dimen/tw_dp_w8"
                android:paddingBottom="@dimen/tw_dp_h8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView
            android:visibility="gone"
            android:text="@string/sound_setting1"
            style="@style/fragmen_title_style"/>
        <LinearLayout
            android:visibility="gone"
            style="@style/fragment_linearlayout_style">
            <TextView
                android:text="@string/sound_priority_title"
                style="@style/fragment_hint_style"/>
            <RelativeLayout style="@style/fragment_relativeLayout_style">
                <TextView
                    android:id="@+id/system_sound_priority"
                    android:text="@string/system_sound_priority_title"
                    android:layout_alignParentLeft="true"
                    style="@style/FragmentFacilitySoundButton"/>
                <TextView
                    android:id="@+id/rd_party_sound_priority"
                    android:text="@string/rd_party_sound_priority"
                    android:layout_centerHorizontal="true"
                    style="@style/FragmentFacilitySoundButton"/>
                <TextView
                    android:id="@+id/intelligent_priority"
                    android:text="@string/intelligent_priority"
                    android:layout_alignParentRight="true"
                    style="@style/FragmentFacilitySoundButton"/>
            </RelativeLayout>
            <View style="@style/fragment_divider_View_style"/>
            <TextView
                android:text="@string/navi_audio_title"
                style="@style/fragment_hint_style"/>
            <RelativeLayout style="@style/fragment_relativeLayout_style">
                <TextView
                    android:id="@+id/navi_audio_mixing"
                    android:text="@string/mixing"
                    android:layout_alignParentLeft="true"
                    style="@style/FragmentFacilitySoundButton"/>
                <TextView
                    android:id="@+id/navi_audio_unmixed"
                    android:text="@string/unmixed"
                    android:layout_centerHorizontal="true"
                    style="@style/FragmentFacilitySoundButton"/>
            </RelativeLayout>
            <View style="@style/fragment_divider_View_style"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/ringtone_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="ringtone_title"
                app:show_divider="false"
                app:title="@string/ringtone_title"/>
        </LinearLayout>
        <TextView
            android:visibility="gone"
            android:text="@string/guide_mix_voice_set"
            style="@style/fragmen_title_style"/>
        <LinearLayout
            android:visibility="gone"
            style="@style/fragment_linearlayout_style">
            <TextView
                android:text="@string/key_navi"
                style="@style/fragment_hint_style"/>
            <LinearLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View style="@style/FragmentFacilitySeekbarView"/>
                <SeekBar
                    android:id="@+id/guide_sound_seek_bar"
                    style="@style/CustomSeekbarStyle"/>
                <View style="@style/FragmentFacilitySeekbarView"/>
            </LinearLayout>
            <View style="@style/fragment_divider_View_style"/>
            <TextView
                android:text="@string/guide_background_void"
                style="@style/fragment_hint_style"/>
            <LinearLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View style="@style/FragmentFacilitySeekbarView"/>
                <SeekBar
                    android:id="@+id/background_sound_seek_bar"
                    style="@style/CustomSeekbarStyle"/>
                <View style="@style/FragmentFacilitySeekbarView"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
