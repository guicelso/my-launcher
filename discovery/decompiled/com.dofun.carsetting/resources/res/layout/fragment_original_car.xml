<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/fragment_root_style">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:text="@string/original_info"
            style="@style/fragmen_title_style"/>
        <LinearLayout style="@style/fragment_linearlayout_style">
            <com.dofun.carsetting.widget.SwitchPreference
                android:id="@+id/tw_show_temperature"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="tw_air_control"
                app:title="@string/tw_show_temperature"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/air_popup_window_entries"
                android:id="@+id/tw_air_popup_window"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/air_popup_window_values"
                app:key="air_popup_window"
                app:title="@string/tw_air_popup_window"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:entries="@array/air_style_entries"
                android:id="@+id/tw_air_style"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/air_style_values"
                app:key="air_popup_window"
                app:title="@string/tw_air_style"/>
            <com.dofun.carsetting.widget.SwitchPreference
                android:id="@+id/disable_door"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="disable_door"
                app:title="@string/disable_door"/>
            <com.dofun.carsetting.widget.SwitchPreference
                android:id="@+id/system_fradar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="reverse_radar"
                app:title="@string/reverse_radar"/>
            <com.dofun.carsetting.widget.SwitchPreference
                android:id="@+id/reverse_front_radar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="reverse_front_radar"
                app:title="@string/reverse_front_radar"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/key_wheel_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="key_wheel_title"
                app:title="@string/key_wheel_title"/>
            <com.dofun.carsetting.widget.MultiCheckPreference
                android:entries="@array/temp_mode_entries"
                android:id="@+id/temp_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entryValues="@array/temp_mode_values"
                app:key="temp_mode_title"
                app:title="@string/temp_mode_title"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
