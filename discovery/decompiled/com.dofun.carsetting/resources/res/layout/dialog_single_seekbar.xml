<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/pop_7"
    android:padding="@dimen/tw_dp_w5"
    android:layout_width="@dimen/tw_dp_w500"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_title_height"
        android:layout_marginTop="@dimen/tw_dp_h3">
        <TextView
            android:textSize="@dimen/title_text_size"
            android:textColor="@color/text_color_normal"
            android:gravity="center"
            android:id="@+id/tv_dialog_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:layout_weight="1"
            android:paddingStart="@dimen/tw_dp_w24"
            android:paddingEnd="@dimen/tw_dp_w32"/>
        <ImageView
            android:id="@+id/iv_dialog_close"
            android:clickable="true"
            android:layout_width="@dimen/dialog_btn_close_size"
            android:layout_height="@dimen/dialog_btn_close_size"
            android:layout_marginRight="@dimen/tw_dp_w24"
            android:src="@drawable/select_btn_close"
            android:scaleType="centerInside"/>
    </LinearLayout>
    <View
        android:id="@+id/view_divider"
        android:background="@drawable/dialog_title_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tw_dp_h3"
        android:layout_below="@+id/re_title"/>
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.dofun.carsetting.widget.MyListView
            android:id="@+id/item_list"
            android:padding="@dimen/tw_dp_h24"
            android:fadingEdge="none"
            android:fadingEdgeLength="0dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:listSelector="#00000000"
            android:cacheColorHint="#00000000"
            android:divider="@null"/>
    </ScrollView>
    <TextView
        android:textSize="@dimen/normal_text_size"
        android:textColor="@drawable/config_text_back"
        android:gravity="center"
        android:layout_gravity="right"
        android:id="@+id/tv_confirm"
        android:background="@drawable/tr_b_bg"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dialog_btn_bottom_height"
        android:layout_margin="@dimen/tw_dp_w10"
        android:text="@string/confirm"/>
</LinearLayout>
