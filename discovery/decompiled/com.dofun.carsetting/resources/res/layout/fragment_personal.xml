<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/fragment_root_style">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_personal_info"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:text="@string/personal_info"
                style="@style/fragmen_title_style"/>
            <LinearLayout style="@style/fragment_linearlayout_style">
                <com.dofun.carsetting.widget.InfoPreference
                    android:id="@+id/ip_account"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="pref_current_wifi"
                    app:title="@string/account"/>
                <com.dofun.carsetting.widget.InfoPreference
                    android:id="@+id/ip_language"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="pref_wifi_more"
                    app:title="@string/language_and_input"/>
                <com.dofun.carsetting.widget.InfoPreference
                    android:id="@+id/input_method_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="input_method_settings"
                    app:title="@string/input_method_settings"/>
                <com.dofun.carsetting.widget.InfoPreference
                    android:id="@+id/ip_phone_connect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="pref_wifi_more"
                    app:title="@string/phone_connect"/>
                <com.dofun.carsetting.widget.SwitchPreference
                    android:id="@+id/therr_d_door"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="therr_d_door"
                    app:title="@string/therr_d_door"/>
                <com.dofun.carsetting.widget.InfoPreference
                    android:id="@+id/ip_gesture_control"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="ip_gesture_control"
                    app:title="@string/multi_touch_action"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_hi_car"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tw_dp_h16">
            <TextView
                android:text="@string/hi_car"
                style="@style/fragmen_title_style"/>
            <LinearLayout style="@style/fragment_linearlayout_style">
                <com.dofun.carsetting.widget.InfoPreference
                    android:id="@+id/ip_hi_car"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="pref_hi_car"
                    app:show_divider="true"
                    app:title="@string/hi_car_manager"/>
                <com.dofun.carsetting.widget.InfoPreference
                    android:entries="@array/hicar_default_screen_size_entries"
                    android:id="@+id/ip_hicar_screen_size"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:entryValues="@array/hicar_default_screen_size_values"
                    app:key="ip_hicar_screen_size"
                    app:show_divider="false"
                    app:title="@string/screen_size"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
