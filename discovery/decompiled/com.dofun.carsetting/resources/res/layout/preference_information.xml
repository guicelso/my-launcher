<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:id="@+id/item_container"
    android:background="@drawable/selectable_item_bg"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/preference_height"
    android:layout_marginLeft="@dimen/tw_dp_w16"
    android:layout_marginRight="@dimen/tw_dp_w16"
    android:minHeight="@dimen/preference_min_height">
    <RelativeLayout
        android:paddingTop="@dimen/tw_dp_h8"
        android:paddingBottom="@dimen/tw_dp_h8"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toLeftOf="@+id/ll_right"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="@dimen/preference_title_text_size"
                android:textColor="@color/text_color_normal"
                android:gravity="center"
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:maxLines="1"
                android:layout_weight="1"/>
            <com.dofun.carsetting.fragment.MarqueeTextView
                android:textSize="@dimen/preference_summary_text_size"
                android:textColor="@color/pref_text_summary_color"
                android:ellipsize="marquee"
                android:gravity="center"
                android:id="@+id/tv_summary"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:singleLine="true"
                android:layout_weight="1"
                android:marqueeRepeatLimit="marquee_forever"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/ll_right"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/tw_dp_w16"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true">
            <ImageView
                android:id="@+id/iv_value_icon"
                android:visibility="visible"
                android:layout_width="@dimen/preference_value_icon_width"
                android:layout_height="@dimen/preference_value_icon_height"
                android:layout_marginLeft="@dimen/tw_dp_w32"
                android:layout_marginRight="@dimen/tw_dp_w16"/>
            <TextView
                android:textSize="@dimen/preference_value_text_size"
                android:textColor="@color/text_color_normal"
                android:ellipsize="marquee"
                android:gravity="center"
                android:id="@+id/tv_value"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/tw_dp_w16"
                android:layout_marginRight="@dimen/tw_dp_w16"
                android:maxWidth="@dimen/preference_value_min_width"
                android:singleLine="true"
                android:marqueeRepeatLimit="marquee_forever"/>
            <ImageView
                android:id="@+id/iv_right_icon"
                android:layout_width="@dimen/preference_right_icon_width"
                android:layout_height="@dimen/preference_right_icon_height"
                android:src="@drawable/pref_select_more"
                android:scaleType="centerInside"/>
        </LinearLayout>
    </RelativeLayout>
    <View
        android:id="@+id/view_divider"
        android:background="@drawable/tl_list_divider2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tw_dp_h2"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
