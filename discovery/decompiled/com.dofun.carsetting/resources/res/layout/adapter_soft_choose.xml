<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingLeft="@dimen/tw_dp_w16"
    android:paddingRight="@dimen/tw_dp_w16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/tw_dp_h8"
    android:layout_marginBottom="@dimen/tw_dp_h8">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:gravity="center"
            android:id="@+id/tv_app_icon"
            android:layout_width="@dimen/item_app_list_icon_size"
            android:layout_height="@dimen/item_app_list_icon_size"
            android:layout_marginLeft="@dimen/tw_dp_w16"
            android:layout_marginTop="@dimen/tw_dp_h8"
            android:layout_marginRight="@dimen/tw_dp_w16"
            android:layout_marginBottom="@dimen/tw_dp_h8"/>
        <TextView
            android:textSize="@dimen/normal_text_size"
            android:textColor="@color/text_color_normal"
            android:gravity="center"
            android:id="@+id/tv_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_app_choose"
            android:background="@drawable/btn_shutter_pressed_disabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <View
        android:background="@color/black_lucid_close"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
</LinearLayout>
