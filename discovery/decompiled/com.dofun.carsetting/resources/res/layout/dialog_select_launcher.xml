<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/pop5"
    android:padding="@dimen/tw_dp_w20"
    android:layout_width="@dimen/tw_dp_w300"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/re_title_group"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_title_height"
        android:layout_marginTop="@dimen/tw_dp_h3">
        <TextView
            android:textSize="@dimen/title_text_size"
            android:textColor="@color/text_color_normal"
            android:gravity="center"
            android:id="@+id/tv_dialog_title"
            android:paddingLeft="@dimen/tw_dp_w24"
            android:paddingRight="@dimen/tw_dp_w32"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/launcher_set"
            android:maxLines="1"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/iv_dialog_close"
            android:clickable="true"
            android:layout_width="@dimen/dialog_btn_close_size"
            android:layout_height="@dimen/dialog_btn_close_size"
            android:layout_marginRight="@dimen/tw_dp_w24"
            android:src="@drawable/select_btn_close"
            android:scaleType="centerInside"/>
    </LinearLayout>
    <View
        android:id="@+id/view_divider"
        android:background="@drawable/dialog_title_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tw_dp_h3"
        android:layout_marginBottom="@dimen/tw_dp_h8"
        android:layout_below="@+id/re_title_group"/>
    <RadioGroup
        android:orientation="horizontal"
        android:id="@+id/radio_group_launcher"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/view_divider">
        <RadioButton
            android:textSize="@dimen/tw_dp_w24"
            android:textColor="@color/text_color_normal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/radio_theme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:button="@drawable/select_launcher_btn"
            android:text="@string/launcher_theme"
            android:layout_weight="1"/>
        <RadioButton
            android:textSize="@dimen/tw_dp_w24"
            android:textColor="@color/text_color_normal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/radio_bba"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:button="@drawable/select_launcher_btn"
            android:text="@string/launcher_bba"
            android:layout_weight="1"/>
    </RadioGroup>
    <HorizontalScrollView
        android:id="@+id/scroll_view_bba"
        android:scrollbars="none"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/radio_group_launcher">
        <RadioGroup
            android:orientation="horizontal"
            android:id="@+id/radio_group_bba"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/radio_group_launcher">
            <RadioButton
                android:textSize="@dimen/tw_dp_w24"
                android:textColor="@color/text_color_normal"
                android:gravity="center"
                android:id="@+id/radio_bm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:button="@null"
                android:text="@string/bba_bm"
                android:drawableBottom="@drawable/ic_bba_bm"/>
            <RadioButton
                android:textSize="@dimen/tw_dp_w24"
                android:textColor="@color/text_color_normal"
                android:gravity="center"
                android:id="@+id/radio_ad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@null"
                android:text="@string/bba_ad"
                android:drawableBottom="@drawable/ic_bba_ad"
                android:layout_marginStart="@dimen/tw_dp_w10"/>
            <RadioButton
                android:textSize="@dimen/tw_dp_w24"
                android:textColor="@color/text_color_normal"
                android:gravity="center"
                android:id="@+id/radio_benz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@null"
                android:text="@string/bba_benz"
                android:drawableBottom="@drawable/ic_bba_benz"
                android:layout_marginStart="@dimen/tw_dp_w10"/>
            <RadioButton
                android:textSize="@dimen/tw_dp_w24"
                android:textColor="@color/text_color_normal"
                android:gravity="center"
                android:id="@+id/radio_lexus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@null"
                android:text="@string/lexus"
                android:drawableBottom="@drawable/ic_lexus"
                android:layout_marginStart="@dimen/tw_dp_w10"/>
        </RadioGroup>
    </HorizontalScrollView>
</RelativeLayout>
