<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/selectable_item_bg"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/item_app_list_height">
    <ImageView
        android:id="@+id/iv_left_icon"
        android:visibility="gone"
        android:layout_width="@dimen/tw_dp_h60"
        android:layout_height="@dimen/tw_dp_h60"
        android:src="@drawable/icon_voice_std"
        android:scaleType="centerInside"
        android:layout_marginStart="@dimen/tw_dp_w16"
        android:layout_marginEnd="@dimen/tw_dp_w16"/>
    <TextView
        android:textSize="@dimen/normal_text_size"
        android:textColor="@color/text_color_normal"
        android:gravity="center"
        android:id="@+id/tv_text"
        android:paddingLeft="@dimen/tw_dp_w16"
        android:paddingRight="@dimen/tw_dp_w16"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:maxLines="1"
        android:layout_weight="1"/>
    <TextView
        android:textSize="@dimen/normal_text_size"
        android:textColor="@color/text_color_normal"
        android:gravity="center"
        android:id="@+id/tv_right_tip"
        android:paddingLeft="@dimen/tw_dp_w16"
        android:paddingRight="@dimen/tw_dp_w32"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:maxLines="1"/>
    <ImageView
        android:id="@+id/iv_right_icon"
        android:layout_width="@dimen/tw_dp_h60"
        android:layout_height="@dimen/tw_dp_h60"
        android:layout_marginLeft="@dimen/tw_dp_w16"
        android:layout_marginRight="@dimen/tw_dp_w16"
        android:src="@drawable/lev_item_check"
        android:scaleType="centerInside"/>
</LinearLayout>
