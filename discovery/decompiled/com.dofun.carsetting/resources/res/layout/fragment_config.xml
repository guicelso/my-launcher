<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/fragment_root_style">
    <include layout="@layout/layout_top_content"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/ic_config_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/tw_dp_h24"
                android:layout_marginStart="@dimen/tw_dp_w24"
                android:layout_marginEnd="@dimen/tw_dp_w24">
                <com.dofun.carsetting.widget.SwitchPreference
                    android:id="@+id/tw_rds"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="tw_rds"
                    app:title="@string/rds"/>
                <com.dofun.carsetting.widget.SwitchPreference
                    android:id="@+id/tw_more_lights"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="tw_more_lights"
                    app:title="@string/config_entries_item4"/>
                <com.dofun.carsetting.widget.SwitchPreference
                    android:id="@+id/tw_nfc"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="tw_nfc"
                    app:summary="@string/multicolor_lights_cannot_be_used"
                    app:title="NFC"/>
                <com.dofun.carsetting.widget.SwitchPreference
                    android:id="@+id/tw_no_dvd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="tw_no_dvd"
                    app:title="@string/key_disc"/>
                <com.dofun.carsetting.widget.SwitchPreference
                    android:id="@+id/tw_cursor_knob"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="tw_cursor_knob"
                    app:title="@string/tw_cursor_knob"/>
                <com.dofun.carsetting.widget.SwitchPreference
                    android:id="@+id/tw_no_play"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="tw_no_play"
                    app:title="@string/config_entries_item12"/>
                <com.dofun.carsetting.widget.SwitchPreference
                    android:id="@+id/tw_panorama_360"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="tw_panorama_360"
                    app:title="@string/config_360"/>
                <com.dofun.carsetting.widget.SwitchPreference
                    android:id="@+id/tw_no_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="tw_no_tv"
                    app:title="@string/key_tv"/>
                <com.dofun.carsetting.widget.SwitchPreference
                    android:id="@+id/tw_no_aux"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="tw_no_aux"
                    app:title="@string/tw_no_aux"/>
                <com.dofun.carsetting.widget.SwitchPreference
                    android:id="@+id/tw_no_radio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="tw_no_radio"
                    app:title="@string/key_radio"/>
                <com.dofun.carsetting.widget.SwitchPreference
                    android:id="@+id/tw_air_control"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="tw_air_control"
                    app:title="@string/tw_air_control"/>
                <com.dofun.carsetting.widget.SwitchPreference
                    android:id="@+id/display_normal_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="display_normal_button"
                    app:title="@string/display_normal_button"/>
                <com.dofun.carsetting.widget.SwitchPreference
                    android:id="@+id/tw_dialer_control"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="tw_dialer_control"
                    app:title="@string/tw_dialer_control"/>
                <com.dofun.carsetting.widget.SwitchPreference
                    android:id="@+id/tw_no_streammedia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="tw_no_streammedia"
                    app:title="@string/tw_no_streammedia"/>
                <com.dofun.carsetting.widget.SwitchPreference
                    android:id="@+id/tw_tpms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="tw_tpms"
                    app:title="@string/tw_tpms"/>
                <com.dofun.carsetting.widget.SwitchPreference
                    android:id="@+id/tw_wheel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="tw_wheel"
                    app:title="@string/key_wheel_title"/>
                <com.dofun.carsetting.widget.SwitchPreference
                    android:id="@+id/tw_no_dofunplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="tw_no_dofunplay"
                    app:title="@string/tw_no_dofunplay"/>
                <com.dofun.carsetting.widget.SwitchPreference
                    android:id="@+id/tw_no_carmate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="tw_no_carmate"
                    app:title="@string/tw_no_carmate"/>
                <com.dofun.carsetting.widget.SwitchPreference
                    android:id="@+id/tw_install_apk"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="tw_install_apk"
                    app:title="@string/install_apk"/>
                <com.dofun.carsetting.widget.SwitchPreference
                    android:id="@+id/tw_magic_eq"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="tw_magic_eq"
                    app:title="Magic EQ"/>
                <com.dofun.carsetting.widget.SwitchPreference
                    android:id="@+id/tw_ips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="tw_ips"
                    app:title="IPS"/>
                <com.dofun.carsetting.widget.SwitchPreference
                    android:id="@+id/tw_hicar"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="tw_hicar"
                    app:title="HiCar"/>
                <com.dofun.carsetting.widget.InfoPreference
                    android:entries="@array/bt_ic_entries"
                    android:id="@+id/tw_bt_ic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:entryValues="@array/bt_ic_value"
                    app:key="tw_bt_ic"
                    app:title="@string/bluetooth_ic"/>
                <com.dofun.carsetting.widget.InfoPreference
                    android:entries="@array/screen_display_entries"
                    android:id="@+id/tw_screen_display"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:entryValues="@array/screen_display_values"
                    app:key="tw_screen_display"
                    app:title="@string/screen_display"/>
                <com.dofun.carsetting.widget.InfoPreference
                    android:entries="@array/screen_size_entries"
                    android:id="@+id/tw_screen_size"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:entryValues="@array/screen_size_values"
                    app:key="tw_screen_size"
                    app:title="@string/screen_size"/>
                <com.dofun.carsetting.widget.SwitchPreference
                    android:id="@+id/tw_file"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="tw_file"
                    app:title="@string/tw_file"/>
                <com.dofun.carsetting.widget.SwitchPreference
                    android:id="@+id/tw_chrome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="tw_chrome"
                    app:title="@string/tw_chrome"/>
                <com.dofun.carsetting.widget.SwitchPreference
                    android:id="@+id/tw_google"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:key="tw_google"
                    app:title="@string/tw_google"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
