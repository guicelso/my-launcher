<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/pop5"
    android:padding="@dimen/tw_dp_w3"
    android:layout_width="@dimen/dialog_edit_width"
    android:layout_height="@dimen/dialog_edit_height">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_title_height">
        <TextView
            android:textSize="@dimen/title_text_size"
            android:textColor="@color/text_color_normal"
            android:textColorHint="@color/gray"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_dialog_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:paddingStart="@dimen/tw_dp_w24"
            android:paddingEnd="@dimen/tw_dp_w32"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingLeft="@dimen/tw_dp_w24"
        android:paddingRight="@dimen/tw_dp_w24"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/tw_dp_h12"
        android:layout_weight="1">
        <EditText
            android:textSize="@dimen/normal_text_size"
            android:textColor="@color/text_color_normal"
            android:gravity="bottom|left"
            android:id="@+id/edittext"
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <ImageView
            android:background="#90ffffff"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tw_dp_h1"
            android:layout_marginTop="@dimen/tw_dp_h2"/>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_btn_bottom_height">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_bottom"
            android:background="@drawable/pop5_bottom"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <Button
                android:textSize="@dimen/normal_text_size"
                android:textColor="@color/text_color_normal"
                android:gravity="center"
                android:id="@+id/cancel"
                android:background="@drawable/btn_bg_left"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/dlg_cancel"
                android:layout_weight="1"/>
            <Button
                android:textSize="@dimen/normal_text_size"
                android:textColor="@color/text_color_normal"
                android:gravity="center"
                android:id="@+id/change"
                android:background="@drawable/btn_bg_middle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/change_password"
                android:layout_weight="1"/>
            <Button
                android:textSize="@dimen/normal_text_size"
                android:textColor="@color/text_color_normal"
                android:gravity="center"
                android:id="@+id/confirm"
                android:background="@drawable/btn_bg_right"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/confirm"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_old_bottom"
            android:background="@drawable/pop4_bottom"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <Button
                android:textSize="@dimen/normal_text_size"
                android:textColor="@color/text_color_normal"
                android:gravity="center"
                android:id="@+id/old_cancel"
                android:background="@drawable/btn_bg_left"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/dlg_cancel"
                android:layout_weight="1"/>
            <Button
                android:textSize="@dimen/normal_text_size"
                android:textColor="@color/text_color_normal"
                android:gravity="center"
                android:id="@+id/old_confirm"
                android:background="@drawable/btn_bg_right"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/confirm"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_new_bottom"
            android:background="@drawable/pop4_bottom"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <Button
                android:textSize="@dimen/normal_text_size"
                android:textColor="@color/text_color_normal"
                android:gravity="center"
                android:id="@+id/new_cancel"
                android:background="@drawable/btn_bg_left"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/dlg_cancel"
                android:layout_weight="1"/>
            <Button
                android:textSize="@dimen/normal_text_size"
                android:textColor="@color/text_color_normal"
                android:gravity="center"
                android:id="@+id/new_confirm"
                android:background="@drawable/btn_bg_right"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/confirm_change"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_bottom2"
            android:background="@drawable/pop4_bottom"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <Button
                android:textSize="@dimen/normal_text_size"
                android:textColor="@color/text_color_normal"
                android:gravity="center"
                android:id="@+id/cancel2"
                android:background="@drawable/btn_bg_left"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/dlg_cancel"
                android:layout_weight="1"/>
            <Button
                android:textSize="@dimen/normal_text_size"
                android:textColor="@color/text_color_normal"
                android:gravity="center"
                android:id="@+id/confirm2"
                android:background="@drawable/btn_bg_right"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/confirm"
                android:layout_weight="1"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
