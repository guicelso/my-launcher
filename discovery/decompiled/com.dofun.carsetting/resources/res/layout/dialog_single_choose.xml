<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/pop5"
    android:layout_width="match_parent"
    android:layout_height="@dimen/tw_dp_h300">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_title_height"
        android:layout_marginTop="@dimen/tw_dp_h3">
        <TextView
            android:textSize="@dimen/title_text_size"
            android:textColor="@color/text_color_normal"
            android:gravity="center"
            android:id="@+id/tv_dialog_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:layout_weight="1"
            android:paddingStart="@dimen/tw_dp_w24"
            android:paddingEnd="@dimen/tw_dp_w32"/>
        <ImageView
            android:id="@+id/iv_dialog_close"
            android:clickable="true"
            android:layout_width="@dimen/dialog_btn_close_size"
            android:layout_height="@dimen/dialog_btn_close_size"
            android:layout_marginRight="@dimen/tw_dp_w24"
            android:src="@drawable/select_btn_close"
            android:scaleType="centerInside"/>
    </LinearLayout>
    <View
        android:background="@drawable/dialog_title_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tw_dp_h3"/>
    <ScrollView
        android:padding="@dimen/tw_dp_h24"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RadioGroup
            android:id="@+id/rg_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>
</LinearLayout>
