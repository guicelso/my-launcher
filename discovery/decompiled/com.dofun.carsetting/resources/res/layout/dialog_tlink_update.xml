<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/pop_7"
    android:padding="@dimen/tw_dp_w20"
    android:layout_width="@dimen/dialog_check_update_info_width"
    android:layout_height="@dimen/dialog_check_update_info_height">
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/re_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_title_height">
        <TextView
            android:textSize="@dimen/title_text_size"
            android:textColor="@color/text_color_normal"
            android:gravity="center"
            android:id="@+id/tv_dialog_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/iv_dialog_close"
            android:clickable="true"
            android:layout_width="@dimen/dialog_btn_close_size"
            android:layout_height="@dimen/dialog_btn_close_size"
            android:src="@drawable/select_btn_close"
            android:scaleType="centerInside"/>
    </LinearLayout>
    <View
        android:id="@+id/view_divider"
        android:background="@drawable/dialog_title_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tw_dp_h3"
        android:layout_below="@+id/re_title"/>
    <RelativeLayout
        android:id="@+id/rl_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/ll_update_tv"
        android:layout_below="@+id/view_divider">
        <ListView
            android:id="@+id/item_list"
            android:fadingEdge="none"
            android:fadingEdgeLength="0dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:listSelector="#00000000"
            android:cacheColorHint="#00000000"
            android:divider="@null"
            android:layout_centerInParent="true"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_update_confirm"
            android:background="@drawable/pop_7"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true">
            <TextView
                android:textSize="@dimen/normal_text_size"
                android:textColor="@color/text_color_normal"
                android:gravity="center"
                android:id="@+id/tv_update_cancel"
                android:background="@drawable/tr_b_bg"
                android:clickable="true"
                android:layout_width="@dimen/tw_dp_w255"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/tw_dp_w20"
                android:text="@string/dlg_cancel"/>
            <TextView
                android:textSize="@dimen/normal_text_size"
                android:textColor="@color/text_color_normal"
                android:gravity="center"
                android:id="@+id/tv_update_confirm"
                android:background="@drawable/tr_b_bg"
                android:clickable="true"
                android:layout_width="@dimen/tw_dp_w255"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/tw_dp_w20"
                android:text="@string/confirm"/>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_update_tv"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tw_dp_h64"
        android:layout_marginLeft="@dimen/tw_dp_w4"
        android:layout_marginRight="@dimen/tw_dp_w4"
        android:layout_alignParentBottom="true">
        <com.dofun.carsetting.widget.AlignTextView
            android:textSize="@dimen/normal_text_size"
            android:textColor="@android:color/holo_red_light"
            android:ellipsize="marquee"
            android:gravity="center"
            android:id="@+id/update_tv"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="@dimen/tw_dp_w16"
            android:text="@string/system_update_summary"
            android:layout_weight="1"
            android:marqueeRepeatLimit="marquee_forever"/>
        <ProgressBar
            android:layout_width="@dimen/tw_dp_h35"
            android:layout_height="@dimen/tw_dp_h35"/>
    </LinearLayout>
</RelativeLayout>
