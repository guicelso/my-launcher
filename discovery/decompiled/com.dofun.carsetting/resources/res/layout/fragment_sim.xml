<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/fragment_root_style">
    <include layout="@layout/layout_top_content"/>
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/ll_sim1_text"
                android:text="@string/sim1"
                style="@style/fragmen_title_style"/>
            <LinearLayout
                android:id="@+id/ll_sim1"
                android:visibility="visible"
                style="@style/fragment_linearlayout_style">
                <TextView
                    android:id="@+id/tv_operator_sim1"
                    android:layout_marginTop="0dp"
                    android:text="@string/about_operator"
                    style="@style/sim_into_item_style"/>
                <TextView
                    android:id="@+id/tv_signal_strength_sim1"
                    android:text="@string/about_signal_strength"
                    style="@style/sim_into_item_style"/>
                <TextView
                    android:id="@+id/tv_mobile_type_sim1"
                    android:text="@string/about_mobile_type"
                    style="@style/sim_into_item_style"/>
                <TextView
                    android:id="@+id/tv_service_stat_sim1"
                    android:text="@string/about_service_stat"
                    style="@style/sim_into_item_style"/>
                <TextView
                    android:id="@+id/tv_mobile_stat_sim1"
                    android:text="@string/about_mobile_stat"
                    style="@style/sim_into_item_style"/>
            </LinearLayout>
            <TextView
                android:id="@+id/ll_sim2_text"
                android:text="@string/sim2"
                style="@style/fragmen_title_style"/>
            <LinearLayout
                android:id="@+id/ll_sim2"
                android:visibility="visible"
                style="@style/fragment_linearlayout_style">
                <TextView
                    android:id="@+id/tv_operator_sim2"
                    android:layout_marginTop="0dp"
                    android:text="@string/about_operator"
                    style="@style/sim_into_item_style"/>
                <TextView
                    android:id="@+id/tv_signal_strength_sim2"
                    android:text="@string/about_signal_strength"
                    style="@style/sim_into_item_style"/>
                <TextView
                    android:id="@+id/tv_mobile_type_sim2"
                    android:text="@string/about_mobile_type"
                    style="@style/sim_into_item_style"/>
                <TextView
                    android:id="@+id/tv_service_stat_sim2"
                    android:text="@string/about_service_stat"
                    style="@style/sim_into_item_style"/>
                <TextView
                    android:id="@+id/tv_mobile_stat_sim2"
                    android:text="@string/about_mobile_stat"
                    style="@style/sim_into_item_style"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
