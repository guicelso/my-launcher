<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/main_layout_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <android.support.v7.widget.RecyclerView
        android:id="@+id/rv_navi_bar"
        android:background="@drawable/tl_bg"
        android:paddingTop="@dimen/tw_dp_h2"
        android:paddingRight="@dimen/tw_dp_w2"
        android:layout_width="@dimen/main_radio_group_min_width"
        android:layout_height="match_parent"
        android:maxWidth="@dimen/main_radio_group_max_width"
        android:minWidth="@dimen/main_radio_group_min_width"/>
    <FrameLayout
        android:id="@+id/main_frame_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="0dp"/>
</LinearLayout>
