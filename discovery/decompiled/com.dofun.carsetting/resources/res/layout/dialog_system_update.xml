<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/pop5"
    android:paddingTop="@dimen/tw_dp_w5"
    android:layout_width="@dimen/tw_dp_w300"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/tw_dp_w5"
    android:paddingEnd="@dimen/tw_dp_w5">
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/re_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_title_height"
        android:layout_marginTop="@dimen/tw_dp_h3">
        <TextView
            android:textSize="@dimen/title_text_size"
            android:textColor="@color/text_color_normal"
            android:gravity="center"
            android:id="@+id/tv_dialog_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:layout_weight="1"
            android:paddingStart="@dimen/tw_dp_w24"
            android:paddingEnd="@dimen/tw_dp_w32"/>
        <ImageView
            android:id="@+id/iv_dialog_close"
            android:clickable="true"
            android:layout_width="@dimen/dialog_btn_close_size"
            android:layout_height="@dimen/dialog_btn_close_size"
            android:layout_marginRight="@dimen/tw_dp_w24"
            android:src="@drawable/select_btn_close"
            android:scaleType="centerInside"/>
    </LinearLayout>
    <View
        android:id="@+id/view_divider"
        android:background="@drawable/dialog_title_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tw_dp_h3"
        android:layout_below="@+id/re_title"/>
    <ListView
        android:id="@+id/item_list"
        android:fadingEdge="none"
        android:fadingEdgeLength="0dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:listSelector="#00000000"
        android:cacheColorHint="#00000000"
        android:divider="@null"
        android:layout_above="@+id/ll_update_tv"
        android:layout_below="@+id/view_divider"/>
    <LinearLayout
        android:gravity="left"
        android:orientation="horizontal"
        android:id="@+id/ll_update_tv"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tw_dp_h64"
        android:layout_marginLeft="@dimen/tw_dp_w24"
        android:layout_marginRight="@dimen/tw_dp_w24"
        android:layout_above="@+id/ll_clear_data">
        <com.dofun.carsetting.widget.AlignTextView
            android:textSize="@dimen/normal_text_size"
            android:textColor="@android:color/holo_red_light"
            android:ellipsize="marquee"
            android:gravity="center"
            android:id="@+id/update_tv"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="@dimen/tw_dp_w16"
            android:text="@string/system_update_summary"
            android:layout_weight="1"
            android:marqueeRepeatLimit="marquee_forever"/>
        <ProgressBar
            android:layout_gravity="center_vertical"
            android:id="@+id/update_progress"
            android:layout_width="@dimen/tw_dp_h35"
            android:layout_height="@dimen/tw_dp_h35"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_clear_data"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/tw_dp_w24"
        android:layout_marginRight="@dimen/tw_dp_w24"
        android:layout_marginBottom="@dimen/tw_dp_h16"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="@dimen/normal_text_size"
            android:textColor="@color/text_color_normal"
            android:ellipsize="marquee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/system_update_wipe_data_and_formate_flash"
            android:singleLine="true"
            android:layout_weight="1"
            android:marqueeRepeatLimit="marquee_forever"/>
        <Switch
            android:id="@+id/btn_clear_data"
            android:layout_width="@dimen/tw_dp_w130"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/tw_dp_w120"/>
    </LinearLayout>
</RelativeLayout>
