<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/layout_top_content"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/fragment_linearlayout_style">
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/user_lock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="user_lock"
                app:title="@string/client_settings_title"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/factory_lock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="factory_lock"
                app:title="@string/factory_settings_title"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/reset_factory_lock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="reset_factory_lock"
                app:title="@string/reset_factory_title"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/platforminfo_lock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="platforminfo_lock"
                app:title="@string/about_platform_info"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/cpu_lock"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="cpu_lock"
                app:title="@string/about_cpu_info_t"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/boot_lock"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="boot_lock"
                app:title="@string/about_boot_info_t"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/mcu_lock"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="mcu_lock"
                app:title="@string/about_mcu_info_t"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/system_lock"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="system_lock"
                app:title="@string/about_system_info_t"/>
            <com.dofun.carsetting.widget.InfoPreference
                android:id="@+id/app_version_lock"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="app_version_lock"
                app:title="@string/about_versioncode_info"/>
            <com.dofun.carsetting.widget.SwitchPreference
                android:id="@+id/hardware_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="hardware_info"
                app:title="@string/hardware_info"/>
            <com.dofun.carsetting.widget.SwitchPreference
                android:id="@+id/resolution_info"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="resolution_info"
                app:title="@string/resolution_title"/>
            <com.dofun.carsetting.widget.SwitchPreference
                android:id="@+id/storage_info_switch"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:key="storage_info_switch"
                app:title="@string/storage_space"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
