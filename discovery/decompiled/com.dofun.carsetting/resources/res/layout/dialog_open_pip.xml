<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="#00000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/auto_reboot_dialog_bg"
        android:layout_width="@dimen/tw_dp_w530"
        android:layout_height="@dimen/tw_dp_h442"
        android:layout_centerInParent="true">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/tw_dp_w20"
            android:paddingRight="@dimen/tw_dp_w20"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dialog_btn_bottom_height">
            <TextView
                android:textSize="@dimen/normal_text_size"
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/force_pip"
                android:layout_weight="1"/>
            <TextView
                android:textSize="@dimen/normal_text_size"
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/open"/>
        </LinearLayout>
        <View
            android:background="#99ffffff"
            android:layout_width="match_parent"
            android:layout_height="2dp"/>
        <RelativeLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/iv_time_number"
                android:layout_width="@dimen/dialog_auto_confirm_animation_size"
                android:layout_height="@dimen/dialog_auto_confirm_animation_size"
                android:layout_marginTop="@dimen/tw_dp_h22"
                android:src="@drawable/lev_count_down_number"
                android:scaleType="centerInside"
                android:layout_centerHorizontal="true"/>
            <ImageView
                android:id="@+id/iv_time_bg"
                android:layout_width="@dimen/dialog_auto_confirm_animation_size"
                android:layout_height="@dimen/dialog_auto_confirm_animation_size"
                android:layout_marginTop="@dimen/tw_dp_h22"
                android:src="@drawable/anim_time_count_down_bg"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="@dimen/normal_text_size"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/tv_dialog_message"
                android:layout_width="match_parent"
                android:layout_height="@dimen/tw_dp_h120"
                android:text="@string/reboot_now"
                android:maxLines="2"
                android:layout_below="@+id/iv_time_bg"
                android:paddingStart="@dimen/tw_dp_w24"
                android:paddingEnd="@dimen/tw_dp_w32"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:background="@drawable/auto_reboot_dialog_bottom"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dialog_btn_bottom_height">
            <Button
                android:textSize="@dimen/normal_text_size"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/cancel"
                android:background="@drawable/btn_auto_confirm_cancel"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/dlg_cancel"
                android:layout_weight="1"/>
            <Button
                android:textSize="@dimen/normal_text_size"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/confirm"
                android:background="@drawable/btn_auto_confirm_confirm"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/confirm"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
