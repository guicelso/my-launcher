<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/pop5"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/tw_dp_h15">
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/re_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_title_height"
        android:layout_marginTop="@dimen/tw_dp_h3">
        <TextView
            android:textSize="@dimen/title_text_size"
            android:textColor="@color/text_color_normal"
            android:gravity="center"
            android:id="@+id/tv_dialog_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/high_definition_selection_title"
            android:maxLines="1"
            android:layout_weight="1"
            android:paddingStart="@dimen/tw_dp_w24"
            android:paddingEnd="@dimen/tw_dp_w32"/>
        <ImageView
            android:id="@+id/iv_dialog_close"
            android:clickable="true"
            android:layout_width="@dimen/dialog_btn_close_size"
            android:layout_height="@dimen/dialog_btn_close_size"
            android:layout_marginRight="@dimen/tw_dp_w24"
            android:src="@drawable/select_btn_close"
            android:scaleType="centerInside"/>
    </LinearLayout>
    <View
        android:id="@+id/view_divider"
        android:background="@drawable/dialog_title_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tw_dp_h3"
        android:layout_below="@+id/re_title"/>
    <ExpandableListView
        android:id="@+id/expandablelistview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="10dp"
        android:childDivider="@drawable/tl_list_divider4"
        android:divider="@drawable/tl_list_divider1"
        android:choiceMode="singleChoice"
        android:layout_weight="1"/>
    <Button
        android:id="@+id/btn_reverse_type"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:text="@string/key_enter"/>
</LinearLayout>
