<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/fragment_root_style">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:text="@string/basic_inf"
                style="@style/fragmen_title_style"/>
            <LinearLayout
                android:id="@+id/ll_general"
                style="@style/fragment_linearlayout_style">
                <TextView
                    android:id="@+id/tv_platform_info"
                    android:text="@string/about_platform_info_unknown"
                    style="@style/about_info_text_style"/>
                <TextView
                    android:id="@+id/tv_iccid"
                    android:text="@string/about_iccid_unknown"
                    style="@style/about_info_text_style"/>
                <TextView
                    android:id="@+id/tv_chipid"
                    android:visibility="gone"
                    android:text="@string/about_chipid_unknown"
                    style="@style/about_info_text_style"/>
                <TextView
                    android:id="@+id/tv_device_num"
                    android:text="@string/about_device_num"
                    style="@style/about_info_text_style"/>
                <TextView
                    android:id="@+id/tv_imei_num"
                    android:text="@string/about_imei_unknown"
                    style="@style/about_info_text_style"/>
                <TextView
                    android:id="@+id/tv_imei_num1"
                    android:text="@string/about_imei_unknown"
                    style="@style/about_info_text_style"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/hardware_info_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:text="@string/hardware_info"
                style="@style/fragmen_title_style"/>
            <LinearLayout style="@style/fragment_linearlayout_style">
                <TextView
                    android:id="@+id/tv_cpu_info"
                    android:text="@string/about_cpu_info"
                    style="@style/about_info_text_style"/>
                <TextView
                    android:id="@+id/tv_npu_info"
                    android:visibility="gone"
                    android:text="@string/about_npu_info"
                    style="@style/about_info_text_style"/>
                <TextView
                    android:id="@+id/tv_gpu_info"
                    android:visibility="gone"
                    android:text="@string/about_gpu_info"
                    style="@style/about_info_text_style"/>
                <TextView
                    android:id="@+id/tv_sound_info"
                    android:text="@string/about_music_core"
                    style="@style/about_info_text_style"/>
                <TextView
                    android:id="@+id/tv_radio_info"
                    android:text="@string/about_system_info1"
                    style="@style/about_info_text_style"/>
                <TextView
                    android:id="@+id/tv_bt_info"
                    android:text="@string/about_system_info1"
                    style="@style/about_info_text_style"/>
                <com.dofun.carsetting.widget.AlignTextView
                    android:id="@+id/tv_baseband_info"
                    android:text="@string/about_band_info"
                    style="@style/about_info_text_style"/>
                <TextView
                    android:id="@+id/camera_system_info"
                    android:visibility="gone"
                    android:text="@string/camera_system_info_unknown"
                    style="@style/about_info_text_style"/>
                <TextView
                    android:id="@+id/ic360_info"
                    android:visibility="gone"
                    android:text="@string/ic360"
                    style="@style/about_info_text_style"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:text="@string/storage_space"
                style="@style/fragmen_title_style"/>
            <LinearLayout
                android:orientation="horizontal"
                style="@style/fragment_linearlayout_style">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_rom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:text="@string/about_storage"
                        style="@style/about_info_text_style"/>
                    <TextView
                        android:id="@+id/tv_rom_total"
                        android:text="@string/about_total"
                        style="@style/about_info_text_style"/>
                    <TextView
                        android:id="@+id/tv_rom_useful"
                        android:text="@string/about_useful"
                        style="@style/about_info_text_style"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_ram"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/tw_dp_w40">
                    <TextView
                        android:text="@string/about_ram"
                        style="@style/about_info_text_style"/>
                    <TextView
                        android:id="@+id/tv_ram_total"
                        android:text="@string/about_total"
                        style="@style/about_info_text_style"/>
                    <TextView
                        android:id="@+id/tv_ram_useful"
                        android:text="@string/about_useful"
                        style="@style/about_info_text_style"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_moblie_network"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:text="@string/mobile_network"
                style="@style/fragmen_title_style"/>
            <LinearLayout
                android:orientation="horizontal"
                style="@style/fragment_linearlayout_style">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/mobile_network_sim1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:id="@+id/tv_operator_sim1"
                        android:text="@string/about_operator"
                        style="@style/about_info_text_style"/>
                    <TextView
                        android:id="@+id/tv_signal_strength_sim1"
                        android:text="@string/about_signal_strength"
                        style="@style/about_info_text_style"/>
                    <TextView
                        android:id="@+id/tv_mobile_type_sim1"
                        android:text="@string/about_mobile_type"
                        style="@style/about_info_text_style"/>
                    <TextView
                        android:id="@+id/tv_service_stat_sim1"
                        android:text="@string/about_service_stat"
                        style="@style/about_info_text_style"/>
                    <TextView
                        android:id="@+id/tv_mobile_stat_sim1"
                        android:text="@string/about_mobile_stat"
                        style="@style/about_info_text_style"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/mobile_network_sim2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:id="@+id/tv_operator_sim2"
                        android:text="@string/about_operator"
                        style="@style/about_info_text_style"/>
                    <TextView
                        android:id="@+id/tv_signal_strength_sim2"
                        android:text="@string/about_signal_strength"
                        style="@style/about_info_text_style"/>
                    <TextView
                        android:id="@+id/tv_mobile_type_sim2"
                        android:text="@string/about_mobile_type"
                        style="@style/about_info_text_style"/>
                    <TextView
                        android:id="@+id/tv_service_stat_sim2"
                        android:text="@string/about_service_stat"
                        style="@style/about_info_text_style"/>
                    <TextView
                        android:id="@+id/tv_mobile_stat_sim2"
                        android:text="@string/about_mobile_stat"
                        style="@style/about_info_text_style"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_cpbox_carinfo"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:text="@string/cpbox_carinfo"
                style="@style/fragmen_title_style"/>
            <LinearLayout
                android:orientation="horizontal"
                style="@style/fragment_linearlayout_style">
                <TextView
                    android:id="@+id/car_info"
                    style="@style/about_info_text_style"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:text="@string/about_system_info"
                style="@style/fragmen_title_style"/>
            <LinearLayout
                android:orientation="horizontal"
                style="@style/fragment_linearlayout_style">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="5">
                    <TextView
                        android:id="@+id/tv_can_info"
                        android:text="@string/about_can_info"
                        style="@style/about_info_text_style"/>
                    <TextView
                        android:id="@+id/tv_boot_info"
                        android:text="@string/about_boot_info"
                        style="@style/about_info_text_style"/>
                    <TextView
                        android:id="@+id/tv_mcu_info"
                        android:text="@string/about_mcu_info"
                        android:layout_weight="8"
                        style="@style/about_info_text_style"/>
                    <TextView
                        android:id="@+id/tv_ts10s_versioncode_info"
                        android:visibility="gone"
                        android:text="@string/about_versioncode_info"
                        android:layout_weight="8"
                        style="@style/about_info_text_style"/>
                    <TextView
                        android:id="@+id/tv_system_edi"
                        android:text="@string/about_system_info1"
                        android:layout_weight="8"
                        style="@style/about_info_text_style"/>
                    <TextView
                        android:id="@+id/tv_display_info"
                        android:visibility="gone"
                        android:text="@string/about_display_info"
                        android:onClick="onClick"
                        style="@style/about_info_text_style"/>
                    <TextView
                        android:id="@+id/tv_android_version_info"
                        android:text="@string/about_android_info"
                        style="@style/about_info_text_style"/>
                    <TextView
                        android:id="@+id/tv_app_info"
                        android:text="@string/about_app_info"
                        style="@style/about_info_text_style"/>
                    <TextView
                        android:id="@+id/tv_custom_info"
                        style="@style/about_info_text_style"/>
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="right"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/tw_dp_w15"
                        android:layout_weight="2">
                        <ImageView
                            android:id="@+id/btn_about"
                            android:layout_width="@dimen/about_info_icon_size"
                            android:layout_height="@dimen/about_info_icon_size"
                            android:layout_marginRight="@dimen/tw_dp_w30"
                            android:src="@drawable/rb_about2_bg"
                            android:scaleType="centerInside"
                            android:onClick="onClick"/>
                        <TextView
                            android:textSize="@dimen/normal_text_size"
                            android:textColor="@color/text_color_checkupdate"
                            android:gravity="center"
                            android:id="@+id/btn_export_log"
                            android:background="@drawable/tr_b_bg"
                            android:paddingLeft="@dimen/tw_dp_w16"
                            android:paddingRight="@dimen/tw_dp_w16"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/about_info_icon_size"
                            android:layout_marginRight="@dimen/tw_dp_w30"
                            android:text="@string/cfg_export_log"
                            android:onClick="onClick"/>
                        <TextView
                            android:textSize="@dimen/normal_text_size"
                            android:textColor="@color/text_color_checkupdate"
                            android:gravity="center"
                            android:id="@+id/btn_checkupdate"
                            android:background="@drawable/tr_b_bg"
                            android:paddingLeft="@dimen/tw_dp_w16"
                            android:paddingRight="@dimen/tw_dp_w16"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/about_info_icon_size"
                            android:text="@string/about_detection_update"
                            android:onClick="onClick"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
