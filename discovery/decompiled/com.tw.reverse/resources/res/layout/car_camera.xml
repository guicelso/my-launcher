<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/panel_background"
    android:layout_width="450dp"
    android:layout_height="290dp">
    <TextView
        android:textSize="18dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/car_camera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/camera_title"/>
    <TextView
        android:textSize="18dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/car_camera_brightness_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/brightness"/>
    <LinearLayout
        android:gravity="center"
        android:layout_width="450dp"
        android:layout_height="50dp">
        <Button
            android:id="@+id/car_camera_brightness_down"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="@string/down"/>
        <SeekBar
            android:id="@+id/car_camera_brightness_level"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"/>
        <Button
            android:id="@+id/car_camera_brightness_up"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="@string/up"/>
    </LinearLayout>
    <TextView
        android:textSize="18dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/car_camera_contrast_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/contrast"/>
    <LinearLayout
        android:gravity="center"
        android:layout_width="450dp"
        android:layout_height="50dp">
        <Button
            android:id="@+id/car_camera_contrast_down"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="@string/down"/>
        <SeekBar
            android:id="@+id/car_camera_contrast_level"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"/>
        <Button
            android:id="@+id/car_camera_contrast_up"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="@string/up"/>
    </LinearLayout>
    <TextView
        android:textSize="18dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/car_camera_saturation_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/car_saturation"/>
    <LinearLayout
        android:gravity="center"
        android:layout_width="450dp"
        android:layout_height="50dp">
        <Button
            android:id="@+id/car_camera_saturation_down"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="@string/down"/>
        <SeekBar
            android:id="@+id/car_camera_saturation_level"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"/>
        <Button
            android:id="@+id/car_camera_saturation_up"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="@string/up"/>
    </LinearLayout>
</LinearLayout>
