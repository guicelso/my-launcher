<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:radar="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_centerInParent="true">
    <RelativeLayout
        android:id="@+id/rl_reverse"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true">
        <SurfaceView
            android:id="@+id/surface_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:background="@drawable/cvbs_mask"
                android:layout_width="3dp"
                android:layout_height="match_parent"/>
            <View
                android:background="@drawable/cvbs_mask"
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"/>
            <View
                android:background="@drawable/cvbs_mask"
                android:layout_width="match_parent"
                android:layout_height="3dp"/>
        </RelativeLayout>
        <FrameLayout
            android:layout_width="380dp"
            android:layout_height="144dp"
            android:layout_centerInParent="true">
            <ImageView
                android:id="@+id/warning_image"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/warning_novideosignal"
                android:scaleType="center"/>
            <TextView
                android:textSize="26dp"
                android:textColor="#000"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/warning_text_signal"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/warning_signal_t"
                android:singleLine="false"
                android:layout_marginStart="13dp"
                android:layout_marginEnd="13dp"/>
        </FrameLayout>
        <RelativeLayout
            android:id="@+id/dynamic_view"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/dynamic_radar_left"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/radar_dynamic_left"/>
            <ImageView
                android:id="@+id/dynamic_radar_centerleft"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/radar_dynamic_centerleft"/>
            <ImageView
                android:id="@+id/dynamic_radar_centerright"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/radar_dynamic_centerright"/>
            <ImageView
                android:id="@+id/dynamic_radar_right"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/radar_dynamic_right"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_reverse2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.tw.reverse.ReverseLineRuler
                android:id="@+id/lreverse2"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <Button
                android:id="@+id/btn_reset"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="96dp"
                android:layout_height="48dp"
                android:layout_marginLeft="160dp"
                android:layout_marginTop="32dp"
                android:text="@string/reset"
                android:layout_alignParentLeft="true"
                android:onClick="onClick"/>
            <Button
                android:id="@+id/btn_adjust"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="96dp"
                android:layout_height="48dp"
                android:layout_margin="32dp"
                android:text="@string/save"
                android:layout_toRightOf="@+id/btn_reset"
                android:onClick="onClick"/>
        </RelativeLayout>
        <ImageView
            android:id="@+id/lreverse"
            android:background="@drawable/reverse_l_bg_0"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/rmsg"
            android:background="#60000000"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_alignParentBottom="true">
            <View
                android:background="#fff"
                android:layout_width="match_parent"
                android:layout_height="2dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="30dp"
                    android:src="@drawable/camera_icon_alarm"
                    android:scaleType="center"/>
                <TextView
                    android:textSize="28dp"
                    android:textColor="#fff"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_camera_alarm_message"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/camera_alarm"
                    android:layout_weight="1"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@drawable/camera_ahd_bg"
                    android:layout_width="188dp"
                    android:layout_height="44dp"
                    android:layout_marginRight="20dp">
                    <FrameLayout
                        android:id="@+id/flayout_common"
                        android:background="@drawable/lev_camera_ahd"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:onClick="onClick">
                        <TextView
                            android:textSize="24dp"
                            android:textColor="#fff"
                            android:layout_gravity="center"
                            android:id="@+id/tv_common"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/camera_CommonorAHD_common"/>
                    </FrameLayout>
                    <FrameLayout
                        android:id="@+id/flayout_ahd"
                        android:background="@drawable/lev_camera_ahd"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:onClick="onClick">
                        <TextView
                            android:textSize="24dp"
                            android:textColor="#fff"
                            android:layout_gravity="center"
                            android:id="@+id/tv_ahd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/camera_CommonorAHD_ahd"/>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <include
            android:id="@+id/layout_detecting"
            android:visibility="gone"
            layout="@layout/camera_detecting"/>
        <RelativeLayout
            android:id="@+id/reverse"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/breverse"
                android:background="@drawable/radar_r_bg"
                android:visibility="gone"
                android:layout_width="119dp"
                android:layout_height="474dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true">
                <ImageView
                    android:id="@+id/reverse_close"
                    android:background="@drawable/radar_rb_bg"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:src="@drawable/radar_close"
                    android:scaleType="center"
                    android:onClick="onClick"/>
                <ImageView
                    android:id="@+id/reverse_voice"
                    android:background="@drawable/radar_rb_bg"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:src="@drawable/radar_voice"
                    android:scaleType="center"
                    android:onClick="onClick"/>
                <ImageView
                    android:background="@drawable/radar_rb_bg"
                    android:visibility="invisible"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:scaleType="center"
                    android:onClick="onClick"/>
                <ImageView
                    android:background="@drawable/radar_rb_bg"
                    android:visibility="invisible"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:scaleType="center"
                    android:onClick="onClick"/>
                <ImageView
                    android:background="@drawable/radar_rb_bg"
                    android:visibility="invisible"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:scaleType="center"
                    android:onClick="onClick"/>
                <ImageView
                    android:id="@+id/reverse_mode"
                    android:background="@drawable/radar_rb_bg"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:src="@drawable/radar_mode"
                    android:scaleType="center"
                    android:onClick="onClick"/>
                <ImageView
                    android:id="@+id/reverse_switch"
                    android:background="@drawable/radar_rb_bg"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:src="@drawable/radar_switch"
                    android:scaleType="center"
                    android:onClick="onClick"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/breverse2"
                android:visibility="gone"
                android:layout_width="119dp"
                android:layout_height="474dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true">
                <ImageView
                    android:id="@+id/reverse_fv"
                    android:background="@drawable/radar_rb_bg"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:src="@drawable/radar_switch"
                    android:scaleType="center"
                    android:onClick="onClick"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/breverse3"
                android:background="@drawable/radar_r_bg"
                android:visibility="gone"
                android:layout_width="119dp"
                android:layout_height="474dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true">
                <ImageView
                    android:id="@+id/reverse3_close"
                    android:background="@drawable/radar_rb_bg"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="30dp"
                    android:src="@drawable/radar_close"
                    android:scaleType="center"
                    android:onClick="onClick"/>
                <ImageView
                    android:id="@+id/reverse_wa"
                    android:background="@drawable/radar_rb_bg"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="15dp"
                    android:src="@drawable/radar_wa"
                    android:scaleType="center"
                    android:onClick="onClick"/>
                <ImageView
                    android:id="@+id/reverse_std"
                    android:background="@drawable/radar_rb_bg"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="15dp"
                    android:src="@drawable/radar_std"
                    android:scaleType="center"
                    android:onClick="onClick"/>
                <ImageView
                    android:id="@+id/reverse_ol"
                    android:background="@drawable/radar_rb_bg"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="20dp"
                    android:src="@drawable/radar_ol"
                    android:scaleType="center"
                    android:onClick="onClick"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/breverse4"
                android:background="@drawable/radar_r_bg"
                android:visibility="gone"
                android:layout_width="119dp"
                android:layout_height="474dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true">
                <ImageView
                    android:id="@+id/reverse4_close"
                    android:background="@drawable/radar_rb_bg"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:src="@drawable/radar_close"
                    android:scaleType="center"
                    android:onClick="onClick"/>
                <ImageView
                    android:id="@+id/reverse4_voice"
                    android:background="@drawable/radar_rb_bg"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:src="@drawable/radar_voice"
                    android:scaleType="center"
                    android:onClick="onClick"/>
                <ImageView
                    android:id="@+id/reverse4_mode1"
                    android:background="@drawable/radar_rb_bg"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:src="@drawable/radar4_mode1"
                    android:scaleType="center"
                    android:onClick="onClick"/>
                <ImageView
                    android:id="@+id/reverse4_mode2"
                    android:background="@drawable/radar_rb_bg"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:src="@drawable/radar4_mode2"
                    android:scaleType="center"
                    android:onClick="onClick"/>
                <ImageView
                    android:id="@+id/reverse4_mode3"
                    android:background="@drawable/radar_rb_bg"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:src="@drawable/radar4_mode3"
                    android:scaleType="center"
                    android:onClick="onClick"/>
                <ImageView
                    android:id="@+id/reverse4_mode4"
                    android:background="@drawable/radar_rb_bg"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:src="@drawable/radar4_mode4"
                    android:scaleType="center"
                    android:onClick="onClick"/>
                <ImageView
                    android:id="@+id/reverse4_display_set"
                    android:background="@drawable/radar_rb_bg"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:src="@drawable/radar_display_set"
                    android:scaleType="center"
                    android:onClick="onClick"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/breverse5"
                android:background="@drawable/radar_r_bg"
                android:visibility="gone"
                android:layout_width="119dp"
                android:layout_height="474dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true">
                <ImageView
                    android:id="@+id/reverse5_close"
                    android:background="@drawable/radar_rb_bg"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:src="@drawable/radar_close"
                    android:scaleType="center"
                    android:onClick="onClick"/>
                <ImageView
                    android:id="@+id/reverse5_mode1"
                    android:background="@drawable/radar_rb_bg"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:src="@drawable/radar4_mode3"
                    android:scaleType="center"
                    android:onClick="onClick"/>
                <ImageView
                    android:id="@+id/reverse5_mode2"
                    android:background="@drawable/radar_rb_bg"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:src="@drawable/radar4_mode1"
                    android:scaleType="center"
                    android:onClick="onClick"/>
                <ImageView
                    android:id="@+id/reverse5_mode3"
                    android:background="@drawable/radar_rb_bg"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:src="@drawable/radar4_mode4"
                    android:scaleType="center"
                    android:onClick="onClick"/>
                <ImageView
