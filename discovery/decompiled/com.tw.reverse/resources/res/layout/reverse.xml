    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rreverse"
        android:visibility="gone"
        android:layout_width="170dp"
        android:layout_height="410dp"
        android:layout_centerVertical="true">
        <com.tw.reverse.RadarView
            android:id="@+id/reverse_rv"
            android:clickable="true"
            android:layout_width="210dp"
            android:layout_height="350dp"
            android:layout_centerInParent="true"
            radar:orientation="vertical"
            radar:src="@drawable/radar_bg"/>
        <TextView
            android:textSize="22dp"
            android:gravity="center"
            android:id="@+id/freverse_d"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_alignParentTop="true"/>
        <TextView
            android:textSize="22dp"
            android:gravity="center"
            android:id="@+id/rreverse_d"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/camera_settings"
        android:background="@drawable/radar_rb_bg"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginRight="50dp"
        android:src="@drawable/icon_camera_settings"
        android:scaleType="center"
        android:layout_alignParentRight="true"
        android:onClick="onClick"/>
    <RelativeLayout
        android:id="@+id/outer_layer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:id="@+id/layout_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_centerHorizontal="true">
            <ImageView
                android:id="@+id/reset"
                android:background="@drawable/b_p"
                android:clickable="true"
                android:layout_width="53dp"
                android:layout_height="33dp"
                android:src="@drawable/reset"
                android:onClick="onClick"/>
            <ImageView
                android:id="@+id/save"
                android:background="@drawable/b_p"
                android:clickable="true"
                android:layout_width="53dp"
                android:layout_height="33dp"
                android:layout_marginLeft="30dp"
                android:src="@drawable/save"
                android:onClick="onClick"/>
            <ImageView
                android:id="@+id/change"
                android:background="@drawable/b_p"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="53dp"
                android:layout_height="33dp"
                android:layout_marginLeft="30dp"
                android:src="@drawable/car"
                android:onClick="onClick"/>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/inner_layer"
            android:layout_width="170dp"
            android:layout_height="410dp">
            <View
                android:id="@+id/centre"
                android:background="@drawable/points"
                android:clickable="true"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
