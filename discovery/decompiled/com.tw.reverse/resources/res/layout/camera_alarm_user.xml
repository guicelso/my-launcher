<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="#b2000000"
    android:layout_width="450dp"
    android:layout_height="300dp">
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/camera_icon_alarm_big"
        android:scaleType="center"/>
    <TextView
        android:textSize="30dp"
        android:textColor="#fff"
        android:gravity="center"
        android:id="@+id/tv_camera_alarm_user"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"/>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <TextView
            android:textSize="30dp"
            android:textColor="#fff"
            android:gravity="center"
            android:id="@+id/tv_camera_alarm_user_ok"
            android:background="@drawable/btn_camera_alarm_user"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/camera_alarm_user_ok"/>
        <TextView
            android:textSize="30dp"
            android:textColor="#fff"
            android:gravity="center"
            android:id="@+id/tv_camera_alarm_user_cancel"
            android:background="@drawable/btn_camera_alarm_user"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="@string/camera_alarm_user_cancel"/>
    </LinearLayout>
</LinearLayout>
