<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#b2000000"
    android:layout_width="550dp"
    android:layout_height="400dp">
    <LinearLayout
        android:gravity="center"
        android:id="@+id/ll_title"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="24dp"
            android:textColor="@color/camera_title_white"
            android:gravity="center"
            android:id="@+id/tv_layout_frame"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/camera_frame"
            android:drawableBottom="@drawable/lev_camera_title_line"
            android:layout_weight="1"/>
        <TextView
            android:textSize="24dp"
            android:textColor="@color/camera_title_white"
            android:gravity="center"
            android:id="@+id/tv_layout_camera"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/camera_title_camera"
            android:drawableBottom="@drawable/lev_camera_title_line"
            android:layout_weight="1"/>
    </LinearLayout>
    <ScrollView
        android:gravity="center_horizontal"
        android:id="@+id/layout_frame"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp"
        android:layout_below="@+id/ll_title">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="18dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/brightness_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/brightness"/>
            <LinearLayout
                android:gravity="center"
                android:layout_width="@dimen/seekbar_layout_width"
                android:layout_height="@dimen/seekbar_layout_height">
                <ImageView
                    android:id="@+id/brightness_down"
                    android:layout_width="@dimen/seekbar_layout_height"
                    android:layout_height="@dimen/seekbar_layout_height"
                    android:src="@drawable/btn_down"
                    android:scaleType="center"
                    android:text="@string/down"/>
                <SeekBar
                    android:id="@+id/brightness_level"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:maxHeight="9dp"
                    android:progressDrawable="@drawable/progressdrawable"
                    android:thumb="@drawable/thumb"
                    android:thumbOffset="21dp"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/brightness_up"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/btn_up"
                    android:scaleType="center"
                    android:text="@string/up"/>
            </LinearLayout>
            <TextView
                android:textSize="18dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/contrast_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/contrast"/>
            <LinearLayout
                android:gravity="center"
                android:layout_width="450dp"
                android:layout_height="50dp">
                <ImageView
                    android:id="@+id/contrast_down"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/btn_down"
                    android:scaleType="center"
                    android:text="@string/down"/>
                <SeekBar
                    android:id="@+id/contrast_level"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:maxHeight="9dp"
                    android:progressDrawable="@drawable/progressdrawable"
                    android:thumb="@drawable/thumb"
                    android:thumbOffset="21dp"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/contrast_up"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/btn_up"
                    android:scaleType="center"
                    android:text="@string/up"/>
            </LinearLayout>
            <TextView
                android:textSize="18dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/saturation_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/saturation"/>
            <LinearLayout
                android:gravity="center"
                android:layout_width="450dp"
                android:layout_height="50dp">
                <ImageView
                    android:id="@+id/saturation_down"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/btn_down"
                    android:scaleType="center"
                    android:text="@string/down"/>
                <SeekBar
                    android:id="@+id/saturation_level"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:maxHeight="9dp"
                    android:progressDrawable="@drawable/progressdrawable"
                    android:thumb="@drawable/thumb"
                    android:thumbOffset="21dp"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/saturation_up"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/btn_up"
                    android:scaleType="center"
                    android:text="@string/up"/>
            </LinearLayout>
            <TextView
                android:textSize="24dp"
                android:textColor="#fff"
                android:gravity="center"
                android:id="@+id/tv_camera_reset"
                android:background="@drawable/btn_camera_alarm_user"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/camera_reset"/>
        </LinearLayout>
    </ScrollView>
    <ScrollView
        android:gravity="center_horizontal"
        android:id="@+id/layout_camera"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp"
        android:layout_below="@+id/ll_title">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="64dp">
                <TextView
                    android:textSize="@dimen/camera_settings_textsize"
                    android:textColor="#ffffff"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/mirror_left_right"
                    android:maxLines="1"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/lrreverse_mirror_left_right"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="28dp"
                    android:layout_marginRight="8dp"
                    android:src="@drawable/btn_switch"
                    android:scaleType="center"/>
            </LinearLayout>
            <ImageView
                android:background="@drawable/title_xian"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/camera_title_settings"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="64dp">
                <TextView
                    android:textSize="@dimen/camera_settings_textsize"
                    android:textColor="#ffffff"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/mirror_top_bottom"
                    android:maxLines="1"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/lrreverse_mirror_top_bottom"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="28dp"
                    android:layout_marginRight="8dp"
                    android:src="@drawable/btn_switch"
                    android:scaleType="center"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
