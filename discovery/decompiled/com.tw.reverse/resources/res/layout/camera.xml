<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#e6000000"
    android:layout_width="550dp"
    android:layout_height="400dp">
    <LinearLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="24dp"
            android:textColor="@color/camera_title_white"
            android:gravity="center"
            android:id="@+id/tv_layout_frame"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/camera_frame"
            android:drawableBottom="@drawable/lev_camera_title_line"
            android:layout_weight="1"/>
        <TextView
            android:textSize="24dp"
            android:textColor="@color/camera_title_white"
            android:gravity="center"
            android:id="@+id/tv_layout_camera"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/camera_title_camera"
            android:drawableBottom="@drawable/lev_camera_title_line"
            android:layout_weight="1"/>
        <TextView
            android:textSize="24dp"
            android:textColor="@color/camera_title_white"
            android:gravity="center"
            android:id="@+id/tv_reverse_view_mode"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/camera_title_mode"
            android:drawableBottom="@drawable/lev_camera_title_line"
            android:layout_weight="1"/>
    </LinearLayout>
    <ScrollView
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/scrollViewCamera"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="72dp">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="64dp">
                <TextView
                    android:textSize="@dimen/camera_settings_textsize"
                    android:textColor="#ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/camera_title_settings"
                    android:maxLines="1"/>
                <TextView
                    android:textSize="@dimen/reverse_textsize"
                    android:textColor="@color/blue"
                    android:gravity="right"
                    android:id="@+id/reverse_ahd"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/reverse_ahd_30f"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/lev_arrow"
                    android:background="@drawable/button_jiantou"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="28dp"
                    android:layout_marginRight="8dp"
                    android:src="@drawable/lev_arrow"
                    android:scaleType="center"/>
            </LinearLayout>
            <ImageView
                android:background="@drawable/title_xian"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/camera_title_settings"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/layout_camera"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="@dimen/reverse_textsize"
                    android:textColor="#ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/reverse_tip"/>
                <RadioGroup
                    android:orientation="vertical"
                    android:id="@+id/ahd_check"
                    android:paddingLeft="26dp"
                    android:paddingRight="26dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TableRow
                        android:orientation="horizontal"
                        android:paddingTop="18dp"
                        android:paddingBottom="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <RadioButton
                            android:id="@+id/ahd_auto"
                            android:visibility="gone"
                            android:text="@string/reverse_ahd_auto"
                            style="@style/cus_rb_480dp"/>
                        <View
                            android:visibility="gone"
                            android:layout_width="0dp"
                            android:layout_height="2dp"
                            android:layout_weight="1"/>
                        <RadioButton
                            android:id="@+id/ahd_ntsc"
                            android:text="@string/reverse_ahd_ntsc"
                            style="@style/cus_rb_480dp"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="2dp"
                            android:layout_weight="1"/>
                        <RadioButton
                            android:id="@+id/ahd_pal"
                            android:text="@string/reverse_ahd_pal"
                            style="@style/cus_rb_480dp"/>
                    </TableRow>
                    <TableRow
                        android:orientation="horizontal"
                        android:paddingTop="6dp"
                        android:paddingBottom="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <RadioButton
                            android:id="@+id/ahd_25f"
                            android:text="@string/reverse_ahd_25f"
                            style="@style/cus_rb_480dp"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="2dp"
                            android:layout_weight="1"/>
                        <RadioButton
                            android:id="@+id/ahd_30f"
                            android:text="@string/reverse_ahd_30f"
                            style="@style/cus_rb_480dp"/>
                    </TableRow>
                    <TableRow
                        android:orientation="horizontal"
                        android:paddingTop="6dp"
                        android:paddingBottom="18dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <RadioButton
                            android:id="@+id/tvi_25f"
                            android:text="@string/reverse_tvi_25f"
                            style="@style/cus_rb_480dp"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="2dp"
                            android:layout_weight="1"/>
                        <RadioButton
                            android:id="@+id/tvi_30f"
                            android:text="@string/reverse_tvi_30f"
                            style="@style/cus_rb_480dp"/>
                    </TableRow>
                    <TableRow
                        android:orientation="horizontal"
                        android:paddingTop="6dp"
                        android:paddingBottom="18dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <RadioButton
                            android:id="@+id/ahd_1080p_25f"
                            android:text="@string/reverse_ahd_1080p_25f"
                            style="@style/cus_rb_480dp"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="2dp"
                            android:layout_weight="1"/>
                        <RadioButton
                            android:id="@+id/ahd_1080p_30f"
                            android:text="@string/reverse_ahd_1080p_30f"
                            style="@style/cus_rb_480dp"/>
                    </TableRow>
                    <TableRow
                        android:orientation="horizontal"
                        android:paddingTop="6dp"
                        android:paddingBottom="18dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <RadioButton
                            android:id="@+id/tvi_1080p_25f"
                            android:text="@string/reverse_tvi_1080p_25f"
                            style="@style/cus_rb_480dp"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="2dp"
                            android:layout_weight="1"/>
                        <RadioButton
                            android:id="@+id/tvi_1080p_30f"
                            android:text="@string/reverse_tvi_1080p_30f"
                            style="@style/cus_rb_480dp"/>
                    </TableRow>
                </RadioGroup>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="64dp">
                <TextView
                    android:textSize="@dimen/camera_settings_textsize"
                    android:textColor="#ffffff"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/reversing_ruler_line"
                    android:maxLines="1"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/reversing_ruler_line"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="28dp"
                    android:layout_marginRight="8dp"
                    android:src="@drawable/btn_switch"
                    android:scaleType="center"/>
            </LinearLayout>
            <ImageView
                android:background="@drawable/title_xian"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/camera_title_settings"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/image_debounce_switch"
                android:layout_width="match_parent"
                android:layout_height="64dp">
                <TextView
                    android:textSize="@dimen/camera_settings_textsize"
                    android:textColor="#ffffff"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/image_debounce"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/image_debounce"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="28dp"
                    android:layout_marginRight="8dp"
                    android:src="@drawable/btn_imagedebounce_switch"
                    android:scaleType="center"/>
            </LinearLayout>
            <ImageView
                android:background="@drawable/title_xian"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/camera_title_settings"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/camera_settings_textsize"
                    android:textColor="#ffffff"
                    android:gravity="center_vertical"
                    android:id="@+id/reversing_ruler_line_settings"
                    android:visibility="visible"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="@string/reversing_ruler_line_settings"
                    android:maxLines="1"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <ScrollView
        android:gravity="center_horizontal"
        android:id="@+id/layout_frame"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="72dp">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="18dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/brightness_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/brightness"/>
            <LinearLayout
                android:gravity="center"
                android:layout_width="@dimen/seekbar_layout_width"
                android:layout_height="@dimen/seekbar_layout_height">
                <ImageView
                    android:id="@+id/brightness_down"
                    android:layout_width="@dimen/seekbar_layout_height"
                    android:layout_height="@dimen/seekbar_layout_height"
                    android:src="@drawable/btn_down"
                    android:scaleType="center"
                    android:text="@string/down"/>
                <SeekBar
                    android:id="@+id/brightness_level"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:maxHeight="9dp"
                    android:progressDrawable="@drawable/progressdrawable"
                    android:thumb="@drawable/thumb"
                    android:thumbOffset="21dp"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/brightness_up"
                    android:layout_width="@dimen/seekbar_layout_height"
                    android:layout_height="@dimen/seekbar_layout_height"
                    android:src="@drawable/btn_up"
                    android:scaleType="center"
                    android:text="@string/up"/>
            </LinearLayout>
            <TextView
                android:textSize="18dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/contrast_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/contrast"/>
            <LinearLayout
                android:gravity="center"
                android:layout_width="@dimen/seekbar_layout_width"
                android:layout_height="@dimen/seekbar_layout_height">
                <ImageView
                    android:id="@+id/contrast_down"
                    android:layout_width="@dimen/seekbar_layout_height"
                    android:layout_height="@dimen/seekbar_layout_height"
                    android:src="@drawable/btn_down"
                    android:scaleType="center"
                    android:text="@string/down"/>
                <SeekBar
                    android:id="@+id/contrast_level"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:maxHeight="9dp"
                    android:progressDrawable="@drawable/progressdrawable"
                    android:thumb="@drawable/thumb"
                    android:thumbOffset="21dp"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/contrast_up"
                    android:layout_width="@dimen/seekbar_layout_height"
                    android:layout_height="@dimen/seekbar_layout_height"
                    android:src="@drawable/btn_up"
                    android:scaleType="center"
                    android:text="@string/up"/>
            </LinearLayout>
            <TextView
                android:textSize="18dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/saturation_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/saturation"/>
            <LinearLayout
                android:gravity="center"
                android:layout_width="@dimen/seekbar_layout_width"
                android:layout_height="@dimen/seekbar_layout_height">
                <ImageView
                    android:id="@+id/saturation_down"
                    android:layout_width="@dimen/seekbar_layout_height"
                    android:layout_height="@dimen/seekbar_layout_height"
                    android:src="@drawable/btn_down"
                    android:scaleType="center"
                    android:text="@string/down"/>
                <SeekBar
                    android:id="@+id/saturation_level"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:maxHeight="9dp"
                    android:progressDrawable="@drawable/progressdrawable"
                    android:thumb="@drawable/thumb"
                    android:thumbOffset="21dp"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/saturation_up"
                    android:layout_width="@dimen/seekbar_layout_height"
                    android:layout_height="@dimen/seekbar_layout_height"
                    android:src="@drawable/btn_up"
                    android:scaleType="center"
                    android:text="@string/up"/>
            </LinearLayout>
            <TextView
                android:textSize="24dp"
                android:textColor="#fff"
                android:gravity="center"
                android:id="@+id/tv_camera_reset"
                android:background="@drawable/btn_camera_alarm_user"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/camera_reset"/>
        </LinearLayout>
    </ScrollView>
    <ScrollView
        android:gravity="center_horizontal"
        android:id="@+id/layout_reverse_view_mode"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="72dp">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="64dp">
                <TextView
                    android:textSize="@dimen/camera_settings_textsize"
                    android:textColor="#ffffff"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/reverse_view_mode1"
                    android:maxLines="1"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/reverse_view_mode1"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="28dp"
                    android:layout_marginRight="8dp"
                    android:src="@drawable/btn_switch"
                    android:scaleType="center"/>
            </LinearLayout>
            <ImageView
                android:background="@drawable/title_xian"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/camera_title_settings"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="64dp">
                <TextView
                    android:textSize="@dimen/camera_settings_textsize"
                    android:textColor="#ffffff"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/reverse_view_mode2"
                    android:maxLines="1"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/reverse_view_mode2"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="28dp"
                    android:layout_marginRight="8dp"
                    android:src="@drawable/btn_switch"
                    android:scaleType="center"/>
            </LinearLayout>
            <ImageView
                android:background="@drawable/title_xian"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/camera_title_settings"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="64dp">
                <TextView
                    android:textSize="@dimen/camera_settings_textsize"
                    android:textColor="#ffffff"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/reverse_view_mode3"
                    android:maxLines="1"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/reverse_view_mode3"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="28dp"
                    android:layout_marginRight="8dp"
                    android:src="@drawable/btn_switch"
                    android:scaleType="center"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/context_reverse_view_mode4"
                android:layout_width="match_parent"
                android:layout_height="64dp">
                <TextView
                    android:textSize="@dimen/camera_settings_textsize"
                    android:textColor="#ffffff"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/reverse_view_mode4"
                    android:maxLines="1"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/reverse_view_mode4"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="28dp"
                    android:layout_marginRight="8dp"
                    android:src="@drawable/btn_switch"
                    android:scaleType="center"/>
            </LinearLayout>
            <ImageView
                android:background="@drawable/title_xian"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/camera_title_settings"/>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
