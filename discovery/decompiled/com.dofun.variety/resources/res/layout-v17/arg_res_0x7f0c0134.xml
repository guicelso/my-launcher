<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="26px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_price"
        android:background="@drawable/arg_res_0x7f08024a"
        android:paddingLeft="6px"
        android:paddingTop="6px"
        android:paddingRight="6px"
        android:paddingBottom="6px"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="20px"
        android:minWidth="180px"
        android:minHeight="60px"
        android:paddingStart="6px"
        android:paddingEnd="6px"
        android:layout_marginEnd="20px"
        app:adapt_calc_base_on="5"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toStartOf="@+id/tv_open_vip"
        app:layout_constraintHorizontal_chainStyle="2"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toLeftOf="@+id/tv_open_vip"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <com.dofun.overseasvariety.view.AutoDelTextView
        android:textSize="22px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_original_price"
        android:focusable="false"
        android:visibility="invisible"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12px"
        android:layout_marginStart="12px"
        app:delColor="@color/arg_res_0x7f0602b8"
        app:delShowing="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/tv_price"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toRightOf="@+id/tv_price"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toEndOf="@+id/tv_price"
        app:layout_constraintTop_toTopOf="@+id/tv_price"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="26px"
        android:textColor="#ba7f11"
        android:gravity="center"
        android:id="@+id/tv_open_vip"
        android:background="@drawable/arg_res_0x7f080289"
        android:paddingLeft="6px"
        android:paddingTop="6px"
        android:paddingRight="6px"
        android:paddingBottom="6px"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20px"
        android:maxWidth="200px"
        android:minWidth="160px"
        android:minHeight="60px"
        android:text="@string/arg_res_0x7f1002f8"
        android:paddingStart="6px"
        android:paddingEnd="6px"
        android:layout_marginStart="20px"
        app:adapt_calc_base_on="5"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toEndOf="@+id/tv_price"
        app:layout_constraintTop_toTopOf="0"/>
</merge>
