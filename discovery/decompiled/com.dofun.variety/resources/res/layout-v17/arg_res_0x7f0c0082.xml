<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@mipmap/arg_res_0x7f0e0060"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.dofun.overseasvariety.view.MeterView
        android:id="@+id/meter_speed"
        android:layout_width="360px"
        android:layout_height="360px"
        android:layout_marginRight="60px"
        android:layout_marginEnd="60px"
        app:adapt_calc_base_on="3"
        app:childMarginCenter="15px"
        app:childTextSize="20px"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toStartOf="@+id/meter_time"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"
        app:mainMarginCenter="5px"
        app:mainTextSize="49px"
        app:maxSpeed="240"
        app:meterDial="@mipmap/arg_res_0x7f0e0063"
        app:meterType="1"
        app:offsetAngle="-90"
        app:pointer="@mipmap/arg_res_0x7f0e0062"
        app:speedStartDegress="120"
        app:speedSweepDegress="300"
        app:textType="1"/>
    <com.dofun.overseasvariety.view.MeterView
        android:id="@+id/meter_time"
        android:layout_width="360px"
        android:layout_height="360px"
        android:layout_marginLeft="60px"
        android:layout_marginStart="60px"
        app:adapt_calc_base_on="3"
        app:childMarginCenter="15px"
        app:childTextSize="20px"
        app:format="MM-dd"
        app:layout_constraintBottom_toBottomOf="@+id/meter_speed"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toEndOf="@+id/meter_speed"
        app:layout_constraintTop_toTopOf="@+id/meter_speed"
        app:mainMarginCenter="5px"
        app:mainTextSize="49px"
        app:meterDial="@mipmap/arg_res_0x7f0e0061"
        app:meterType="0"
        app:pointer="@mipmap/arg_res_0x7f0e0062"
        app:textType="1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
