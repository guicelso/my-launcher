<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_dw_app_error"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="32px"
        android:gravity="center"
        android:id="@+id/tv_app_error_tips1"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:text="@string/arg_res_0x7f100188"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toTopOf="@+id/tv_app_error_tips2"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"
        app:layout_constraintVertical_chainStyle="2"
        style="@style/arg_res_0x7f110124"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_app_error_tips2"
        android:visibility="gone"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="12dp"
        android:text="@string/arg_res_0x7f100145"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:adapt_calc_base_on="5"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_app_error_tips1"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="23px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_retry"
        android:background="@drawable/arg_res_0x7f080145"
        android:paddingLeft="14px"
        android:paddingTop="8px"
        android:paddingRight="14px"
        android:paddingBottom="8px"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:minWidth="80dp"
        android:minHeight="30dp"
        android:text="@string/arg_res_0x7f100304"
        android:maxLines="1"
        android:singleLine="true"
        app:adapt_calc_base_on="3"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_app_error_tips2"
        app:minTextSize="14dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
