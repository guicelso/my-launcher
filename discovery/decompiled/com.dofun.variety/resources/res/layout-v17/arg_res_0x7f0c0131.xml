<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="36px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_probation"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20px"
        android:maxWidth="200px"
        android:minWidth="160px"
        android:text="@string/arg_res_0x7f1002ed"
        android:layout_marginStart="20px"
        app:adapt_calc_base_on="5"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toStartOf="@+id/center"
        app:layout_constraintHorizontal_chainStyle="2"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <View
        android:id="@+id/center"
        android:background="@android:color/white"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:layout_marginLeft="10px"
        android:layout_marginRight="10px"
        android:layout_marginStart="10px"
        android:layout_marginEnd="10px"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toStartOf="@+id/ll_probation_buy_and_original_price"
        app:layout_constraintStart_toEndOf="@+id/tv_probation"
        app:layout_constraintTop_toTopOf="0"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/ll_probation_buy_and_original_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toStartOf="@+id/tv_probation_price"
        app:layout_constraintStart_toEndOf="@+id/center"
        app:layout_constraintTop_toTopOf="0">
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="17px"
            android:textColor="@android:color/white"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_probation_buy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/arg_res_0x7f1000aa"/>
        <com.dofun.overseasvariety.view.AutoDelTextView
            android:textSize="14px"
            android:textColor="@android:color/white"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_probation_original_price"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:delColor="@color/arg_res_0x7f0602b8"
            app:delShowing="true"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="36px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_probation_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8px"
        android:layout_marginRight="20px"
        android:layout_marginStart="8px"
        android:layout_marginEnd="20px"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toEndOf="@+id/ll_probation_buy_and_original_price"
        app:layout_constraintTop_toTopOf="0"/>
</merge>
