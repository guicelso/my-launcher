<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/model_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.dofun.overseasvariety.view.PressRelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/model_root"
        android:paddingLeft="24px"
        android:paddingRight="24px"
        android:paddingBottom="24px"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24px"
        android:paddingEnd="24px"
        app:adapt_calc_base_on="3">
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="18px"
            android:textColor="#96a0b0"
            android:id="@+id/tv_desc"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="26px"
            android:textColor="@android:color/white"
            android:id="@+id/tv_seek_min"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_desc"/>
        <cn.cardoor.variety.base.ui.adapt.AutoSeekBar
            android:id="@+id/seekbar"
            android:paddingLeft="14px"
            android:paddingRight="14px"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6px"
            android:maxHeight="10px"
            android:progressDrawable="@drawable/arg_res_0x7f08021e"
            android:minHeight="10px"
            android:thumb="@drawable/arg_res_0x7f080262"
            android:layout_toLeftOf="@+id/tv_seek_max"
            android:layout_toRightOf="@+id/tv_seek_min"
            android:layout_below="@+id/tv_desc"
            android:paddingEnd="14px"
            android:layout_toStartOf="@+id/tv_seek_max"
            android:layout_toEndOf="@+id/tv_seek_min"
            app:adapt_calc_base_on="3"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="26px"
            android:textColor="@android:color/white"
            android:id="@+id/tv_seek_max"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_desc"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"/>
    </com.dofun.overseasvariety.view.PressRelativeLayout>
</merge>
