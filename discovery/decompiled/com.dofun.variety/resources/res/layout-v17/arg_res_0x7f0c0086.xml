<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:scrollbarStyle="outsideInset"
    android:id="@+id/scroll_plugin_root"
    android:paddingRight="50dp"
    android:fadingEdge="vertical"
    android:fadingEdgeLength="20dp"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginRight="10dp"
    android:fadeScrollbars="true"
    android:requiresFadingEdge="vertical"
    android:paddingEnd="50dp"
    android:layout_marginEnd="10dp">
    <cn.cardoor.variety.base.ui.adapt.AutoLinearLayout
        android:orientation="vertical"
        android:id="@+id/animate_root"
        android:paddingTop="20px"
        android:paddingBottom="30px"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <cn.cardoor.variety.base.ui.adapt.AutoButton
            android:textSize="24px"
            android:textColor="@android:color/white"
            android:gravity="center_vertical"
            android:id="@+id/btn_app_transfer"
            android:tag="nav_set"
            android:background="@null"
            android:padding="24px"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10px"
            android:minHeight="90px"
            android:text="@string/arg_res_0x7f100084"
            android:drawableRight="@mipmap/arg_res_0x7f0e0005"
            android:drawableEnd="@mipmap/arg_res_0x7f0e0005"
            app:adapt_calc_base_on="3"
            app:bl_corners_radius="8dp"
            app:bl_solid_color="@color/arg_res_0x7f060036"/>
        <cn.cardoor.variety.base.ui.adapt.AutoRelativeLayout
            android:paddingLeft="24px"
            android:paddingRight="24px"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="90px"
            android:layout_marginTop="10px"
            app:adapt_calc_base_on="3"
            app:bl_corners_radius="8dp"
            app:bl_solid_color="@color/arg_res_0x7f060036">
            <cn.cardoor.variety.base.ui.adapt.AutoTextView
                android:textSize="24px"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/tv_auto_task"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/arg_res_0x7f100099"
                android:includeFontPadding="false"
                android:drawableRight="@drawable/arg_res_0x7f080194"
                android:drawablePadding="8dp"
                android:layout_centerVertical="true"
                android:drawableEnd="@drawable/arg_res_0x7f080194"
                app:endDrawableHeight="24px"
                app:endDrawableWidth="24px"/>
            <cn.cardoor.variety.base.ui.adapt.AutoImageView
                android:id="@+id/iv_add_task"
                android:background="@drawable/arg_res_0x7f080178"
                android:layout_width="30px"
                android:layout_height="30px"
                android:layout_marginRight="20px"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="20px"
                android:layout_alignParentEnd="true"
                app:is_square="true"/>
        </cn.cardoor.variety.base.ui.adapt.AutoRelativeLayout>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="20px"
            android:textColor="@android:color/white"
            android:id="@+id/tv_theme_launcher"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10px"
            android:text="@string/arg_res_0x7f100376"
            android:drawableLeft="@mipmap/arg_res_0x7f0e001a"
            android:drawablePadding="8px"
            android:drawableStart="@mipmap/arg_res_0x7f0e001a"
            app:startDrawableHeight="24px"
            app:startDrawableWidth="24px"/>
        <cn.cardoor.variety.base.ui.adapt.AutoRecyclerView
            android:id="@+id/rv_theme_launcher"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10px"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="20px"
            android:textColor="@android:color/white"
            android:id="@+id/tv_system_acc"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10px"
            android:text="@string/arg_res_0x7f100341"
            android:drawableLeft="@drawable/arg_res_0x7f080177"
            android:drawablePadding="8px"
            android:drawableStart="@drawable/arg_res_0x7f080177"
            app:startDrawableHeight="24px"
            app:startDrawableWidth="24px"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_system_acc"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10px"/>
    </cn.cardoor.variety.base.ui.adapt.AutoLinearLayout>
</androidx.core.widget.NestedScrollView>
