<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_apps_msg_content"
    android:paddingLeft="22px"
    android:paddingRight="22px"
    android:layout_width="match_parent"
    android:layout_height="90px"
    android:paddingStart="22px"
    android:paddingEnd="22px"
    app:adapt_calc_base_on="3"
    app:bl_corners_radius="22px"
    app:bl_solid_color="#ffffff">
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_apps_msg"
        android:padding="5px"
        android:layout_width="80px"
        android:layout_height="80px"
        app:adapt_calc_base_on="3"
        app:is_square="true"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="#4a4a4a"
        android:ellipsize="end"
        android:id="@+id/tv_apps_msg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8px"
        android:layout_marginRight="17px"
        android:maxLines="2"
        android:layout_marginStart="8px"
        android:layout_marginEnd="17px"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toStartOf="@+id/tv_apps_msg_btn"
        app:layout_constraintLeft_toRightOf="@+id/iv_apps_msg"
        app:layout_constraintRight_toLeftOf="@+id/tv_apps_msg_btn"
        app:layout_constraintStart_toEndOf="@+id/iv_apps_msg"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="22px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_apps_msg_btn"
        android:layout_width="150px"
        android:layout_height="56px"
        android:layout_marginRight="10px"
        android:text="@string/arg_res_0x7f100364"
        android:layout_marginEnd="10px"
        app:adapt_calc_base_on="3"
        app:bl_corners_radius="100px"
        app:bl_solid_color="#0076ff"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintTop_toTopOf="0"/>
</cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
