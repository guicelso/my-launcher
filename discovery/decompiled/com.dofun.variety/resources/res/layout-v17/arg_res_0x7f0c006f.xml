<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="30px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_dw_setting_title"
        android:background="#272f3d"
        android:layout_width="0px"
        android:layout_height="80px"
        android:text="@string/arg_res_0x7f100118"
        app:adapt_calc_base_on="3"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"
        app:pressed_effect="false"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/ib_dw_setting_back"
        android:background="@null"
        android:layout_width="44px"
        android:layout_height="44px"
        android:layout_marginLeft="50px"
        android:src="@drawable/arg_res_0x7f080233"
        android:layout_marginStart="50px"
        app:layout_constraintBottom_toBottomOf="@+id/tv_dw_setting_title"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="@+id/tv_dw_setting_title"/>
    <cn.cardoor.variety.base.ui.adapt.AutoRecyclerView
        android:id="@+id/rv_dw_apps"
        android:fadingEdge="vertical"
        android:fadingEdgeLength="16dp"
        android:layout_width="0px"
        android:layout_height="0px"
        android:requiresFadingEdge="vertical"
        android:layout_marginStart="80px"
        android:layout_marginEnd="80px"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_dw_setting_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
