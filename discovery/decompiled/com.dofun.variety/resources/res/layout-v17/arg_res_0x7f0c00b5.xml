<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/cl_content"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginLeft="40px"
    android:layout_marginRight="40px"
    android:minWidth="680px"
    android:minHeight="440px"
    android:layout_marginStart="40px"
    android:layout_marginEnd="40px"
    app:adapt_calc_base_on="3"
    app:bl_corners_radius="10dp"
    app:bl_solid_color="@android:color/white">
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="16px"
        android:textColor="#000000"
        android:id="@+id/tv_remain_count"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20px"
        android:layout_marginTop="20px"
        android:layout_marginStart="20px"
        app:fitTypeface="false"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_exchange_status"
        android:layout_width="110px"
        android:layout_height="110px"
        android:layout_marginTop="18px"
        app:adapt_calc_base_on="3"
        app:is_square="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_exchange_result"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"
        app:layout_constraintVertical_chainStyle="2"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="40px"
        android:textColor="#585757"
        android:gravity="center"
        android:id="@+id/tv_exchange_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18px"
        android:layout_marginStart="20px"
        android:layout_marginEnd="20px"
        app:adapt_calc_base_on="3"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_exchange_result_toast"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/iv_exchange_status"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="#707070"
        android:gravity="center"
        android:id="@+id/tv_exchange_result_toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6px"
        android:layout_marginStart="20px"
        android:layout_marginEnd="20px"
        app:adapt_calc_base_on="3"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_exchange_ok"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_exchange_result"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:id="@+id/tv_exchange_ok"
        android:layout_marginTop="26px"
        android:layout_marginBottom="18px"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_exchange_result_toast"
        style="@style/arg_res_0x7f110120"/>
</androidx.constraintlayout.widget.ConstraintLayout>
