<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_app_no_permission"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="28dp"
        android:textColor="#00a2f9"
        android:id="@+id/tv_desktop_window_permission_tips_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/arg_res_0x7f100290"
        app:layout_constraintBottom_toTopOf="@+id/tv_desktop_window_permission_tips_2"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"
        app:layout_constraintVertical_chainStyle="2"/>
    <me.grantland.widget.AutofitTextView
        android:textSize="24dp"
        android:gravity="center"
        android:id="@+id/tv_desktop_window_permission_tips_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/arg_res_0x7f100291"
        android:maxLines="1"
        android:singleLine="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_desktop_window_permission_tips_3"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_desktop_window_permission_tips_1"
        app:minTextSize="14dp"
        style="@style/arg_res_0x7f110124"/>
    <me.grantland.widget.AutofitTextView
        android:textSize="24dp"
        android:gravity="center"
        android:id="@+id/tv_desktop_window_permission_tips_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/arg_res_0x7f100292"
        android:maxLines="1"
        android:singleLine="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_desktop_window_permission_request"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_desktop_window_permission_tips_2"
        app:minTextSize="14dp"
        style="@style/arg_res_0x7f110124"/>
    <cn.cardoor.variety.base.ui.adapt.AutoButton
        android:textSize="28px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_desktop_window_permission_request"
        android:background="@drawable/arg_res_0x7f080145"
        android:paddingLeft="80px"
        android:paddingTop="16px"
        android:paddingRight="80px"
        android:paddingBottom="16px"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30px"
        android:text="@string/arg_res_0x7f10028c"
        android:paddingStart="80px"
        android:paddingEnd="80px"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_desktop_window_permission_tips_3"/>
</androidx.constraintlayout.widget.ConstraintLayout>
