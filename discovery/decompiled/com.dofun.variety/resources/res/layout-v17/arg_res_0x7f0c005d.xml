<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout
        android:layout_width="680px"
        android:layout_height="460px"
        app:adapt_calc_base_on="3"
        app:bl_corners_radius="20px"
        app:bl_solid_color="#f8f8f8">
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="24px"
            android:textColor="#4a4a4a"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15px"
            android:text="@string/arg_res_0x7f100121"
            app:adapt_calc_base_on="3"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toTopOf="0"/>
        <cn.cardoor.variety.base.ui.adapt.AutoImageView
            android:id="@+id/iv_close"
            android:layout_width="28px"
            android:layout_height="28px"
            android:layout_marginRight="16px"
            android:src="@mipmap/arg_res_0x7f0e0009"
            android:layout_marginEnd="16px"
            app:adapt_calc_base_on="3"
            app:is_square="true"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintTop_toTopOf="@+id/tv_title"/>
        <cn.cardoor.variety.base.ui.adapt.AutoRecyclerView
            android:id="@+id/rv_data"
            android:focusable="false"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginLeft="6px"
            android:layout_marginTop="20px"
            android:layout_marginRight="6px"
            android:layout_marginBottom="22px"
            android:fadeScrollbars="false"
            android:overScrollMode="always"
            app:adapt_calc_base_on="3"
            app:layout_constraintBottom_toBottomOf="0"
            app:layout_constraintTop_toBottomOf="@+id/iv_close"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_loading_mask"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:bl_corners_radius="20dp"
            app:bl_solid_color="#3b333333">
            <cn.cardoor.variety.base.ui.adapt.AutoProgressBar
                android:layout_width="132px"
                android:layout_height="132px"
                android:indeterminate="false"
                android:indeterminateDrawable="@drawable/arg_res_0x7f0801b5"
                app:adapt_calc_base_on="3"
                style="@android:style/Widget.Holo.Light.ProgressBar.Large"/>
            <cn.cardoor.variety.base.ui.adapt.AutoTextView
                android:textSize="20px"
                android:textColor="#aeafb9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10px"
                android:text="@string/arg_res_0x7f1001c7"
                app:adapt_calc_base_on="3"/>
        </LinearLayout>
    </cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
</FrameLayout>
