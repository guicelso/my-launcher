<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/mTitleContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mPreviewRecyclerView"
        android:background="#f0303030"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:layout_alignParentBottom="true"/>
    <RelativeLayout
        android:id="@+id/bottom_bar"
        android:background="#f0303030"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true">
        <View
            android:background="#30ffffff"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <CheckBox
            android:textColor="@color/arg_res_0x7f06032f"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/mOriginalCheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:button="@null"
            android:text="@string/arg_res_0x7f1002b4"
            android:drawablePadding="5dp"
            android:layout_centerInParent="true"/>
        <CheckBox
            android:textColor="#ffffff"
            android:id="@+id/mSelectCheckBox"
            android:paddingLeft="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="12dp"
            android:button="@null"
            android:text="@string/arg_res_0x7f1002b3"
            android:includeFontPadding="true"
            android:drawablePadding="4dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:paddingStart="4dp"
            android:layout_marginEnd="12dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</RelativeLayout>
