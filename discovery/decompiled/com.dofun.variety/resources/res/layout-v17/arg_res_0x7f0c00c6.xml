<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/cl_content"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="600px"
    android:minHeight="400px"
    app:adapt_calc_base_on="3"
    app:bl_corners_radius="10dp"
    app:bl_solid_color="@android:color/white">
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="#4a4a4a"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20px"
        android:text="@string/arg_res_0x7f10012d"
        app:adapt_calc_base_on="3"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_close"
        android:layout_width="28px"
        android:layout_height="28px"
        android:layout_marginRight="16px"
        android:src="@mipmap/arg_res_0x7f0e0009"
        android:layout_marginEnd="16px"
        app:adapt_calc_base_on="3"
        app:is_square="true"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintTop_toTopOf="@+id/tv_title"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_source_theme"
        android:layout_width="160px"
        android:layout_height="150px"
        android:src="@mipmap/arg_res_0x7f0e0054"
        android:scaleType="fitXY"
        app:adapt_calc_base_on="3"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_source_theme_tag"
        android:visibility="invisible"
        android:layout_width="24px"
        android:layout_height="24px"
        android:src="@drawable/arg_res_0x7f080183"
        android:scaleType="fitXY"
        app:adapt_calc_base_on="3"
        app:layout_constraintLeft_toLeftOf="@+id/iv_source_theme"
        app:layout_constraintStart_toStartOf="@+id/iv_source_theme"
        app:layout_constraintTop_toTopOf="@+id/iv_source_theme"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="22px"
        android:textColor="#ff4a4a4a"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10px"
        android:maxWidth="180px"
        android:text="@string/arg_res_0x7f100367"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/iv_source_theme"
        app:layout_constraintStart_toStartOf="@+id/iv_source_theme"
        app:layout_constraintTop_toBottomOf="@+id/iv_source_theme"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_source_custom"
        android:layout_width="160px"
        android:layout_height="150px"
        android:src="@mipmap/arg_res_0x7f0e0053"
        android:scaleType="fitXY"
        app:adapt_calc_base_on="3"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_source_custom_tag"
        android:visibility="invisible"
        android:layout_width="24px"
        android:layout_height="24px"
        android:src="@drawable/arg_res_0x7f080183"
        android:scaleType="fitXY"
        app:adapt_calc_base_on="3"
        app:layout_constraintLeft_toLeftOf="@+id/iv_source_custom"
        app:layout_constraintStart_toStartOf="@+id/iv_source_custom"
        app:layout_constraintTop_toTopOf="@+id/iv_source_custom"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="22px"
        android:textColor="#ff4a4a4a"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10px"
        android:maxWidth="180px"
        android:text="@string/arg_res_0x7f100197"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/iv_source_custom"
        app:layout_constraintStart_toStartOf="@+id/iv_source_custom"
        app:layout_constraintTop_toBottomOf="@+id/iv_source_custom"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/flow_image_source"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        app:constraint_referenced_ids="iv_source_theme,iv_source_custom"
        app:flow_horizontalGap="30dp"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        app:layout_constraintVertical_bias="0.35"/>
</cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
