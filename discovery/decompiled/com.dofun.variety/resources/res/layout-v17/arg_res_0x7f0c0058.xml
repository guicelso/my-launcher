<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.variety.base.ui.adapt.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:layout_width="680px"
    android:layout_height="440px">
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="30px"
        android:textColor="@android:color/black"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30px"
        android:layout_centerHorizontal="true"
        app:adapt_calc_base_on="3"/>
    <com.dofun.overseasvariety.view.TransparentWebView
        android:id="@+id/wv_content"
        android:layout_width="560px"
        android:layout_height="match_parent"
        android:layout_marginTop="20px"
        android:layout_marginBottom="30px"
        android:layout_below="@+id/tv_title"
        android:layout_centerHorizontal="true"
        android:layerType="software"/>
    <ProgressBar
        android:id="@+id/pb"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        style="@android:style/Widget.Holo.Light.ProgressBar.Large"/>
    <FrameLayout
        android:id="@+id/fl_error"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="25px"
            android:textColor="#acacac"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/arg_res_0x7f1001c6"
            android:drawableTop="@mipmap/arg_res_0x7f0e0056"
            android:drawablePadding="25px"/>
    </FrameLayout>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_close"
        android:background="@mipmap/arg_res_0x7f0e0009"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="20px"
        android:layout_alignTop="@+id/tv_title"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="20px"
        android:layout_alignParentEnd="true"/>
</cn.cardoor.variety.base.ui.adapt.AutoRelativeLayout>
