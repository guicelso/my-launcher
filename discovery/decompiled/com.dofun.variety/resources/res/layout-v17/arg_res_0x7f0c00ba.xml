<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout
        android:id="@+id/cl_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="50px"
        android:layout_marginTop="12px"
        android:layout_marginRight="50px"
        android:layout_marginStart="50px"
        android:layout_marginEnd="50px">
        <cn.cardoor.variety.base.ui.adapt.AutoShapeableImageView
            android:id="@+id/iv_user_avatar"
            android:visibility="invisible"
            android:layout_width="150px"
            android:layout_height="150px"
            android:layout_marginLeft="20px"
            android:layout_marginTop="40px"
            android:layout_marginBottom="40px"
            android:scaleType="centerCrop"
            android:layout_marginStart="20px"
            app:adapt_calc_base_on="3"
            app:layout_constraintBottom_toBottomOf="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toTopOf="0"
            app:shapeAppearance="@style/arg_res_0x7f11011f"/>
        <cn.cardoor.variety.base.ui.adapt.AutoImageView
            android:id="@+id/iv_user_vip_icon"
            android:visibility="invisible"
            android:layout_width="50px"
            android:layout_height="26px"
            android:scaleType="fitXY"
            app:adapt_calc_base_on="3"
            app:bl_corners_radius="25dp"
            app:layout_constraintEnd_toEndOf="@+id/iv_user_avatar"
            app:layout_constraintRight_toRightOf="@+id/iv_user_avatar"
            app:layout_constraintTop_toTopOf="@+id/iv_user_avatar"/>
        <cn.cardoor.variety.base.ui.adapt.AutoImageView
            android:id="@+id/iv_user_close"
            android:visibility="visible"
            android:layout_width="40px"
            android:layout_height="40px"
            android:layout_marginRight="40px"
            android:src="@mipmap/arg_res_0x7f0e002d"
            android:onClick="onClick"
            android:layout_marginEnd="40px"
            app:adapt_calc_base_on="3"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintTop_toTopOf="@+id/iv_user_avatar"/>
        <cn.cardoor.variety.base.ui.adapt.AutoImageView
            android:id="@+id/iv_user_login_out"
            android:visibility="invisible"
            android:layout_width="40px"
            android:layout_height="40px"
            android:layout_marginRight="40px"
            android:src="@mipmap/arg_res_0x7f0e0030"
            android:onClick="onClick"
            android:layout_marginEnd="40px"
            app:adapt_calc_base_on="3"
            app:layout_constraintEnd_toStartOf="@+id/iv_user_close"
            app:layout_constraintRight_toLeftOf="@+id/iv_user_close"
            app:layout_constraintTop_toTopOf="@+id/iv_user_avatar"/>
        <cn.cardoor.variety.base.ui.adapt.AutoButton
            android:textSize="24px"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/btn_user_renew"
            android:visibility="invisible"
            android:layout_width="142px"
            android:layout_height="40px"
            android:layout_marginRight="40px"
            android:text="@string/arg_res_0x7f100302"
            android:layout_marginEnd="40px"
            app:adapt_calc_base_on="3"
            app:bl_corners_radius="25dp"
            app:bl_solid_color="#ffc066"
            app:layout_constraintEnd_toStartOf="@+id/iv_user_login_out"
            app:layout_constraintRight_toLeftOf="@+id/iv_user_login_out"
            app:layout_constraintTop_toTopOf="@+id/iv_user_avatar"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="30px"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:id="@+id/tv_user_nick_name"
            android:visibility="invisible"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30px"
            android:maxLines="1"
            android:layout_marginStart="30px"
            app:adapt_calc_base_on="3"
            app:layout_constraintEnd_toStartOf="@+id/btn_user_renew"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintLeft_toRightOf="@+id/iv_user_avatar"
            app:layout_constraintRight_toLeftOf="@+id/btn_user_renew"
            app:layout_constraintStart_toEndOf="@+id/iv_user_avatar"
            app:layout_constraintTop_toTopOf="@+id/iv_user_avatar"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="24px"
            android:textColor="@android:color/white"
            android:id="@+id/tv_user_vip_time"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5px"
            android:text="@string/arg_res_0x7f1003f6"
            app:adapt_calc_base_on="3"
            app:fitTypeface="false"
            app:layout_constraintLeft_toLeftOf="@+id/tv_user_nick_name"
            app:layout_constraintStart_toStartOf="@+id/tv_user_nick_name"
            app:layout_constraintTop_toBottomOf="@+id/tv_user_nick_name"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="24px"
            android:textColor="@android:color/white"
            android:id="@+id/tv_travel"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20px"
            android:text="@string/arg_res_0x7f1003b6"
            app:adapt_calc_base_on="3"
            app:layout_constraintLeft_toLeftOf="@+id/tv_user_nick_name"
            app:layout_constraintStart_toStartOf="@+id/tv_user_nick_name"
            app:layout_constraintTop_toBottomOf="@+id/tv_user_vip_time"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="24px"
            android:textColor="@android:color/white"
            android:id="@+id/tv_travel_value"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10px"
            app:adapt_calc_base_on="3"
            app:layout_constraintEnd_toEndOf="@+id/tv_travel"
            app:layout_constraintLeft_toLeftOf="@+id/tv_user_nick_name"
            app:layout_constraintRight_toRightOf="@+id/tv_travel"
            app:layout_constraintStart_toStartOf="@+id/tv_user_nick_name"
            app:layout_constraintTop_toBottomOf="@+id/tv_travel"/>
        <View
            android:id="@+id/view_user_gradient"
            android:background="@drawable/arg_res_0x7f080257"
            android:visibility="invisible"
            android:layout_width="1px"
            android:layout_height="0px"
            android:layout_marginLeft="30px"
            android:layout_marginStart="30px"
            app:adapt_calc_base_on="3"
            app:layout_constraintBottom_toBottomOf="@+id/tv_travel_value"
            app:layout_constraintLeft_toRightOf="@+id/tv_travel"
            app:layout_constraintStart_toEndOf="@+id/tv_travel"
            app:layout_constraintTop_toTopOf="@+id/tv_travel"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="24px"
            android:textColor="@android:color/white"
            android:id="@+id/theme_count"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30px"
            android:text="@string/arg_res_0x7f100370"
            android:layout_marginStart="30px"
            app:adapt_calc_base_on="3"
            app:layout_constraintLeft_toRightOf="@+id/view_user_gradient"
            app:layout_constraintStart_toEndOf="@+id/view_user_gradient"
            app:layout_constraintTop_toTopOf="@+id/tv_travel"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="24px"
            android:textColor="@android:color/white"
            android:id="@+id/tv_theme_count_value"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10px"
            app:adapt_calc_base_on="3"
            app:layout_constraintEnd_toEndOf="@+id/theme_count"
            app:layout_constraintLeft_toLeftOf="@+id/theme_count"
            app:layout_constraintRight_toRightOf="@+id/theme_count"
            app:layout_constraintStart_toStartOf="@+id/theme_count"
            app:layout_constraintTop_toBottomOf="@+id/theme_count"/>
        <View
            android:id="@+id/view_count_gradient"
            android:background="@drawable/arg_res_0x7f080257"
            android:visibility="invisible"
            android:layout_width="1px"
            android:layout_height="0px"
            android:layout_marginLeft="30px"
            android:layout_marginStart="30px"
            app:adapt_calc_base_on="3"
            app:layout_constraintBottom_toBottomOf="@+id/tv_theme_count_value"
            app:layout_constraintLeft_toRightOf="@+id/theme_count"
            app:layout_constraintStart_toEndOf="@+id/theme_count"
            app:layout_constraintTop_toTopOf="@+id/theme_count"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="24px"
            android:textColor="@android:color/white"
            android:id="@+id/tv_theme_favorite"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30px"
            android:text="@string/arg_res_0x7f1003ab"
            android:layout_marginStart="30px"
            app:adapt_calc_base_on="3"
            app:layout_constraintLeft_toRightOf="@+id/view_count_gradient"
            app:layout_constraintStart_toEndOf="@+id/view_count_gradient"
            app:layout_constraintTop_toTopOf="@+id/theme_count"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="24px"
            android:textColor="@android:color/white"
            android:id="@+id/tv_theme_favorite_value"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10px"
            app:adapt_calc_base_on="3"
            app:layout_constraintEnd_toEndOf="@+id/tv_theme_favorite"
            app:layout_constraintLeft_toLeftOf="@+id/tv_theme_favorite"
            app:layout_constraintRight_toRightOf="@+id/tv_theme_favorite"
            app:layout_constraintStart_toStartOf="@+id/tv_theme_favorite"
            app:layout_constraintTop_toBottomOf="@+id/tv_theme_favorite"/>
        <androidx.constraintlayout.helper.widget.Layer
            android:id="@+id/group_theme_favorite"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tv_theme_favorite,tv_theme_favorite_value"/>
    </cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
</FrameLayout>
