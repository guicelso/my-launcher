<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ypx.imagepicker.widget.ShowTypeImageView
        android:id="@+id/mImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"/>
    <View
        android:id="@+id/v_masker"
        android:background="#80000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/mCheckBoxPanel"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_alignParentEnd="true">
        <CheckBox
            android:layout_gravity="end"
            android:id="@+id/mCheckBox"
            android:visibility="visible"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="5dp"
            android:button="@null"
            android:maxWidth="20dp"
            android:maxHeight="20dp"
            android:layout_marginEnd="10dp"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/mVideoLayout"
        android:background="@mipmap/arg_res_0x7f0e004f"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_alignParentBottom="true">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@mipmap/arg_res_0x7f0e004e"
            android:scaleType="centerInside"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:id="@+id/mVideoTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"/>
    </LinearLayout>
</RelativeLayout>
