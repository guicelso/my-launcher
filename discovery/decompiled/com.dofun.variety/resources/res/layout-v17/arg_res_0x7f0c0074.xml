<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_back"
        android:layout_width="44px"
        android:layout_height="44px"
        android:layout_marginLeft="30px"
        android:layout_marginTop="30px"
        android:src="@mipmap/arg_res_0x7f0e0069"
        android:layout_marginStart="30px"
        app:adapt_calc_base_on="3"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="30px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/arg_res_0x7f1003f9"
        android:layout_centerHorizontal="true"
        app:adapt_calc_base_on="3"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="@+id/iv_back"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="26px"
        android:textColor="@android:color/white"
        android:gravity="center_vertical"
        android:id="@+id/tv_exchange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="30px"
        android:text="@string/arg_res_0x7f100148"
        android:drawableLeft="@drawable/arg_res_0x7f0801c3"
        android:drawablePadding="12px"
        android:drawableStart="@drawable/arg_res_0x7f0801c3"
        android:layout_marginEnd="30px"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintTop_toTopOf="@+id/tv_title"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="28px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_vip_recharge_tips"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20px"
        android:layout_marginTop="34px"
        android:layout_marginRight="20px"
        android:text="@string/arg_res_0x7f1003f8"
        android:layout_marginStart="20px"
        android:layout_marginEnd="20px"
        app:adapt_calc_base_on="3"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <cn.cardoor.variety.base.ui.adapt.AutoRecyclerView
        android:id="@+id/rv_vip_combo"
        android:fadingEdge="vertical"
        android:fadingEdgeLength="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30px"
        android:requiresFadingEdge="vertical"
        app:adapt_calc_base_on="3"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_vip_service"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_vip_recharge_tips"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_chainStyle="2"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="@color/arg_res_0x7f060035"
        android:id="@+id/tv_vip_service"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24px"
        app:layout_constraintBottom_toTopOf="@+id/btn_recharge"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/rv_vip_combo"/>
    <cn.cardoor.variety.base.ui.adapt.AutoButton
        android:id="@+id/btn_recharge"
        android:layout_marginTop="24px"
        android:layout_marginBottom="30px"
        android:text="@string/arg_res_0x7f1002f7"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_vip_service"
        style="@style/arg_res_0x7f110120"/>
</androidx.constraintlayout.widget.ConstraintLayout>
