<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_desktop_window_app_setting"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="28px"
        android:textColor="#00a2f9"
        android:gravity="center"
        android:id="@+id/tv_setting_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/tv_setting_subtitle"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"
        app:layout_constraintVertical_chainStyle="2"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:gravity="center"
        android:id="@+id/tv_setting_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20px"
        android:layout_marginTop="20px"
        android:layout_marginRight="20px"
        android:layout_marginBottom="40px"
        android:layout_marginStart="10px"
        android:layout_marginEnd="20px"
        app:layout_constraintBottom_toTopOf="@+id/tv_modify_desktop_window"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_setting_title"
        style="@style/arg_res_0x7f110124"/>
    <me.grantland.widget.AutofitTextView
        android:textSize="20dp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_modify_desktop_window"
        android:background="@drawable/arg_res_0x7f080145"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginRight="8dp"
        android:minWidth="180dp"
        android:minHeight="50dp"
        android:text="@string/arg_res_0x7f10010b"
        android:singleLine="true"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toStartOf="@+id/btn_go_setting"
        app:layout_constraintHorizontal_chainStyle="2"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_setting_subtitle"
        app:minTextSize="14dp"/>
    <me.grantland.widget.AutofitTextView
        android:textSize="20dp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/btn_go_setting"
        android:background="@drawable/arg_res_0x7f080145"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:minWidth="180dp"
        android:minHeight="50dp"
        android:text="@string/arg_res_0x7f10011b"
        android:singleLine="true"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_marginStart="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toEndOf="@+id/tv_modify_desktop_window"
        app:layout_constraintTop_toTopOf="@+id/tv_modify_desktop_window"
        app:minTextSize="14dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
