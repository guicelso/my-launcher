<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#0affffff"
    android:paddingLeft="15px"
    android:paddingTop="25px"
    android:paddingRight="15px"
    android:paddingBottom="25px"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:adapt_calc_base_on="3"
    app:layout_constraintEnd_toEndOf="0"
    app:layout_constraintRight_toRightOf="0">
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_linkage_instructions_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/arg_res_0x7f1000ab"
        app:adapt_calc_base_on="3"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <com.dofun.overseasvariety.view.TransparentWebView
        android:id="@+id/web_linkage_instructions"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="50px"
        android:layout_marginBottom="50px"
        android:layerType="software"
        app:layout_constraintBottom_toTopOf="@+id/tv_linkage_instructions_phantom"
        app:layout_constraintTop_toBottomOf="@+id/tv_linkage_instructions_title"/>
    <cn.cardoor.variety.base.ui.adapt.AutoProgressBar
        android:id="@+id/pb"
        android:visibility="gone"
        android:layout_width="80px"
        android:layout_height="80px"
        android:layout_centerInParent="true"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toBottomOf="@+id/web_linkage_instructions"
        app:layout_constraintEnd_toEndOf="@+id/web_linkage_instructions"
        app:layout_constraintLeft_toLeftOf="@+id/web_linkage_instructions"
        app:layout_constraintRight_toRightOf="@+id/web_linkage_instructions"
        app:layout_constraintStart_toStartOf="@+id/web_linkage_instructions"
        app:layout_constraintTop_toTopOf="@+id/web_linkage_instructions"
        style="@android:style/Widget.Holo.Light.ProgressBar.Large"/>
    <FrameLayout
        android:id="@+id/fl_error"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/web_linkage_instructions"
        app:layout_constraintEnd_toEndOf="@+id/web_linkage_instructions"
        app:layout_constraintLeft_toLeftOf="@+id/web_linkage_instructions"
        app:layout_constraintRight_toRightOf="@+id/web_linkage_instructions"
        app:layout_constraintStart_toStartOf="@+id/web_linkage_instructions"
        app:layout_constraintTop_toTopOf="@+id/web_linkage_instructions">
        <cn.cardoor.variety.base.ui.adapt.AutoImageView
            android:layout_gravity="center"
            android:layout_width="60px"
            android:layout_height="60px"
            android:src="@mipmap/arg_res_0x7f0e0056"
            app:adapt_calc_base_on="3"/>
    </FrameLayout>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="16px"
        android:textColor="@android:color/white"
        android:gravity="center_vertical"
        android:id="@+id/tv_linkage_instructions_phantom"
        android:padding="12px"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60px"
        android:drawablePadding="20px"
        android:layoutDirection="ltr"
        app:adapt_calc_base_on="3"
        app:bl_corners_radius="18px"
        app:bl_solid_color="#0affffff"
        app:layout_constraintBottom_toBottomOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:layout_width="28px"
        android:layout_height="28px"
        android:layout_marginRight="12px"
        android:src="@mipmap/arg_res_0x7f0e0069"
        android:rotation="180"
        android:layoutDirection="ltr"
        android:layout_marginEnd="12px"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toBottomOf="@+id/tv_linkage_instructions_phantom"
        app:layout_constraintEnd_toEndOf="@+id/tv_linkage_instructions_phantom"
        app:layout_constraintRight_toRightOf="@+id/tv_linkage_instructions_phantom"
        app:layout_constraintTop_toTopOf="@+id/tv_linkage_instructions_phantom"/>
</cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
