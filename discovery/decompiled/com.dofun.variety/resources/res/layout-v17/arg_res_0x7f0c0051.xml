<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fl_state_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:bl_corners_radius="20dp"
    app:bl_solid_color="@android:color/white">
    <cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout
        android:layout_gravity="center"
        android:layout_width="900px"
        android:layout_height="460px">
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="22px"
            android:textColor="@android:color/black"
            android:gravity="center_vertical"
            android:id="@+id/search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="50px"
            android:text="@string/arg_res_0x7f1000bc"
            android:drawableRight="@mipmap/arg_res_0x7f0e001f"
            android:drawablePadding="22px"
            android:drawableEnd="@mipmap/arg_res_0x7f0e001f"
            android:layout_marginStart="50px"
            app:adapt_calc_base_on="3"
            app:endDrawableHeight="28px"
            app:endDrawableWidth="28px"
            app:is_square="true"
            app:layout_constraintBottom_toBottomOf="@+id/rg_category_tab"
            app:layout_constraintLeft_toLeftOf="@+id/view_pager"
            app:layout_constraintStart_toStartOf="@+id/view_pager"
            app:layout_constraintTop_toTopOf="@+id/rg_category_tab"/>
        <com.dofun.variety.ui.BottomIndicatorRadioGroup
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/rg_category_tab"
            android:paddingTop="5px"
            android:paddingBottom="5px"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10px"
            app:adapt_calc_base_on="3"
            app:layout_constraintBottom_toBottomOf="@+id/tv_online_theme"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toTopOf="0">
            <cn.cardoor.variety.base.ui.adapt.AutoRadioButton
                android:textSize="25px"
                android:textColor="@android:color/black"
                android:gravity="center"
                android:id="@+id/rb_tab_level1"
                android:paddingLeft="10px"
                android:paddingRight="10px"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:button="@null"
                android:maxWidth="250px"
                android:minWidth="120px"
                android:text="@string/arg_res_0x7f1000bd"
                android:paddingStart="10px"
                android:paddingEnd="10px"
                app:adapt_calc_base_on="3"/>
            <cn.cardoor.variety.base.ui.adapt.AutoRadioButton
                android:textSize="25px"
                android:textColor="@android:color/black"
                android:gravity="center"
                android:id="@+id/rb_tab_feature"
                android:paddingLeft="10px"
                android:paddingRight="10px"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:button="@null"
                android:maxWidth="250px"
                android:minWidth="120px"
                android:text="@string/arg_res_0x7f100169"
                android:paddingStart="10px"
                android:paddingEnd="10px"
                app:adapt_calc_base_on="3"/>
        </com.dofun.variety.ui.BottomIndicatorRadioGroup>
        <cn.cardoor.variety.base.ui.adapt.AutoImageView
            android:id="@+id/close"
            android:background="@mipmap/arg_res_0x7f0e0009"
            android:layout_width="30px"
            android:layout_height="30px"
            android:layout_margin="16px"
            app:adapt_calc_base_on="3"
            app:is_square="true"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintTop_toTopOf="0"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="3"
            app:constraint_referenced_ids="search,rg_category_tab,close"/>
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:adapt_calc_base_on="3"
            app:layout_constraintBottom_toBottomOf="0"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toBottomOf="@+id/barrier_title"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="24px"
            android:textColor="@android:color/white"
            android:id="@+id/tv_select_tips"
            android:paddingLeft="28px"
            android:paddingTop="12px"
            android:paddingRight="28px"
            android:paddingBottom="12px"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/arg_res_0x7f1000c6"
            android:drawablePadding="6px"
            android:paddingStart="28px"
            android:paddingEnd="28px"
            app:bl_corners_radius="28dp"
            app:bl_solid_color="#b3000000"
            app:layout_constraintBottom_toBottomOf="0"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toTopOf="0"/>
    </cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
</FrameLayout>
