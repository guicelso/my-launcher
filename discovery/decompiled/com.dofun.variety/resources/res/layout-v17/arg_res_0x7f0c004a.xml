<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/content"
        android:layout_width="740px"
        android:layout_height="wrap_content"
        app:adapt_calc_base_on="5"
        app:bl_corners_radius="20dp"
        app:bl_solid_color="#f20f1828">
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="24px"
            android:textColor="@android:color/white"
            android:id="@+id/tv_select_app_title"
            android:layout_width="260px"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30px"
            android:layout_marginTop="30px"
            android:text="@string/arg_res_0x7f1000c5"
            android:layout_marginStart="34px"
            app:adapt_calc_base_on="5"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toTopOf="0"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="24px"
            android:textColor="@android:color/white"
            android:gravity="center_vertical"
            android:id="@+id/delete_association"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30px"
            android:maxWidth="160px"
            android:text="@string/arg_res_0x7f100105"
            android:drawableLeft="@drawable/arg_res_0x7f08015d"
            android:drawablePadding="4px"
            android:drawableStart="@drawable/arg_res_0x7f08015d"
            android:layout_marginStart="30px"
            android:layout_marginEnd="30px"
            app:adapt_calc_base_on="5"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintTop_toTopOf="0"
            app:startDrawableHeight="40px"
            app:startDrawableWidth="40px"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="24px"
            android:textColor="@android:color/white"
            android:gravity="center_vertical"
            android:id="@+id/modify_app_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="160px"
            android:text="@string/arg_res_0x7f10020f"
            android:drawableLeft="@drawable/arg_res_0x7f0801da"
            android:drawablePadding="4px"
            android:drawableStart="@drawable/arg_res_0x7f0801da"
            android:layout_marginStart="30px"
            android:layout_marginEnd="30px"
            app:adapt_calc_base_on="5"
            app:layout_constraintEnd_toStartOf="@+id/delete_association"
            app:layout_constraintRight_toLeftOf="@+id/delete_association"
            app:layout_constraintTop_toTopOf="@+id/delete_association"
            app:startDrawableHeight="40px"
            app:startDrawableWidth="40px"/>
        <cn.cardoor.variety.base.ui.EdgeEffectView
            android:id="@+id/app_list_layout"
            android:padding="20px"
            android:layout_width="0px"
            android:layout_height="400px"
            android:layout_marginTop="30px"
            app:adapt_calc_base_on="5"
            app:edge_position="0x5"
            app:layout_constraintBottom_toBottomOf="0"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toBottomOf="@+id/delete_association">
            <com.dofun.variety.theme.ui.IndicatorViewPager
                android:id="@+id/vp_app_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </cn.cardoor.variety.base.ui.EdgeEffectView>
    </cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
    <include
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        layout="@layout/arg_res_0x7f0c00cf"/>
</FrameLayout>
