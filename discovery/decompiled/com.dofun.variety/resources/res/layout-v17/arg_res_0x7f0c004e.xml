<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:paddingLeft="40px"
    android:paddingRight="40px"
    android:layout_width="900px"
    android:layout_height="460px"
    android:paddingStart="40px"
    android:paddingEnd="40px"
    app:bl_corners_radius="20dp"
    app:bl_solid_color="@android:color/white">
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="#4a4a4a"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15px"
        android:text="@string/arg_res_0x7f100315"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoCheckBox
        android:textSize="24px"
        android:textColor="#4a4a4a"
        android:gravity="center_vertical"
        android:id="@+id/cb_select_all"
        android:paddingLeft="30px"
        android:focusable="true"
        android:visibility="invisible"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:button="@null"
        android:text="@string/arg_res_0x7f100066"
        android:drawablePadding="14px"
        android:paddingStart="30px"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="@+id/tv_title"/>
    <cn.cardoor.variety.base.ui.EdgeEffectView
        android:id="@+id/fl_state_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:edge_position="0xa"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_title">
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/cl_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/app_bar"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="120px"
                app:elevation="0dp">
                <cn.cardoor.variety.base.ui.adapt.AutoRecyclerView
                    android:scrollbarSize="4dp"
                    android:scrollbarThumbHorizontal="@drawable/arg_res_0x7f08024c"
                    android:scrollbarStyle="outsideInset"
                    android:id="@+id/rv_indices_data"
                    android:scrollbars="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_scrollFlags="0x7"/>
            </com.google.android.material.appbar.AppBarLayout>
            <cn.cardoor.variety.base.ui.adapt.AutoRecyclerView
                android:scrollbarSize="4dp"
                android:scrollbarThumbVertical="@drawable/arg_res_0x7f08024c"
                android:scrollbarStyle="insideOverlay"
                android:id="@+id/rv_categories_data"
                android:paddingLeft="30px"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="30px"
                app:layout_behavior="@string/arg_res_0x7f10008e"/>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </cn.cardoor.variety.base.ui.EdgeEffectView>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/close"
        android:background="@mipmap/arg_res_0x7f0e0009"
        android:layout_width="30px"
        android:layout_height="30px"
        android:layout_marginTop="16px"
        app:adapt_calc_base_on="3"
        app:is_square="true"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="#aeafb9"
        android:id="@+id/tv_use_local_images"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15px"
        android:text="@string/arg_res_0x7f1003ea"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"/>
</cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
