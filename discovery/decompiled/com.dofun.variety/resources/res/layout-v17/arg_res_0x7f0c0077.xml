<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#151e36"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_back"
        android:layout_width="44px"
        android:layout_height="44px"
        android:layout_marginLeft="30px"
        android:layout_marginTop="30px"
        android:src="@mipmap/arg_res_0x7f0e0069"
        android:onClick="onClick"
        android:layout_marginStart="30px"
        app:adapt_calc_base_on="3"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_exchange"
        android:layout_width="44px"
        android:layout_height="44px"
        android:layout_marginRight="30px"
        android:src="@drawable/arg_res_0x7f080171"
        android:onClick="onClick"
        android:layout_marginEnd="30px"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toBottomOf="@+id/iv_back"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintTop_toTopOf="@+id/iv_back"/>
    <com.dofun.overseasvariety.view.TabLayout
        android:gravity="top"
        android:id="@+id/tab_layout"
        android:paddingBottom="6px"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:adapt_calc_base_on="3"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="@+id/iv_back"
        app:tabIndicatorColor="#ffc066"
        app:tabIndicatorHeight="4px"
        app:tabIndicatorStyle="1"
        app:tabItemMarginLeft="30px"
        app:tabItemMarginRight="30px"
        app:tabTitleTextColor="@android:color/white"
        app:tabTitleTextSize="30px"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="3"
        app:constraint_referenced_ids="iv_back,tab_layout,iv_exchange"/>
    <com.dofun.overseasvariety.view.ScrollViewPager
        android:id="@+id/view_pager"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toTopOf="@+id/barrier_bottom"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/barrier_title"/>
    <cn.cardoor.variety.base.ui.adapt.AutoButton
        android:textSize="30px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/btn_open"
        android:paddingLeft="15px"
        android:paddingRight="15px"
        android:layout_width="wrap_content"
        android:layout_height="60px"
        android:layout_marginBottom="15px"
        android:minWidth="300px"
        android:text="@string/arg_res_0x7f1002f8"
        android:maxLines="1"
        android:onClick="onClick"
        app:adapt_calc_base_on="3"
        app:bl_corners_radius="71dp"
        app:bl_solid_color="#ffc066"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_agreement"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/arg_res_0x7f1003fa"
        android:onClick="onClick"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toBottomOf="@+id/btn_open"
        app:layout_constraintEnd_toStartOf="@+id/btn_open"
        app:layout_constraintHorizontal_bias="0.4"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toLeftOf="@+id/btn_open"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="@+id/btn_open"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="2"
        app:constraint_referenced_ids="btn_open,tv_agreement"/>
</androidx.constraintlayout.widget.ConstraintLayout>
