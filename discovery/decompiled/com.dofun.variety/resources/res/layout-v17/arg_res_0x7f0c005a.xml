<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/cl_login_benefit_reward_panel"
        android:paddingLeft="28px"
        android:paddingTop="22px"
        android:paddingRight="28px"
        android:paddingBottom="32px"
        android:layout_width="726px"
        android:layout_height="468px"
        android:paddingStart="28px"
        android:paddingEnd="28px"
        app:adapt_calc_base_on="3"
        app:bl_corners_radius="8px"
        app:bl_solid_color="@android:color/white">
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="34px"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/tv_task_achieved_icon"
            android:layout_width="42px"
            android:layout_height="42px"
            android:text="✓"
            android:includeFontPadding="false"
            app:adapt_calc_base_on="3"
            app:bl_corners_radius="21px"
            app:bl_solid_color="#6bd137"
            app:fitTypeface="false"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toTopOf="0"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="34px"
            android:textColor="#69d233"
            android:gravity="center_vertical"
            android:id="@+id/tv_task_achieved"
            android:layout_width="wrap_content"
            android:layout_height="42px"
            android:layout_marginLeft="16px"
            android:text="@string/arg_res_0x7f1001d8"
            android:includeFontPadding="false"
            android:layout_marginStart="16px"
            app:adapt_calc_base_on="3"
            app:fitTypeface="false"
            app:layout_constraintBottom_toBottomOf="@+id/tv_task_achieved_icon"
            app:layout_constraintLeft_toRightOf="@+id/tv_task_achieved_icon"
            app:layout_constraintStart_toEndOf="@+id/tv_task_achieved_icon"
            app:layout_constraintTop_toTopOf="@+id/tv_task_achieved_icon"/>
        <cn.cardoor.variety.base.ui.adapt.AutoImageView
            android:id="@+id/iv_reward_close"
            android:layout_width="44px"
            android:layout_height="44px"
            android:src="@drawable/arg_res_0x7f080158"
            android:scaleType="centerInside"
            app:adapt_calc_base_on="3"
            app:is_square="true"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintTop_toTopOf="0"/>
        <cn.cardoor.variety.base.ui.adapt.AutoImageView
            android:id="@+id/iv_reward_preview"
            android:layout_width="256px"
            android:layout_height="150px"
            android:layout_marginTop="28px"
            android:scaleType="fitCenter"
            app:adapt_calc_base_on="3"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toBottomOf="@+id/tv_task_achieved_icon"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="32px"
            android:textColor="#444444"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_reward_title"
            android:layout_width="0dp"
            android:layout_height="42px"
            android:layout_marginTop="14px"
            android:maxLines="1"
            android:includeFontPadding="false"
            app:adapt_calc_base_on="3"
            app:fitTypeface="false"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toBottomOf="@+id/iv_reward_preview"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="22px"
            android:textColor="#7a7a7a"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_reward_subtitle"
            android:layout_width="0dp"
            android:layout_height="28px"
            android:layout_marginTop="4px"
            android:maxLines="1"
            android:includeFontPadding="false"
            app:adapt_calc_base_on="3"
            app:fitTypeface="false"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toBottomOf="@+id/tv_reward_title"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="28px"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/btn_reward_action"
            android:paddingLeft="30px"
            android:paddingTop="10px"
            android:paddingRight="30px"
            android:paddingBottom="10px"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24px"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:paddingStart="30px"
            android:paddingEnd="30px"
            app:adapt_calc_base_on="3"
            app:bl_corners_radius="32px"
            app:bl_solid_color="#08a8f8"
            app:fitTypeface="false"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toBottomOf="@+id/tv_reward_subtitle"/>
    </cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
</FrameLayout>
