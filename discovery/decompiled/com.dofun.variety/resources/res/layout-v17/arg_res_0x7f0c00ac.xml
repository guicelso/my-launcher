<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="22px"
        android:textColor="#4a4a4a"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26px"
        android:text="@string/arg_res_0x7f100084"
        app:adapt_calc_base_on="3"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="26px"
        android:textColor="#202020"
        android:gravity="center"
        android:id="@+id/btnClose"
        android:layout_width="36px"
        android:layout_height="36px"
        android:layout_marginTop="26px"
        android:text="X"
        android:layout_marginEnd="40px"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="16px"
        android:textColor="#5b5b5b"
        android:gravity="center_vertical"
        android:id="@+id/tvWifiName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="18px"
        android:layout_marginRight="10px"
        android:drawableLeft="@drawable/arg_res_0x7f08028c"
        android:drawablePadding="6px"
        android:drawableStart="@drawable/arg_res_0x7f08028c"
        android:textDirection="locale"
        android:layout_marginStart="18px"
        android:layout_marginEnd="10px"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
        app:layout_constraintEnd_toStartOf="@+id/tvTitle"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toLeftOf="@+id/tvTitle"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="@+id/tvTitle"
        app:startDrawableHeight="22px"
        app:startDrawableWidth="32px"/>
    <View
        android:id="@+id/viewWifiCircle"
        android:background="@drawable/arg_res_0x7f080174"
        android:layout_width="100px"
        android:layout_height="100px"
        android:layout_marginTop="16px"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="18px"
        android:textColor="#555555"
        android:id="@+id/tvWifiTip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14px"
        android:text="@string/arg_res_0x7f100085"
        app:adapt_calc_base_on="3"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/viewWifiCircle"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/ivNoNetworkIcon"
        android:background="@drawable/arg_res_0x7f08028b"
        android:layout_width="128px"
        android:layout_height="128px"
        android:layout_marginTop="18px"
        app:adapt_calc_base_on="3"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="18px"
        android:textColor="#4f4f4f"
        android:id="@+id/tvNoNetworkTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14px"
        android:text="@string/arg_res_0x7f100077"
        app:adapt_calc_base_on="3"
        app:layout_constraintEnd_toStartOf="@+id/tvNoNetworkAction"
        app:layout_constraintHorizontal_chainStyle="2"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/ivNoNetworkIcon"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="18px"
        android:textColor="#1297ff"
        android:id="@+id/tvNoNetworkAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/arg_res_0x7f100076"
        android:layout_marginStart="10px"
        app:adapt_calc_base_on="3"
        app:layout_constraintBaseline_toBaselineOf="@+id/tvNoNetworkTitle"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toEndOf="@+id/tvNoNetworkTitle"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/ivQrPlaceholder"
        android:layout_width="172px"
        android:layout_height="172px"
        android:layout_marginTop="28px"
        android:layout_marginStart="40px"
        app:adapt_calc_base_on="3"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="18px"
        android:textColor="#555555"
        android:id="@+id/tvScanJoinNetwork"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:text="@string/arg_res_0x7f100086"
        android:layout_marginStart="42px"
        android:layout_marginEnd="40px"
        app:adapt_calc_base_on="3"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toEndOf="@+id/ivQrPlaceholder"
        app:layout_constraintTop_toTopOf="@+id/ivQrPlaceholder"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="16px"
        android:textColor="#666666"
        android:id="@+id/tvHotspotName"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:layout_marginTop="26px"
        app:adapt_calc_base_on="3"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="@+id/tvScanJoinNetwork"
        app:layout_constraintTop_toBottomOf="@+id/tvScanJoinNetwork"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="16px"
        android:textColor="#666666"
        android:id="@+id/tvHotspotPwd"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:layout_marginTop="8px"
        app:adapt_calc_base_on="3"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="@+id/tvHotspotName"
        app:layout_constraintTop_toBottomOf="@+id/tvHotspotName"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierNetworkHeaderBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="3"
        app:constraint_referenced_ids="tvWifiTip,tvNoNetworkTitle,ivQrPlaceholder,tvHotspotPwd"/>
    <cn.cardoor.variety.base.ui.adapt.AutoScrollView
        android:id="@+id/scrollInstructions"
        android:layout_width="0px"
        android:layout_height="0px"
        android:layout_marginLeft="30px"
        android:layout_marginTop="8px"
        android:layout_marginBottom="12px"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:layout_marginStart="30px"
        android:layout_marginEnd="30px"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toStartOf="@+id/startBarrierBottomButtons"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/barrierNetworkHeaderBottom">
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="15px"
            android:textColor="#686868"
            android:gravity="start"
            android:id="@+id/tvInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="6px"
            android:textDirection="locale"
            app:adapt_calc_base_on="3"/>
    </cn.cardoor.variety.base.ui.adapt.AutoScrollView>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="16px"
        android:textColor="#202020"
        android:id="@+id/btnHotspotMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="26px"
        android:text="@string/arg_res_0x7f100087"
        android:layout_marginEnd="26px"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="16px"
        android:textColor="#202020"
        android:id="@+id/btnWifiMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="26px"
        android:text="@string/arg_res_0x7f100088"
        android:layout_marginEnd="26px"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/startBarrierBottomButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="5"
        app:constraint_referenced_ids="btnHotspotMode,btnWifiMode"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/viewWarnCircle"
        android:background="@drawable/arg_res_0x7f08028a"
        android:layout_width="128px"
        android:layout_height="128px"
        android:layout_marginTop="38px"
        app:adapt_calc_base_on="3"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="18px"
        android:textColor="#4f4f4f"
        android:id="@+id/tvNoticeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18px"
        android:text="@string/arg_res_0x7f10007a"
        app:adapt_calc_base_on="3"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/viewWarnCircle"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="16px"
        android:textColor="#666666"
        android:gravity="start"
        android:id="@+id/tvNoticeDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18px"
        android:lineSpacingExtra="8px"
        app:adapt_calc_base_on="3"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tvNoticeTitle"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="17px"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/btnAcknowledge"
        android:background="@drawable/arg_res_0x7f080220"
        android:layout_width="202px"
        android:layout_height="48px"
        android:layout_marginTop="34px"
        android:text="@string/arg_res_0x7f100072"
        app:adapt_calc_base_on="3"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tvNoticeDesc"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="17px"
        android:textColor="#555555"
        android:id="@+id/tvPermissionIntro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40px"
        android:text="@string/arg_res_0x7f10007d"
        android:layout_marginStart="40px"
        app:adapt_calc_base_on="3"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
    <cn.cardoor.variety.base.ui.adapt.AutoLinearLayout
        android:orientation="vertical"
        android:id="@+id/layoutPermissionConditions"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:layout_marginTop="28px"
        android:layout_marginStart="68px"
        android:layout_marginEnd="68px"
        app:adapt_calc_base_on="3"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tvPermissionIntro"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/viewSuccess"
        android:background="@drawable/arg_res_0x7f08025f"
        android:layout_width="120px"
        android:layout_height="120px"
        android:layout_marginTop="46px"
        app:adapt_calc_base_on="3"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="18px"
        android:textColor="#555555"
        android:id="@+id/tvTransferDoneTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20px"
        app:adapt_calc_base_on="3"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/viewSuccess"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="16px"
        android:textColor="#666666"
        android:id="@+id/tvTransferDoneSize"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10px"
        app:adapt_calc_base_on="3"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tvTransferDoneTitle"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="16px"
        android:textColor="#666666"
        android:id="@+id/tvTransferDonePath"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14px"
        android:text="@string/arg_res_0x7f100083"
        app:adapt_calc_base_on="3"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tvTransferDoneSize"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="17px"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/btnFinish"
        android:background="@drawable/arg_res_0x7f080220"
        android:visibility="gone"
        android:layout_width="202px"
        android:layout_height="48px"
        android:layout_marginTop="34px"
        android:text="@string/arg_res_0x7f100073"
        app:adapt_calc_base_on="3"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tvTransferDonePath"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/layoutInstructionCommon"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="scrollInstructions"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/layoutWifiMode"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tvWifiName,viewWifiCircle,tvWifiTip,btnHotspotMode"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/layoutNoNetwork"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="ivNoNetworkIcon,tvNoNetworkTitle,tvNoNetworkAction,btnHotspotMode"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/layoutHotspotMode"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="ivQrPlaceholder,tvScanJoinNetwork,tvHotspotName,tvHotspotPwd,btnWifiMode"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/layoutHotspotTips"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="viewWarnCircle,tvNoticeTitle,tvNoticeDesc,btnAcknowledge,btnWifiMode"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/layoutPermission"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tvPermissionIntro,layoutPermissionConditions"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/layoutTransferDone"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="viewSuccess,tvTransferDoneTitle,tvTransferDoneSize,tvTransferDonePath"/>
</merge>
