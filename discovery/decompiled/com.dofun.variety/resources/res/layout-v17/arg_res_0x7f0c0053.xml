<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:paddingLeft="20px"
    android:paddingRight="20px"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginLeft="40px"
    android:layout_marginRight="40px"
    android:minWidth="680px"
    android:minHeight="440px"
    android:paddingStart="20px"
    android:paddingEnd="20px"
    android:layout_marginStart="40px"
    android:layout_marginEnd="40px"
    app:adapt_calc_base_on="3"
    app:bl_corners_radius="10dp"
    app:bl_solid_color="@android:color/white">
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="28px"
        android:textColor="@android:color/black"
        android:gravity="start"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="14px"
        android:lineSpacingExtra="2px"
        app:fitTypeface="false"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_tips"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"
        app:layout_constraintVertical_chainStyle="2"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="@android:color/darker_gray"
        android:gravity="start"
        android:id="@+id/tv_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40px"
        android:layout_marginTop="26px"
        android:layout_marginRight="40px"
        android:drawablePadding="14px"
        android:lineSpacingExtra="2px"
        android:layout_marginStart="40px"
        android:layout_marginEnd="40px"
        app:fitTypeface="false"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/btn_ok"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <cn.cardoor.variety.base.ui.adapt.AutoButton
        android:id="@+id/btn_ok"
        android:layout_marginTop="50px"
        android:layout_marginBottom="26px"
        android:text="@string/arg_res_0x7f100287"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_tips"
        style="@style/arg_res_0x7f110120"/>
</cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
