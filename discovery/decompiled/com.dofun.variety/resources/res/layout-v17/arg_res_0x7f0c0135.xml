<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.dofun.bases.upgrade.impl.universal.banner.RoundCornerRelativeLayout
        android:layout_gravity="center"
        android:id="@+id/rl_text_desc"
        android:background="@android:color/white"
        android:layout_width="@dimen/arg_res_0x7f070330"
        android:layout_height="@dimen/arg_res_0x7f07032f">
        <ImageView
            android:id="@+id/imageView_close"
            android:padding="@dimen/arg_res_0x7f070324"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/arg_res_0x7f08026b"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"/>
        <ImageView
            android:id="@+id/imageView_update_icon"
            android:layout_width="@dimen/arg_res_0x7f070321"
            android:layout_height="@dimen/arg_res_0x7f070321"
            android:layout_marginLeft="@dimen/arg_res_0x7f07032a"
            android:layout_marginTop="@dimen/arg_res_0x7f07031a"
            android:layout_marginStart="@dimen/arg_res_0x7f07032a"/>
        <TextView
            android:textSize="@dimen/arg_res_0x7f070327"
            android:textColor="#282828"
            android:id="@+id/textView_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/arg_res_0x7f070329"
            android:layout_toRightOf="@+id/imageView_update_icon"
            android:layout_alignTop="@+id/imageView_update_icon"
            android:layout_marginStart="@dimen/arg_res_0x7f070329"
            android:layout_toEndOf="@+id/imageView_update_icon"/>
        <TextView
            android:textSize="@dimen/arg_res_0x7f070324"
            android:textColor="#979797"
            android:id="@+id/textView_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/arg_res_0x7f070320"
            android:layout_toRightOf="@+id/textView_title"
            android:layout_alignBottom="@+id/textView_title"
            android:layout_marginStart="@dimen/arg_res_0x7f070320"
            android:layout_toEndOf="@+id/textView_title"/>
        <TextView
            android:textSize="@dimen/arg_res_0x7f070325"
            android:textColor="#282828"
            android:id="@+id/textView_update_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/arg_res_0x7f070315"
            android:text="@string/arg_res_0x7f1003e6"
            android:layout_below="@+id/textView_title"
            android:layout_alignLeft="@+id/textView_title"
            android:layout_alignStart="@+id/textView_title"/>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/arg_res_0x7f07031c"
            android:layout_marginBottom="@dimen/arg_res_0x7f07031c"
            android:layout_above="@+id/button_update"
            android:layout_below="@+id/textView_update_hint"
            android:layout_alignLeft="@+id/textView_update_hint"
            android:layout_alignStart="@+id/textView_update_hint">
            <TextView
                android:textSize="@dimen/arg_res_0x7f070322"
                android:textColor="#282828"
                android:id="@+id/textView_content"
                android:padding="@dimen/arg_res_0x7f07031c"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/arg_res_0x7f1003df"
                android:lineSpacingExtra="@dimen/arg_res_0x7f07032c"/>
        </ScrollView>
        <Button
            android:textSize="@dimen/arg_res_0x7f070327"
            android:textColor="#ffffff"
            android:id="@+id/button_update"
            android:background="@drawable/arg_res_0x7f080271"
            android:paddingLeft="@dimen/arg_res_0x7f07032a"
            android:paddingTop="@dimen/arg_res_0x7f07031f"
            android:paddingRight="@dimen/arg_res_0x7f07032a"
            android:paddingBottom="@dimen/arg_res_0x7f07031f"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/arg_res_0x7f070324"
            android:layout_marginBottom="@dimen/arg_res_0x7f070316"
            android:text="@string/arg_res_0x7f1003e5"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:onClick="onClick"
            android:layout_marginEnd="@dimen/arg_res_0x7f070324"
            android:layout_alignParentEnd="true"
            style="?android:attr/borderlessButtonStyle"/>
        <TextView
            android:textSize="@dimen/arg_res_0x7f070325"
            android:textColor="@android:color/darker_gray"
            android:id="@+id/text_desc_tv_do_not_detect"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/arg_res_0x7f070315"
            android:layout_toLeftOf="@+id/button_update"
            android:layout_alignBaseline="@+id/button_update"
            android:layout_marginEnd="@dimen/arg_res_0x7f070315"
            android:layout_toStartOf="@+id/button_update"/>
        <ProgressBar
            android:id="@+id/progress"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/arg_res_0x7f070316"
            android:layout_marginRight="@dimen/arg_res_0x7f070328"
            android:progress="0"
            android:progressDrawable="@drawable/arg_res_0x7f08026f"
            android:layout_above="@+id/tv_downloading"
            android:layout_alignLeft="@+id/textView_update_hint"
            android:layout_marginEnd="@dimen/arg_res_0x7f070328"
            android:layout_alignStart="@+id/textView_update_hint"
            style="?android:attr/progressBarStyleHorizontal"/>
        <TextView
            android:textSize="@dimen/arg_res_0x7f070327"
            android:textColor="@android:color/black"
            android:id="@+id/tv_downloading"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/arg_res_0x7f07031c"
            android:layout_marginBottom="@dimen/arg_res_0x7f070315"
            android:text="@string/arg_res_0x7f1003d9"
            android:layout_alignLeft="@+id/textView_title"
            android:layout_alignParentBottom="true"
            android:layout_alignStart="@+id/textView_title"/>
        <TextView
            android:textSize="@dimen/arg_res_0x7f070327"
            android:textColor="#1155b9"
            android:id="@+id/tv_download_percent"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/arg_res_0x7f1003e3"
            android:layout_alignTop="@+id/tv_downloading"
            android:layout_alignRight="@+id/progress"
            android:layout_alignEnd="@+id/progress"/>
        <TextView
            android:textSize="@dimen/arg_res_0x7f070327"
            android:textColor="#1155b9"
            android:id="@+id/tv_download_progress"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/arg_res_0x7f1003e4"
            android:layout_toLeftOf="@+id/tv_download_percent"
            android:layout_alignTop="@+id/tv_downloading"
            android:layout_toStartOf="@+id/tv_download_percent"/>
        <TextView
            android:textSize="@dimen/arg_res_0x7f070327"
            android:textColor="#1155b9"
            android:id="@+id/tv_downloaded"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/arg_res_0x7f07031c"
            android:text="@string/arg_res_0x7f1003d8"
            android:layout_toLeftOf="@+id/tv_download_progress"
            android:layout_below="@+id/progress"
            android:layout_toStartOf="@+id/tv_download_progress"/>
    </com.dofun.bases.upgrade.impl.universal.banner.RoundCornerRelativeLayout>
    <com.dofun.bases.upgrade.impl.universal.banner.RoundCornerRelativeLayout
        android:layout_gravity="center"
        android:id="@+id/rl_image_desc"
        android:background="@android:color/white"
        android:visibility="gone"
        android:layout_width="@dimen/arg_res_0x7f07032e"
        android:layout_height="@dimen/arg_res_0x7f07031b">
        <ImageView
            android:id="@+id/imageView_update_icon_image"
            android:layout_width="@dimen/arg_res_0x7f07031e"
            android:layout_height="@dimen/arg_res_0x7f07031e"
            android:layout_marginLeft="@dimen/arg_res_0x7f070329"
            android:layout_marginTop="@dimen/arg_res_0x7f070315"
            android:layout_marginBottom="@dimen/arg_res_0x7f070316"
            android:layout_alignParentLeft="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/arg_res_0x7f070329"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="@dimen/arg_res_0x7f070329"
            android:textColor="#282828"
            android:ellipsize="end"
            android:id="@+id/textView_title_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/arg_res_0x7f070320"
            android:layout_marginRight="@dimen/arg_res_0x7f070320"
            android:maxLines="1"
            android:layout_toLeftOf="@+id/fl_download"
            android:layout_toRightOf="@+id/imageView_update_icon_image"
            android:layout_alignTop="@+id/imageView_update_icon_image"
            android:layout_marginStart="@dimen/arg_res_0x7f070320"
            android:layout_marginEnd="@dimen/arg_res_0x7f070320"
            android:layout_toStartOf="@+id/fl_download"
            android:layout_toEndOf="@+id/imageView_update_icon_image"/>
        <TextView
            android:textSize="@dimen/arg_res_0x7f070327"
            android:textColor="#282828"
            android:ellipsize="end"
            android:id="@+id/textView_update_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/arg_res_0x7f070320"
            android:layout_marginRight="@dimen/arg_res_0x7f070320"
            android:maxLines="1"
            android:layout_toLeftOf="@+id/fl_download"
            android:layout_toRightOf="@+id/imageView_update_icon_image"
            android:layout_alignBottom="@+id/imageView_update_icon_image"
            android:layout_marginStart="@dimen/arg_res_0x7f070320"
            android:layout_marginEnd="@dimen/arg_res_0x7f070320"
            android:layout_toStartOf="@+id/fl_download"
            android:layout_toEndOf="@+id/imageView_update_icon_image"/>
        <com.dofun.bases.upgrade.impl.universal.banner.RollPagerView
            android:id="@+id/banner_view_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/imageView_update_icon_image"
            android:layout_alignParentTop="true"/>
        <ImageView
            android:id="@+id/imageView_close_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/arg_res_0x7f080187"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textSize="@dimen/arg_res_0x7f070325"
            android:textColor="@android:color/darker_gray"
            android:gravity="center"
            android:id="@+id/image_desc_tv_do_not_detect"
            android:background="@drawable/arg_res_0x7f08026c"
            android:paddingLeft="@dimen/arg_res_0x7f070320"
            android:paddingRight="@dimen/arg_res_0x7f070320"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/arg_res_0x7f070315"
            android:layout_toLeftOf="@+id/imageView_close_image"
            android:layout_alignBottom="@+id/imageView_close_image"
            android:paddingStart="@dimen/arg_res_0x7f070320"
            android:paddingEnd="@dimen/arg_res_0x7f070320"
            android:layout_marginEnd="@dimen/arg_res_0x7f070315"
            android:layout_toStartOf="@+id/imageView_close_image"/>
        <FrameLayout
            android:id="@+id/fl_download"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/arg_res_0x7f070322"
            android:layout_marginRight="@dimen/arg_res_0x7f070329"
            android:layout_marginBottom="@dimen/arg_res_0x7f070322"
            android:minWidth="@dimen/arg_res_0x7f070326"
            android:minHeight="@dimen/arg_res_0x7f07031d"
            android:layout_alignTop="@+id/imageView_update_icon_image"
            android:layout_alignBottom="@+id/imageView_update_icon_image"
            android:layout_alignParentRight="true"
            android:layout_marginEnd="@dimen/arg_res_0x7f070329"
            android:layout_alignParentEnd="true">
            <ProgressBar
                android:id="@+id/progress_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:progressDrawable="@drawable/arg_res_0x7f080270"
                style="@android:style/Widget.ProgressBar.Horizontal"/>
            <TextView
                android:textSize="@dimen/arg_res_0x7f070327"
                android:textColor="#ffffff"
                android:layout_gravity="center"
                android:id="@+id/textView_download_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/arg_res_0x7f1003e0"/>
        </FrameLayout>
    </com.dofun.bases.upgrade.impl.universal.banner.RoundCornerRelativeLayout>
</FrameLayout>
