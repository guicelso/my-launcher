<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/center"
        android:layout_width="1px"
        android:layout_height="1px"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_wechat_qrcode"
        android:layout_width="150px"
        android:layout_height="150px"
        android:layout_marginRight="35px"
        android:layout_marginEnd="35px"
        app:is_square="true"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintRight_toLeftOf="@+id/center"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_ali_qrcode"
        android:layout_width="150px"
        android:layout_height="150px"
        android:layout_marginLeft="35px"
        android:layout_marginStart="35px"
        app:is_square="true"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintLeft_toRightOf="@+id/center"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="20px"
        android:textColor="#ff000000"
        android:id="@+id/tv_wechat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12px"
        android:text="@string/arg_res_0x7f100418"
        android:drawableLeft="@mipmap/arg_res_0x7f0e0085"
        android:drawablePadding="6px"
        android:drawableStart="@mipmap/arg_res_0x7f0e0085"
        app:layout_constraintLeft_toLeftOf="@+id/iv_wechat_qrcode"
        app:layout_constraintRight_toRightOf="@+id/iv_wechat_qrcode"
        app:layout_constraintTop_toBottomOf="@+id/iv_wechat_qrcode"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="20px"
        android:textColor="#ff000000"
        android:id="@+id/tv_alipay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12px"
        android:text="@string/arg_res_0x7f100064"
        android:drawableLeft="@mipmap/arg_res_0x7f0e0001"
        android:drawablePadding="6px"
        android:drawableStart="@mipmap/arg_res_0x7f0e0001"
        app:layout_constraintLeft_toLeftOf="@+id/iv_ali_qrcode"
        app:layout_constraintRight_toRightOf="@+id/iv_ali_qrcode"
        app:layout_constraintTop_toBottomOf="@+id/iv_ali_qrcode"/>
    <com.dofun.overseasvariety.view.ATScrollView
        android:id="@+id/pay_desc_asv"
        android:padding="20px"
        android:layout_width="wrap_content"
        android:layout_height="100px"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_alipay">
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="20px"
            android:textColor="#000000"
            android:id="@+id/pay_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </com.dofun.overseasvariety.view.ATScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
