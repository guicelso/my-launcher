<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.variety.base.ui.adapt.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="30px"
    android:paddingTop="30px"
    android:paddingRight="30px"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:adapt_calc_base_on="3">
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_back"
        android:layout_width="44px"
        android:layout_height="44px"
        android:src="@mipmap/arg_res_0x7f0e0069"
        android:layout_alignTop="@+id/tv_title"
        app:adapt_calc_base_on="3"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="30px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="@android:color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_save"
        android:background="@drawable/arg_res_0x7f080240"
        android:paddingLeft="24px"
        android:paddingRight="24px"
        android:clickable="false"
        android:layout_width="150px"
        android:layout_height="50px"
        android:text="@string/arg_res_0x7f100308"
        android:lines="1"
        android:layout_alignTop="@+id/tv_title"
        android:layout_alignBottom="@+id/tv_title"
        android:layout_alignParentRight="true"
        android:paddingStart="24px"
        android:paddingEnd="24px"
        android:layout_alignParentEnd="true"
        app:adapt_calc_base_on="3"
        app:fitTypeface="false"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="20px"
        android:layout_below="@+id/tv_title">
        <cn.cardoor.variety.base.ui.adapt.AutoLinearLayout
            android:orientation="vertical"
            android:id="@+id/animate_root"
            android:paddingTop="20px"
            android:paddingBottom="30px"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <cn.cardoor.variety.base.ui.adapt.AutoLinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10px"
                app:bl_corners_radius="8dp"
                app:bl_solid_color="@color/arg_res_0x7f060036">
                <com.dofun.overseasvariety.view.PressRelativeLayout
                    android:id="@+id/rl_set_task_condition"
                    android:padding="24px"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="90px"
                    app:adapt_calc_base_on="3">
                    <cn.cardoor.variety.base.ui.adapt.AutoTextView
                        android:textSize="24px"
                        android:textColor="@android:color/white"
                        android:id="@+id/tv_condition"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/arg_res_0x7f100156"
                        android:layout_centerVertical="true"/>
                    <cn.cardoor.variety.base.ui.adapt.AutoImageView
                        android:id="@+id/iv_set_speed_task_condition_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6px"
                        android:src="@mipmap/arg_res_0x7f0e0004"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="6px"
                        android:layout_alignParentEnd="true"
                        app:is_square="true"/>
                    <com.dofun.variety.ui.DrawableFollowTextView
                        android:textSize="24px"
                        android:textColor="@android:color/white"
                        android:id="@+id/tv_task_condition"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10px"
                        android:drawablePadding="8px"
                        android:layout_toLeftOf="@+id/iv_set_speed_task_condition_arrow"
                        android:layout_toRightOf="@+id/tv_condition"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="10px"
                        android:layout_toStartOf="@+id/iv_set_speed_task_condition_arrow"
                        android:layout_toEndOf="@+id/tv_condition"
                        app:fitTypeface="false"
                        app:view_gravity="1"/>
                </com.dofun.overseasvariety.view.PressRelativeLayout>
                <HorizontalScrollView
                    android:fadingEdge="horizontal"
                    android:fadingEdgeLength="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:requiresFadingEdge="horizontal">
                    <cn.cardoor.variety.base.ui.adapt.AutoRadioGroup
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/rg_set_task_condition"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="90px"
                        app:adapt_calc_base_on="3"/>
                </HorizontalScrollView>
            </cn.cardoor.variety.base.ui.adapt.AutoLinearLayout>
            <cn.cardoor.variety.base.ui.adapt.AutoLinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10px"
                app:bl_corners_radius="8dp"
                app:bl_solid_color="@color/arg_res_0x7f060036">
                <com.dofun.overseasvariety.view.PressRelativeLayout
                    android:id="@+id/rl_delay_time"
                    android:padding="24px"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="90px"
                    app:adapt_calc_base_on="3">
                    <cn.cardoor.variety.base.ui.adapt.AutoTextView
                        android:textSize="26px"
                        android:textColor="@android:color/white"
                        android:id="@+id/tv_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/arg_res_0x7f100104"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"
                        android:layout_alignParentStart="true"/>
                    <cn.cardoor.variety.base.ui.adapt.AutoTextView
                        android:textSize="26px"
                        android:textColor="@android:color/white"
                        android:id="@+id/tv_delay_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="8px"
                        android:layout_toLeftOf="@+id/iv_delay_time_arrow"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@+id/iv_delay_time_arrow"
                        app:fitTypeface="false"/>
                    <cn.cardoor.variety.base.ui.adapt.AutoImageView
                        android:id="@+id/iv_delay_time_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6px"
                        android:src="@mipmap/arg_res_0x7f0e0004"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="6px"
                        android:layout_alignParentEnd="true"/>
                </com.dofun.overseasvariety.view.PressRelativeLayout>
                <com.dofun.variety.ui.CustomSeekBarLayout
                    android:id="@+id/layout_set_delay"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </cn.cardoor.variety.base.ui.adapt.AutoLinearLayout>
            <cn.cardoor.variety.base.ui.adapt.AutoLinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10px"
                app:bl_corners_radius="8dp"
                app:bl_solid_color="@color/arg_res_0x7f060036">
                <com.dofun.overseasvariety.view.PressRelativeLayout
                    android:id="@+id/rl_set_task_operation"
                    android:padding="24px"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="90px"
                    app:adapt_calc_base_on="3">
                    <cn.cardoor.variety.base.ui.adapt.AutoTextView
                        android:textSize="24px"
                        android:textColor="@android:color/white"
                        android:id="@+id/tv_operation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/arg_res_0x7f10009a"
                        android:layout_centerVertical="true"/>
                    <cn.cardoor.variety.base.ui.adapt.AutoImageView
                        android:id="@+id/iv_set_speed_task_operation_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6px"
                        android:src="@mipmap/arg_res_0x7f0e0004"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="6px"
                        android:layout_alignParentEnd="true"
                        app:is_square="true"/>
                    <com.dofun.variety.ui.DrawableFollowTextView
                        android:textSize="24px"
                        android:textColor="@android:color/white"
                        android:id="@+id/tv_task_operation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10px"
                        android:drawablePadding="8px"
                        android:layout_toLeftOf="@+id/iv_set_speed_task_operation_arrow"
                        android:layout_toRightOf="@+id/tv_operation"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="10px"
                        android:layout_toStartOf="@+id/iv_set_speed_task_operation_arrow"
                        android:layout_toEndOf="@+id/tv_operation"
                        app:fitTypeface="false"
                        app:view_gravity="1"/>
                </com.dofun.overseasvariety.view.PressRelativeLayout>
                <HorizontalScrollView
                    android:fadingEdge="horizontal"
                    android:fadingEdgeLength="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:requiresFadingEdge="horizontal">
                    <cn.cardoor.variety.base.ui.adapt.AutoRadioGroup
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/rg_set_task_operation"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="90px"
                        app:adapt_calc_base_on="3"/>
                </HorizontalScrollView>
            </cn.cardoor.variety.base.ui.adapt.AutoLinearLayout>
            <cn.cardoor.variety.base.ui.adapt.AutoRelativeLayout
                android:id="@+id/rl_point_app"
                android:padding="24px"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10px"
                android:minHeight="90px"
                app:adapt_calc_base_on="3"
                app:bl_corners_radius="8dp"
                app:bl_solid_color="@color/arg_res_0x7f060036">
                <cn.cardoor.variety.base.ui.adapt.AutoTextView
                    android:textSize="24px"
                    android:textColor="@android:color/white"
                    android:id="@+id/tv_app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/arg_res_0x7f1002e6"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"/>
                <cn.cardoor.variety.base.ui.adapt.AutoImageView
                    android:id="@+id/iv_app_set_arrow"
                    android:background="@mipmap/arg_res_0x7f0e0005"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6px"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="6px"
                    android:layout_alignParentEnd="true"
                    app:is_square="true"/>
                <com.dofun.variety.ui.DrawableFollowTextView
                    android:textSize="24px"
                    android:textColor="@android:color/white"
                    android:id="@+id/tv_point_app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10px"
                    android:drawablePadding="8px"
                    android:layout_toLeftOf="@+id/iv_app_set_arrow"
                    android:layout_toRightOf="@+id/tv_app_name"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10px"
                    android:layout_toStartOf="@+id/iv_app_set_arrow"
                    android:layout_toEndOf="@+id/tv_app_name"
                    app:fitTypeface="false"
                    app:view_gravity="1"/>
            </cn.cardoor.variety.base.ui.adapt.AutoRelativeLayout>
        </cn.cardoor.variety.base.ui.adapt.AutoLinearLayout>
    </androidx.core.widget.NestedScrollView>
</cn.cardoor.variety.base.ui.adapt.AutoRelativeLayout>
