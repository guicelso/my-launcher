<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/arg_res_0x7f060038"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <cn.cardoor.variety.base.ui.adapt.AutoFrameLayout
        android:id="@+id/fl_item_height"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="120px"
        app:adapt_calc_base_on="5"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <include
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:inputType="text"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"
        layout="@layout/arg_res_0x7f0c00cf"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="15dp"/>
    <cn.cardoor.variety.base.ui.adapt.AutoButton
        android:textSize="24px"
        android:textColor="@android:color/white"
        android:gravity="center_vertical"
        android:id="@+id/btn_cancel_modify"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="60px"
        android:text="@string/arg_res_0x7f1000b4"
        android:drawableLeft="@drawable/arg_res_0x7f080233"
        android:drawablePadding="20px"
        android:drawableStart="@drawable/arg_res_0x7f080233"
        android:layout_marginStart="60px"
        app:adapt_calc_base_on="5"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="@+id/guideline_title"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="28px"
        android:textColor="@android:color/white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/arg_res_0x7f10020f"
        app:layout_constraintBottom_toBottomOf="@+id/btn_cancel_modify"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="@+id/btn_cancel_modify"/>
    <cn.cardoor.variety.base.ui.adapt.AutoButton
        android:textSize="23px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/btn_modify"
        android:paddingLeft="28px"
        android:paddingTop="10px"
        android:paddingRight="28px"
        android:paddingBottom="10px"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="70px"
        android:text="@string/arg_res_0x7f100309"
        android:paddingStart="28px"
        android:paddingEnd="28px"
        android:layout_marginEnd="70px"
        app:adapt_calc_base_on="5"
        app:bl_corners_radius="30dp"
        app:bl_stroke_color="@android:color/white"
        app:bl_stroke_width="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_cancel_modify"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintTop_toTopOf="@+id/btn_cancel_modify"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_display_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="90px"
        android:layout_marginTop="28px"
        android:text="@string/arg_res_0x7f100133"
        android:layout_marginStart="90px"
        app:adapt_calc_base_on="5"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/btn_cancel_modify"/>
    <cn.cardoor.variety.base.ui.adapt.AutoEditText
        android:textSize="30px"
        android:textColor="@android:color/white"
        android:id="@+id/et_modify_text"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40px"
        android:drawableRight="@drawable/arg_res_0x7f0801da"
        android:drawableEnd="@drawable/arg_res_0x7f0801da"
        android:layout_marginStart="40px"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_display_text"
        app:layout_constraintStart_toEndOf="@+id/tv_display_text"/>
    <cn.cardoor.variety.base.ui.adapt.AutoViewPager
        android:id="@+id/vp_icons"
        android:layout_width="match_parent"
        android:layout_height="0px"
        android:layout_marginTop="14px"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_display_text"/>
    <com.dofun.overseasvariety.view.DotView
        android:id="@+id/dotView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="25px"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"/>
</androidx.constraintlayout.widget.ConstraintLayout>
