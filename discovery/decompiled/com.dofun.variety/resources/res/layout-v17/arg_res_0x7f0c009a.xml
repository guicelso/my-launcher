<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="128px"
    app:adapt_calc_base_on="3"
    app:bl_corners_radius="16dp"
    app:bl_solid_color="#0affffff">
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="45px"
        android:layout_marginStart="45px"
        app:adapt_calc_base_on="3"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_date"
        app:layout_constraintEnd_toStartOf="@+id/tv_update"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toLeftOf="@+id/tv_update"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="@+id/tv_update"
        app:layout_constraintVertical_chainStyle="2"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="18px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="45px"
        android:layout_marginTop="5px"
        android:layout_marginStart="45px"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toBottomOf="@+id/tv_update"
        app:layout_constraintEnd_toStartOf="@+id/tv_update"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toLeftOf="@+id/tv_update"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="15px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_update"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="50px"
        android:minWidth="130px"
        android:minHeight="35px"
        android:text="@string/arg_res_0x7f1003d1"
        android:layout_marginEnd="50px"
        app:adapt_calc_base_on="3"
        app:bl_corners_radius="50dp"
        app:bl_solid_color="@color/arg_res_0x7f060035"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintTop_toTopOf="0"/>
</cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
