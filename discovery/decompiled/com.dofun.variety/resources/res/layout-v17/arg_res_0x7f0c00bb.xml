<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout
        android:paddingLeft="15px"
        android:paddingTop="32px"
        android:paddingRight="15px"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:adapt_calc_base_on="3">
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="22px"
            android:textColor="@color/arg_res_0x7f060330"
            android:id="@+id/tv_recently"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16px"
            android:text="@string/arg_res_0x7f1002f6"
            android:layout_marginStart="16px"
            app:adapt_calc_base_on="2"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toTopOf="0"/>
        <cn.cardoor.variety.base.ui.adapt.AutoRecyclerView
            android:scrollbarSize="0dp"
            android:scrollbarThumbVertical="@null"
            android:id="@+id/rv_recent_apps"
            android:focusable="false"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="100px"
            android:layout_marginTop="23px"
            android:overScrollMode="never"
            app:adapt_calc_base_on="2"
            app:layout_constraintTop_toBottomOf="@+id/tv_recently"/>
        <View
            android:id="@+id/divider"
            android:background="@drawable/arg_res_0x7f080164"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginTop="23px"
            app:adapt_calc_base_on="2"
            app:layout_constraintTop_toBottomOf="@+id/rv_recent_apps"/>
        <com.dofun.variety.theme.ui.IndicatorViewPager
            android:id="@+id/vp_app_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10px"
            android:layout_marginBottom="5px"
            app:adapt_calc_base_on="2"
            app:layout_constraintBottom_toBottomOf="0"
            app:layout_constraintTop_toBottomOf="@+id/divider"/>
    </cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
</merge>
