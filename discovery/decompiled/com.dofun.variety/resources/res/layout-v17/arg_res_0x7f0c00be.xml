<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/frame_gd_navigation"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTypefaceTextView
        android:textSize="76px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_navi_icon"
        android:layout_width="160px"
        android:layout_height="120px"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTypefaceTextView
        android:textSize="73px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_seg_remain_dis"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTypefaceTextView
        android:textSize="33px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_seg_remain_dis_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTypefaceTextView
        android:textSize="33px"
        android:textColor="@android:color/white"
        android:ellipsize="end"
        android:id="@+id/tv_next_road_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTypefaceTextView
        android:textSize="23px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_last_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/arg_res_0x7f100301"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTypefaceTextView
        android:textSize="23px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_last_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTypefaceTextView
        android:textSize="23px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_last_time_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTypefaceTextView
        android:textSize="23px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_last_dis"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTypefaceTextView
        android:textSize="23px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_last_dis_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageView
        android:id="@+id/iv_camera_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTypefaceTextView
        android:textSize="23px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_camera_type_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</merge>
