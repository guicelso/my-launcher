<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_back"
        android:background="@mipmap/arg_res_0x7f0e0069"
        android:layout_width="44px"
        android:layout_height="44px"
        android:layout_marginLeft="42px"
        android:layout_marginTop="32px"
        android:layout_marginStart="42px"
        app:is_square="true"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <com.dofun.overseasvariety.view.SearchView
        android:id="@+id/view_search"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="18px"
        android:layout_marginRight="18px"
        app:layout_constraintBottom_toBottomOf="@+id/iv_back"
        app:layout_constraintEnd_toStartOf="@+id/tv_do_search"
        app:layout_constraintLeft_toRightOf="@+id/iv_back"
        app:layout_constraintRight_toLeftOf="@+id/tv_do_search"
        app:layout_constraintStart_toEndOf="@+id/iv_back"
        app:layout_constraintTop_toTopOf="@+id/iv_back"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_do_search"
        android:paddingLeft="18px"
        android:paddingRight="18px"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginRight="38px"
        android:minHeight="42px"
        android:text="@android:string/search_go"
        android:layout_marginEnd="38px"
        app:adapt_calc_base_on="3"
        app:fitTypeface="false"
        app:layout_constraintBottom_toBottomOf="@+id/view_search"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintTop_toTopOf="@+id/view_search"/>
    <cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout
        android:id="@+id/cl_search_history"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="30px"
        app:layout_constraintEnd_toEndOf="@+id/tv_do_search"
        app:layout_constraintLeft_toLeftOf="@+id/iv_back"
        app:layout_constraintRight_toRightOf="@+id/tv_do_search"
        app:layout_constraintStart_toStartOf="@+id/iv_back"
        app:layout_constraintTop_toBottomOf="@+id/view_search">
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="22px"
            android:id="@+id/tv_search_history_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/arg_res_0x7f1003ad"
            app:adapt_calc_base_on="3"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toTopOf="0"/>
        <cn.cardoor.variety.base.ui.adapt.AutoImageView
            android:textSize="20px"
            android:textColor="#039be5"
            android:id="@+id/tv_clear_search_history"
            android:layout_width="25px"
            android:layout_height="25px"
            android:src="@mipmap/arg_res_0x7f0e000f"
            app:adapt_calc_base_on="3"
            app:layout_constraintBottom_toBottomOf="@+id/tv_search_history_title"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintTop_toTopOf="@+id/tv_search_history_title"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_search_history"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20px"
            android:layout_weight="0.95"
            android:scrollbarFadeDuration="0"
            android:fadeScrollbars="false"
            android:overScrollMode="always"
            app:adapt_calc_base_on="3"
            app:layout_constraintTop_toBottomOf="@+id/tv_search_history_title"/>
    </cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
    <cn.cardoor.variety.base.ui.EdgeEffectView
        android:id="@+id/fl_content"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="gone"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="22px"
        app:adapt_calc_base_on="3"
        app:edge_position="0xa"
        app:edge_width="14dp"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/view_search">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_search_data"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:adapt_calc_base_on="3"/>
    </cn.cardoor.variety.base.ui.EdgeEffectView>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="26px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_load_more_error_retry"
        android:padding="10px"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10px"
        android:minWidth="200px"
        android:minHeight="60px"
        android:text="@string/arg_res_0x7f1002ff"
        app:adapt_calc_base_on="3"
        app:bl_corners_radius="86dp"
        app:bl_solid_color="@color/arg_res_0x7f060045"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"/>
</androidx.constraintlayout.widget.ConstraintLayout>
