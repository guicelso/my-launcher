<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.variety.base.ui.adapt.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="460px"
    android:layout_height="wrap_content">
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="26px"
        android:textColor="@android:color/black"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10px"
        android:text="@string/arg_res_0x7f1000cb"
        android:layout_centerHorizontal="true"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="20px"
        android:textColor="@android:color/black"
        android:id="@+id/tv_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20px"
        android:layout_marginTop="10px"
        android:layout_marginRight="20px"
        android:text="@string/arg_res_0x7f1000cc"
        android:layout_below="@+id/tv_title"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="20px"
        android:layout_marginEnd="20px"/>
    <cn.cardoor.variety.base.ui.adapt.AutoLinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="60px"
        android:layout_marginTop="20px"
        android:divider="@drawable/arg_res_0x7f08023c"
        android:layout_below="@+id/tv_desc"
        android:showDividers="middle|beginning"
        app:adapt_calc_base_on="3">
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="20px"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:id="@+id/tv_cancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/arg_res_0x7f1000b3"
            android:layout_weight="1"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="20px"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:id="@+id/tv_ok"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/arg_res_0x7f100287"
            android:layout_weight="1"/>
    </cn.cardoor.variety.base.ui.adapt.AutoLinearLayout>
</cn.cardoor.variety.base.ui.adapt.AutoRelativeLayout>
