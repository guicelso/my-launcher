<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="20px"
        android:gravity="center"
        android:id="@+id/tv_dw_app_info"
        android:background="@drawable/arg_res_0x7f080167"
        android:paddingTop="6px"
        android:paddingBottom="10px"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="130px"
        android:minHeight="130px"
        android:drawablePadding="10px"
        android:paddingStart="30px"
        android:paddingEnd="30px"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toTopOf="@+id/tv_dw_app_tips"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"
        app:layout_constraintVertical_chainStyle="2"
        style="@style/arg_res_0x7f110124"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:id="@+id/tv_dw_app_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4px"
        android:text="@string/arg_res_0x7f10010e"
        app:layout_constraintBottom_toTopOf="@+id/tv_modify_desktop_window"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_dw_app_info"
        style="@style/arg_res_0x7f110124"/>
    <me.grantland.widget.AutofitTextView
        android:textSize="20dp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_modify_desktop_window"
        android:background="@drawable/arg_res_0x7f080145"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:layout_marginRight="8dp"
        android:minWidth="180dp"
        android:minHeight="50dp"
        android:text="@string/arg_res_0x7f10010b"
        android:singleLine="true"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toStartOf="@+id/tv_go_download"
        app:layout_constraintHorizontal_chainStyle="2"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_dw_app_tips"
        app:minTextSize="14dp"/>
    <me.grantland.widget.AutofitTextView
        android:textSize="20dp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_go_download"
        android:background="@drawable/arg_res_0x7f080145"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:minWidth="180dp"
        android:minHeight="50dp"
        android:text="@string/arg_res_0x7f100185"
        android:singleLine="true"
        android:layout_marginStart="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toEndOf="@+id/tv_modify_desktop_window"
        app:layout_constraintTop_toTopOf="@+id/tv_modify_desktop_window"
        app:minTextSize="14dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
