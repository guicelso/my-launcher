<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_back"
        android:layout_width="44px"
        android:layout_height="44px"
        android:layout_marginLeft="30px"
        android:layout_marginTop="30px"
        android:src="@mipmap/arg_res_0x7f0e0069"
        android:onClick="onClick"
        android:layout_marginStart="30px"
        app:adapt_calc_base_on="5"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoShapeableImageView
        android:id="@+id/iv_title_img"
        android:layout_width="40px"
        android:layout_height="40px"
        android:layout_marginLeft="26px"
        android:src="@drawable/arg_res_0x7f0801b4"
        android:scaleType="centerCrop"
        android:layout_marginStart="26px"
        app:adapt_calc_base_on="5"
        app:layout_constraintBottom_toBottomOf="@+id/iv_back"
        app:layout_constraintEnd_toStartOf="@+id/tv_title"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="2"
        app:layout_constraintLeft_toRightOf="@+id/iv_back"
        app:layout_constraintRight_toLeftOf="@+id/tv_title"
        app:layout_constraintStart_toEndOf="@+id/iv_back"
        app:layout_constraintTop_toTopOf="@+id/iv_back"
        app:shapeAppearance="@style/arg_res_0x7f11011f"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="30px"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6px"
        android:text="@string/arg_res_0x7f10009f"
        android:lines="1"
        android:layout_marginStart="6px"
        app:adapt_calc_base_on="5"
        app:fitTypeface="false"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/iv_back"
        app:layout_constraintEnd_toStartOf="@+id/iv_title_triangle"
        app:layout_constraintLeft_toRightOf="@+id/iv_title_img"
        app:layout_constraintRight_toLeftOf="@+id/iv_title_triangle"
        app:layout_constraintStart_toEndOf="@+id/iv_title_img"
        app:layout_constraintTop_toTopOf="@+id/iv_back"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_title_triangle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10px"
        android:layout_marginRight="16px"
        android:src="@mipmap/arg_res_0x7f0e0081"
        android:layout_marginStart="10px"
        android:layout_marginEnd="16px"
        app:adapt_calc_base_on="5"
        app:layout_constraintBottom_toBottomOf="@+id/iv_back"
        app:layout_constraintEnd_toStartOf="@+id/tab_layout"
        app:layout_constraintLeft_toRightOf="@+id/tv_title"
        app:layout_constraintRight_toLeftOf="@+id/tab_layout"
        app:layout_constraintStart_toEndOf="@+id/tv_title"
        app:layout_constraintTop_toTopOf="@+id/iv_back"/>
    <cn.cardoor.variety.base.ui.adapt.AutoFrameLayout
        android:id="@+id/view_title_indicator"
        android:background="@drawable/arg_res_0x7f080234"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="4px"
        android:layout_marginTop="5px"
        app:adapt_calc_base_on="5"
        app:layout_constraintEnd_toEndOf="@+id/tv_title"
        app:layout_constraintLeft_toLeftOf="@+id/iv_title_img"
        app:layout_constraintRight_toRightOf="@+id/tv_title"
        app:layout_constraintStart_toStartOf="@+id/iv_title_img"
        app:layout_constraintTop_toBottomOf="@+id/iv_title_img"/>
    <androidx.constraintlayout.helper.widget.Layer
        android:id="@+id/group_user"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:constraint_referenced_ids="iv_title_img,iv_title_triangle,tv_title"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_back_r"
        android:visibility="invisible"
        android:layout_width="70px"
        android:layout_height="44px"
        android:layout_marginLeft="30px"
        android:layout_marginTop="30px"
        android:src="@mipmap/arg_res_0x7f0e0069"
        android:onClick="onClick"
        android:layout_marginStart="30px"
        app:adapt_calc_base_on="5"
        app:layout_constraintLeft_toRightOf="@+id/iv_title_triangle"
        app:layout_constraintStart_toEndOf="@+id/iv_title_triangle"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_edit_theme"
        android:layout_width="40px"
        android:layout_height="40px"
        android:layout_marginRight="40px"
        android:src="@mipmap/arg_res_0x7f0e0010"
        android:scaleType="fitXY"
        android:layout_marginEnd="40px"
        app:adapt_calc_base_on="5"
        app:layout_constraintBottom_toBottomOf="@+id/iv_exchange"
        app:layout_constraintEnd_toStartOf="@+id/iv_exchange"
        app:layout_constraintRight_toLeftOf="@+id/iv_exchange"
        app:layout_constraintTop_toTopOf="@+id/iv_setting"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_exchange"
        android:layout_width="40px"
        android:layout_height="40px"
        android:layout_marginRight="40px"
        android:src="@drawable/arg_res_0x7f080171"
        android:onClick="onClick"
        android:layout_marginEnd="40px"
        app:adapt_calc_base_on="5"
        app:layout_constraintBottom_toBottomOf="@+id/iv_setting"
        app:layout_constraintEnd_toStartOf="@+id/iv_setting"
        app:layout_constraintRight_toLeftOf="@+id/iv_setting"
        app:layout_constraintTop_toTopOf="@+id/iv_setting"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_setting"
        android:background="@drawable/arg_res_0x7f0801b2"
        android:layout_width="40px"
        android:layout_height="40px"
        android:layout_marginRight="30px"
        android:onClick="onClick"
        android:layout_marginEnd="30px"
        app:adapt_calc_base_on="5"
        app:is_square="true"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintTop_toTopOf="@+id/iv_back"/>
    <com.dofun.overseasvariety.view.TabLayout
        android:gravity="top"
        android:id="@+id/tab_layout"
        android:paddingBottom="6px"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="@+id/iv_back"
        app:tabIndicatorColor="#00adf7"
        app:tabIndicatorHeight="4px"
        app:tabTitleTextColor="@android:color/white"
        app:tabTitleTextSize="30px"/>
    <androidx.constraintlayout.helper.widget.Layer
        android:id="@+id/group_mine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="group_user,iv_edit_theme,iv_exchange,iv_setting,tab_layout"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="30px"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_theme_manage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8px"
        android:text="@string/arg_res_0x7f10037a"
        android:lines="1"
        android:layout_marginStart="8px"
        app:adapt_calc_base_on="5"
        app:fitTypeface="false"
        app:layout_constraintBottom_toBottomOf="@+id/iv_back"
        app:layout_constraintLeft_toRightOf="@+id/iv_back"
        app:layout_constraintStart_toEndOf="@+id/iv_back"
        app:layout_constraintTop_toTopOf="@+id/iv_back"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_theme_manage_check_all"
        android:visibility="gone"
        android:layout_width="40px"
        android:layout_height="40px"
        android:layout_marginRight="40px"
        android:src="@drawable/arg_res_0x7f080226"
        android:scaleType="fitXY"
        android:layout_marginEnd="40px"
        app:adapt_calc_base_on="5"
        app:is_square="true"
        app:layout_constraintBottom_toBottomOf="@+id/iv_theme_manage_delete"
        app:layout_constraintEnd_toStartOf="@+id/iv_theme_manage_delete"
        app:layout_constraintRight_toLeftOf="@+id/iv_theme_manage_delete"
        app:layout_constraintTop_toTopOf="@+id/iv_theme_manage_delete"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_theme_manage_delete"
        android:layout_width="40px"
        android:layout_height="40px"
        android:layout_marginRight="40px"
        android:src="@mipmap/arg_res_0x7f0e000f"
        android:onClick="onClick"
        android:layout_marginEnd="40px"
        app:adapt_calc_base_on="5"
        app:layout_constraintBottom_toBottomOf="@+id/iv_theme_manage_exit"
        app:layout_constraintEnd_toStartOf="@+id/iv_theme_manage_exit"
        app:layout_constraintRight_toLeftOf="@+id/iv_theme_manage_exit"
        app:layout_constraintTop_toTopOf="@+id/iv_theme_manage_exit"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_theme_manage_exit"
        android:background="@mipmap/arg_res_0x7f0e0011"
        android:layout_width="40px"
        android:layout_height="40px"
        android:layout_marginRight="30px"
        android:onClick="onClick"
        android:layout_marginEnd="30px"
        app:adapt_calc_base_on="5"
        app:is_square="true"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintTop_toTopOf="@+id/iv_back"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_mine_editing"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_theme_manage,iv_theme_manage_check_all,iv_theme_manage_delete,iv_theme_manage_exit"/>
    <com.dofun.overseasvariety.view.ScrollViewPager
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tab_layout"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_toast_login"
        android:paddingLeft="12px"
        android:paddingRight="12px"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14px"
        android:layout_marginRight="14px"
        android:text="@string/arg_res_0x7f100368"
        android:onClick="onClick"
        android:paddingStart="12px"
        android:paddingEnd="12px"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/iv_back_r"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="@+id/iv_back_r"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/view_title_indicator"/>
</cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
