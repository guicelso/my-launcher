<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_back"
        android:layout_width="44px"
        android:layout_height="44px"
        android:layout_marginLeft="30px"
        android:src="@mipmap/arg_res_0x7f0e0069"
        android:layout_alignTop="@+id/tv_title"
        android:layout_marginStart="30px"
        app:adapt_calc_base_on="5"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="30px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30px"
        android:text="@string/arg_res_0x7f100327"
        android:layout_centerHorizontal="true"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="@android:color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_update"
        android:background="@drawable/arg_res_0x7f080222"
        android:paddingLeft="24px"
        android:paddingRight="24px"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="62px"
        android:text="@string/arg_res_0x7f1000c2"
        android:lines="1"
        android:layout_alignTop="@+id/tv_title"
        android:layout_alignBottom="@+id/tv_title"
        android:layout_alignParentRight="true"
        android:paddingStart="24px"
        android:paddingEnd="24px"
        android:layout_marginEnd="62px"
        android:layout_alignParentEnd="true"
        app:adapt_calc_base_on="5"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="10px"
        android:id="@+id/tv_new_upgrade"
        android:background="@drawable/arg_res_0x7f080244"
        android:padding="2px"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10px"
        android:layout_marginRight="10px"
        android:text="@string/arg_res_0x7f100361"
        android:layout_alignRight="@+id/tv_update"
        android:layout_marginEnd="10px"
        android:layout_alignEnd="@+id/tv_update"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv_items"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20px"
        android:layout_marginTop="10px"
        android:layout_below="@+id/iv_back"
        android:layout_marginStart="20px">
        <cn.cardoor.variety.base.ui.adapt.AutoRadioGroup
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/rg_item"
            android:layout_width="260px"
            android:layout_height="wrap_content">
            <cn.cardoor.variety.base.ui.adapt.AutoRadioButton
                android:textSize="26px"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/tv_launcher_set"
                android:tag="launch"
                android:paddingLeft="4px"
                android:paddingRight="4px"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@null"
                android:minWidth="200px"
                android:minHeight="62px"
                android:text="@string/arg_res_0x7f1001b3"
                android:includeFontPadding="false"
                android:paddingStart="4px"
                android:paddingEnd="4px"
                app:adapt_calc_base_on="5"
                app:bl_checked_solid_color="#00a2f9"
                app:bl_corners_radius="130dp"
                app:bl_pressed_solid_color="#00a2f9"/>
            <cn.cardoor.variety.base.ui.adapt.AutoRadioButton
                android:textSize="26px"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/tv_theme_plugin_set"
                android:tag="plugin"
                android:paddingLeft="4px"
                android:paddingRight="4px"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30px"
                android:button="@null"
                android:minWidth="200px"
                android:minHeight="62px"
                android:text="@string/arg_res_0x7f10037d"
                android:paddingStart="4px"
                android:paddingEnd="4px"
                app:adapt_calc_base_on="5"
                app:bl_checked_solid_color="#00a2f9"
                app:bl_corners_radius="130dp"
                app:bl_pressed_solid_color="#00a2f9"/>
            <cn.cardoor.variety.base.ui.adapt.AutoRadioButton
                android:textSize="26px"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/tv_task"
                android:tag="task"
                android:paddingLeft="4px"
                android:paddingRight="4px"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30px"
                android:button="@null"
                android:minWidth="200px"
                android:minHeight="62px"
                android:text="@string/arg_res_0x7f10034e"
                android:paddingStart="4px"
                android:paddingEnd="4px"
                app:adapt_calc_base_on="5"
                app:bl_checked_solid_color="#00a2f9"
                app:bl_corners_radius="130dp"
                app:bl_pressed_solid_color="#00a2f9"/>
            <cn.cardoor.variety.base.ui.adapt.AutoRadioButton
                android:textSize="26px"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/tv_about"
                android:tag="about"
                android:paddingLeft="4px"
                android:paddingRight="4px"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30px"
                android:button="@null"
                android:minWidth="200px"
                android:minHeight="62px"
                android:text="@string/arg_res_0x7f10001b"
                android:paddingStart="4px"
                android:paddingEnd="4px"
                app:adapt_calc_base_on="5"
                app:bl_checked_solid_color="#00a2f9"
                app:bl_corners_radius="130dp"
                app:bl_pressed_solid_color="#00a2f9"/>
            <cn.cardoor.variety.base.ui.adapt.AutoButton
                android:textSize="26px"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/tv_clear_data"
                android:background="@null"
                android:paddingLeft="4px"
                android:paddingRight="4px"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30px"
                android:layout_marginBottom="30px"
                android:minWidth="200px"
                android:minHeight="62px"
                android:text="@string/arg_res_0x7f1000cb"
                android:paddingStart="4px"
                android:paddingEnd="4px"
                app:adapt_calc_base_on="5"
                app:bl_checked_solid_color="#00a2f9"
                app:bl_corners_radius="130dp"
                app:bl_pressed_solid_color="#00a2f9"/>
        </cn.cardoor.variety.base.ui.adapt.AutoRadioGroup>
    </androidx.core.widget.NestedScrollView>
    <cn.cardoor.variety.base.ui.adapt.AutoFrameLayout
        android:id="@+id/fragment_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="20px"
        android:layout_toRightOf="@+id/nsv_items"
        android:layout_alignTop="@+id/nsv_items"
        android:layout_marginStart="20px"
        android:layout_toEndOf="@+id/nsv_items"
        app:edge_position="0xa"
        app:edge_width="30dp"/>
</RelativeLayout>
