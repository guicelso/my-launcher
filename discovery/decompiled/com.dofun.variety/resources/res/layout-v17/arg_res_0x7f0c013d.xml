<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#151e36"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="40px"
    android:paddingEnd="40px">
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="28px"
        android:textColor="#ffffff"
        android:id="@+id/tv_connect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50px"
        android:text="@string/arg_res_0x7f1000e6"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_close"
        android:layout_width="20px"
        android:layout_height="20px"
        android:src="@mipmap/arg_res_0x7f0e0009"
        app:layout_constraintBottom_toBottomOf="@+id/tv_connect"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="@+id/tv_connect"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_show"
        android:layout_width="576px"
        android:layout_height="425px"
        android:layout_marginTop="30px"
        android:layout_marginBottom="48px"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_connect"/>
    <cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout
        android:id="@+id/cl_show"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/iv_show"
        app:layout_constraintEnd_toStartOf="@+id/iv_show"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="@+id/iv_show">
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="24px"
            android:textColor="#ffffff"
            android:id="@+id/tv_login"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/arg_res_0x7f10030b"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/iv_qr_code"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toTopOf="0"/>
        <cn.cardoor.variety.base.ui.adapt.AutoImageView
            android:id="@+id/iv_qr_code"
            android:background="@drawable/arg_res_0x7f08025a"
            android:layout_width="200px"
            android:layout_height="200px"
            android:layout_marginTop="45px"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toTopOf="0"/>
        <cn.cardoor.variety.base.ui.adapt.AutoImageView
            android:layout_width="40px"
            android:layout_height="40px"
            app:layout_constraintBottom_toBottomOf="@+id/iv_qr_code"
            app:layout_constraintEnd_toEndOf="@+id/iv_qr_code"
            app:layout_constraintStart_toStartOf="@+id/iv_qr_code"
            app:layout_constraintTop_toTopOf="@+id/iv_qr_code"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="20px"
            android:textColor="#6c6c6c"
            android:gravity="center"
            android:id="@+id/tv_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25px"
            android:text="@string/arg_res_0x7f1000e8"
            app:layout_constraintEnd_toEndOf="@+id/iv_qr_code"
            app:layout_constraintStart_toStartOf="@+id/iv_qr_code"
            app:layout_constraintTop_toBottomOf="@+id/iv_qr_code"/>
        <CheckBox
            android:id="@+id/cb_agreement"
            android:background="@drawable/arg_res_0x7f080224"
            android:layout_width="30px"
            android:layout_height="30px"
            android:layout_marginTop="10px"
            android:layout_marginBottom="10px"
            android:checked="true"
            android:button="@null"
            android:layout_marginEnd="10px"
            app:layout_constraintEnd_toStartOf="@+id/tv_agreement"
            app:layout_constraintHorizontal_chainStyle="2"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toBottomOf="@+id/tv_tips"/>
        <TextView
            android:textSize="20px"
            android:id="@+id/tv_agreement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/cb_agreement"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintStart_toEndOf="@+id/cb_agreement"
            app:layout_constraintTop_toTopOf="@+id/cb_agreement"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="20dp"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/tv_read_first"
            android:padding="30dp"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="请先阅读并勾选以下协议"
            app:bl_corners_radius="19dp"
            app:bl_solid_color="#c5000000"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/iv_qr_code"
            app:layout_constraintLeft_toLeftOf="@+id/iv_qr_code"
            app:layout_constraintRight_toRightOf="@+id/iv_qr_code"
            app:layout_constraintTop_toTopOf="@+id/iv_qr_code"/>
    </cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
</cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
