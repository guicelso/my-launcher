<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_dw_app_error"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="32dp"
        android:gravity="center"
        android:id="@+id/tv_app_error_tips1"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:text="@string/arg_res_0x7f100188"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_app_error_tips2"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"
        app:layout_constraintVertical_chainStyle="2"
        style="@style/arg_res_0x7f110124"/>
    <TextView
        android:textSize="24dp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_app_error_tips2"
        android:visibility="gone"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="12dp"
        android:text="@string/arg_res_0x7f100145"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_app_error_tips1"/>
    <me.grantland.widget.AutofitTextView
        android:textSize="20dp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_modify_desktop_window"
        android:background="@drawable/arg_res_0x7f080145"
        android:paddingLeft="14dp"
        android:paddingTop="8dp"
        android:paddingRight="14dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:minWidth="180dp"
        android:minHeight="50dp"
        android:text="@string/arg_res_0x7f10010b"
        android:maxLines="1"
        android:singleLine="true"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_app_error_tips2"
        app:minTextSize="14dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
