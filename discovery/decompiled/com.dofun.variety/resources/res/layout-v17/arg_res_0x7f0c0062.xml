<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/fl_state_container"
    android:layout_width="900px"
    android:layout_height="460px"
    app:bl_corners_radius="20dp"
    app:bl_solid_color="@android:color/white">
    <cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout
        android:paddingLeft="40px"
        android:paddingRight="40px"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="40px"
        android:paddingEnd="40px"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0">
        <cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout
            android:id="@+id/cl_resolution"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginLeft="42px"
            android:layout_marginStart="42px"
            app:adapt_calc_base_on="3"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title"
            app:layout_constraintEnd_toStartOf="@+id/tv_title"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toLeftOf="@+id/tv_title"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toTopOf="@+id/tv_title">
            <cn.cardoor.variety.base.ui.adapt.AutoTextView
                android:textSize="20px"
                android:textColor="#4a4a4a"
                android:gravity="start|center_vertical"
                android:id="@+id/tv_resolution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                app:adapt_calc_base_on="3"
                app:fitTypeface="false"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="0"
                app:layout_constraintLeft_toLeftOf="0"
                app:layout_constraintStart_toStartOf="0"
                app:layout_constraintTop_toTopOf="0"/>
            <cn.cardoor.variety.base.ui.adapt.AutoImageView
                android:id="@+id/iv_resolution_triangle"
                android:visibility="gone"
                android:layout_width="12px"
                android:layout_height="12px"
                android:layout_marginLeft="10px"
                android:src="@mipmap/arg_res_0x7f0e0082"
                android:layout_marginStart="10px"
                app:adapt_calc_base_on="3"
                app:layout_constraintBottom_toBottomOf="@+id/tv_resolution"
                app:layout_constraintStart_toEndOf="@+id/tv_resolution"
                app:layout_constraintTop_toTopOf="@+id/tv_resolution"/>
        </cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="24px"
            android:textColor="#4a4a4a"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15px"
            android:text="@string/arg_res_0x7f10031a"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toTopOf="0"/>
        <cn.cardoor.variety.base.ui.adapt.AutoRecyclerView
            android:scrollbarSize="4dp"
            android:scrollbarThumbVertical="@drawable/arg_res_0x7f08024c"
            android:scrollbarStyle="outsideOverlay"
            android:id="@+id/rv_wallpapers_data"
            android:visibility="invisible"
            android:scrollbars="vertical"
            android:fadingEdge="vertical"
            android:fadingEdgeLength="20dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginLeft="40px"
            android:layout_marginTop="4px"
            android:layout_marginRight="40px"
            android:requiresFadingEdge="vertical"
            android:layout_marginStart="40px"
            android:layout_marginEnd="40px"
            app:layout_constraintBottom_toBottomOf="0"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
        <cn.cardoor.variety.base.ui.adapt.AutoImageView
            android:id="@+id/close"
            android:background="@mipmap/arg_res_0x7f0e0009"
            android:layout_width="30px"
            android:layout_height="30px"
            android:layout_marginTop="16px"
            app:adapt_calc_base_on="3"
            app:is_square="true"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintTop_toTopOf="0"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="24px"
            android:textColor="@android:color/white"
            android:id="@+id/tv_retry"
            android:paddingLeft="40px"
            android:paddingTop="12px"
            android:paddingRight="40px"
            android:paddingBottom="12px"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20px"
            android:text="@string/arg_res_0x7f1002ff"
            android:paddingStart="40px"
            android:paddingEnd="40px"
            app:bl_corners_radius="60dp"
            app:bl_solid_color="@color/arg_res_0x7f060035"
            app:layout_constraintBottom_toBottomOf="0"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="0"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="17px"
            android:textColor="#838383"
            android:id="@+id/tv_net_unavailable_tip"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/arg_res_0x7f100353"
            app:layout_constraintBottom_toBottomOf="@+id/tv_retry"
            app:layout_constraintEnd_toEndOf="@+id/close"
            app:layout_constraintRight_toRightOf="@+id/close"
            app:layout_constraintTop_toTopOf="@+id/tv_retry"/>
    </cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_downloading_mask"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:bl_corners_radius="20dp"
        app:bl_solid_color="#33333333">
        <ProgressBar
            android:layout_width="132px"
            android:layout_height="132px"
            android:indeterminate="false"
            android:indeterminateDrawable="@drawable/arg_res_0x7f0801b5"
            style="@android:style/Widget.Holo.Light.ProgressBar.Large"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="20px"
            android:textColor="#aeafb9"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10px"
            android:text="@string/arg_res_0x7f1001c7"/>
    </LinearLayout>
</cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
