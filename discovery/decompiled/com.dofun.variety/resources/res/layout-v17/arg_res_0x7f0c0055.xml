<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/cl_root"
    android:paddingLeft="20px"
    android:paddingRight="20px"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="680px"
    android:minHeight="440px"
    android:paddingStart="20px"
    android:paddingEnd="20px"
    app:adapt_calc_base_on="3"
    app:bl_corners_radius="10dp"
    app:bl_solid_color="@android:color/white">
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="@android:color/black"
        android:gravity="center_horizontal"
        android:id="@+id/tv_vip_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30px"
        android:layout_marginTop="15px"
        android:layout_marginStart="30px"
        app:adapt_calc_base_on="3"
        app:layout_constrainedWidth="true"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_close"
        android:layout_width="32px"
        android:layout_height="32px"
        android:layout_marginRight="15px"
        android:src="@mipmap/arg_res_0x7f0e0009"
        android:layout_marginEnd="15px"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toBottomOf="@+id/tv_vip_name"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintTop_toTopOf="@+id/tv_vip_name"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="@android:color/darker_gray"
        android:gravity="center_horizontal"
        android:id="@+id/tv_vip_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:adapt_calc_base_on="3"
        app:fitTypeface="false"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/iv_ali_qrcode"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_vip_name"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_wx_qrcode"
        android:layout_width="200px"
        android:layout_height="200px"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toStartOf="@+id/iv_ali_qrcode"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toLeftOf="@+id/iv_ali_qrcode"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"
        app:layout_constraintVertical_bias="0.4"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="20px"
        android:textColor="@android:color/black"
        android:gravity="center_horizontal"
        android:id="@+id/tv_wx_qrcode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/arg_res_0x7f100418"
        android:drawableLeft="@mipmap/arg_res_0x7f0e0085"
        android:drawablePadding="10px"
        app:adapt_calc_base_on="3"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/iv_wx_qrcode"
        app:layout_constraintLeft_toLeftOf="@+id/iv_wx_qrcode"
        app:layout_constraintRight_toRightOf="@+id/iv_wx_qrcode"
        app:layout_constraintStart_toStartOf="@+id/iv_wx_qrcode"
        app:layout_constraintTop_toBottomOf="@+id/iv_wx_qrcode"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_ali_qrcode"
        android:layout_width="200px"
        android:layout_height="200px"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toRightOf="@+id/iv_wx_qrcode"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toEndOf="@+id/iv_wx_qrcode"
        app:layout_constraintTop_toTopOf="0"
        app:layout_constraintVertical_bias="0.4"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="20px"
        android:textColor="@android:color/black"
        android:gravity="center_horizontal"
        android:id="@+id/tv_ali_qrcode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/arg_res_0x7f100064"
        android:drawableLeft="@mipmap/arg_res_0x7f0e0001"
        android:drawablePadding="10px"
        app:adapt_calc_base_on="3"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/iv_ali_qrcode"
        app:layout_constraintLeft_toLeftOf="@+id/iv_ali_qrcode"
        app:layout_constraintRight_toRightOf="@+id/iv_ali_qrcode"
        app:layout_constraintStart_toStartOf="@+id/iv_ali_qrcode"
        app:layout_constraintTop_toBottomOf="@+id/iv_ali_qrcode"/>
    <com.dofun.overseasvariety.view.ATScrollView
        android:id="@+id/pay_desc_asv"
        android:padding="20px"
        android:layout_width="wrap_content"
        android:layout_height="100px"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_ali_qrcode">
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="24px"
            android:textColor="#000000"
            android:id="@+id/pay_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </com.dofun.overseasvariety.view.ATScrollView>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_pay"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_vip_name,tv_vip_price,         iv_wx_qrcode,iv_ali_qrcode,tv_wx_qrcode,         tv_ali_qrcode,pay_desc_asv"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_pay_success"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="btn_choose_success,         tv_desc_success,tv_name_success,iv_success_icon"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_success_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10px"
        android:src="@mipmap/arg_res_0x7f0e0025"
        app:layout_constraintBottom_toTopOf="@+id/tv_name_success"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="40px"
        android:textColor="@android:color/black"
        android:id="@+id/tv_name_success"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:adapt_calc_base_on="3"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="@android:color/darker_gray"
        android:id="@+id/tv_desc_success"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10px"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_name_success"/>
    <cn.cardoor.variety.base.ui.adapt.AutoButton
        android:textSize="24px"
        android:textColor="@android:color/white"
        android:id="@+id/btn_choose_success"
        android:paddingLeft="20px"
        android:paddingTop="10px"
        android:paddingRight="20px"
        android:paddingBottom="10px"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20px"
        android:paddingStart="20px"
        android:paddingEnd="20px"
        app:bl_corners_radius="60dp"
        app:bl_solid_color="@android:color/holo_blue_dark"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_desc_success"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="25px"
        android:textColor="#acacac"
        android:id="@+id/tv_error_reload"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/arg_res_0x7f1001c6"
        android:drawableTop="@mipmap/arg_res_0x7f0e0056"
        android:drawablePadding="25px"
        android:onClick="onClick"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <ProgressBar
        android:id="@+id/pb_loading"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintTop_toTopOf="0"
        style="@android:style/Widget.Holo.Light.ProgressBar.Large"/>
</cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
