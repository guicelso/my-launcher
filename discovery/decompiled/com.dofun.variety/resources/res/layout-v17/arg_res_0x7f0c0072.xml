<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/factory_line"
        android:background="#1affffff"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_back"
        android:layout_width="44px"
        android:layout_height="44px"
        android:layout_marginLeft="62px"
        android:src="@drawable/arg_res_0x7f080233"
        android:layout_marginStart="62px"
        app:layout_constraintBottom_toBottomOf="@+id/factory_line"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="32px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_factory_scan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/arg_res_0x7f10030a"
        app:layout_constraintBottom_toBottomOf="@+id/factory_line"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="@+id/factory_line"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="26px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_import"
        android:paddingLeft="12px"
        android:paddingRight="12px"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="50px"
        android:minWidth="160px"
        android:minHeight="50px"
        android:text="@string/arg_res_0x7f1003c1"
        android:layout_marginEnd="50px"
        app:adapt_calc_base_on="3"
        app:bl_corners_radius="100dp"
        app:bl_stroke_color="@android:color/white"
        app:bl_stroke_width="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/factory_line"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintTop_toTopOf="@+id/factory_line"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="@android:color/white"
        android:gravity="center_horizontal"
        android:id="@+id/tv_scan_device"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/arg_res_0x7f10012c"
        android:drawablePadding="10px"
        app:layout_constraintBottom_toTopOf="@+id/desc"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/factory_line"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="22px"
        android:textColor="@android:color/white"
        android:id="@+id/desc"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:layout_marginLeft="44px"
        android:layout_marginBottom="24px"
        android:text="@string/arg_res_0x7f10030c"
        android:lineSpacingExtra="4px"
        android:layout_marginStart="44px"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"/>
</androidx.constraintlayout.widget.ConstraintLayout>
