<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <Transition
        app:constraintSetEnd="@+id/vipPackageEnd"
        app:constraintSetStart="@+id/vipPackageStart"
        app:duration="1000"/>
    <ConstraintSet android:id="@+id/vipPackageStart">
        <Constraint
            android:id="@+id/tv_current_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleX="1"
            android:scaleY="1"
            app:layout_constraintBottom_toBottomOf="0"
            app:layout_constraintEnd_toStartOf="@+id/tv_origin_price"
            app:layout_constraintHorizontal_chainStyle="2"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toLeftOf="@+id/tv_origin_price"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toTopOf="0"
            app:layout_constraintVertical_bias="0.6"
            app:transitionEasing="cubic(0.3,0.4,0.5,0.8)"/>
        <Constraint
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/tv_current_price"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toBottomOf="@+id/tv_discount"
            app:transitionEasing="cubic(0.3,0.4,0.5,0.8)"/>
        <Constraint
            android:id="@+id/tv_origin_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10px"
            android:alpha="1"
            android:scaleX="1"
            android:scaleY="1"
            app:layout_constrainedWidth="true"
            app:layout_constraintBaseline_toBaselineOf="@+id/tv_current_price"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toRightOf="@+id/tv_current_price"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toEndOf="@+id/tv_current_price"
            app:transitionEasing="cubic(0.2,0.4,0.4,0.8)"/>
        <Constraint
            android:id="@+id/iv_discount_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="1"
            android:scaleX="1"
            android:scaleY="1"
            app:layout_constrainedHeight="true"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/tv_origin_price"
            app:layout_constraintEnd_toEndOf="@+id/tv_origin_price"
            app:layout_constraintLeft_toLeftOf="@+id/tv_origin_price"
            app:layout_constraintRight_toRightOf="@+id/tv_origin_price"
            app:layout_constraintStart_toStartOf="@+id/tv_origin_price"
            app:layout_constraintTop_toTopOf="@+id/tv_current_price"
            app:layout_constraintVertical_bias="1"
            app:transitionEasing="cubic(0.05,1,0.1,1)"
            app:visibilityMode="1">
            <CustomAttribute
                app:attributeName="pivotX"
                app:customFloatValue="1"/>
        </Constraint>
        <Constraint
            android:id="@+id/tv_vip_des"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="1"
            android:scaleX="1"
            android:scaleY="1"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="0"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toBottomOf="@+id/tv_current_price"
            app:transitionEasing="cubic(0.1,0.8,0.2,1)"/>
        <Constraint
            android:id="@+id/tv_discount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleX="1"
            android:scaleY="1"
            app:layout_constrainedHeight="true"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/fl_background"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toTopOf="@+id/fl_background"
            app:transitionEasing="cubic(0.2,0.4,0.4,0.8)"
            app:visibilityMode="1">
            <CustomAttribute
                app:attributeName="pivotX"
                app:customFloatValue="0"/>
        </Constraint>
        <Constraint
            android:id="@+id/img_discount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:scaleX="1"
            android:scaleY="1"
            app:layout_constraintBottom_toBottomOf="@+id/tv_discount"
            app:layout_constraintEnd_toEndOf="@+id/tv_discount"
            app:layout_constraintLeft_toLeftOf="@+id/tv_discount"
            app:layout_constraintRight_toRightOf="@+id/tv_discount"
            app:layout_constraintStart_toStartOf="@+id/tv_discount"
            app:layout_constraintTop_toTopOf="@+id/tv_discount"
            app:transitionEasing="cubic(0.2,0.4,0.4,0.8)"
            app:visibilityMode="1">
            <CustomAttribute
                app:attributeName="pivotX"
                app:customFloatValue="0"/>
        </Constraint>
        <Constraint
            android:id="@+id/fl_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="20px"
            app:transitionEasing="2"/>
    </ConstraintSet>
    <ConstraintSet android:id="@+id/vipPackageEnd">
        <Constraint
            android:id="@+id/tv_current_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10px"
            android:scaleX="0.7"
            android:scaleY="0.7"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintTop_toTopOf="0"
            app:transitionEasing="cubic(0.3,0.4,0.5,0.8)"/>
        <Constraint
            android:id="@+id/tv_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15px"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/tv_current_price"
            app:layout_constraintEnd_toStartOf="@+id/tv_current_price"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toLeftOf="@+id/tv_current_price"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toTopOf="@+id/tv_current_price"
            app:transitionEasing="cubic(0.3,0.4,0.5,0.8)"/>
        <Constraint
            android:id="@+id/tv_origin_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10px"
            android:alpha="0"
            android:scaleX="0"
            android:scaleY="0"
            app:layout_constrainedWidth="true"
            app:layout_constraintBaseline_toBaselineOf="@+id/tv_current_price"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:transitionEasing="cubic(0.2,0.4,0.4,0.8)"/>
        <Constraint
            android:id="@+id/iv_discount_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:scaleX="0"
            android:scaleY="0"
            app:layout_constrainedHeight="true"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/tv_origin_price"
            app:layout_constraintEnd_toEndOf="@+id/tv_origin_price"
            app:layout_constraintLeft_toLeftOf="@+id/tv_origin_price"
            app:layout_constraintRight_toRightOf="@+id/tv_origin_price"
            app:layout_constraintStart_toStartOf="@+id/tv_origin_price"
            app:layout_constraintTop_toTopOf="@+id/tv_current_price"
            app:layout_constraintVertical_bias="1"
            app:transitionEasing="cubic(0.2,0.4,0.4,0.8)"
            app:visibilityMode="1">
            <CustomAttribute
                app:attributeName="pivotX"
                app:customFloatValue="1"/>
        </Constraint>
        <Constraint
            android:id="@+id/tv_vip_des"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:scaleX="0"
            android:scaleY="0"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toBottomOf="@+id/tv_current_price"
            app:transitionEasing="cubic(0.1,0.8,0.2,1)"/>
        <Constraint
            android:id="@+id/tv_discount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleX="0.9"
            android:scaleY="0.9"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toTopOf="@+id/fl_background"
            app:layout_constraintHeight_max="40px"
            app:layout_constraintHeight_min="20px"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toTopOf="@+id/fl_background"
            app:transitionEasing="cubic(0.2,0.4,0.4,0.8)"
            app:visibilityMode="1">
            <CustomAttribute
                app:attributeName="pivotX"
                app:customFloatValue="0"/>
        </Constraint>
        <Constraint
            android:id="@+id/img_discount"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleX="0.9"
            android:scaleY="0.9"
            app:layout_constrainedHeight="true"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/tv_discount"
            app:layout_constraintEnd_toEndOf="@+id/tv_discount"
            app:layout_constraintLeft_toLeftOf="@+id/tv_discount"
            app:layout_constraintRight_toRightOf="@+id/tv_discount"
            app:layout_constraintStart_toStartOf="@+id/tv_discount"
            app:layout_constraintTop_toTopOf="@+id/tv_discount"
            app:transitionEasing="cubic(0.2,0.4,0.4,0.8)"
            app:visibilityMode="1">
            <CustomAttribute
                app:attributeName="pivotX"
                app:customFloatValue="0"/>
        </Constraint>
        <Constraint
            android:id="@+id/fl_background"
            android:layout_width="match_parent"
            android:layout_height="0px"
            android:layout_marginTop="20px"
            android:maxHeight="100px"
            android:minHeight="90px"
            app:layout_constraintBottom_toBottomOf="@+id/tv_current_price"
            app:layout_constraintTop_toTopOf="0"
            app:transitionEasing="2"/>
    </ConstraintSet>
</MotionScene>
