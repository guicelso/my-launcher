<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_checked="true"
        android:id="@+id/on"
        android:drawable="@drawable/arg_res_0x7f08014d"/>
    <item
        android:id="@+id/off"
        android:drawable="@drawable/arg_res_0x7f08014b"/>
    <transition
        android:drawable="@drawable/arg_res_0x7f08014e"
        android:toId="@+id/off"
        android:fromId="@+id/on"/>
    <transition
        android:drawable="@drawable/arg_res_0x7f08014c"
        android:toId="@+id/on"
        android:fromId="@+id/off"/>
</animated-selector>
