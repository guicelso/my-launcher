<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:height="@dimen/arg_res_0x7f0702eb"
    android:width="@dimen/arg_res_0x7f0702eb">
    <item
        android:state_pressed="true"
        android:id="@+id/pressed"
        android:drawable="@drawable/arg_res_0x7f0801f8"/>
    <item
        android:state_checked="true"
        android:id="@+id/checked"
        android:drawable="@drawable/arg_res_0x7f0801f5"/>
    <item
        android:id="@+id/with_icon"
        android:drawable="@drawable/arg_res_0x7f0801f5"
        app:state_with_icon="true"/>
    <item
        android:id="@+id/unchecked"
        android:drawable="@drawable/arg_res_0x7f0801fb"/>
    <transition
        android:drawable="@drawable/arg_res_0x7f0801f9"
        android:toId="@+id/checked"
        android:fromId="@+id/pressed"/>
    <transition
        android:drawable="@drawable/arg_res_0x7f0801f9"
        android:toId="@+id/with_icon"
        android:fromId="@+id/pressed"/>
    <transition
        android:drawable="@drawable/arg_res_0x7f0801fa"
        android:toId="@+id/unchecked"
        android:fromId="@+id/pressed"/>
    <transition
        android:drawable="@drawable/arg_res_0x7f0801f6"
        android:toId="@+id/pressed"
        android:fromId="@+id/checked"/>
    <transition
        android:drawable="@drawable/arg_res_0x7f0801f7"
        android:toId="@+id/unchecked"
        android:fromId="@+id/checked"/>
    <transition
        android:drawable="@drawable/arg_res_0x7f0801f6"
        android:toId="@+id/pressed"
        android:fromId="@+id/with_icon"/>
    <transition
        android:drawable="@drawable/arg_res_0x7f0801fd"
        android:toId="@+id/pressed"
        android:fromId="@+id/unchecked"/>
    <transition
        android:drawable="@drawable/arg_res_0x7f0801fc"
        android:toId="@+id/checked"
        android:fromId="@+id/unchecked"/>
</animated-selector>
