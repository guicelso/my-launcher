<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/variety_window_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/cl_widget"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="35px"
        android:layout_marginTop="30px"
        android:layout_marginRight="35px"
        android:layout_marginBottom="30px"
        android:layout_marginHorizontal="35px"
        android:layout_marginVertical="30px"
        app:adapt_calc_base_on="3">
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="72px"
            android:textColor="@color/arg_res_0x7f060330"
            android:gravity="center"
            android:id="@+id/tv_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25px"
            android:layout_marginTop="30px"
            android:includeFontPadding="false"
            android:layout_marginStart="25px"
            app:adapt_calc_base_on="3"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toTopOf="0"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="26px"
            android:textColor="@color/arg_res_0x7f060330"
            android:id="@+id/tv_meridiem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginStart="10px"
            app:adapt_calc_base_on="3"
            app:layout_constraintBaseline_toBaselineOf="@+id/tv_date"
            app:layout_constraintStart_toEndOf="@+id/tv_time"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="26px"
            android:textColor="@color/arg_res_0x7f060330"
            android:id="@+id/tv_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6px"
            android:layout_marginStart="50px"
            app:adapt_calc_base_on="3"
            app:layout_constraintBottom_toTopOf="@+id/tv_week"
            app:layout_constraintStart_toEndOf="@+id/tv_meridiem"
            app:layout_constraintTop_toTopOf="@+id/tv_time"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="24px"
            android:textColor="@color/arg_res_0x7f060330"
            android:id="@+id/tv_week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6px"
            app:adapt_calc_base_on="3"
            app:layout_constraintBottom_toBottomOf="@+id/tv_time"
            app:layout_constraintStart_toStartOf="@+id/tv_date"
            app:layout_constraintTop_toBottomOf="@+id/tv_date"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="3"
            app:constraint_referenced_ids="tv_time,tv_week"/>
        <cn.cardoor.variety.base.ui.adapt.AutoRecyclerView
            android:id="@+id/rv_data"
            android:focusable="false"
            android:scrollbars="none"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fadeScrollbars="false"
            android:overScrollMode="never"
            app:adapt_calc_base_on="3"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="0"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toBottomOf="@+id/barrier"
            app:layout_constraintVertical_bias="0.62"/>
    </cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
</merge>
