<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.variety.base.ui.adapt.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_vertical"
    android:paddingLeft="24px"
    android:paddingRight="24px"
    android:layout_width="match_parent"
    android:layout_height="90px"
    android:paddingHorizontal="24px"
    app:adapt_calc_base_on="3">
    <cn.cardoor.variety.base.ui.adapt.AutoSeekBar
        android:id="@+id/seekbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="30px"
        android:max="180"
        android:progressDrawable="@drawable/arg_res_0x7f08021e"
        android:minHeight="30px"
        android:thumb="@null"
        android:layout_toLeftOf="@+id/iv_add"
        android:layout_toRightOf="@+id/iv_decrease"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/iv_add"
        android:layout_toEndOf="@+id/iv_decrease"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_decrease"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@mipmap/arg_res_0x7f0e001b"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"
        app:is_square="true"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@mipmap/arg_res_0x7f0e000d"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        app:is_square="true"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="26px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_min"
        android:paddingLeft="15px"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/arg_res_0x7f100355"
        android:layout_alignLeft="@+id/seekbar"
        android:layout_centerVertical="true"
        android:paddingStart="15px"
        android:layout_alignStart="@+id/seekbar"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="26px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_max"
        android:paddingRight="15px"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/arg_res_0x7f100354"
        android:layout_alignRight="@+id/seekbar"
        android:layout_centerVertical="true"
        android:paddingEnd="15px"
        android:layout_alignEnd="@+id/seekbar"/>
</cn.cardoor.variety.base.ui.adapt.AutoRelativeLayout>
