<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout
        android:layout_width="740px"
        android:layout_height="480px"
        app:adapt_calc_base_on="5"
        app:bl_corners_radius="20px"
        app:bl_solid_color="#fff6f6f6">
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="24px"
            android:textColor="@android:color/black"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25px"
            android:layout_marginTop="18px"
            android:text="@string/arg_res_0x7f10013e"
            android:layout_marginStart="25px"
            app:adapt_calc_base_on="5"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toTopOf="0"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="20px"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:id="@+id/tv_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="30px"
            android:text="@string/arg_res_0x7f10013c"
            android:drawableLeft="@drawable/arg_res_0x7f08018c"
            android:drawablePadding="8px"
            android:drawableStart="@drawable/arg_res_0x7f08018c"
            android:layout_marginEnd="30px"
            app:adapt_calc_base_on="5"
            app:layout_constraintBottom_toBottomOf="@+id/tv_save"
            app:layout_constraintEnd_toStartOf="@+id/tv_cancel"
            app:layout_constraintRight_toLeftOf="@+id/tv_cancel"
            app:layout_constraintTop_toTopOf="@+id/tv_save"
            app:startDrawableHeight="22px"
            app:startDrawableWidth="22px"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="20px"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:id="@+id/tv_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="30px"
            android:text="@android:string/cancel"
            android:drawableLeft="@drawable/arg_res_0x7f08018d"
            android:drawablePadding="8px"
            android:drawableStart="@drawable/arg_res_0x7f08018d"
            android:layout_marginEnd="30px"
            app:adapt_calc_base_on="5"
            app:layout_constraintBottom_toBottomOf="@+id/tv_save"
            app:layout_constraintEnd_toStartOf="@+id/tv_save"
            app:layout_constraintRight_toLeftOf="@+id/tv_save"
            app:layout_constraintTop_toTopOf="@+id/tv_save"
            app:startDrawableHeight="22px"
            app:startDrawableWidth="22px"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:enabled="false"
            android:textSize="20px"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:id="@+id/tv_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="20px"
            android:text="@string/arg_res_0x7f10013d"
            android:drawableLeft="@drawable/arg_res_0x7f08018e"
            android:drawablePadding="8px"
            android:drawableStart="@drawable/arg_res_0x7f08018e"
            android:layout_marginEnd="20px"
            app:adapt_calc_base_on="5"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintTop_toTopOf="@+id/tv_title"
            app:startDrawableHeight="22px"
            app:startDrawableWidth="22px"/>
        <cn.cardoor.variety.base.ui.rvx.DragDropSwipeRecyclerView
            android:id="@+id/rv_dw_selected_apps"
            android:paddingLeft="8px"
            android:paddingRight="8px"
            android:focusable="false"
            android:scrollbars="horizontal"
            android:layout_width="0dp"
            android:layout_height="120px"
            android:layout_marginLeft="25px"
            android:layout_marginTop="20px"
            android:layout_marginRight="25px"
            android:fadeScrollbars="false"
            android:overScrollMode="always"
            android:layout_marginHorizontal="25px"
            android:paddingHorizontal="8px"
            app:adapt_calc_base_on="5"
            app:bl_corners_radius="12px"
            app:bl_solid_color="@android:color/white"
            app:divider="@drawable/arg_res_0x7f08023e"
            app:item_layout="@layout/arg_res_0x7f0c0095"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"
            app:long_press_to_start_dragging="true"/>
        <cn.cardoor.variety.base.ui.adapt.AutoRecyclerView
            android:id="@+id/rv_dw_apps"
            android:focusable="false"
            android:scrollbars="vertical"
            android:layout_width="0dp"
            android:layout_height="0px"
            android:layout_marginTop="20px"
            android:layout_marginBottom="8px"
            android:fadeScrollbars="false"
            android:overScrollMode="always"
            app:layout_constraintBottom_toBottomOf="0"
            app:layout_constraintEnd_toEndOf="@+id/rv_dw_selected_apps"
            app:layout_constraintLeft_toLeftOf="@+id/rv_dw_selected_apps"
            app:layout_constraintRight_toRightOf="@+id/rv_dw_selected_apps"
            app:layout_constraintStart_toStartOf="@+id/rv_dw_selected_apps"
            app:layout_constraintTop_toBottomOf="@+id/rv_dw_selected_apps"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_saving_mask"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:bl_corners_radius="20dp"
            app:bl_solid_color="#3b333333">
            <cn.cardoor.variety.base.ui.adapt.AutoProgressBar
                android:layout_width="132px"
                android:layout_height="132px"
                android:indeterminate="false"
                android:indeterminateDrawable="@drawable/arg_res_0x7f0801b5"
                app:adapt_calc_base_on="5"
                style="@android:style/Widget.Holo.Light.ProgressBar.Large"/>
            <cn.cardoor.variety.base.ui.adapt.AutoTextView
                android:textSize="20px"
                android:textColor="#aeafb9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10px"
                android:text="@string/arg_res_0x7f1001c7"
                app:adapt_calc_base_on="5"/>
        </LinearLayout>
    </cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
</FrameLayout>
