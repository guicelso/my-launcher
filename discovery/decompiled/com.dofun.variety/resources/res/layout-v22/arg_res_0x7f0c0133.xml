<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="20px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_count_down"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="12px"
        android:layout_marginEnd="12px"
        app:adapt_calc_base_on="5"
        app:fitTypeface="false"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/tv_left"
        app:layout_constraintEnd_toStartOf="@+id/tv_left"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toLeftOf="@+id/tv_left"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="@+id/tv_left"/>
    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/arg_res_0x7f080215"
        app:layout_constraintBottom_toBottomOf="@+id/tv_left"
        app:layout_constraintEnd_toEndOf="@+id/tv_left"
        app:layout_constraintLeft_toLeftOf="@+id/tv_left"
        app:layout_constraintRight_toRightOf="@+id/tv_left"
        app:layout_constraintStart_toStartOf="@+id/tv_left"
        app:layout_constraintTop_toTopOf="@+id/tv_left"
        style="?android:attr/progressBarStyleHorizontal"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="26px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_left"
        android:paddingLeft="20px"
        android:paddingTop="10px"
        android:paddingRight="20px"
        android:paddingBottom="10px"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10px"
        android:minWidth="150px"
        android:paddingStart="20px"
        android:paddingEnd="20px"
        android:layout_marginEnd="10px"
        app:adapt_calc_base_on="5"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toStartOf="@+id/tv_price"
        app:layout_constraintHorizontal_chainStyle="2"
        app:layout_constraintLeft_toRightOf="@+id/tv_count_down"
        app:layout_constraintRight_toLeftOf="@+id/tv_price"
        app:layout_constraintStart_toEndOf="@+id/tv_count_down"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="16px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_amount"
        android:paddingLeft="6px"
        android:paddingRight="6px"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="-6px"
        android:layout_marginEnd="-6px"
        android:paddingHorizontal="6px"
        app:adapt_calc_base_on="5"
        app:bl_corners_bottomLeftRadius="0dp"
        app:bl_corners_bottomRightRadius="18px"
        app:bl_corners_topRadius="18px"
        app:bl_solid_color="#ff00ef29"
        app:layout_constraintBottom_toTopOf="@+id/tv_left"
        app:layout_constraintEnd_toEndOf="@+id/tv_left"
        app:layout_constraintRight_toRightOf="@+id/tv_left"
        app:layout_constraintTop_toTopOf="@+id/tv_left"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="26px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_price"
        android:background="@drawable/arg_res_0x7f08024a"
        android:paddingLeft="20px"
        android:paddingTop="10px"
        android:paddingRight="20px"
        android:paddingBottom="10px"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10px"
        android:maxWidth="200px"
        android:minWidth="150px"
        android:text="@string/arg_res_0x7f100136"
        android:paddingStart="20px"
        android:paddingEnd="20px"
        android:layout_marginStart="10px"
        app:adapt_calc_base_on="5"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toStartOf="@+id/tv_original_price"
        app:layout_constraintLeft_toRightOf="@+id/tv_left"
        app:layout_constraintRight_toLeftOf="@+id/tv_original_price"
        app:layout_constraintStart_toEndOf="@+id/tv_left"
        app:layout_constraintTop_toTopOf="0"/>
    <com.dofun.overseasvariety.view.AutoDelTextView
        android:textSize="22px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_original_price"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12px"
        android:layout_marginStart="12px"
        app:delColor="@color/arg_res_0x7f0602b8"
        app:delShowing="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/tv_price"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toRightOf="@+id/tv_price"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toEndOf="@+id/tv_price"
        app:layout_constraintTop_toTopOf="@+id/tv_price"/>
</androidx.constraintlayout.widget.ConstraintLayout>
