<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@drawable/arg_res_0x7f08025a"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout
        android:layout_gravity="center"
        android:paddingTop="40px"
        android:paddingBottom="40px"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="26px"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:id="@+id/tv_keep_system_launcher_launch_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30px"
            android:layout_marginRight="30px"
            android:text="@string/arg_res_0x7f1001a9"
            android:layout_marginHorizontal="30px"
            app:layout_constraintBottom_toTopOf="@+id/tv_keep_system_launcher_launch_desc"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toTopOf="0"
            app:layout_constraintVertical_chainStyle="2"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="22px"
            android:textColor="#a9a9a9"
            android:id="@+id/tv_keep_system_launcher_launch_desc"
            android:scrollbars="vertical"
            android:fadingEdge="vertical"
            android:fadingEdgeLength="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="54px"
            android:layout_marginTop="30px"
            android:layout_marginRight="54px"
            android:maxWidth="600px"
            android:maxHeight="200px"
            android:text="@string/arg_res_0x7f1001aa"
            android:lineSpacingExtra="6px"
            android:fadeScrollbars="false"
            android:requiresFadingEdge="vertical"
            android:layout_marginStart="54px"
            android:layout_marginEnd="54px"
            app:adapt_calc_base_on="3"
            app:layout_constraintBottom_toTopOf="@+id/cb_auto_back_home"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toBottomOf="@+id/tv_keep_system_launcher_launch_title"/>
        <cn.cardoor.variety.base.ui.adapt.AutoCheckBox
            android:textSize="22px"
            android:textColor="#a9a9a9"
            android:gravity="center_vertical"
            android:id="@+id/cb_auto_back_home"
            android:paddingLeft="10px"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="40px"
            android:layout_marginLeft="10px"
            android:layout_marginTop="10px"
            android:button="@drawable/arg_res_0x7f080224"
            android:text="@string/arg_res_0x7f100305"
            android:paddingStart="10px"
            android:layout_marginStart="10px"
            app:adapt_calc_base_on="3"
            app:layout_constraintBottom_toTopOf="@+id/btn_keep_system_launcher_launch_cancel"
            app:layout_constraintStart_toStartOf="@+id/tv_keep_system_launcher_launch_desc"
            app:layout_constraintTop_toBottomOf="@+id/tv_keep_system_launcher_launch_desc"/>
        <cn.cardoor.variety.base.ui.adapt.AutoButton
            android:textSize="26px"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/btn_keep_system_launcher_launch_cancel"
            android:background="@drawable/arg_res_0x7f080231"
            android:layout_width="250px"
            android:layout_height="70px"
            android:layout_marginTop="20px"
            android:text="@string/arg_res_0x7f1000b3"
            app:adapt_calc_base_on="3"
            app:layout_constraintBottom_toBottomOf="0"
            app:layout_constraintEnd_toStartOf="@+id/btn_keep_system_launcher_launch_ctrl"
            app:layout_constraintHorizontal_chainStyle="2"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toLeftOf="@+id/btn_keep_system_launcher_launch_ctrl"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toBottomOf="@+id/cb_auto_back_home"/>
        <cn.cardoor.variety.base.ui.adapt.AutoButton
            android:textSize="26px"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/btn_keep_system_launcher_launch_ctrl"
            android:background="@drawable/arg_res_0x7f080231"
            android:layout_width="250px"
            android:layout_height="70px"
            android:layout_marginLeft="60px"
            android:layout_marginTop="20px"
            android:layout_marginBottom="20dp"
            android:text="@string/arg_res_0x7f1000d1"
            android:layout_marginStart="60px"
            app:adapt_calc_base_on="3"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toRightOf="@+id/btn_keep_system_launcher_launch_cancel"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toEndOf="@+id/btn_keep_system_launcher_launch_cancel"
            app:layout_constraintTop_toBottomOf="@+id/cb_auto_back_home"/>
    </cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
</FrameLayout>
