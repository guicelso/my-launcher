<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="12px"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:adapt_calc_base_on="3">
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_back"
        android:paddingLeft="3px"
        android:paddingTop="3px"
        android:paddingRight="3px"
        android:paddingBottom="3px"
        android:layout_width="23px"
        android:layout_height="23px"
        android:layout_marginLeft="6px"
        android:src="@mipmap/arg_res_0x7f0e0044"
        android:layout_marginStart="6px"
        android:paddingHorizontal="3px"
        android:paddingVertical="3px"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="@+id/tv_title"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="20px"
        android:textColor="@android:color/black"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15px"
        android:text="@string/arg_res_0x7f100252"
        app:adapt_calc_base_on="3"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="20px"
        android:textColor="@android:color/black"
        android:id="@+id/tv_show_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="25px"
        android:text="@string/arg_res_0x7f10032c"
        android:layout_marginStart="25px"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toBottomOf="@+id/switch_show_app_name"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="@+id/switch_show_app_name"/>
    <com.dofun.overseasvariety.view.SwitchView
        android:id="@+id/switch_show_app_name"
        android:paddingLeft="4px"
        android:paddingTop="4px"
        android:paddingRight="4px"
        android:paddingBottom="4px"
        android:layout_width="55px"
        android:layout_height="35px"
        android:layout_marginTop="25px"
        android:layout_marginRight="25px"
        android:layout_marginEnd="25px"
        android:paddingHorizontal="4px"
        android:paddingVertical="4px"
        app:adapt_calc_base_on="3"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        app:primaryColor="#ff00a2f9"/>
    <cn.cardoor.variety.base.ui.adapt.AutoSpace
        android:layout_width="wrap_content"
        android:layout_height="10px"
        app:layout_constraintTop_toBottomOf="@+id/switch_show_app_name"/>
</cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
