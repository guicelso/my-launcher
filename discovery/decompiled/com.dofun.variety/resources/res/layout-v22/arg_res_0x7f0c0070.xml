<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="#cc000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="28px"
        android:gravity="center"
        android:id="@+id/tv_dw_app_info"
        android:background="@drawable/arg_res_0x7f080167"
        android:paddingLeft="20px"
        android:paddingTop="6px"
        android:paddingRight="20px"
        android:paddingBottom="6px"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="5px"
        android:paddingStart="20px"
        android:paddingEnd="20px"
        app:adapt_calc_base_on="5"
        app:layout_constraintBottom_toTopOf="@+id/tv_dw_app_tips"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"
        app:layout_constraintVertical_chainStyle="2"
        style="@style/arg_res_0x7f110124"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="26px"
        android:id="@+id/tv_dw_app_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4px"
        android:text="@string/arg_res_0x7f10010e"
        app:adapt_calc_base_on="5"
        app:layout_constraintBottom_toTopOf="@+id/tv_go_download"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_dw_app_info"
        style="@style/arg_res_0x7f110124"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="20px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_go_download"
        android:background="@drawable/arg_res_0x7f080145"
        android:paddingLeft="20px"
        android:paddingTop="5px"
        android:paddingRight="20px"
        android:paddingBottom="5px"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="10px"
        android:minWidth="100px"
        android:minHeight="30px"
        android:text="@string/arg_res_0x7f100185"
        android:singleLine="true"
        android:layout_marginStart="8dp"
        android:paddingHorizontal="20px"
        android:paddingVertical="5px"
        app:adapt_calc_base_on="5"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_dw_app_tips"
        app:minTextSize="14dp"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="20px"
        android:textColor="@android:color/white"
        android:ellipsize="middle"
        android:gravity="center"
        android:id="@+id/tv_modify_desktop_floating_app_window"
        android:background="@drawable/arg_res_0x7f080145"
        android:paddingLeft="20px"
        android:paddingTop="5px"
        android:paddingRight="20px"
        android:paddingBottom="5px"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10px"
        android:minWidth="100px"
        android:minHeight="30px"
        android:text="@string/arg_res_0x7f100107"
        android:singleLine="true"
        android:paddingHorizontal="20px"
        android:paddingVertical="5px"
        app:adapt_calc_base_on="5"
        app:layout_constrainedWidth="false"
        app:layout_constraintEnd_toEndOf="@+id/tv_go_download"
        app:layout_constraintStart_toStartOf="@+id/tv_go_download"
        app:layout_constraintTop_toBottomOf="@+id/tv_go_download"
        app:minTextSize="14dp"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_close_floating_app_window"
        android:layout_width="30px"
        android:layout_height="30px"
        android:layout_marginTop="18px"
        android:layout_marginRight="18px"
        android:src="@drawable/arg_res_0x7f080188"
        android:layout_marginEnd="18px"
        app:adapt_calc_base_on="3"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintTop_toTopOf="0"/>
</androidx.constraintlayout.widget.ConstraintLayout>
