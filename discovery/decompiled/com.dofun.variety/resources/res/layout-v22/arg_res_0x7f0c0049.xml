<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:bl_corners_radius="20dp"
    app:bl_solid_color="@android:color/white">
    <cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout
        android:layout_gravity="center"
        android:paddingTop="40px"
        android:paddingBottom="40px"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.dofun.overseasvariety.view.RoundImageView
            android:id="@+id/iv_access_notification_icon"
            android:layout_width="90px"
            android:layout_height="90px"
            android:src="@drawable/app_theme"
            app:adapt_calc_base_on="3"
            app:imageType="1"
            app:is_square="true"
            app:layout_constraintBottom_toTopOf="@+id/tv_access_notification_title"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toTopOf="0"
            app:layout_constraintVertical_chainStyle="2"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="28px"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:id="@+id/tv_access_notification_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30px"
            android:layout_marginTop="10px"
            android:layout_marginRight="30px"
            android:text="@string/arg_res_0x7f10031e"
            android:layout_marginHorizontal="30px"
            app:layout_constraintBottom_toTopOf="@+id/tv_access_notification_desc"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toBottomOf="@+id/iv_access_notification_icon"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="22px"
            android:textColor="#a9a9a9"
            android:id="@+id/tv_access_notification_desc"
            android:scrollbars="vertical"
            android:fadingEdge="vertical"
            android:fadingEdgeLength="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="54px"
            android:layout_marginTop="30px"
            android:layout_marginRight="54px"
            android:maxWidth="600px"
            android:maxHeight="200px"
            android:lineSpacingExtra="6px"
            android:fadeScrollbars="false"
            android:requiresFadingEdge="vertical"
            android:layout_marginStart="54px"
            android:layout_marginEnd="54px"
            app:adapt_calc_base_on="3"
            app:fitTypeface="false"
            app:layout_constraintBottom_toTopOf="@+id/btn_do_not_use"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toBottomOf="@+id/tv_access_notification_title"
            app:pressed_effect="false"/>
        <cn.cardoor.variety.base.ui.adapt.AutoButton
            android:textSize="26px"
            android:textColor="@color/arg_res_0x7f060035"
            android:gravity="center"
            android:id="@+id/btn_do_not_use"
            android:layout_width="250px"
            android:layout_height="70px"
            android:layout_marginTop="60px"
            app:adapt_calc_base_on="3"
            app:bl_corners_radius="100dp"
            app:bl_stroke_color="@color/arg_res_0x7f060035"
            app:bl_stroke_width="1dp"
            app:layout_constraintBottom_toBottomOf="0"
            app:layout_constraintEnd_toStartOf="@+id/btn_authorize"
            app:layout_constraintHorizontal_chainStyle="2"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toLeftOf="@+id/btn_authorize"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toBottomOf="@+id/tv_access_notification_desc"/>
        <cn.cardoor.variety.base.ui.adapt.AutoButton
            android:textSize="26px"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/btn_authorize"
            android:layout_width="250px"
            android:layout_height="70px"
            android:layout_marginLeft="60px"
            android:layout_marginTop="60px"
            android:layout_marginBottom="20dp"
            android:layout_marginStart="60px"
            app:adapt_calc_base_on="3"
            app:bl_corners_radius="100dp"
            app:bl_solid_color="@color/arg_res_0x7f060035"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toRightOf="@+id/btn_do_not_use"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toEndOf="@+id/btn_do_not_use"
            app:layout_constraintTop_toBottomOf="@+id/tv_access_notification_desc"/>
    </cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
</FrameLayout>
