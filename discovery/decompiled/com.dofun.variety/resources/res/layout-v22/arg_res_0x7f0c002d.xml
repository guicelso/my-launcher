<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_back"
        android:layout_width="44px"
        android:layout_height="44px"
        android:layout_marginLeft="30px"
        android:layout_marginTop="30px"
        android:src="@mipmap/arg_res_0x7f0e0069"
        android:layout_marginStart="30px"
        app:adapt_calc_base_on="5"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="30px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_theme_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/iv_back"
        app:layout_constraintEnd_toEndOf="@+id/vp_theme_details"
        app:layout_constraintLeft_toLeftOf="@+id/vp_theme_details"
        app:layout_constraintRight_toRightOf="@+id/vp_theme_details"
        app:layout_constraintStart_toStartOf="@+id/vp_theme_details"
        app:layout_constraintTop_toTopOf="@+id/iv_back"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_theme_update"
        android:layout_width="30px"
        android:layout_height="30px"
        android:layout_marginLeft="18px"
        android:scaleType="fitXY"
        android:layout_marginStart="18px"
        app:is_square="true"
        app:layout_constraintBottom_toBottomOf="@+id/tv_theme_name"
        app:layout_constraintLeft_toRightOf="@+id/tv_theme_name"
        app:layout_constraintStart_toEndOf="@+id/tv_theme_name"
        app:layout_constraintTop_toTopOf="@+id/tv_theme_name"/>
    <cn.cardoor.variety.base.ui.adapt.AutoView
        android:id="@+id/view_end_of_update"
        android:layout_width="1px"
        android:layout_height="1px"
        android:layout_marginLeft="30px"
        android:layout_marginStart="30px"
        app:adapt_calc_base_on="5"
        app:layout_constraintBottom_toBottomOf="@+id/iv_theme_update"
        app:layout_constraintLeft_toRightOf="@+id/iv_theme_update"
        app:layout_constraintStart_toEndOf="@+id/iv_theme_update"
        app:layout_constraintTop_toTopOf="@+id/iv_theme_update"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_favorite"
        android:visibility="invisible"
        android:layout_width="35px"
        android:layout_height="35px"
        android:layout_marginRight="40px"
        android:src="@drawable/arg_res_0x7f080229"
        android:scaleType="fitXY"
        android:layout_marginEnd="40px"
        app:adapt_calc_base_on="5"
        app:is_square="true"
        app:layout_constraintBottom_toBottomOf="@+id/tv_theme_name"
        app:layout_constraintEnd_toStartOf="@+id/barrier_right"
        app:layout_constraintTop_toTopOf="@+id/tv_theme_name"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_go_login"
        android:visibility="invisible"
        android:layout_width="35px"
        android:layout_height="35px"
        android:layout_marginRight="20px"
        android:src="@drawable/arg_res_0x7f0801b4"
        android:scaleType="fitXY"
        android:layout_marginEnd="20px"
        app:adapt_calc_base_on="5"
        app:is_square="true"
        app:layout_constraintBottom_toBottomOf="@+id/iv_favorite"
        app:layout_constraintEnd_toStartOf="@+id/iv_favorite"
        app:layout_constraintTop_toTopOf="@+id/iv_favorite"/>
    <com.dofun.variety.ui.BottomIndicatorRadioGroup
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/rg_alone_themes"
        android:paddingTop="28px"
        android:paddingBottom="12px"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="240px"
        app:adapt_calc_base_on="3"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintTop_toTopOf="0">
        <cn.cardoor.variety.base.ui.adapt.AutoRadioButton
            android:textSize="24px"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/rb_introduction"
            android:focusable="true"
            android:visibility="@integer/arg_res_0x7f0a0009"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:maxWidth="100px"
            android:minWidth="80px"
            android:text="@string/arg_res_0x7f1001a5"
            app:adapt_calc_base_on="3"/>
        <cn.cardoor.variety.base.ui.adapt.AutoRadioButton
            android:textSize="24px"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/rb_features"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:minWidth="80px"
            android:text="@string/arg_res_0x7f100169"
            app:adapt_calc_base_on="3"/>
        <cn.cardoor.variety.base.ui.adapt.AutoRadioButton
            android:textSize="24px"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/rb_discounts"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:minWidth="80px"
            android:text="@string/arg_res_0x7f10012e"
            app:adapt_calc_base_on="3"/>
    </com.dofun.variety.ui.BottomIndicatorRadioGroup>
    <cn.cardoor.variety.base.ui.adapt.AutoFrameLayout
        android:id="@+id/rl_alone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="@+id/rg_alone_themes"
        app:layout_constraintTop_toBottomOf="@+id/rg_alone_themes"/>
    <androidx.constraintlayout.helper.widget.Layer
        android:id="@+id/layer_rg"
        android:background="#0affffff"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:constraint_referenced_ids="rg_alone_themes,rl_alone"/>
    <cn.cardoor.variety.base.ui.adapt.AutoFrameLayout
        android:id="@+id/fl_linkage_instructions"
        android:background="#0affffff"
        android:visibility="gone"
        android:layout_width="260px"
        android:layout_height="match_parent"
        app:adapt_calc_base_on="3"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintRight_toRightOf="0"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="5"
        app:constraint_referenced_ids="rg_alone_themes"/>
    <cn.cardoor.variety.base.ui.adapt.AutoView
        android:id="@+id/anchor_theme_group_popup"
        android:layout_width="0dp"
        android:layout_height="8px"
        app:adapt_calc_base_on="3"
        app:layout_constraintEnd_toEndOf="@+id/vp_theme_details"
        app:layout_constraintLeft_toLeftOf="@+id/vp_theme_details"
        app:layout_constraintRight_toRightOf="@+id/vp_theme_details"
        app:layout_constraintStart_toStartOf="@+id/vp_theme_details"
        app:layout_constraintTop_toBottomOf="@+id/iv_back"/>
    <cn.cardoor.variety.base.ui.adapt.AutoViewPager
        android:id="@+id/vp_theme_details"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="50px"
        android:layout_marginTop="26px"
        android:layout_marginRight="50px"
        android:layout_marginHorizontal="50px"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toTopOf="@+id/dot_view"
        app:layout_constraintEnd_toStartOf="@+id/barrier_right"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toLeftOf="@+id/barrier_right"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_theme_name"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="16px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_details_vip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginRight="15px"
        android:minWidth="48px"
        android:layout_marginEnd="15px"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toBottomOf="@+id/ll_preview_img_resolution"
        app:layout_constraintEnd_toStartOf="@+id/ll_preview_img_resolution"
        app:layout_constraintRight_toLeftOf="@+id/ll_preview_img_resolution"
        app:layout_constraintTop_toTopOf="@+id/ll_preview_img_resolution"/>
    <cn.cardoor.variety.base.ui.adapt.AutoLinearLayout
        android:gravity="center"
        android:id="@+id/ll_preview_img_resolution"
        android:padding="4px"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="110px"
        app:adapt_calc_base_on="3"
        app:layout_constraintEnd_toEndOf="@+id/vp_theme_details"
        app:layout_constraintRight_toRightOf="@+id/vp_theme_details"
        app:layout_constraintTop_toTopOf="@+id/vp_theme_details">
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="15px"
            android:textColor="@android:color/white"
            android:id="@+id/tv_resolution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <cn.cardoor.variety.base.ui.adapt.AutoImageView
            android:id="@+id/iv_resolution_triangle"
            android:layout_width="8px"
            android:layout_height="8px"
            android:layout_marginLeft="8px"
            android:src="@mipmap/arg_res_0x7f0e0081"
            android:layout_marginStart="8px"
            app:adapt_calc_base_on="3"/>
    </cn.cardoor.variety.base.ui.adapt.AutoLinearLayout>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_left_arrow"
        android:visibility="gone"
        android:layout_width="35px"
        android:layout_height="62px"
        android:layout_marginLeft="16px"
        android:src="@drawable/arg_res_0x7f0801af"
        android:layout_marginStart="16px"
        app:layout_constraintBottom_toBottomOf="@+id/vp_theme_details"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="@+id/vp_theme_details"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_right_arrow"
        android:visibility="gone"
        android:layout_width="35px"
        android:layout_height="62px"
        android:layout_marginRight="16px"
        android:src="@drawable/arg_res_0x7f0801b1"
        android:layout_marginEnd="16px"
        app:layout_constraintBottom_toBottomOf="@+id/vp_theme_details"
        app:layout_constraintEnd_toStartOf="@+id/barrier_right"
        app:layout_constraintRight_toLeftOf="@+id/barrier_right"
        app:layout_constraintTop_toTopOf="@+id/vp_theme_details"/>
    <View
        android:id="@+id/iv_version_triangle"
        android:background="@drawable/arg_res_0x7f080265"
        android:layout_width="26px"
        android:layout_height="26px"
        app:adapt_calc_base_on="3"
        app:is_square="true"
        app:layout_constraintEnd_toEndOf="@+id/iv_theme_update"
        app:layout_constraintStart_toStartOf="@+id/iv_theme_update"
        app:layout_constraintTop_toBottomOf="@+id/iv_theme_update"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="20px"
        android:textColor="@android:color/white"
        android:gravity="start"
        android:id="@+id/tv_version_switch_tips"
        android:paddingLeft="12px"
        android:paddingTop="2px"
        android:paddingRight="12px"
        android:paddingBottom="2px"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12px"
        android:paddingVertical="2px"
        app:adapt_calc_base_on="3"
        app:bl_corners_radius="8dp"
        app:bl_solid_color="#00a6ff"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/view_end_of_update"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="@+id/view_end_of_update"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/iv_version_triangle"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_version_switch_tips"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="iv_version_triangle,tv_version_switch_tips"/>
    <com.dofun.overseasvariety.view.DotView
        android:id="@+id/dot_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15px"
        android:layout_marginBottom="15px"
        android:layout_marginVertical="15px"
        app:layout_constraintBottom_toTopOf="@+id/btn_pay"
        app:layout_constraintEnd_toEndOf="@+id/vp_theme_details"
        app:layout_constraintLeft_toLeftOf="@+id/vp_theme_details"
        app:layout_constraintRight_toRightOf="@+id/vp_theme_details"
        app:layout_constraintStart_toStartOf="@+id/vp_theme_details"
        app:layout_constraintTop_toBottomOf="@+id/vp_theme_details"/>
    <com.dofun.overseasvariety.view.PayButtonView
        android:id="@+id/btn_pay"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="26px"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toStartOf="@+id/barrier_right"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toLeftOf="@+id/barrier_right"
        app:layout_constraintStart_toStartOf="0"
        app:pressed_effect="false"/>
</androidx.constraintlayout.widget.ConstraintLayout>
