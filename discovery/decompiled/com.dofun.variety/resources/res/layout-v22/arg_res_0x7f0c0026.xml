<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/arg_res_0x7f08025a"
    android:paddingLeft="20px"
    android:paddingTop="10px"
    android:paddingRight="20px"
    android:paddingBottom="10px"
    android:layout_width="680px"
    android:layout_height="440px"
    android:paddingHorizontal="20px"
    android:paddingVertical="10px"
    app:adapt_calc_base_on="3">
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_close"
        android:layout_width="44px"
        android:layout_height="44px"
        android:src="@drawable/arg_res_0x7f080158"
        app:is_square="true"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="16px"
        android:textColor="@android:color/black"
        android:id="@+id/tv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:fitTypeface="false"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_app_icon"
        android:layout_width="44px"
        android:layout_height="44px"
        app:is_square="true"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_time"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="20px"
        android:textColor="@android:color/black"
        android:gravity="center"
        android:id="@+id/tv_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20px"
        android:text="@string/arg_res_0x7f1003ed"
        android:layout_marginStart="20px"
        app:fitTypeface="false"
        app:layout_constraintBottom_toBottomOf="@+id/iv_app_icon"
        app:layout_constraintLeft_toRightOf="@+id/iv_app_icon"
        app:layout_constraintStart_toEndOf="@+id/iv_app_icon"
        app:layout_constraintTop_toTopOf="@+id/iv_app_icon"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="3"
        app:constraint_referenced_ids="iv_app_icon,tv_app_name,iv_close"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="16px"
        android:textColor="@android:color/black"
        android:gravity="start"
        android:id="@+id/tv_error_info"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5px"
        android:layout_marginBottom="5px"
        android:lineSpacingExtra="6px"
        android:layout_marginVertical="5px"
        app:fitTypeface="false"
        app:layout_constraintBottom_toTopOf="@+id/divider"
        app:layout_constraintTop_toBottomOf="@+id/barrier_top"/>
    <View
        android:id="@+id/divider"
        android:background="@android:color/darker_gray"
        android:layout_width="match_parent"
        android:layout_height="2px"
        android:layout_marginBottom="20px"
        app:layout_constraintBottom_toTopOf="@+id/btn_upload"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_exception_icon"
        android:background="@drawable/arg_res_0x7f08028a"
        android:layout_width="40px"
        android:layout_height="40px"
        app:is_square="true"
        app:layout_constraintBottom_toBottomOf="@+id/btn_upload"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="@+id/btn_upload"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="@android:color/black"
        android:id="@+id/tv_exception"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20px"
        android:text="@string/arg_res_0x7f100147"
        android:layout_marginStart="20px"
        app:fitTypeface="false"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_bbid"
        app:layout_constraintEnd_toStartOf="@+id/btn_upload"
        app:layout_constraintLeft_toRightOf="@+id/iv_exception_icon"
        app:layout_constraintRight_toLeftOf="@+id/btn_upload"
        app:layout_constraintStart_toEndOf="@+id/iv_exception_icon"
        app:layout_constraintTop_toBottomOf="@+id/tv_error_info"/>
    <cn.cardoor.variety.base.ui.adapt.AutoButton
        android:textSize="24px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/btn_upload"
        android:background="@drawable/arg_res_0x7f080231"
        android:paddingTop="5px"
        android:paddingBottom="5px"
        android:layout_width="120px"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5px"
        android:text="@string/arg_res_0x7f1003e8"
        android:paddingVertical="5px"
        app:layout_constraintBottom_toTopOf="@+id/tv_bbid"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintRight_toRightOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="20px"
        android:textColor="@android:color/black"
        android:gravity="start"
        android:id="@+id/tv_bbid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:fitTypeface="false"
        app:layout_constraintBottom_toBottomOf="0"/>
</cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
