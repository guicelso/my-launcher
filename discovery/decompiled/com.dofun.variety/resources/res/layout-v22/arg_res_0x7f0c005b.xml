<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:paddingLeft="20px"
    android:paddingTop="15px"
    android:paddingRight="20px"
    android:paddingBottom="15px"
    android:layout_width="680px"
    android:layout_height="440px"
    android:minWidth="680px"
    android:minHeight="440px"
    android:paddingHorizontal="20px"
    android:paddingVertical="15px"
    app:adapt_calc_base_on="3"
    app:bl_corners_radius="15dp"
    app:bl_solid_color="@android:color/white">
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="20px"
        android:textColor="@android:color/black"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/arg_res_0x7f100251"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_close"
        android:layout_width="25px"
        android:layout_height="25px"
        android:layout_marginRight="16px"
        android:src="@mipmap/arg_res_0x7f0e0009"
        android:layout_marginEnd="16px"
        app:adapt_calc_base_on="3"
        app:is_square="true"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintTop_toTopOf="@+id/tv_title"/>
    <cn.cardoor.variety.base.ui.adapt.AutoRecyclerView
        android:scrollbarSize="4dp"
        android:scrollbarThumbVertical="@drawable/arg_res_0x7f08024d"
        android:scrollbarStyle="outsideOverlay"
        android:id="@+id/rv_data"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20px"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
</cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
