<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@android:color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/iv_hour_ten_digits"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/iv_hour_digits"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/iv_spacing"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@mipmap/arg_res_0x7f0e007f"
            android:scaleType="fitXY"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/iv_minute_ten_digits"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/iv_minute_digits"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:layout_weight="1"/>
    </LinearLayout>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="18px"
        android:textColor="@android:color/white"
        android:gravity="top"
        android:id="@+id/tv_time_apm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8px"
        android:layout_marginTop="-2dp"
        android:includeFontPadding="false"
        android:layout_toRightOf="@+id/ll_time"
        android:layout_alignTop="@+id/ll_time"/>
</RelativeLayout>
