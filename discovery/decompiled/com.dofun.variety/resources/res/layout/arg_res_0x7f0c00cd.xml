<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_vip_tips_content"
    android:paddingLeft="22px"
    android:paddingRight="22px"
    android:layout_width="match_parent"
    android:layout_height="90px"
    app:adapt_calc_base_on="3"
    app:bl_corners_topRadius="16px"
    app:bl_solid_color="#ffffff">
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_app_logo"
        android:padding="5px"
        android:layout_width="80px"
        android:layout_height="80px"
        android:src="@mipmap/arg_res_0x7f0e0029"
        app:adapt_calc_base_on="3"
        app:is_square="true"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="#4a4a4a"
        android:id="@+id/tv_vip_tips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8px"
        android:layout_marginRight="17px"
        android:maxLines="2"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toStartOf="@+id/tv_vip_tips_renewal"
        app:layout_constraintLeft_toRightOf="@+id/iv_app_logo"
        app:layout_constraintRight_toLeftOf="@+id/tv_vip_tips_renewal"
        app:layout_constraintStart_toEndOf="@+id/iv_app_logo"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="20px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_vip_tips_renewal"
        android:layout_width="165px"
        android:layout_height="56px"
        android:text="@string/arg_res_0x7f100302"
        app:adapt_calc_base_on="3"
        app:bl_corners_bottomLeftRadius="100px"
        app:bl_corners_topRadius="100px"
        app:bl_solid_color="#0076ff"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintTop_toTopOf="0"/>
</cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
