<?xml version="1.0" encoding="utf-8"?>
<com.dofun.overseasvariety.view.CustomSlideUpPanelLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never"
    app:duration="400"
    app:panelHeight="100px"
    app:panelState="0">
    <com.dofun.variety.theme.ui.AnimScalableBackgroundFrameLayout
        android:id="@+id/fl_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.dofun.variety.theme.varietor.HomePagerView
            android:id="@+id/home_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.dofun.overseasvariety.view.DotView
            android:id="@+id/home_dotView"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.dofun.variety.theme.widget.Hotseat
            android:id="@+id/hotseat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/iv_home_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/arg_res_0x7f0e0006"/>
    </com.dofun.variety.theme.ui.AnimScalableBackgroundFrameLayout>
    <FrameLayout
        android:id="@+id/dragView"
        android:visibility="visible"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.dofun.overseasvariety.view.VipExpireTipView
            android:layout_gravity="bottom"
            android:id="@+id/view_vip_tips"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:adapt_calc_base_on="3"/>
    </FrameLayout>
</com.dofun.overseasvariety.view.CustomSlideUpPanelLayout>
