<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <cn.cardoor.variety.base.ui.adapt.AutoRelativeLayout
        android:id="@+id/rl_top"
        android:background="#1affffff"
        android:layout_width="match_parent"
        android:layout_height="80px">
        <cn.cardoor.variety.base.ui.adapt.AutoImageView
            android:id="@+id/iv_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="62px"
            android:src="@mipmap/arg_res_0x7f0e0069"
            android:layout_centerVertical="true"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="28px"
            android:textColor="@android:color/white"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/arg_res_0x7f100295"
            android:layout_centerInParent="true"/>
    </cn.cardoor.variety.base.ui.adapt.AutoRelativeLayout>
    <cn.cardoor.variety.base.ui.adapt.AutoEditText
        android:textSize="24px"
        android:gravity="start"
        android:id="@+id/edit_feedback"
        android:background="@drawable/arg_res_0x7f080252"
        android:paddingLeft="30px"
        android:paddingTop="15px"
        android:layout_width="match_parent"
        android:layout_height="300px"
        android:layout_marginLeft="69px"
        android:layout_marginTop="20px"
        android:layout_marginRight="69px"
        android:hint="@string/arg_res_0x7f1002e1"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/rl_top"/>
    <cn.cardoor.variety.base.ui.adapt.AutoEditText
        android:textSize="24px"
        android:gravity="center_vertical"
        android:id="@+id/edit_email"
        android:background="@drawable/arg_res_0x7f080252"
        android:paddingLeft="30px"
        android:layout_width="match_parent"
        android:layout_height="60px"
        android:layout_marginLeft="69px"
        android:layout_marginTop="20px"
        android:layout_marginRight="69px"
        android:hint="@string/arg_res_0x7f10042b"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/edit_feedback"/>
    <View
        android:id="@+id/center"
        android:layout_width="1px"
        android:layout_height="1px"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_cancel"
        android:background="@drawable/arg_res_0x7f08025d"
        android:layout_width="210px"
        android:layout_height="60px"
        android:layout_marginTop="30px"
        android:layout_marginRight="10px"
        android:text="@string/arg_res_0x7f1000b3"
        app:layout_constraintEnd_toStartOf="@+id/center"
        app:layout_constraintRight_toLeftOf="@+id/center"
        app:layout_constraintTop_toBottomOf="@+id/edit_email"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_send"
        android:background="@drawable/arg_res_0x7f080237"
        android:layout_width="210px"
        android:layout_height="60px"
        android:layout_marginLeft="10px"
        android:layout_marginTop="30px"
        android:text="@string/arg_res_0x7f10031c"
        app:layout_constraintLeft_toRightOf="@+id/center"
        app:layout_constraintStart_toEndOf="@+id/center"
        app:layout_constraintTop_toBottomOf="@+id/edit_email"/>
</androidx.constraintlayout.widget.ConstraintLayout>
