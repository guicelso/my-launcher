<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="26px"
        android:gravity="center_horizontal"
        android:id="@+id/tv_info"
        android:paddingTop="6px"
        android:paddingBottom="10px"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="130px"
        android:minHeight="130px"
        android:drawablePadding="10px"
        app:adapt_calc_base_on="3"
        style="@style/arg_res_0x7f110124"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:id="@+id/tv_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4px"
        style="@style/arg_res_0x7f110124"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="20px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/btn_function"
        android:background="@drawable/arg_res_0x7f080145"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="180px"
        android:minHeight="50px"
        android:text="@string/arg_res_0x7f100185"
        android:singleLine="true"
        app:adapt_calc_base_on="3"
        app:minTextSize="14px"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:orientation="vertical"
        android:id="@+id/flow"
        android:layout_width="1dp"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_info,tv_tips,btn_function"
        app:flow_verticalGap="16dp"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
</merge>
