<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fadingEdge="vertical"
    android:fadingEdgeLength="18dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:requiresFadingEdge="vertical">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingBottom="30px"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="30px"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/tv_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8px"
            android:drawablePadding="16px"
            app:fitTypeface="false"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toTopOf="0"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="22px"
            android:textColor="@android:color/white"
            android:id="@+id/tv_contact_us"
            android:paddingLeft="16px"
            android:paddingTop="4px"
            android:paddingRight="16px"
            android:paddingBottom="4px"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8px"
            android:text="@string/arg_res_0x7f1000e9"
            app:bl_corners_radius="26px"
            app:bl_solid_color="@color/arg_res_0x7f060036"
            app:layout_constraintBottom_toBottomOf="@+id/tv_app_name"
            app:layout_constraintLeft_toRightOf="@+id/tv_app_name"
            app:layout_constraintStart_toEndOf="@+id/tv_app_name"
            app:layout_constraintTop_toTopOf="@+id/tv_app_name"/>
        <cn.cardoor.variety.base.ui.adapt.AutoImageView
            android:id="@+id/iv_app_img"
            android:layout_width="100px"
            android:layout_height="100px"
            android:layout_marginTop="8px"
            android:layout_marginRight="30px"
            app:is_square="true"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintTop_toTopOf="0"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="22px"
            android:textColor="@android:color/white"
            android:id="@+id/tv_version"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10px"
            app:fitTypeface="false"
            app:layout_constraintEnd_toStartOf="@+id/iv_app_img"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toLeftOf="@+id/iv_app_img"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toBottomOf="@+id/tv_contact_us"
            app:layout_goneMarginTop="30dp"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="22px"
            android:textColor="@android:color/white"
            android:id="@+id/tv_company"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10px"
            android:text="@string/arg_res_0x7f1000d4"
            app:fitTypeface="false"
            app:layout_constraintEnd_toStartOf="@+id/iv_app_img"
            app:layout_constraintLeft_toLeftOf="@+id/tv_version"
            app:layout_constraintRight_toLeftOf="@+id/iv_app_img"
            app:layout_constraintStart_toStartOf="@+id/tv_version"
            app:layout_constraintTop_toBottomOf="@+id/tv_version"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/guideline1"
            android:layout_width="0px"
            android:layout_height="0px"
            app:barrierDirection="3"
            app:constraint_referenced_ids="tv_company,iv_app_img"/>
        <androidx.constraintlayout.helper.widget.Flow
            android:id="@+id/flow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10px"
            app:constraint_referenced_ids="tv_service_agreement,tv_privacy_policy,tv_vip_service,tv_user_agreement,tv_purchase_notes,tv_about_design"
            app:flow_horizontalBias="0"
            app:flow_horizontalGap="10dp"
            app:flow_horizontalStyle="2"
            app:flow_verticalGap="12dp"
            app:flow_wrapMode="1"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toLeftOf="@+id/tv_version"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="@+id/tv_version"
            app:layout_constraintTop_toBottomOf="@+id/guideline1"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="22px"
            android:textColor="@android:color/white"
            android:id="@+id/tv_service_agreement"
            android:paddingLeft="16px"
            android:paddingTop="4px"
            android:paddingRight="16px"
            android:paddingBottom="4px"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/arg_res_0x7f10031d"
            app:bl_corners_radius="26px"
            app:bl_solid_color="@color/arg_res_0x7f060036"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="22px"
            android:textColor="@android:color/white"
            android:id="@+id/tv_privacy_policy"
            android:paddingLeft="16px"
            android:paddingTop="4px"
            android:paddingRight="16px"
            android:paddingBottom="4px"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/arg_res_0x7f1002eb"
            app:bl_corners_radius="26px"
            app:bl_solid_color="@color/arg_res_0x7f060036"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="22px"
            android:textColor="@android:color/white"
            android:id="@+id/tv_vip_service"
            android:paddingLeft="16px"
            android:paddingTop="4px"
            android:paddingRight="16px"
            android:paddingBottom="4px"
            android:visibility="@integer/arg_res_0x7f0a000b"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/arg_res_0x7f1003fa"
            app:bl_corners_radius="26px"
            app:bl_solid_color="@color/arg_res_0x7f060036"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="22px"
            android:textColor="@android:color/white"
            android:id="@+id/tv_user_agreement"
            android:paddingLeft="16px"
            android:paddingTop="4px"
            android:paddingRight="16px"
            android:paddingBottom="4px"
            android:visibility="@integer/arg_res_0x7f0a0009"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/arg_res_0x7f1003eb"
            app:bl_corners_radius="26px"
            app:bl_solid_color="@color/arg_res_0x7f060036"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="22px"
            android:textColor="@android:color/white"
            android:id="@+id/tv_purchase_notes"
            android:paddingLeft="16px"
            android:paddingTop="4px"
            android:paddingRight="16px"
            android:paddingBottom="4px"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/arg_res_0x7f1002ef"
            app:bl_corners_radius="26px"
            app:bl_solid_color="@color/arg_res_0x7f060036"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="22px"
            android:textColor="@android:color/white"
            android:id="@+id/tv_about_design"
            android:paddingLeft="16px"
            android:paddingTop="4px"
            android:paddingRight="16px"
            android:paddingBottom="4px"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/arg_res_0x7f10001c"
            app:bl_corners_radius="26px"
            app:bl_solid_color="@color/arg_res_0x7f060036"/>
        <cn.cardoor.variety.base.ui.adapt.AutoButton
            android:textSize="22px"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/btn_renew"
            android:padding="8px"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10px"
            android:maxWidth="200px"
            android:minWidth="160px"
            android:minHeight="50px"
            app:adapt_calc_base_on="3"
            app:bl_corners_radius="26px"
            app:bl_solid_color="@color/arg_res_0x7f060036"
            app:layout_constraintEnd_toEndOf="@+id/iv_app_img"
            app:layout_constraintTop_toBottomOf="@+id/flow"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="22px"
            android:textColor="@android:color/white"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_vip_info"
            android:visibility="gone"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_marginRight="6px"
            android:lineSpacingExtra="2px"
            app:adapt_calc_base_on="3"
            app:layout_constraintBottom_toBottomOf="@+id/btn_renew"
            app:layout_constraintEnd_toStartOf="@+id/btn_renew"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toTopOf="@+id/btn_renew"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="3"
            app:constraint_referenced_ids="btn_renew,tv_vip_info"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="22px"
            android:textColor="@android:color/white"
            android:gravity="start"
            android:id="@+id/tv_machine_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10px"
            android:layout_marginBottom="60px"
            android:lineSpacingExtra="6px"
            app:fitTypeface="false"
            app:layout_constraintBottom_toBottomOf="0"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toBottomOf="@+id/btn_renew"/>
        <cn.cardoor.variety.base.ui.adapt.AutoButton
            android:textSize="22px"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/btn_activate_the_warranty"
            android:padding="8px"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8px"
            android:maxWidth="200px"
            android:minWidth="160px"
            android:minHeight="50px"
            android:text="@string/arg_res_0x7f100056"
            app:adapt_calc_base_on="3"
            app:bl_corners_radius="26px"
            app:bl_solid_color="@color/arg_res_0x7f060036"
            app:layout_constraintEnd_toEndOf="@+id/iv_app_img"
            app:layout_constraintTop_toBottomOf="@+id/tv_machine_info"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="22px"
            android:textColor="@android:color/white"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_warranty_period"
            android:visibility="gone"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_marginRight="6px"
            android:lineSpacingExtra="2px"
            app:adapt_calc_base_on="3"
            app:layout_constraintBottom_toBottomOf="@+id/btn_activate_the_warranty"
            app:layout_constraintEnd_toStartOf="@+id/btn_activate_the_warranty"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toTopOf="@+id/btn_activate_the_warranty"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
