<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/acl_root_layout"
    android:paddingLeft="30px"
    android:paddingRight="30px"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/arg_res_0x7f10008e">
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_back"
        android:layout_width="44px"
        android:layout_height="44px"
        android:layout_marginTop="30px"
        android:src="@mipmap/arg_res_0x7f0e0069"
        app:adapt_calc_base_on="3"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="30px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_exchange_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10px"
        android:text="@string/arg_res_0x7f100148"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toBottomOf="@+id/iv_back"
        app:layout_constraintLeft_toRightOf="@+id/iv_back"
        app:layout_constraintStart_toEndOf="@+id/iv_back"
        app:layout_constraintTop_toTopOf="@+id/iv_back"/>
    <cn.cardoor.variety.base.ui.adapt.AutoButton
        android:textSize="20px"
        android:textColor="#65360d"
        android:gravity="center"
        android:id="@+id/btn_exchange_renew"
        android:visibility="gone"
        android:layout_width="150px"
        android:layout_height="50px"
        android:layout_marginTop="30px"
        android:layout_marginRight="10px"
        android:text="@string/arg_res_0x7f100302"
        app:adapt_calc_base_on="3"
        app:bl_corners_radius="71dp"
        app:bl_solid_color="#e4c584"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_exchange_vip_info"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20px"
        android:layout_marginRight="10px"
        android:text="@string/arg_res_0x7f1003f5"
        android:drawableLeft="@mipmap/arg_res_0x7f0e0024"
        android:drawablePadding="10px"
        android:drawableStart="@mipmap/arg_res_0x7f0e0024"
        app:adapt_calc_base_on="3"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/btn_exchange_renew"
        app:layout_constraintEnd_toStartOf="@+id/btn_exchange_renew"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintLeft_toRightOf="@+id/tv_exchange_type"
        app:layout_constraintRight_toLeftOf="@+id/btn_exchange_renew"
        app:layout_constraintStart_toEndOf="@+id/tv_exchange_type"
        app:layout_constraintTop_toTopOf="@+id/btn_exchange_renew"
        app:startDrawableHeight="30px"
        app:startDrawableWidth="30px"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="3"
        app:constraint_referenced_ids="iv_back,tv_exchange_type,tv_exchange_vip_info,btn_exchange_renew"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="20px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_error_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="10px"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/barrier_title"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/view_nested"
        android:fadingEdge="vertical"
        android:fadingEdgeLength="14dp"
        android:layout_width="0px"
        android:layout_height="0px"
        android:layout_marginTop="18px"
        android:requiresFadingEdge="vertical"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_error_tips">
        <cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.helper.widget.Layer
                android:id="@+id/layer1"
                android:paddingBottom="20dp"
                android:layout_width="0px"
                android:layout_height="wrap_content"
                app:bl_corners_radius="10dp"
                app:bl_solid_color="#0affffff"
                app:constraint_referenced_ids="view_match,et_input_code,btn_authorization_code_activation"/>
            <View
                android:id="@+id/view_match"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <cn.cardoor.variety.base.ui.adapt.AutoEditText
                android:textSize="24px"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/et_input_code"
                android:background="@null"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20px"
                android:minHeight="70px"
                android:hint="@string/arg_res_0x7f1001a2"
                app:layout_constraintEnd_toEndOf="0"
                app:layout_constraintLeft_toLeftOf="0"
                app:layout_constraintRight_toRightOf="0"
                app:layout_constraintStart_toStartOf="0"
                app:layout_constraintTop_toTopOf="0"/>
            <cn.cardoor.variety.base.ui.adapt.AutoButton
                android:textSize="24px"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/btn_authorization_code_activation"
                android:padding="10px"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20px"
                android:layout_marginRight="20px"
                android:layout_marginBottom="20px"
                android:minWidth="160px"
                android:minHeight="50px"
                android:text="@string/arg_res_0x7f100287"
                app:adapt_calc_base_on="3"
                app:bl_corners_radius="25dp"
                app:bl_solid_color="#33ffffff"
                app:layout_constraintEnd_toEndOf="@+id/et_input_code"
                app:layout_constraintStart_toStartOf="@+id/et_input_code"
                app:layout_constraintTop_toBottomOf="@+id/et_input_code"/>
            <cn.cardoor.variety.base.ui.adapt.AutoTextView
                android:textSize="24px"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/tv_wifi_name"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableLeft="@mipmap/arg_res_0x7f0e002f"
                android:drawablePadding="10px"
                android:drawableStart="@mipmap/arg_res_0x7f0e002f"
                app:adapt_calc_base_on="3"
                app:layout_constraintBottom_toBottomOf="@+id/btn_authorization_code_activation"
                app:layout_constraintEnd_toStartOf="@+id/btn_authorization_code_activation"
                app:layout_constraintLeft_toLeftOf="0"
                app:layout_constraintRight_toLeftOf="@+id/btn_authorization_code_activation"
                app:layout_constraintStart_toStartOf="0"
                app:layout_constraintTop_toTopOf="@+id/btn_authorization_code_activation"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="3"
                app:constraint_referenced_ids="btn_authorization_code_activation,layer1"/>
            <cn.cardoor.variety.base.ui.adapt.AutoTextView
                android:textSize="20px"
                android:textColor="@android:color/white"
                android:id="@+id/tv_activation_software_tips"
                android:visibility="@integer/arg_res_0x7f0a000c"
                android:layout_width="0px"
                android:layout_height="wrap_content"
                android:layout_marginTop="30px"
                android:lineSpacingExtra="8px"
                app:layout_constraintEnd_toEndOf="0"
                app:layout_constraintStart_toStartOf="0"
                app:layout_constraintTop_toBottomOf="@+id/guideline"/>
            <com.dofun.variety.theme.widget.ad.AdBanner
                android:id="@+id/ads_banner"
                android:layout_width="0px"
                android:layout_height="228dp"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="0"
                app:layout_constraintLeft_toLeftOf="0"
                app:layout_constraintRight_toRightOf="0"
                app:layout_constraintStart_toStartOf="0"
                app:layout_constraintTop_toBottomOf="@+id/tv_activation_software_tips"/>
        </cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
