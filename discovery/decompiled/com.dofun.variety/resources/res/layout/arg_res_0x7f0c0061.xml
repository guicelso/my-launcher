<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_religious_style_root"
    android:paddingLeft="24px"
    android:paddingTop="24px"
    android:paddingRight="24px"
    android:paddingBottom="24px"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_close"
        android:layout_width="36px"
        android:layout_height="36px"
        android:src="@drawable/arg_res_0x7f080157"
        app:adapt_calc_base_on="3"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="28px"
        android:textStyle="bold"
        android:textColor="#222222"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/arg_res_0x7f1002fd"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toTopOf="@+id/tv_subtitle"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"
        app:layout_constraintVertical_chainStyle="2"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="22px"
        android:textColor="#00a2f9"
        android:gravity="center"
        android:id="@+id/tv_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8px"
        android:text="@string/arg_res_0x7f1002fc"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toTopOf="@+id/np_religious_style_options"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <NumberPicker
        android:id="@+id/np_religious_style_options"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="0dp"
        android:layout_height="190px"
        android:layout_marginTop="18px"
        app:layout_constraintBottom_toTopOf="@+id/btn_confirm"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_subtitle"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="22px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/btn_confirm"
        android:background="@drawable/arg_res_0x7f080220"
        android:layout_width="180px"
        android:layout_height="46px"
        android:layout_marginTop="18px"
        android:text="@string/arg_res_0x7f100287"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/np_religious_style_options"/>
</androidx.constraintlayout.widget.ConstraintLayout>
