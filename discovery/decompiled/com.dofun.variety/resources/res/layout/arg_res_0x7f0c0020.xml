<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.user.view.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/arg_res_0x7f080085"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <cn.cardoor.user.view.AutoImageView
        android:id="@+id/account_success_iv"
        android:layout_width="111px"
        android:layout_height="111px"
        android:layout_marginTop="90px"
        android:src="@drawable/arg_res_0x7f080093"
        android:layout_centerHorizontal="true"/>
    <cn.cardoor.user.view.AutoTextView
        android:textSize="30px"
        android:textColor="#000000"
        android:gravity="center_horizontal"
        android:id="@+id/account_success_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20px"
        android:text="@string/arg_res_0x7f100035"
        android:layout_below="@+id/account_success_iv"/>
    <cn.cardoor.user.view.AutoTextView
        android:textSize="20px"
        android:textColor="#545454"
        android:gravity="center_horizontal"
        android:id="@+id/account_success_countdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6px"
        android:layout_below="@+id/account_success_title"/>
    <cn.cardoor.user.view.AutoImageView
        android:id="@+id/account_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14px"
        android:layout_marginRight="14px"
        android:src="@drawable/arg_res_0x7f080083"
        android:layout_alignParentRight="true"/>
</cn.cardoor.user.view.AutoRelativeLayout>
