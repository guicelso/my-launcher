<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.variety.base.ui.adapt.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fl_app_item"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.dofun.overseasvariety.view.RoundImageView
        android:id="@+id/iv_app_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        app:is_square="true"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"/>
</cn.cardoor.variety.base.ui.adapt.AutoFrameLayout>
