<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="20px"
    android:paddingTop="5px"
    android:paddingRight="18px"
    android:paddingBottom="5px"
    android:layout_width="match_parent"
    android:layout_height="70px"
    android:layout_marginLeft="15px"
    android:layout_marginRight="15px"
    app:adapt_calc_base_on="3"
    app:bl_corners_radius="10px"
    app:bl_solid_color="@android:color/white">
    <com.dofun.overseasvariety.view.SwitchView
        android:id="@+id/sw_widget_enable"
        android:layout_width="80px"
        android:layout_height="40px"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"
        app:primaryColor="#ff00a2f9"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="#4a4a4a"
        android:id="@+id/tv_widget_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="26px"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toBottomOf="@+id/sw_widget_enable"
        app:layout_constraintLeft_toRightOf="@+id/sw_widget_enable"
        app:layout_constraintStart_toEndOf="@+id/sw_widget_enable"
        app:layout_constraintTop_toTopOf="@+id/sw_widget_enable"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_widget_sort"
        android:layout_width="45px"
        android:layout_height="45px"
        android:layout_marginRight="16px"
        android:src="@mipmap/arg_res_0x7f0e002a"
        app:adapt_calc_base_on="3"
        app:is_square="true"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintTop_toTopOf="0"/>
</cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
