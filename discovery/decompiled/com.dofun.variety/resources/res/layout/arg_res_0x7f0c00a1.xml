<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <cn.cardoor.variety.base.ui.adapt.AutoRelativeLayout
        android:layout_gravity="center"
        android:id="@+id/rl_app_icon"
        android:paddingBottom="12px"
        android:layout_width="90px"
        android:layout_height="wrap_content"
        app:adapt_calc_base_on="3">
        <cn.cardoor.variety.base.ui.adapt.AutoShapeableImageView
            android:layout_gravity="center"
            android:id="@+id/iv_app_icon"
            android:padding="8px"
            android:layout_width="90px"
            android:layout_height="90px"
            android:layout_centerHorizontal="true"
            app:adapt_calc_base_on="3"
            app:is_square="true"
            app:shapeAppearance="@style/arg_res_0x7f110125"/>
        <cn.cardoor.variety.base.ui.adapt.AutoImageView
            android:layout_gravity="end|top"
            android:id="@+id/iv_app_label"
            android:layout_width="22px"
            android:layout_height="22px"
            android:src="@drawable/arg_res_0x7f080228"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            app:adapt_calc_base_on="3"
            app:is_square="true"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="12px"
            android:textColor="@android:color/black"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/tv_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_below="@+id/iv_app_icon"
            android:layout_alignLeft="@+id/iv_app_icon"
            android:layout_alignRight="@+id/iv_app_icon"/>
    </cn.cardoor.variety.base.ui.adapt.AutoRelativeLayout>
</FrameLayout>
