<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_app_icon"
        android:layout_width="40px"
        android:layout_height="40px"
        android:layout_marginLeft="30px"
        android:layout_marginTop="30px"
        app:is_square="true"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="30px"
        android:textColor="@android:color/white"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_online_theme"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10px"
        android:layout_marginRight="10px"
        android:text="@string/arg_res_0x7f100288"
        app:adapt_calc_base_on="5"
        app:layout_constraintBottom_toBottomOf="@+id/iv_app_icon"
        app:layout_constraintEnd_toStartOf="@+id/rg_themes"
        app:layout_constraintLeft_toRightOf="@+id/iv_app_icon"
        app:layout_constraintRight_toLeftOf="@+id/rg_themes"
        app:layout_constraintStart_toEndOf="@+id/iv_app_icon"
        app:layout_constraintTop_toTopOf="@+id/iv_app_icon"/>
    <cn.cardoor.variety.base.ui.adapt.AutoShapeableImageView
        android:id="@+id/iv_local"
        android:layout_width="40px"
        android:layout_height="40px"
        android:layout_marginRight="40px"
        android:scaleType="centerCrop"
        app:adapt_calc_base_on="5"
        app:is_square="true"
        app:layout_constraintEnd_toStartOf="@+id/iv_setting"
        app:layout_constraintRight_toLeftOf="@+id/iv_setting"
        app:layout_constraintTop_toTopOf="@+id/iv_setting"
        app:shapeAppearance="@style/arg_res_0x7f11011f"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_setting"
        android:layout_width="40px"
        android:layout_height="40px"
        android:layout_marginTop="30px"
        android:layout_marginRight="30px"
        android:src="@drawable/arg_res_0x7f0801b2"
        app:is_square="true"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_favorite_icon"
        android:layout_width="80px"
        android:layout_height="40px"
        android:layout_marginRight="20px"
        app:adapt_calc_base_on="5"
        app:layout_constraintBottom_toBottomOf="@+id/iv_local"
        app:layout_constraintEnd_toStartOf="@+id/iv_local"
        app:layout_constraintRight_toLeftOf="@+id/iv_local"
        app:layout_constraintTop_toTopOf="@+id/iv_local"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="3"
        app:constraint_referenced_ids="iv_app_icon,tv_online_theme,rg_themes"/>
    <cn.cardoor.variety.base.ui.adapt.AutoFrameLayout
        android:id="@+id/fl_content"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="15px"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintTop_toBottomOf="@+id/barrier">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_online_data"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:fadingEdge="vertical"
            android:fadingEdgeLength="16dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:requiresFadingEdge="vertical"/>
    </cn.cardoor.variety.base.ui.adapt.AutoFrameLayout>
    <com.dofun.variety.ui.BottomIndicatorRadioGroup
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/rg_themes"
        android:paddingTop="8px"
        android:paddingBottom="8px"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/tv_online_theme"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="@+id/tv_online_theme">
        <cn.cardoor.variety.base.ui.adapt.AutoRadioButton
            android:textSize="30px"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/rb_recommend_themes"
            android:paddingLeft="10px"
            android:paddingRight="10px"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:button="@null"
            android:maxWidth="250px"
            android:minWidth="120px"
            android:text="@string/arg_res_0x7f1002f9"
            app:adapt_calc_base_on="5"/>
        <cn.cardoor.variety.base.ui.adapt.AutoRadioButton
            android:textSize="30px"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/rb_newest_themes"
            android:paddingLeft="10px"
            android:paddingRight="10px"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:button="@null"
            android:maxWidth="250px"
            android:minWidth="120px"
            android:text="@string/arg_res_0x7f10026e"
            app:adapt_calc_base_on="5"/>
    </com.dofun.variety.ui.BottomIndicatorRadioGroup>
    <cn.cardoor.variety.base.ui.adapt.AutoFrameLayout
        android:id="@+id/fl_favorite_triangle"
        android:background="@drawable/arg_res_0x7f080265"
        android:layout_width="17px"
        android:layout_height="17px"
        app:layout_constraintEnd_toEndOf="@+id/iv_favorite_icon"
        app:layout_constraintStart_toStartOf="@+id/iv_favorite_icon"
        app:layout_constraintTop_toBottomOf="@+id/iv_favorite_icon"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="@android:color/white"
        android:gravity="start"
        android:id="@+id/tv_favorite_tips"
        android:paddingLeft="22px"
        android:paddingTop="2px"
        android:paddingRight="22px"
        android:paddingBottom="2px"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:bl_corners_radius="6px"
        app:bl_solid_color="#00a6ff"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/iv_favorite_icon"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/fl_favorite_triangle"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_favorites"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="fl_favorite_triangle,tv_favorite_tips"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="26px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_load_more_error_retry"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10px"
        android:minWidth="200px"
        android:minHeight="60px"
        android:text="@string/arg_res_0x7f1002ff"
        app:adapt_calc_base_on="5"
        app:bl_corners_radius="86dp"
        app:bl_solid_color="@color/arg_res_0x7f060045"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"/>
    <com.dofun.overseasvariety.view.VipExpireTipView
        android:id="@+id/view_vip_tips"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:adapt_calc_base_on="5"
        app:layout_constraintBottom_toBottomOf="0"/>
</androidx.constraintlayout.widget.ConstraintLayout>
