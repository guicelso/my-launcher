<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="40px"
    android:paddingTop="15px"
    android:paddingRight="40px"
    android:paddingBottom="15px"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:adapt_calc_base_on="3"
    app:bl_corners_radius="70px"
    app:bl_solid_color="#1affffff">
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_search"
        android:background="@mipmap/arg_res_0x7f0e0020"
        android:layout_width="24px"
        android:layout_height="24px"
        app:adapt_calc_base_on="3"
        app:is_square="true"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoEditText
        android:textSize="20px"
        android:gravity="center_vertical"
        android:id="@+id/et_search"
        android:background="#00000000"
        android:layout_width="0dp"
        android:layout_height="42px"
        android:layout_marginLeft="15px"
        android:layout_marginRight="15px"
        android:hint="@string/arg_res_0x7f100191"
        android:maxLines="1"
        android:inputType="text"
        android:imeOptions="actionSearch"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toStartOf="@+id/iv_search_clear"
        app:layout_constraintLeft_toRightOf="@+id/iv_search"
        app:layout_constraintRight_toLeftOf="@+id/iv_search_clear"
        app:layout_constraintStart_toEndOf="@+id/iv_search"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_search_clear"
        android:background="@drawable/arg_res_0x7f080158"
        android:layout_width="28px"
        android:layout_height="28px"
        android:alpha="0.68"
        app:adapt_calc_base_on="3"
        app:is_square="true"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintTop_toTopOf="0"/>
</androidx.constraintlayout.widget.ConstraintLayout>
