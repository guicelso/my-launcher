<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:bl_corners_radius="20dp"
    app:bl_solid_color="@android:color/white">
    <cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout
        android:layout_gravity="center"
        android:paddingTop="25px"
        android:layout_width="542px"
        android:layout_height="wrap_content">
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="28px"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:id="@+id/tv_tips_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30px"
            android:layout_marginRight="30px"
            android:text="@string/arg_res_0x7f10039e"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toTopOf="0"/>
        <cn.cardoor.variety.base.ui.adapt.AutoImageView
            android:id="@+id/iv_close"
            android:visibility="gone"
            android:layout_width="28px"
            android:layout_height="28px"
            android:layout_marginRight="16px"
            android:src="@mipmap/arg_res_0x7f0e0009"
            app:adapt_calc_base_on="3"
            app:is_square="true"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintTop_toTopOf="@+id/tv_title"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="22px"
            android:textColor="#4a4a4a"
            android:id="@+id/tv_tips_desc"
            android:scrollbars="vertical"
            android:fadingEdge="vertical"
            android:fadingEdgeLength="20dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="54px"
            android:layout_marginTop="28px"
            android:layout_marginRight="54px"
            android:layout_marginBottom="28px"
            android:maxWidth="600px"
            android:maxHeight="200px"
            android:lineSpacingExtra="6px"
            android:fadeScrollbars="false"
            android:requiresFadingEdge="vertical"
            app:adapt_calc_base_on="3"
            app:fitTypeface="false"
            app:layout_constraintBottom_toTopOf="@+id/btn_cancel"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toBottomOf="@+id/tv_tips_title"
            app:pressed_effect="false"/>
        <cn.cardoor.variety.base.ui.adapt.AutoButton
            android:textSize="26px"
            android:textColor="@color/arg_res_0x7f060035"
            android:gravity="center"
            android:id="@+id/btn_cancel"
            android:layout_width="200px"
            android:layout_height="50px"
            android:layout_marginTop="60px"
            android:text="@string/arg_res_0x7f1000b3"
            app:adapt_calc_base_on="3"
            app:bl_corners_radius="100dp"
            app:bl_stroke_color="@color/arg_res_0x7f060035"
            app:bl_stroke_width="1dp"
            app:layout_constraintBottom_toTopOf="@+id/barrier_bottom"
            app:layout_constraintEnd_toStartOf="@+id/btn_confirm"
            app:layout_constraintHorizontal_chainStyle="2"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toLeftOf="@+id/btn_confirm"
            app:layout_constraintStart_toStartOf="0"/>
        <cn.cardoor.variety.base.ui.adapt.AutoButton
            android:textSize="26px"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/btn_confirm"
            android:layout_width="200px"
            android:layout_height="50px"
            android:layout_marginLeft="60px"
            android:layout_marginTop="60px"
            android:text="@string/arg_res_0x7f100287"
            app:adapt_calc_base_on="3"
            app:bl_corners_radius="100dp"
            app:bl_enabled_solid_color="#00a2f9"
            app:bl_unEnabled_solid_color="#8000a2f9"
            app:layout_constraintBottom_toBottomOf="@+id/btn_cancel"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toRightOf="@+id/btn_cancel"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toEndOf="@+id/btn_cancel"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="2"
            app:constraint_referenced_ids="space_bottom,tv_tips_bottom"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="16px"
            android:textColor="#eb8c8c8c"
            android:gravity="center"
            android:id="@+id/tv_tips_bottom"
            android:paddingTop="16px"
            android:paddingBottom="10px"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30px"
            android:layout_marginRight="30px"
            app:adapt_calc_base_on="3"
            app:layout_constraintBottom_toBottomOf="0"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="0"/>
        <cn.cardoor.variety.base.ui.adapt.AutoSpace
            android:id="@+id/space_bottom"
            android:layout_width="wrap_content"
            android:layout_height="28px"
            app:adapt_calc_base_on="3"
            app:layout_constraintBottom_toBottomOf="0"/>
    </cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
</FrameLayout>
