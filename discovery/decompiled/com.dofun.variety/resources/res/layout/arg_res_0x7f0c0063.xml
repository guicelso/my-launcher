<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@drawable/arg_res_0x7f08025a"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout
        android:layout_gravity="center"
        android:paddingLeft="40px"
        android:paddingTop="16px"
        android:paddingRight="40px"
        android:paddingBottom="16px"
        android:layout_width="700px"
        android:layout_height="wrap_content">
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="30px"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:id="@+id/tv_sf_theme_illegal_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40px"
            android:layout_marginRight="40px"
            android:text="@string/arg_res_0x7f10032b"
            android:drawablePadding="12px"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toTopOf="0"
            app:layout_constraintVertical_chainStyle="2"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="16px"
            android:textColor="@android:color/darker_gray"
            android:gravity="center"
            android:id="@+id/tv_incompatibles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@+id/tv_sf_theme_illegal_title"
            app:layout_constraintLeft_toLeftOf="@+id/tv_sf_theme_illegal_title"
            app:layout_constraintRight_toRightOf="@+id/tv_sf_theme_illegal_title"
            app:layout_constraintStart_toStartOf="@+id/tv_sf_theme_illegal_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_sf_theme_illegal_title"
            app:layout_constraintVertical_chainStyle="2"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="20px"
            android:textColor="@android:color/black"
            android:gravity="center_horizontal"
            android:id="@+id/tv_device_qr_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10px"
            android:text="@string/arg_res_0x7f10012c"
            android:drawablePadding="4px"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintTop_toBottomOf="@+id/tv_incompatibles"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="20px"
            android:textColor="#404040"
            android:id="@+id/tv_fun1_desc"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_marginRight="8px"
            android:text="@string/up"
            android:lineSpacingExtra="6px"
            app:layout_constraintEnd_toStartOf="@+id/tv_device_qr_code"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toLeftOf="@+id/tv_device_qr_code"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toTopOf="@+id/tv_device_qr_code"/>
        <cn.cardoor.variety.base.ui.adapt.AutoButton
            android:textSize="20px"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/btn_clear_data"
            android:background="@drawable/arg_res_0x7f080231"
            android:paddingLeft="10px"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20px"
            android:minWidth="180px"
            android:minHeight="50px"
            android:text="@string/arg_res_0x7f1000cb"
            app:layout_constraintLeft_toLeftOf="@+id/tv_fun1_desc"
            app:layout_constraintStart_toStartOf="@+id/tv_fun1_desc"
            app:layout_constraintTop_toBottomOf="@+id/tv_fun1_desc"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier"
            android:background="@color/arg_res_0x7f060038"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="3"
            app:constraint_referenced_ids="btn_clear_data,tv_device_qr_code"/>
        <View
            android:id="@+id/dotted_line_1"
            android:background="@drawable/arg_res_0x7f08023d"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_marginTop="12px"
            android:layerType="software"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toBottomOf="@+id/barrier"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="20px"
            android:textColor="#404040"
            android:id="@+id/tv_tips_two_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="30px"
            android:text="@string/arg_res_0x7f10032a"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintRight_toLeftOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toBottomOf="@+id/dotted_line_1"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="20px"
            android:textColor="#404040"
            android:id="@+id/tv_tips_two_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="30px"
            android:text="@string/arg_res_0x7f100375"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintRight_toLeftOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toBottomOf="@+id/dotted_line_1"/>
        <cn.cardoor.variety.base.ui.adapt.AutoButton
            android:textSize="20px"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/btn_go_setting"
            android:background="@drawable/arg_res_0x7f080231"
            android:paddingRight="10px"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10px"
            android:minWidth="180px"
            android:minHeight="50px"
            android:text="@string/arg_res_0x7f10011b"
            app:layout_constraintBottom_toBottomOf="@+id/tv_tips_two_1"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintTop_toTopOf="@+id/tv_tips_two_1"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="3"
            app:constraint_referenced_ids="tv_tips_two_1,btn_go_setting,tv_tips_two_2"/>
        <View
            android:id="@+id/dotted_line_2"
            android:background="@drawable/arg_res_0x7f08023d"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_marginTop="32px"
            android:layerType="software"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toBottomOf="@+id/barrier_2"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="20px"
            android:textColor="#404040"
            android:id="@+id/tv_tips_three_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15px"
            android:text="@string/arg_res_0x7f100329"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toBottomOf="@+id/dotted_line_2"/>
        <cn.cardoor.variety.base.ui.adapt.AutoImageView
            android:id="@+id/close"
            android:background="@mipmap/arg_res_0x7f0e0009"
            android:layout_width="28px"
            android:layout_height="28px"
            app:adapt_calc_base_on="3"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintTop_toTopOf="0"/>
    </cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
</FrameLayout>
