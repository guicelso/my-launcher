<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout
        android:layout_gravity="center"
        android:background="@drawable/arg_res_0x7f080259"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="700px"
        android:minHeight="400px"
        app:adapt_calc_base_on="3">
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="26px"
            android:textColor="@android:color/black"
            android:id="@+id/tv_warranty_activation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20px"
            android:text="@string/arg_res_0x7f100400"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toTopOf="0"/>
        <cn.cardoor.variety.base.ui.adapt.AutoImageView
            android:id="@+id/iv_warranty_qr_code"
            android:background="@drawable/arg_res_0x7f080175"
            android:layout_width="160px"
            android:layout_height="160px"
            android:layout_marginRight="60px"
            app:adapt_calc_base_on="3"
            app:layout_constraintBottom_toBottomOf="@+id/tv_warranty_activation_desc"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintTop_toTopOf="@+id/tv_warranty_activation_desc"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="18px"
            android:textColor="#494848"
            android:gravity="start"
            android:id="@+id/tv_warranty_qr_code_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="280px"
            android:text="@string/arg_res_0x7f10040a"
            android:lineSpacingExtra="2dp"
            app:layout_constraintEnd_toEndOf="@+id/iv_warranty_qr_code"
            app:layout_constraintLeft_toLeftOf="@+id/iv_warranty_qr_code"
            app:layout_constraintRight_toRightOf="@+id/iv_warranty_qr_code"
            app:layout_constraintStart_toStartOf="@+id/iv_warranty_qr_code"
            app:layout_constraintTop_toBottomOf="@+id/iv_warranty_qr_code"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="22px"
            android:textColor="#a9a9a9"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_warranty_activation_desc"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_marginLeft="60px"
            android:layout_marginTop="12px"
            android:text="@string/arg_res_0x7f100401"
            android:lineSpacingExtra="2dp"
            app:layout_constraintEnd_toStartOf="@+id/iv_warranty_qr_code"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toLeftOf="@+id/iv_warranty_qr_code"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toBottomOf="@+id/tv_warranty_activation"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="3"
            app:constraint_referenced_ids="tv_warranty_activation_desc,iv_warranty_qr_code"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="22px"
            android:textColor="#a9a9a9"
            android:gravity="center_horizontal"
            android:id="@+id/tv_network_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14px"
            android:text="@string/arg_res_0x7f10026b"
            android:drawableTop="@drawable/arg_res_0x7f080204"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintStart_toStartOf="@+id/tv_warranty_activation_desc"
            app:layout_constraintTop_toTopOf="@+id/guideline"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="22px"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:gravity="center_horizontal"
            android:id="@+id/tv_sn_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="20px"
            android:text="@string/arg_res_0x7f100337"
            app:layout_constraintLeft_toRightOf="@+id/tv_network_status"
            app:layout_constraintStart_toEndOf="@+id/tv_network_status"
            app:layout_constraintTop_toTopOf="@+id/tv_network_status"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="20px"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:id="@+id/tv_wifi_name"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4px"
            android:drawableEnd="@drawable/arg_res_0x7f08028d"
            app:layout_constraintBottom_toTopOf="@+id/edt_sn_code_input"
            app:layout_constraintEnd_toEndOf="@+id/edt_sn_code_input"
            app:layout_constraintLeft_toRightOf="@+id/tv_network_status"/>
        <cn.cardoor.variety.base.ui.adapt.AutoEditText
            android:textSize="22px"
            android:textColor="@android:color/black"
            android:textColorHint="#a9a9a9"
            android:gravity="start|center_vertical"
            android:id="@+id/edt_sn_code_input"
            android:background="@drawable/arg_res_0x7f080252"
            android:padding="8px"
            android:focusable="false"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_marginTop="20px"
            android:hint="@string/arg_res_0x7f1002e2"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:imeActionLabel="@string/arg_res_0x7f100058"
            app:layout_constraintEnd_toEndOf="@+id/iv_warranty_qr_code"
            app:layout_constraintLeft_toLeftOf="@+id/tv_sn_code"
            app:layout_constraintStart_toStartOf="@+id/tv_sn_code"
            app:layout_constraintTop_toBottomOf="@+id/tv_sn_code"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="3"
            app:constraint_referenced_ids="edt_sn_code_input,tv_network_status"/>
        <cn.cardoor.variety.base.ui.adapt.AutoButton
            android:textSize="26px"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/btn_cancel"
            android:background="@drawable/arg_res_0x7f080231"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12px"
            android:layout_marginRight="120px"
            android:minWidth="250px"
            android:minHeight="70px"
            android:text="@string/arg_res_0x7f10026f"
            app:adapt_calc_base_on="3"
            app:layout_constraintEnd_toStartOf="@+id/btn_ok"
            app:layout_constraintHorizontal_chainStyle="2"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toLeftOf="@+id/btn_ok"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toBottomOf="@+id/barrier"/>
        <cn.cardoor.variety.base.ui.adapt.AutoButton
            android:textSize="26px"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/btn_ok"
            android:background="@drawable/arg_res_0x7f080231"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12px"
            android:minWidth="250px"
            android:minHeight="70px"
            android:text="@string/arg_res_0x7f100058"
            app:adapt_calc_base_on="3"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toRightOf="@+id/btn_cancel"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toEndOf="@+id/btn_cancel"
            app:layout_constraintTop_toBottomOf="@+id/barrier"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="22px"
            android:textColor="#a9a9a9"
            android:id="@+id/tv_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12px"
            android:layout_marginRight="10px"
            android:layout_marginBottom="20px"
            android:text="@string/arg_res_0x7f10040b"
            app:layout_constraintBottom_toBottomOf="0"
            app:layout_constraintEnd_toStartOf="@+id/tv_open_network"
            app:layout_constraintHorizontal_chainStyle="2"
            app:layout_constraintLeft_toLeftOf="@+id/tv_warranty_activation_desc"
            app:layout_constraintRight_toLeftOf="@+id/tv_open_network"
            app:layout_constraintStart_toStartOf="@+id/tv_warranty_activation_desc"
            app:layout_constraintTop_toBottomOf="@+id/btn_ok"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="22px"
            android:textColor="#a9a9a9"
            android:id="@+id/tv_open_network"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10px"
            android:layout_marginTop="12px"
            android:layout_marginBottom="20px"
            android:text="@string/arg_res_0x7f100293"
            app:layout_constraintBottom_toBottomOf="0"
            app:layout_constraintEnd_toEndOf="@+id/iv_warranty_qr_code"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toRightOf="@+id/iv_warranty_qr_code"
            app:layout_constraintStart_toEndOf="@+id/tv_tips"
            app:layout_constraintTop_toBottomOf="@+id/btn_ok"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="22px"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/tv_toast"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="400px"
            android:minHeight="120px"
            android:text="@string/arg_res_0x7f100293"
            app:bl_corners_radius="10dp"
            app:bl_solid_color="#e6000000"
            app:layout_constraintBottom_toBottomOf="0"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toTopOf="0"/>
    </cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
</FrameLayout>
