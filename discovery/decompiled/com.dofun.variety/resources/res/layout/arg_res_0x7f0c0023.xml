<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:dofun="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_back"
        android:background="@mipmap/arg_res_0x7f0e0069"
        android:layout_width="44px"
        android:layout_height="44px"
        android:layout_marginLeft="42px"
        android:layout_marginTop="32px"
        dofun:adapt_calc_base_on="3"
        dofun:is_square="true"
        dofun:layout_constraintStart_toStartOf="0"
        dofun:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="30px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_title_first"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="23px"
        android:minHeight="42px"
        dofun:adapt_calc_base_on="3"
        dofun:fitTypeface="false"
        dofun:layout_constraintBottom_toBottomOf="@+id/iv_back"
        dofun:layout_constraintLeft_toRightOf="@+id/iv_back"
        dofun:layout_constraintStart_toEndOf="@+id/iv_back"
        dofun:layout_constraintTop_toTopOf="@+id/iv_back"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="30px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="42px"
        dofun:adapt_calc_base_on="3"
        dofun:fitTypeface="false"
        dofun:layout_constraintBottom_toBottomOf="@+id/iv_back"
        dofun:layout_constraintEnd_toEndOf="0"
        dofun:layout_constraintStart_toStartOf="0"
        dofun:layout_constraintTop_toTopOf="@+id/iv_back"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="20px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_count_down"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        dofun:adapt_calc_base_on="3"
        dofun:fitTypeface="false"
        dofun:layout_constraintBottom_toBottomOf="@+id/tv_title"
        dofun:layout_constraintEnd_toEndOf="0"
        dofun:layout_constraintStart_toEndOf="@+id/tv_title"
        dofun:layout_constraintTop_toTopOf="@+id/tv_title"/>
    <cn.cardoor.variety.base.ui.EdgeEffectView
        android:id="@+id/fl_content"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="22px"
        dofun:adapt_calc_base_on="3"
        dofun:edge_position="0xa"
        dofun:edge_width="14dp"
        dofun:layout_constraintBottom_toBottomOf="0"
        dofun:layout_constraintTop_toBottomOf="@+id/iv_back">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_data"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            dofun:adapt_calc_base_on="3"/>
    </cn.cardoor.variety.base.ui.EdgeEffectView>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="26px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_load_more_error_retry"
        android:padding="10px"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10px"
        android:minWidth="200px"
        android:minHeight="60px"
        android:text="@string/arg_res_0x7f1002ff"
        dofun:adapt_calc_base_on="3"
        dofun:bl_corners_radius="86dp"
        dofun:bl_solid_color="@color/arg_res_0x7f060045"
        dofun:layout_constraintBottom_toBottomOf="0"
        dofun:layout_constraintEnd_toEndOf="0"
        dofun:layout_constraintLeft_toLeftOf="0"
        dofun:layout_constraintRight_toRightOf="0"
        dofun:layout_constraintStart_toStartOf="0"/>
</androidx.constraintlayout.widget.ConstraintLayout>
