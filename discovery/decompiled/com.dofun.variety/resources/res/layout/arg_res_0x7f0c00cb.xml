<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="160px"
    android:layout_height="wrap_content">
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="16px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/arg_res_0x7f100146"
        app:layout_constraintBottom_toTopOf="@+id/ll_time"
        app:layout_constraintHorizontal_chainStyle="2"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoLinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2px"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_title">
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="16px"
            android:textColor="@android:color/white"
            android:id="@+id/tv_day"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="16px"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/tv_hour"
            android:background="@drawable/arg_res_0x7f080256"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="16px"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text=":"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="16px"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/tv_minute"
            android:background="@drawable/arg_res_0x7f080256"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="16px"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text=":"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="16px"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/tv_second"
            android:background="@drawable/arg_res_0x7f080256"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
    </cn.cardoor.variety.base.ui.adapt.AutoLinearLayout>
</cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
