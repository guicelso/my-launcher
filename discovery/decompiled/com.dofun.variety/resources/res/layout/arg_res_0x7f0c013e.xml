<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout
        android:layout_gravity="center"
        android:layout_width="620px"
        android:layout_height="480px"
        app:adapt_calc_base_on="3"
        app:bl_corners_radius="15dp"
        app:bl_solid_color="@android:color/white">
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="30px"
            android:textColor="#ff898989"
            android:id="@+id/tv_theme_window_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20px"
            android:layout_marginTop="11px"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toTopOf="0"/>
        <cn.cardoor.variety.base.ui.adapt.AutoImageView
            android:id="@+id/iv_theme_window_close"
            android:paddingLeft="10px"
            android:paddingTop="12px"
            android:paddingRight="20px"
            android:paddingBottom="10px"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/arg_res_0x7f0e0009"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintTop_toTopOf="0"/>
        <cn.cardoor.variety.base.ui.adapt.AutoFrameLayout
            android:id="@+id/line"
            android:background="@drawable/arg_res_0x7f080254"
            android:layout_width="match_parent"
            android:layout_height="10px"
            android:layout_marginTop="10px"
            android:layout_below="@+id/tv_theme_window_title"
            app:adapt_calc_base_on="3"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toBottomOf="@+id/iv_theme_window_close"/>
        <cn.cardoor.variety.base.ui.adapt.AutoImageView
            android:id="@+id/iv_loading"
            android:layout_width="132px"
            android:layout_height="132px"
            android:layout_marginTop="72px"
            android:layout_centerHorizontal="true"
            app:adapt_calc_base_on="3"
            app:is_square="true"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toBottomOf="@+id/line"/>
        <com.dofun.overseasvariety.view.PressRelativeLayout
            android:id="@+id/rl_theme_status"
            android:layout_width="270px"
            android:layout_height="70px"
            android:layout_marginBottom="30px"
            app:adapt_calc_base_on="3"
            app:layout_constraintBottom_toBottomOf="0"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintStart_toStartOf="0">
            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/arg_res_0x7f080215"
                style="?android:attr/progressBarStyleHorizontal"/>
            <cn.cardoor.variety.base.ui.adapt.AutoTextView
                android:textSize="30px"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/tv_theme_status"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.dofun.overseasvariety.view.PressRelativeLayout>
    </cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
</FrameLayout>
