<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_back"
        android:layout_width="44px"
        android:layout_height="44px"
        android:layout_marginLeft="30px"
        android:layout_marginTop="30px"
        android:src="@mipmap/arg_res_0x7f0e0069"
        app:adapt_calc_base_on="3"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="30px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_screensaver_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/iv_back"
        app:layout_constraintEnd_toEndOf="@+id/vp_screensaver_details"
        app:layout_constraintLeft_toLeftOf="@+id/vp_screensaver_details"
        app:layout_constraintRight_toRightOf="@+id/vp_screensaver_details"
        app:layout_constraintStart_toStartOf="@+id/vp_screensaver_details"
        app:layout_constraintTop_toTopOf="@+id/iv_back"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_screensaver_update"
        android:layout_width="30px"
        android:layout_height="30px"
        android:layout_marginLeft="18px"
        android:scaleType="fitXY"
        app:is_square="true"
        app:layout_constraintBottom_toBottomOf="@+id/tv_screensaver_name"
        app:layout_constraintLeft_toRightOf="@+id/tv_screensaver_name"
        app:layout_constraintStart_toEndOf="@+id/tv_screensaver_name"
        app:layout_constraintTop_toTopOf="@+id/tv_screensaver_name"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_go_login"
        android:visibility="invisible"
        android:layout_width="35px"
        android:layout_height="35px"
        android:layout_marginRight="25px"
        android:src="@drawable/arg_res_0x7f0801b4"
        android:scaleType="fitXY"
        app:adapt_calc_base_on="3"
        app:enable_adapt_gone_margin="true"
        app:is_square="true"
        app:layout_constraintBottom_toBottomOf="@+id/iv_go_exchange"
        app:layout_constraintEnd_toStartOf="@+id/iv_go_exchange"
        app:layout_constraintRight_toLeftOf="@+id/iv_go_exchange"
        app:layout_constraintTop_toTopOf="@+id/iv_go_exchange"
        app:layout_goneMarginEnd="40px"
        app:layout_goneMarginRight="40px"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_go_exchange"
        android:visibility="gone"
        android:layout_width="35px"
        android:layout_height="35px"
        android:layout_marginRight="25px"
        android:src="@drawable/arg_res_0x7f080171"
        android:scaleType="fitXY"
        app:adapt_calc_base_on="3"
        app:is_square="true"
        app:layout_constraintBottom_toBottomOf="@+id/iv_delete"
        app:layout_constraintEnd_toStartOf="@+id/iv_delete"
        app:layout_constraintRight_toLeftOf="@+id/iv_delete"
        app:layout_constraintTop_toTopOf="@+id/iv_delete"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_delete"
        android:visibility="gone"
        android:layout_width="35px"
        android:layout_height="35px"
        android:layout_marginRight="40px"
        android:src="@drawable/arg_res_0x7f08015d"
        android:scaleType="fitXY"
        app:adapt_calc_base_on="3"
        app:is_square="true"
        app:layout_constraintBottom_toBottomOf="@+id/tv_screensaver_name"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintTop_toTopOf="@+id/tv_screensaver_name"/>
    <cn.cardoor.variety.base.ui.adapt.AutoViewPager
        android:id="@+id/vp_screensaver_details"
        android:layout_width="0dp"
        android:layout_height="360px"
        android:layout_marginLeft="58px"
        android:layout_marginTop="20px"
        android:layout_marginRight="58px"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_screensaver_name"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_left_arrow"
        android:visibility="gone"
        android:layout_width="35px"
        android:layout_height="62px"
        android:layout_marginLeft="16px"
        android:src="@drawable/arg_res_0x7f0801af"
        app:layout_constraintBottom_toBottomOf="@+id/vp_screensaver_details"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="@+id/vp_screensaver_details"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_right_arrow"
        android:visibility="gone"
        android:layout_width="35px"
        android:layout_height="62px"
        android:layout_marginRight="16px"
        android:src="@drawable/arg_res_0x7f0801b1"
        app:layout_constraintBottom_toBottomOf="@+id/vp_screensaver_details"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintTop_toTopOf="@+id/vp_screensaver_details"/>
    <com.dofun.overseasvariety.view.DotView
        android:id="@+id/dot_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/btn_pay"
        app:layout_constraintEnd_toEndOf="@+id/vp_screensaver_details"
        app:layout_constraintStart_toStartOf="@+id/vp_screensaver_details"
        app:layout_constraintTop_toBottomOf="@+id/vp_screensaver_details"/>
    <com.dofun.variety.screensaver.details.ScreensaverPayButtonView
        android:id="@+id/btn_pay"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:adapt_calc_base_on="3"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/vp_screensaver_details"
        app:pressed_effect="false"/>
</androidx.constraintlayout.widget.ConstraintLayout>
