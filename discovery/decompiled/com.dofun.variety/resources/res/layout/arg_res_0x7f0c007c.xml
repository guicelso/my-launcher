<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="22px"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:adapt_calc_base_on="3">
    <cn.cardoor.variety.base.ui.adapt.AutoScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="15px"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toTopOf="@+id/iv_theme_size"
        app:layout_constraintTop_toTopOf="0">
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="22px"
            android:textColor="@android:color/white"
            android:id="@+id/tv_introduction"
            android:scrollbars="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </cn.cardoor.variety.base.ui.adapt.AutoScrollView>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_theme_size"
        android:layout_width="20px"
        android:layout_height="20px"
        android:layout_marginBottom="16px"
        android:src="@mipmap/arg_res_0x7f0e0031"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toTopOf="@+id/iv_download_amount"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintStart_toStartOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="20px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_theme_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10px"
        app:adapt_calc_base_on="3"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/iv_theme_size"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toRightOf="@+id/iv_theme_size"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toEndOf="@+id/iv_theme_size"
        app:layout_constraintTop_toTopOf="@+id/iv_theme_size"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_download_amount"
        android:layout_width="20px"
        android:layout_height="20px"
        android:layout_marginBottom="32px"
        android:src="@mipmap/arg_res_0x7f0e002e"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toTopOf="@+id/iv_author"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintStart_toStartOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="20px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_download_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10px"
        app:adapt_calc_base_on="3"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/iv_download_amount"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toRightOf="@+id/iv_download_amount"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toEndOf="@+id/iv_download_amount"
        app:layout_constraintTop_toTopOf="@+id/iv_download_amount"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_author"
        android:layout_width="40px"
        android:layout_height="40px"
        android:layout_marginBottom="8px"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintStart_toStartOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="20px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_author"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10px"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toBottomOf="@+id/iv_author"
        app:layout_constraintLeft_toRightOf="@+id/iv_author"
        app:layout_constraintStart_toEndOf="@+id/iv_author"
        app:layout_constraintTop_toTopOf="@+id/iv_author"/>
    <androidx.constraintlayout.helper.widget.Layer
        android:id="@+id/layer_theme_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="iv_theme_size,tv_theme_size"/>
    <androidx.constraintlayout.helper.widget.Layer
        android:id="@+id/layer_download_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="iv_download_amount,tv_download_amount"/>
    <androidx.constraintlayout.helper.widget.Layer
        android:id="@+id/layer_author"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:constraint_referenced_ids="iv_author,tv_author"/>
</cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
