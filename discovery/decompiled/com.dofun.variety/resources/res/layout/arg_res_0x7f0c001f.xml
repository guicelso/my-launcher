<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.user.view.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/arg_res_0x7f080085"
    android:paddingLeft="30px"
    android:paddingRight="30px"
    android:paddingBottom="20px"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <cn.cardoor.user.view.AutoTextView
        android:textSize="24px"
        android:textColor="#000000"
        android:id="@+id/account_security_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20px"
        android:text="@string/arg_res_0x7f10004b"
        android:layout_centerHorizontal="true"/>
    <cn.cardoor.user.view.AutoLinearLayout
        android:orientation="vertical"
        android:id="@+id/account_unbind_content_layout"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20px"
        android:layout_above="@+id/account_security_bottom_layout"
        android:layout_below="@+id/account_security_title">
        <cn.cardoor.user.view.AutoTextView
            android:textSize="20px"
            android:textColor="#000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/arg_res_0x7f100029"/>
    </cn.cardoor.user.view.AutoLinearLayout>
    <ScrollView
        android:id="@+id/account_security_content_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20px"
        android:layout_above="@+id/account_security_bottom_layout"
        android:layout_below="@+id/account_security_title">
        <cn.cardoor.user.view.AutoLinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <cn.cardoor.user.view.AutoTextView
                android:textSize="20px"
                android:textColor="#000000"
                android:id="@+id/account_security_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/arg_res_0x7f100048"/>
            <cn.cardoor.user.view.AutoTextView
                android:textSize="20px"
                android:textColor="#000000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30px"
                android:text="@string/arg_res_0x7f100049"/>
        </cn.cardoor.user.view.AutoLinearLayout>
    </ScrollView>
    <cn.cardoor.user.view.AutoRelativeLayout
        android:id="@+id/account_security_bottom_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <cn.cardoor.user.view.AutoPressTextView
            android:textSize="24px"
            android:textColor="@color/arg_res_0x7f060034"
            android:gravity="center"
            android:id="@+id/account_cancel"
            android:background="@drawable/arg_res_0x7f080078"
            android:paddingLeft="30px"
            android:paddingTop="6px"
            android:paddingRight="30px"
            android:paddingBottom="6px"
            android:layout_width="178px"
            android:layout_height="wrap_content"
            android:text="@string/arg_res_0x7f100031"/>
        <cn.cardoor.user.view.AutoPressTextView
            android:textSize="24px"
            android:textColor="@color/arg_res_0x7f060034"
            android:gravity="center"
            android:id="@+id/account_confirm"
            android:background="@drawable/arg_res_0x7f080078"
            android:paddingLeft="10px"
            android:paddingTop="6px"
            android:paddingRight="10px"
            android:paddingBottom="6px"
            android:layout_width="178px"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30px"
            android:text="@string/arg_res_0x7f10004e"
            android:layout_toRightOf="@+id/account_cancel"/>
    </cn.cardoor.user.view.AutoRelativeLayout>
</cn.cardoor.user.view.AutoRelativeLayout>
