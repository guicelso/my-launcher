<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@mipmap/arg_res_0x7f0e0057"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.dofun.overseasvariety.view.RingView
        android:id="@+id/left_rv1"
        android:layout_width="370px"
        android:layout_height="370px"
        android:layout_marginRight="65px"
        app:adapt_calc_base_on="3"
        app:arcWidth="2px"
        app:color="#008ef1"
        app:delayInterval="20"
        app:isDelay="true"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toStartOf="@+id/right_rv1"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"
        app:radius="185px"
        app:startAngle="117"
        app:sweepAngle="303"/>
    <com.dofun.overseasvariety.view.RingView
        android:id="@+id/left_rv2"
        android:layout_width="350px"
        android:layout_height="350px"
        app:adapt_calc_base_on="3"
        app:color="#008ef1"
        app:delayInterval="20"
        app:isDelay="true"
        app:isSolid="true"
        app:layout_constraintBottom_toBottomOf="@+id/left_rv1"
        app:layout_constraintEnd_toEndOf="@+id/left_rv1"
        app:layout_constraintStart_toStartOf="@+id/left_rv1"
        app:layout_constraintTop_toTopOf="@+id/left_rv1"
        app:radius="175px"
        app:startAngle="117"
        app:sweepAngle="303"
        app:useCenter="true"/>
    <com.dofun.overseasvariety.view.RingView
        android:id="@+id/left_rv3"
        android:layout_width="330px"
        android:layout_height="330px"
        app:adapt_calc_base_on="3"
        app:color="#008ef1"
        app:delayInterval="20"
        app:isDelay="true"
        app:isSolid="true"
        app:layout_constraintBottom_toBottomOf="@+id/left_rv2"
        app:layout_constraintEnd_toEndOf="@+id/left_rv2"
        app:layout_constraintStart_toStartOf="@+id/left_rv2"
        app:layout_constraintTop_toTopOf="@+id/left_rv2"
        app:radius="165px"
        app:startAngle="117"
        app:sweepAngle="303"
        app:useCenter="true"/>
    <com.dofun.overseasvariety.view.MeterView
        android:id="@+id/meter_speed"
        android:layout_width="370px"
        android:layout_height="370px"
        app:adapt_calc_base_on="3"
        app:childMarginCenter="22px"
        app:childTextSize="20px"
        app:layout_constraintBottom_toBottomOf="@+id/left_rv1"
        app:layout_constraintEnd_toEndOf="@+id/left_rv1"
        app:layout_constraintStart_toStartOf="@+id/left_rv1"
        app:layout_constraintTop_toTopOf="@+id/left_rv1"
        app:mainMarginCenter="-23px"
        app:maxSpeed="240"
        app:meterDial="@mipmap/arg_res_0x7f0e005a"
        app:meterType="1"
        app:numberScale="0.9"
        app:offsetAngle="-60"
        app:pointer="@mipmap/arg_res_0x7f0e0059"
        app:showMinMax="true"
        app:speedStartDegress="120"
        app:speedSweepDegress="300"
        app:stop_pointer="@mipmap/arg_res_0x7f0e005b"
        app:textType="2"/>
    <com.dofun.overseasvariety.view.RingView
        android:id="@+id/right_rv1"
        android:layout_width="370px"
        android:layout_height="370px"
        android:layout_marginLeft="65px"
        app:adapt_calc_base_on="3"
        app:arcWidth="2px"
        app:color="#008ef1"
        app:delayInterval="20"
        app:isDelay="true"
        app:layout_constraintBottom_toBottomOf="@+id/left_rv1"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toEndOf="@+id/left_rv1"
        app:layout_constraintTop_toTopOf="@+id/left_rv1"
        app:radius="185px"
        app:startAngle="-90"
        app:sweepAngle="360"/>
    <com.dofun.overseasvariety.view.RingView
        android:id="@+id/right_rv2"
        android:layout_width="350px"
        android:layout_height="350px"
        app:adapt_calc_base_on="3"
        app:color="#008ef1"
        app:delayInterval="20"
        app:isDelay="true"
        app:isSolid="true"
        app:layout_constraintBottom_toBottomOf="@+id/right_rv1"
        app:layout_constraintEnd_toEndOf="@+id/right_rv1"
        app:layout_constraintStart_toStartOf="@+id/right_rv1"
        app:layout_constraintTop_toTopOf="@+id/right_rv1"
        app:radius="175px"
        app:startAngle="-90"
        app:sweepAngle="360"
        app:useCenter="true"/>
    <com.dofun.overseasvariety.view.RingView
        android:id="@+id/right_rv3"
        android:layout_width="330px"
        android:layout_height="330px"
        app:adapt_calc_base_on="3"
        app:color="#008ef1"
        app:delayInterval="20"
        app:isDelay="true"
        app:isSolid="true"
        app:layout_constraintBottom_toBottomOf="@+id/right_rv2"
        app:layout_constraintEnd_toEndOf="@+id/right_rv2"
        app:layout_constraintStart_toStartOf="@+id/right_rv2"
        app:layout_constraintTop_toTopOf="@+id/right_rv2"
        app:radius="165px"
        app:startAngle="-90"
        app:sweepAngle="360"
        app:useCenter="true"/>
    <com.dofun.overseasvariety.view.MeterView
        android:id="@+id/meter_time"
        android:layout_width="370px"
        android:layout_height="370px"
        app:adapt_calc_base_on="3"
        app:childMarginCenter="22px"
        app:childTextSize="20px"
        app:format="MM-dd"
        app:layout_constraintBottom_toBottomOf="@+id/right_rv1"
        app:layout_constraintEnd_toEndOf="@+id/right_rv1"
        app:layout_constraintStart_toStartOf="@+id/right_rv1"
        app:layout_constraintTop_toTopOf="@+id/right_rv1"
        app:mainMarginCenter="-23px"
        app:meterDial="@mipmap/arg_res_0x7f0e0058"
        app:meterType="0"
        app:numberScale="0.9"
        app:offsetAngle="30"
        app:pointer="@mipmap/arg_res_0x7f0e0059"
        app:textType="2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
