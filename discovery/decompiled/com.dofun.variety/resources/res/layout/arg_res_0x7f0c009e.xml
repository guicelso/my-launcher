<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.variety.base.ui.adapt.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="20px"
        android:gravity="center"
        android:id="@+id/tv_item_tag"
        android:background="@drawable/arg_res_0x7f080242"
        android:visibility="gone"
        android:layout_width="60px"
        android:layout_height="30px"
        android:text="@string/arg_res_0x7f100361"/>
    <com.dofun.overseasvariety.view.PointTextView
        android:textSize="24px"
        android:textColor="@android:color/white"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4px"
        android:singleLine="true"
        android:layout_below="@+id/iv_preview"
        android:layout_centerHorizontal="true"
        app:pointPadding="10px"
        app:pointRadius="5px"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_item_tag"
        android:layout_width="70px"
        android:layout_height="36px"
        android:scaleType="fitXY"
        app:adapt_calc_base_on="1"/>
    <com.dofun.overseasvariety.view.CornerLabelView
        android:id="@+id/label_current"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:clvFillColor="@color/arg_res_0x7f060044"
        app:clvFlags="0x4"
        app:clvPaddingBottom="6px"
        app:clvText1="@string/arg_res_0x7f1000f1"
        app:clvText1Color="@android:color/white"
        app:clvText1Height="20px"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_current_use"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/arg_res_0x7f080253"
        android:layout_alignTop="@+id/iv_preview"
        android:layout_alignBottom="@+id/iv_preview"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="16px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_give"
        android:background="@drawable/arg_res_0x7f080241"
        android:paddingLeft="6px"
        android:paddingTop="3px"
        android:paddingRight="6px"
        android:paddingBottom="3px"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/arg_res_0x7f100184"
        android:layout_alignParentRight="true"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_mask"
        android:background="#aa000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignTop="@+id/iv_preview"
        android:layout_alignBottom="@+id/iv_preview"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_check"
        android:visibility="gone"
        android:layout_width="30px"
        android:layout_height="30px"
        android:layout_marginLeft="10px"
        android:layout_marginTop="5px"
        android:src="@drawable/arg_res_0x7f08023b"
        app:is_square="true"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_check"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5px"
        android:layout_marginTop="5px"
        android:text="@string/arg_res_0x7f10018f"
        android:layout_toRightOf="@+id/iv_check"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_hide_waring"
        android:visibility="gone"
        android:layout_width="25px"
        android:layout_height="25px"
        android:layout_marginLeft="10px"
        android:layout_marginTop="10px"
        android:src="@mipmap/arg_res_0x7f0e0084"
        app:is_square="true"/>
</cn.cardoor.variety.base.ui.adapt.AutoRelativeLayout>
