<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.variety.base.ui.adapt.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16px"
    app:adapt_calc_base_on="3">
    <cn.cardoor.variety.base.ui.adapt.AutoFrameLayout
        android:layout_gravity="center"
        android:id="@+id/dw_app_set_item_container"
        android:layout_width="165px"
        android:layout_height="165px"
        app:adapt_calc_base_on="3">
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="20px"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/dw_app_set_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:drawablePadding="14px"
            app:adapt_calc_base_on="3"/>
    </cn.cardoor.variety.base.ui.adapt.AutoFrameLayout>
</cn.cardoor.variety.base.ui.adapt.AutoFrameLayout>
