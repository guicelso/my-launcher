<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.variety.base.ui.adapt.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <cn.cardoor.variety.base.ui.adapt.AutoRelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <cn.cardoor.variety.base.ui.adapt.AutoImageView
            android:id="@+id/iv_theme_category_img"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </cn.cardoor.variety.base.ui.adapt.AutoRelativeLayout>
    <cn.cardoor.variety.base.ui.adapt.AutoCheckBox
        android:gravity="bottom"
        android:layout_gravity="bottom"
        android:id="@+id/cb_theme_category"
        android:focusable="true"
        android:clickable="true"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="34px"
        android:layout_marginLeft="14px"
        android:layout_marginBottom="14px"
        android:button="@null"
        app:adapt_calc_base_on="3"/>
</cn.cardoor.variety.base.ui.adapt.AutoFrameLayout>
