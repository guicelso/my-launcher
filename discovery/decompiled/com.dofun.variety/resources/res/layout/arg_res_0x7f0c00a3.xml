<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.variety.base.ui.adapt.AutoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:adapt_calc_base_on="3">
    <cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout
        android:id="@+id/layout_bg"
        android:background="@drawable/arg_res_0x7f0801b6"
        android:paddingBottom="6px"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <cn.cardoor.variety.base.ui.adapt.AutoImageView
            android:id="@+id/iv_app_icon"
            android:layout_width="90px"
            android:layout_height="90px"
            android:layout_marginTop="12px"
            app:is_square="true"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toTopOf="0"/>
        <cn.cardoor.variety.base.ui.adapt.AutoImageView
            android:id="@+id/iv_app_state"
            android:background="@mipmap/arg_res_0x7f0e002b"
            android:visibility="invisible"
            android:layout_width="24px"
            android:layout_height="24px"
            android:layout_marginTop="-10px"
            android:layout_marginRight="-10px"
            app:is_square="true"
            app:layout_constraintEnd_toEndOf="@+id/iv_app_icon"
            app:layout_constraintRight_toRightOf="@+id/iv_app_icon"
            app:layout_constraintTop_toTopOf="@+id/iv_app_icon"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="16px"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_app_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10px"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="@+id/iv_app_icon"
            app:layout_constraintLeft_toLeftOf="@+id/iv_app_icon"
            app:layout_constraintRight_toRightOf="@+id/iv_app_icon"
            app:layout_constraintStart_toStartOf="@+id/iv_app_icon"
            app:layout_constraintTop_toBottomOf="@+id/iv_app_icon"/>
    </cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
</cn.cardoor.variety.base.ui.adapt.AutoFrameLayout>
