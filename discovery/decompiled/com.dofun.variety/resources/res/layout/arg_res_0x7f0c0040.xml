<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_dw_app_no_permission"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="24dp"
        android:gravity="center"
        android:id="@+id/tv_desktop_window_app_no_permission"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/arg_res_0x7f10010d"
        app:layout_constraintBottom_toTopOf="@+id/btn_desktop_window_app_request_permission"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"
        app:layout_constraintVertical_chainStyle="2"
        style="@style/arg_res_0x7f110124"/>
    <Button
        android:textSize="28dp"
        android:textColor="@android:color/white"
        android:id="@+id/btn_desktop_window_app_request_permission"
        android:background="@drawable/arg_res_0x7f080145"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/arg_res_0x7f10028c"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_desktop_window_app_no_permission"/>
</androidx.constraintlayout.widget.ConstraintLayout>
