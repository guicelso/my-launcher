<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:paddingLeft="20px"
    android:paddingRight="20px"
    android:layout_width="680px"
    android:layout_height="440px"
    android:minWidth="680px"
    android:minHeight="440px"
    app:adapt_calc_base_on="3"
    app:bl_corners_radius="10dp"
    app:bl_solid_color="@android:color/white">
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_close"
        android:layout_width="34px"
        android:layout_height="34px"
        android:layout_marginTop="20px"
        android:layout_marginRight="20px"
        android:src="@drawable/arg_res_0x7f080157"
        app:adapt_calc_base_on="3"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_question"
        android:layout_width="24px"
        android:layout_height="24px"
        android:layout_marginTop="20px"
        android:src="@drawable/arg_res_0x7f080219"
        app:adapt_calc_base_on="3"
        app:layout_constraintEnd_toEndOf="@+id/iv_close"
        app:layout_constraintLeft_toLeftOf="@+id/iv_close"
        app:layout_constraintRight_toRightOf="@+id/iv_close"
        app:layout_constraintStart_toStartOf="@+id/iv_close"
        app:layout_constraintTop_toBottomOf="@+id/iv_close"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_qr_code"
        android:layout_width="200px"
        android:layout_height="200px"
        android:layout_marginLeft="20px"
        android:layout_marginTop="40px"
        app:is_square="true"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="@android:color/black"
        android:gravity="start"
        android:id="@+id/tv_qrcode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20px"
        android:layout_marginTop="8px"
        android:layout_marginRight="10px"
        android:text="@string/arg_res_0x7f100297"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/iv_close"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toRightOf="@+id/iv_qr_code"
        app:layout_constraintRight_toLeftOf="@+id/iv_close"
        app:layout_constraintStart_toEndOf="@+id/iv_qr_code"
        app:layout_constraintTop_toTopOf="@+id/iv_qr_code"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="20px"
        android:textColor="@android:color/black"
        android:gravity="start"
        android:id="@+id/tv_pay_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8px"
        android:layout_marginRight="20px"
        android:layout_marginBottom="8px"
        android:text="@string/arg_res_0x7f10029a"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toBottomOf="@+id/iv_qr_code"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="@+id/tv_qrcode"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="@+id/tv_qrcode"
        app:layout_constraintTop_toBottomOf="@+id/tv_qrcode"
        app:layout_constraintVertical_bias="1"/>
    <View
        android:id="@+id/line_dividing"
        android:layout_width="0dp"
        android:layout_height="6px"
        android:layout_marginTop="26px"
        android:layerType="software"
        app:bl_shape="2"
        app:bl_stroke_color="#909090"
        app:bl_stroke_dashGap="6px"
        app:bl_stroke_dashWidth="6px"
        app:bl_stroke_width="2px"
        app:layout_constraintEnd_toEndOf="@+id/iv_close"
        app:layout_constraintLeft_toLeftOf="@+id/iv_qr_code"
        app:layout_constraintRight_toRightOf="@+id/iv_close"
        app:layout_constraintStart_toStartOf="@+id/iv_qr_code"
        app:layout_constraintTop_toBottomOf="@+id/iv_qr_code"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="15px"
        android:textColor="#707070"
        android:gravity="center"
        android:id="@+id/tv_pay_terms_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8px"
        android:text="@string/arg_res_0x7f1002f1"
        android:maxLines="1"
        android:drawableLeft="@drawable/arg_res_0x7f080183"
        android:drawablePadding="10px"
        android:drawableStart="@drawable/arg_res_0x7f080183"
        app:adapt_calc_base_on="3"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/line_dividing"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="@+id/line_dividing"
        app:layout_constraintRight_toRightOf="@+id/line_dividing"
        app:layout_constraintStart_toStartOf="@+id/line_dividing"
        app:layout_constraintTop_toBottomOf="@+id/line_dividing"
        app:startDrawableHeight="15px"
        app:startDrawableWidth="15px"/>
    <com.dofun.overseasvariety.view.TransparentWebView
        android:id="@+id/web_pay_desc"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="20px"
        android:layout_marginTop="10px"
        android:layout_marginRight="20px"
        android:layout_marginBottom="5px"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_pay_terms_tip"/>
    <cn.cardoor.variety.base.ui.adapt.AutoProgressBar
        android:id="@+id/pb"
        android:visibility="gone"
        android:layout_width="80px"
        android:layout_height="80px"
        android:layout_centerInParent="true"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toBottomOf="@+id/web_pay_desc"
        app:layout_constraintEnd_toEndOf="@+id/web_pay_desc"
        app:layout_constraintLeft_toLeftOf="@+id/web_pay_desc"
        app:layout_constraintRight_toRightOf="@+id/web_pay_desc"
        app:layout_constraintStart_toStartOf="@+id/web_pay_desc"
        app:layout_constraintTop_toTopOf="@+id/web_pay_desc"
        style="@android:style/Widget.Holo.Light.ProgressBar.Large"/>
    <FrameLayout
        android:id="@+id/fl_error"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/web_pay_desc"
        app:layout_constraintEnd_toEndOf="@+id/web_pay_desc"
        app:layout_constraintLeft_toLeftOf="@+id/web_pay_desc"
        app:layout_constraintRight_toRightOf="@+id/web_pay_desc"
        app:layout_constraintStart_toStartOf="@+id/web_pay_desc"
        app:layout_constraintTop_toTopOf="@+id/web_pay_desc">
        <cn.cardoor.variety.base.ui.adapt.AutoImageView
            android:layout_gravity="center"
            android:layout_width="60px"
            android:layout_height="60px"
            android:src="@mipmap/arg_res_0x7f0e0056"
            app:adapt_calc_base_on="3"/>
    </FrameLayout>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="30px"
        android:textColor="#585757"
        android:gravity="center"
        android:id="@+id/tv_desc1"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:text="@string/arg_res_0x7f100280"
        android:drawableTop="@drawable/arg_res_0x7f08028a"
        android:drawablePadding="28px"
        app:adapt_calc_base_on="3"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_desc2"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"
        app:layout_constraintVertical_chainStyle="2"
        app:topDrawableHeight="110px"
        app:topDrawableWidth="110px"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="#707070"
        android:gravity="center"
        android:id="@+id/tv_desc2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/arg_res_0x7f100068"
        app:layout_constraintBottom_toTopOf="@+id/btn_exchange"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_desc1"/>
    <cn.cardoor.variety.base.ui.adapt.AutoButton
        android:textColor="@color/arg_res_0x7f060035"
        android:id="@+id/btn_buy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="28px"
        android:layout_marginRight="28px"
        android:text="@string/arg_res_0x7f1000aa"
        app:bl_corners_radius="60dp"
        app:bl_stroke_color="@color/arg_res_0x7f060045"
        app:bl_stroke_width="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_exchange"
        app:layout_constraintEnd_toStartOf="@+id/btn_exchange"
        app:layout_constraintHorizontal_chainStyle="2"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toLeftOf="@+id/btn_exchange"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="@+id/btn_exchange"
        style="@style/arg_res_0x7f110121"/>
    <cn.cardoor.variety.base.ui.adapt.AutoButton
        android:id="@+id/btn_exchange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18px"
        android:layout_marginRight="28px"
        android:text="@string/arg_res_0x7f100148"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toRightOf="@+id/btn_buy"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toEndOf="@+id/btn_buy"
        app:layout_constraintTop_toBottomOf="@+id/tv_desc2"
        style="@style/arg_res_0x7f110120"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_pay"
        android:layout_width="0px"
        android:layout_height="0px"
        app:constraint_referenced_ids="tv_qrcode,iv_question,tv_pay_desc,iv_qr_code,line_dividing,tv_pay_terms_tip,web_pay_desc"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_question"
        android:visibility="invisible"
        android:layout_width="0px"
        android:layout_height="0px"
        app:constraint_referenced_ids="tv_desc1,tv_desc2,btn_buy,btn_exchange"/>
    <cn.cardoor.variety.base.ui.adapt.AutoFrameLayout
        android:id="@+id/fl_expired"
        android:background="#80000000"
        android:visibility="gone"
        android:layout_width="0px"
        android:layout_height="0px"
        app:layout_constraintBottom_toBottomOf="@+id/iv_qr_code"
        app:layout_constraintEnd_toEndOf="@+id/iv_qr_code"
        app:layout_constraintLeft_toLeftOf="@+id/iv_qr_code"
        app:layout_constraintRight_toRightOf="@+id/iv_qr_code"
        app:layout_constraintStart_toStartOf="@+id/iv_qr_code"
        app:layout_constraintTop_toTopOf="@+id/iv_qr_code">
        <cn.cardoor.variety.base.ui.adapt.AutoImageView
            android:layout_gravity="center"
            android:id="@+id/iv_expired"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/arg_res_0x7f0e0056"
            app:is_square="true"/>
    </cn.cardoor.variety.base.ui.adapt.AutoFrameLayout>
</cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
