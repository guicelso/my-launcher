<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.dofun.variety.theme.ui.colorpicker.SVPicker
        android:id="@+id/svPicker"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        app:layout_constraintBottom_toTopOf="@+id/huePicker"
        app:layout_constraintEnd_toStartOf="@+id/preset_color1"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <com.dofun.variety.theme.ui.colorpicker.HuePicker
        android:id="@+id/huePicker"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/preset_color4"
        app:layout_constraintEnd_toEndOf="@+id/svPicker"
        app:layout_constraintStart_toStartOf="@+id/svPicker"/>
    <androidx.constraintlayout.utils.widget.ImageFilterButton
        android:id="@+id/preset_color1"
        app:layout_constraintBottom_toTopOf="@+id/preset_color4"
        app:layout_constraintEnd_toStartOf="@+id/preset_color2"
        app:layout_constraintTop_toTopOf="0"
        style="@style/arg_res_0x7f11032f"/>
    <androidx.constraintlayout.utils.widget.ImageFilterButton
        android:id="@+id/preset_color2"
        app:layout_constraintBottom_toTopOf="@+id/preset_color5"
        app:layout_constraintEnd_toStartOf="@+id/preset_color3"
        app:layout_constraintTop_toTopOf="0"
        style="@style/arg_res_0x7f11032f"/>
    <androidx.constraintlayout.utils.widget.ImageFilterButton
        android:id="@+id/preset_color3"
        app:layout_constraintBottom_toTopOf="@+id/preset_color6"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintTop_toTopOf="0"
        style="@style/arg_res_0x7f11032f"/>
    <androidx.constraintlayout.utils.widget.ImageFilterButton
        android:id="@+id/preset_color4"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintStart_toStartOf="@+id/preset_color1"
        app:layout_constraintTop_toBottomOf="@+id/preset_color1"
        style="@style/arg_res_0x7f11032f"/>
    <androidx.constraintlayout.utils.widget.ImageFilterButton
        android:id="@+id/preset_color5"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintStart_toStartOf="@+id/preset_color2"
        app:layout_constraintTop_toBottomOf="@+id/preset_color2"
        style="@style/arg_res_0x7f11032f"/>
    <androidx.constraintlayout.utils.widget.ImageFilterButton
        android:id="@+id/preset_color6"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintStart_toStartOf="@+id/preset_color3"
        app:layout_constraintTop_toBottomOf="@+id/preset_color3"
        style="@style/arg_res_0x7f11032f"/>
</merge>
