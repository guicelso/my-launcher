<?xml version="1.0" encoding="utf-8"?>
<com.dofun.variety.ui.SwipeMenuLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sl_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bl_corners_radius="8dp"
    app:bl_solid_color="@color/arg_res_0x7f060036">
    <cn.cardoor.variety.base.ui.adapt.AutoRelativeLayout
        android:id="@+id/rl_content"
        android:paddingLeft="10px"
        android:paddingTop="24px"
        android:paddingRight="10px"
        android:paddingBottom="24px"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="90px"
        app:adapt_calc_base_on="3">
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="24px"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10px"
            android:text="@string/arg_res_0x7f100099"
            android:includeFontPadding="false"
            android:drawableLeft="@drawable/arg_res_0x7f080185"
            android:drawablePadding="8dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:drawableStart="@drawable/arg_res_0x7f080185"
            app:fitTypeface="false"
            app:startDrawableHeight="24px"
            app:startDrawableWidth="24px"/>
        <cn.cardoor.variety.base.ui.adapt.AutoImageView
            android:id="@+id/iv_space1"
            android:background="@drawable/arg_res_0x7f0801a3"
            android:layout_width="24px"
            android:layout_height="24px"
            android:layout_marginLeft="12px"
            android:layout_marginRight="12px"
            android:layout_toRightOf="@+id/tv_time"
            android:layout_centerVertical="true"
            app:is_square="true"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="24px"
            android:textColor="@android:color/white"
            android:id="@+id/tv_operation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/arg_res_0x7f100099"
            android:includeFontPadding="false"
            android:drawablePadding="8dp"
            android:layout_toRightOf="@+id/iv_space1"
            android:layout_centerVertical="true"
            app:fitTypeface="false"
            app:startDrawableHeight="24px"
            app:startDrawableWidth="24px"/>
        <cn.cardoor.variety.base.ui.adapt.AutoImageView
            android:id="@+id/iv_space2"
            android:background="@drawable/arg_res_0x7f0801a3"
            android:layout_width="24px"
            android:layout_height="24px"
            android:layout_marginLeft="12px"
            android:layout_marginRight="12px"
            android:layout_toRightOf="@+id/tv_operation"
            android:layout_centerVertical="true"
            app:is_square="true"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="24px"
            android:textColor="@android:color/white"
            android:gravity="start"
            android:id="@+id/tv_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/arg_res_0x7f100099"
            android:includeFontPadding="false"
            android:drawablePadding="8dp"
            android:layout_toLeftOf="@+id/sw_task"
            android:layout_toRightOf="@+id/iv_space2"
            android:layout_centerVertical="true"
            app:fitTypeface="false"
            app:startDrawableHeight="24px"
            app:startDrawableWidth="24px"/>
        <com.dofun.overseasvariety.view.SwitchView
            android:id="@+id/sw_task"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10px"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </cn.cardoor.variety.base.ui.adapt.AutoRelativeLayout>
    <cn.cardoor.variety.base.ui.adapt.AutoFrameLayout
        android:id="@+id/fl_delete"
        android:layout_width="90px"
        android:layout_height="match_parent"
        app:adapt_calc_base_on="3">
        <cn.cardoor.variety.base.ui.adapt.AutoImageView
            android:layout_gravity="center"
            android:background="@drawable/arg_res_0x7f08015d"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="center"/>
    </cn.cardoor.variety.base.ui.adapt.AutoFrameLayout>
</com.dofun.variety.ui.SwipeMenuLayout>
