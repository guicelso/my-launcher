<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout
        android:layout_width="680px"
        android:layout_height="460px"
        app:adapt_calc_base_on="3"
        app:bl_corners_radius="20px"
        app:bl_solid_color="#f8f8f8">
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="24px"
            android:textColor="#4a4a4a"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15px"
            android:text="@string/arg_res_0x7f1003af"
            app:adapt_calc_base_on="3"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toTopOf="0"/>
        <cn.cardoor.variety.base.ui.adapt.AutoImageView
            android:id="@+id/iv_close"
            android:layout_width="28px"
            android:layout_height="28px"
            android:layout_marginRight="16px"
            android:src="@mipmap/arg_res_0x7f0e0009"
            app:adapt_calc_base_on="3"
            app:is_square="true"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintTop_toTopOf="@+id/tv_title"/>
        <cn.cardoor.variety.base.ui.rvx.DragDropSwipeRecyclerView
            android:id="@+id/rv_widget_data"
            android:focusable="false"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginLeft="6px"
            android:layout_marginTop="20px"
            android:layout_marginRight="6px"
            android:layout_marginBottom="26px"
            android:fadeScrollbars="false"
            android:overScrollMode="always"
            app:adapt_calc_base_on="3"
            app:divider="@drawable/arg_res_0x7f08025c"
            app:item_layout="@layout/arg_res_0x7f0c00ab"
            app:layout_constraintBottom_toTopOf="@+id/btn_reset"
            app:layout_constraintTop_toBottomOf="@+id/iv_close"/>
        <cn.cardoor.variety.base.ui.adapt.AutoButton
            android:textSize="26px"
            android:textColor="@color/arg_res_0x7f060035"
            android:gravity="center"
            android:id="@+id/btn_reset"
            android:layout_width="200px"
            android:layout_height="50px"
            android:layout_marginBottom="16px"
            android:text="@string/arg_res_0x7f100365"
            app:adapt_calc_base_on="3"
            app:bl_corners_radius="100dp"
            app:bl_stroke_color="@color/arg_res_0x7f060035"
            app:bl_stroke_width="1dp"
            app:layout_constraintBottom_toBottomOf="0"
            app:layout_constraintEnd_toStartOf="@+id/btn_save"
            app:layout_constraintHorizontal_chainStyle="2"
            app:layout_constraintLeft_toLeftOf="0"
            app:layout_constraintRight_toLeftOf="@+id/btn_save"
            app:layout_constraintStart_toStartOf="0"/>
        <cn.cardoor.variety.base.ui.adapt.AutoButton
            android:textSize="26px"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/btn_save"
            android:layout_width="200px"
            android:layout_height="50px"
            android:layout_marginLeft="60px"
            android:layout_marginTop="60px"
            android:text="@string/arg_res_0x7f100287"
            app:adapt_calc_base_on="3"
            app:bl_corners_radius="100dp"
            app:bl_enabled_solid_color="#00a2f9"
            app:bl_unEnabled_solid_color="#8000a2f9"
            app:layout_constraintBottom_toBottomOf="@+id/btn_reset"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintLeft_toRightOf="@+id/btn_reset"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintStart_toEndOf="@+id/btn_reset"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_saving_mask"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:bl_corners_radius="20dp"
            app:bl_solid_color="#3b333333">
            <cn.cardoor.variety.base.ui.adapt.AutoProgressBar
                android:layout_width="132px"
                android:layout_height="132px"
                android:indeterminate="false"
                android:indeterminateDrawable="@drawable/arg_res_0x7f0801b5"
                app:adapt_calc_base_on="3"
                style="@android:style/Widget.Holo.Light.ProgressBar.Large"/>
            <cn.cardoor.variety.base.ui.adapt.AutoTextView
                android:textSize="20px"
                android:textColor="#aeafb9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10px"
                android:text="@string/arg_res_0x7f1001c7"
                app:adapt_calc_base_on="3"/>
        </LinearLayout>
    </cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
</FrameLayout>
