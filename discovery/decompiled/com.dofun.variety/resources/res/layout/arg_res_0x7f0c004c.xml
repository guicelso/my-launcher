<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/fl_background"
        android:background="@drawable/arg_res_0x7f080259"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="460px"
        android:minHeight="300px"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_waring"
        android:layout_width="120px"
        android:layout_height="120px"
        android:src="@drawable/arg_res_0x7f08028a"
        app:layout_constraintBottom_toTopOf="@+id/fl_background"
        app:layout_constraintEnd_toEndOf="@+id/fl_background"
        app:layout_constraintStart_toStartOf="@+id/fl_background"
        app:layout_constraintTop_toTopOf="@+id/fl_background"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="36px"
        android:textColor="@android:color/black"
        android:id="@+id/tv_brand_custom_theme_exist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="已有定制主题"
        app:layout_constraintBottom_toTopOf="@+id/tv_brand_custom_theme_exist_tips"
        app:layout_constraintEnd_toEndOf="@+id/fl_background"
        app:layout_constraintStart_toStartOf="@+id/fl_background"
        app:layout_constraintTop_toBottomOf="@+id/iv_waring"
        app:layout_constraintVertical_chainStyle="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="@android:color/darker_gray"
        android:id="@+id/tv_brand_custom_theme_exist_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="更改设备UI,在兜风云输入“改主题”"
        app:layout_constraintBottom_toTopOf="@+id/tv_i_known"
        app:layout_constraintEnd_toEndOf="@+id/fl_background"
        app:layout_constraintStart_toStartOf="@+id/fl_background"
        app:layout_constraintTop_toBottomOf="@+id/tv_brand_custom_theme_exist"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="26px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_i_known"
        android:background="@drawable/arg_res_0x7f080235"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="280px"
        android:minHeight="60px"
        android:text="我知道了"
        app:layout_constraintBottom_toBottomOf="@+id/fl_background"
        app:layout_constraintEnd_toEndOf="@+id/fl_background"
        app:layout_constraintStart_toStartOf="@+id/fl_background"
        app:layout_constraintTop_toBottomOf="@+id/tv_brand_custom_theme_exist_tips"/>
</cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
