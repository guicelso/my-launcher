<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fl_state_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout
        android:id="@+id/cl_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <cn.cardoor.variety.base.ui.adapt.AutoRecyclerView
            android:scrollbarStyle="outsideOverlay"
            android:id="@+id/rv_data"
            android:paddingLeft="28px"
            android:paddingRight="28px"
            android:scrollbars="vertical"
            android:fadingEdge="vertical"
            android:fadingEdgeLength="16dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="16px"
            android:fadeScrollbars="false"
            android:requiresFadingEdge="vertical"
            app:layout_constraintBottom_toTopOf="@+id/tv_save"
            app:layout_constraintTop_toTopOf="0"/>
        <cn.cardoor.variety.base.ui.adapt.AutoCheckBox
            android:textSize="24px"
            android:textColor="#4a4a4a"
            android:gravity="center_vertical"
            android:id="@+id/cb_select_all"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="42px"
            android:button="@null"
            android:text="@string/arg_res_0x7f100066"
            android:drawablePadding="14px"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/tv_save"
            app:layout_constraintLeft_toLeftOf="@+id/rv_data"
            app:layout_constraintStart_toStartOf="@+id/rv_data"
            app:layout_constraintTop_toTopOf="@+id/tv_save"/>
        <cn.cardoor.variety.base.ui.adapt.AutoCheckBox
            android:textSize="24px"
            android:textColor="#4a4a4a"
            android:gravity="center_vertical"
            android:id="@+id/cb_select_lite"
            android:focusable="true"
            android:visibility="@integer/arg_res_0x7f0a0009"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20px"
            android:button="@null"
            android:text="@string/arg_res_0x7f1001c3"
            android:drawablePadding="14px"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/tv_save"
            app:layout_constraintEnd_toStartOf="@+id/tv_save"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintLeft_toRightOf="@+id/cb_select_all"
            app:layout_constraintRight_toLeftOf="@+id/tv_save"
            app:layout_constraintStart_toEndOf="@+id/cb_select_all"
            app:layout_constraintTop_toTopOf="@+id/tv_save"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="24px"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/tv_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16px"
            android:minWidth="180px"
            android:minHeight="50px"
            android:text="@string/arg_res_0x7f100309"
            app:adapt_calc_base_on="3"
            app:bl_corners_radius="80dp"
            app:bl_solid_color="#00a2f9"
            app:layout_constraintBottom_toBottomOf="0"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintStart_toStartOf="0"/>
        <cn.cardoor.variety.base.ui.adapt.AutoImageView
            android:id="@+id/iv_right_arrow"
            android:visibility="gone"
            android:layout_width="30px"
            android:layout_height="30px"
            android:layout_marginRight="50px"
            android:src="@drawable/arg_res_0x7f0801db"
            app:adapt_calc_base_on="3"
            app:is_square="true"
            app:layout_constraintBottom_toBottomOf="@+id/iv_choose_car"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintRight_toRightOf="0"
            app:layout_constraintTop_toTopOf="@+id/iv_choose_car"/>
        <cn.cardoor.variety.base.ui.adapt.AutoImageView
            android:id="@+id/iv_choose_car"
            android:visibility="gone"
            android:layout_width="80px"
            android:layout_height="40px"
            android:layout_marginRight="8px"
            android:layout_marginBottom="20px"
            app:adapt_calc_base_on="3"
            app:layout_constraintBottom_toBottomOf="0"
            app:layout_constraintEnd_toStartOf="@+id/iv_right_arrow"
            app:layout_constraintRight_toLeftOf="@+id/iv_right_arrow"/>
    </cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
</FrameLayout>
