<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_desktop_window_modify_guide"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <me.grantland.widget.AutofitTextView
        android:textSize="28dp"
        android:id="@+id/tv_dw_modify_window_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/arg_res_0x7f100210"
        android:maxLines="1"
        android:singleLine="true"
        app:layout_constraintBottom_toTopOf="@+id/iv_right_arrow"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"
        app:layout_constraintVertical_chainStyle="2"
        app:minTextSize="14dp"
        style="@style/arg_res_0x7f110124"/>
    <ImageView
        android:id="@+id/iv_theme_icon"
        android:background="@drawable/arg_res_0x7f080261"
        android:layout_width="90dp"
        android:layout_height="90dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_theme_text"
        app:layout_constraintEnd_toStartOf="@+id/iv_right_arrow"
        app:layout_constraintHorizontal_chainStyle="2"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="@+id/iv_right_arrow"/>
    <ImageView
        android:id="@+id/iv_right_arrow"
        android:background="@drawable/arg_res_0x7f08021d"
        android:layout_width="90dp"
        android:layout_height="90dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_theme_text"
        app:layout_constraintEnd_toStartOf="@+id/iv_setting_icon"
        app:layout_constraintStart_toEndOf="@+id/iv_theme_icon"
        app:layout_constraintTop_toBottomOf="@+id/tv_dw_modify_window_title"/>
    <ImageView
        android:id="@+id/iv_setting_icon"
        android:background="@drawable/arg_res_0x7f080232"
        android:layout_width="90dp"
        android:layout_height="90dp"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toEndOf="@+id/iv_right_arrow"
        app:layout_constraintTop_toTopOf="@+id/iv_right_arrow"/>
    <TextView
        android:textSize="20dp"
        android:id="@+id/tv_theme_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/theme"
        app:layout_constraintBottom_toTopOf="@+id/tv_i_known"
        app:layout_constraintEnd_toEndOf="@+id/iv_theme_icon"
        app:layout_constraintStart_toStartOf="@+id/iv_theme_icon"
        app:layout_constraintTop_toBottomOf="@+id/iv_right_arrow"
        style="@style/arg_res_0x7f110124"/>
    <TextView
        android:textSize="20dp"
        android:id="@+id/tv_setting_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/arg_res_0x7f100324"
        app:layout_constraintEnd_toEndOf="@+id/iv_setting_icon"
        app:layout_constraintStart_toStartOf="@+id/iv_setting_icon"
        app:layout_constraintTop_toBottomOf="@+id/iv_setting_icon"
        style="@style/arg_res_0x7f110124"/>
    <me.grantland.widget.AutofitTextView
        android:textSize="20dp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_i_known"
        android:background="@drawable/arg_res_0x7f080145"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:layout_marginRight="8dp"
        android:minWidth="180dp"
        android:minHeight="50dp"
        android:text="@string/arg_res_0x7f100194"
        android:maxLines="1"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toStartOf="@+id/tv_modify_desktop_window"
        app:layout_constraintHorizontal_chainStyle="2"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_theme_text"
        app:minTextSize="14dp"/>
    <me.grantland.widget.AutofitTextView
        android:textSize="20dp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_modify_desktop_window"
        android:background="@drawable/arg_res_0x7f080145"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:minWidth="180dp"
        android:minHeight="50dp"
        android:text="@string/arg_res_0x7f10010b"
        android:maxLines="1"
        android:singleLine="true"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toEndOf="@+id/tv_i_known"
        app:layout_constraintTop_toTopOf="@+id/tv_i_known"
        app:minTextSize="14dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
