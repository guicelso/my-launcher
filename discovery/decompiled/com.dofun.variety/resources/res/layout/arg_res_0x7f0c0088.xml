<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <cn.cardoor.variety.base.ui.adapt.AutoFrameLayout
        android:id="@+id/fl_bg"
        android:layout_width="match_parent"
        android:layout_height="90px"
        android:layout_marginLeft="20px"
        android:layout_marginRight="20px"
        app:adapt_calc_base_on="3"
        app:bl_corners_radius="20dp"
        app:bl_solid_color="@android:color/white"
        app:layout_constraintBottom_toBottomOf="@+id/iv_icon"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_icon"
        android:layout_width="112px"
        android:layout_height="112px"
        android:layout_marginTop="8px"
        app:is_square="true"
        app:layout_constraintStart_toStartOf="@+id/fl_bg"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="26px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/btn_fun"
        android:paddingLeft="12px"
        android:paddingTop="6px"
        android:paddingRight="12px"
        android:paddingBottom="6px"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="20px"
        app:adapt_calc_base_on="3"
        app:bl_corners_radius="60dp"
        app:bl_solid_color="@color/arg_res_0x7f060035"
        app:layout_constraintBottom_toBottomOf="@+id/fl_bg"
        app:layout_constraintEnd_toEndOf="@+id/fl_bg"
        app:layout_constraintRight_toRightOf="@+id/fl_bg"
        app:layout_constraintTop_toTopOf="@+id/fl_bg"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="26px"
        android:textColor="@android:color/black"
        android:gravity="center_vertical"
        android:id="@+id/tv_title"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12px"
        app:layout_constraintBottom_toBottomOf="@+id/fl_bg"
        app:layout_constraintEnd_toStartOf="@+id/btn_fun"
        app:layout_constraintLeft_toRightOf="@+id/iv_icon"
        app:layout_constraintRight_toLeftOf="@+id/btn_fun"
        app:layout_constraintStart_toEndOf="@+id/iv_icon"
        app:layout_constraintTop_toTopOf="@+id/fl_bg"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_close"
        android:background="@drawable/arg_res_0x7f080158"
        android:layout_width="44px"
        android:layout_height="44px"
        android:layout_marginTop="8px"
        app:is_square="true"
        app:layout_constraintEnd_toStartOf="@+id/fl_bg"
        app:layout_constraintStart_toStartOf="@+id/fl_bg"
        app:layout_constraintTop_toTopOf="0"/>
</cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
