<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.dofun.variety.theme.widget.wallpaper.AspectRatioFrameLayout
        android:id="@+id/fl_video_player"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <SurfaceView
            android:id="@+id/surface_video_player"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.dofun.variety.theme.widget.wallpaper.AspectRatioFrameLayout>
    <View
        android:id="@+id/view_video_player_guide_bg"
        android:background="@color/arg_res_0x7f060038"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_video_player_guide"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <cn.cardoor.variety.base.ui.adapt.AutoImageView
            android:layout_width="135px"
            android:layout_height="135px"
            android:src="@mipmap/arg_res_0x7f0e001c"
            app:adapt_calc_base_on="3"
            app:is_square="true"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="25px"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/arg_res_0x7f1003f4"
            android:maxLines="1"
            android:singleLine="true"
            app:adapt_calc_base_on="3"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="22px"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/btn_function"
            android:background="@drawable/arg_res_0x7f080145"
            android:paddingLeft="20px"
            android:paddingRight="20px"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26px"
            android:minWidth="130px"
            android:minHeight="50px"
            android:text="@string/arg_res_0x7f100318"
            android:singleLine="true"
            app:adapt_calc_base_on="3"/>
    </LinearLayout>
    <View
        android:id="@+id/view_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</merge>
