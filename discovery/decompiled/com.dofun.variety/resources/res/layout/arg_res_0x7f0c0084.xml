<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@mipmap/arg_res_0x7f0e0064"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.dofun.overseasvariety.view.MeterView
        android:id="@+id/meter_speed"
        android:layout_width="362px"
        android:layout_height="362px"
        android:layout_marginRight="72px"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toStartOf="@+id/meter_time"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"
        app:maxSpeed="240"
        app:meterDial="@mipmap/arg_res_0x7f0e0067"
        app:meterType="1"
        app:numberScale="0.6"
        app:pointer="@mipmap/arg_res_0x7f0e0066"
        app:speedStartDegress="120"
        app:speedSweepDegress="300"
        app:textType="2"/>
    <com.dofun.overseasvariety.view.MeterView
        android:id="@+id/meter_time"
        android:layout_width="362px"
        android:layout_height="362px"
        android:layout_marginLeft="72px"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toBottomOf="@+id/meter_speed"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toEndOf="@+id/meter_speed"
        app:layout_constraintTop_toTopOf="@+id/meter_speed"
        app:meterDial="@mipmap/arg_res_0x7f0e0065"
        app:meterType="0"
        app:numberScale="0.6"
        app:offsetAngle="90"
        app:pointer="@mipmap/arg_res_0x7f0e0066"
        app:textType="2"
        app:timeAmPmTextSize="18px"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="30px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_time_week"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="59px"
        app:adapt_calc_base_on="3"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"/>
</androidx.constraintlayout.widget.ConstraintLayout>
