<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/status_bar_latest_event_content"
    android:layout_width="match_parent"
    android:layout_height="128dp">
    <include
        android:layout_width="@dimen/arg_res_0x7f070303"
        android:layout_height="@dimen/arg_res_0x7f070302"
        layout="@layout/arg_res_0x7f0c010e"/>
    <include
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:layout_alignParentRight="true"
        layout="@layout/arg_res_0x7f0c0108"/>
    <include
        android:layout_gravity="fill_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/arg_res_0x7f070303"
        android:layout_toLeftOf="@+id/cancel_action"
        layout="@layout/arg_res_0x7f0c010f"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/media_actions"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_alignParentBottom="true"/>
    <ImageView
        android:id="@+id/action_divider"
        android:background="?android:attr/dividerHorizontal"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_above="@+id/media_actions"/>
</RelativeLayout>
