<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.user.view.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#111827"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <cn.cardoor.user.view.AutoTextView
        android:textSize="28px"
        android:textStyle="bold"
        android:textColor="@color/arg_res_0x7f060034"
        android:id="@+id/agreement_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40px"
        android:layout_centerHorizontal="true"/>
    <cn.cardoor.user.view.AutoPressImageView
        android:id="@+id/agreement_back"
        android:layout_width="60px"
        android:layout_height="60px"
        android:layout_marginLeft="41px"
        android:layout_marginTop="30px"
        android:src="@drawable/arg_res_0x7f080079"
        app:is_square="true"/>
    <WebView
        android:id="@+id/agreement_web_view"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="41px"
        android:layout_marginTop="36px"
        android:layout_marginRight="41px"
        android:layout_marginBottom="41px"
        android:layout_above="@+id/account_return"
        android:layout_below="@+id/agreement_title"/>
    <cn.cardoor.user.view.AutoPressTextView
        android:textSize="24px"
        android:textColor="@color/arg_res_0x7f060034"
        android:gravity="center"
        android:id="@+id/account_return"
        android:background="@drawable/arg_res_0x7f080078"
        android:layout_width="178px"
        android:layout_height="53px"
        android:layout_marginBottom="30px"
        android:text="@string/arg_res_0x7f100047"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
</cn.cardoor.user.view.AutoRelativeLayout>
