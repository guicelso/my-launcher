<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/content"
    android:layout_width="680px"
    android:layout_height="wrap_content"
    app:adapt_calc_base_on="3"
    app:bl_corners_radius="20dp"
    app:bl_solid_color="#f20f1828">
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="29px"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_close"
        android:background="@mipmap/arg_res_0x7f0e0009"
        android:layout_width="20px"
        android:layout_height="20px"
        android:layout_marginRight="22px"
        app:is_square="true"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintTop_toTopOf="@+id/tv_title"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="18px"
        android:textColor="@android:color/white"
        android:gravity="center_vertical"
        android:id="@+id/tv_icon_source"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40px"
        android:layout_marginTop="36px"
        android:text="@string/multifunction_icon_source"
        android:drawablePadding="6px"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <com.dofun.variety.theme.ui.IndicatorViewPager
        android:id="@+id/vp_app_set_list"
        android:padding="20px"
        android:layout_width="match_parent"
        android:layout_height="400px"
        android:layout_marginLeft="15px"
        android:layout_marginTop="20px"
        android:layout_marginRight="15px"
        app:adapt_calc_base_on="3"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_error"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="20px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_empty_list"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/arg_res_0x7f10027e"
        app:layout_constraintBottom_toBottomOf="@+id/vp_app_set_list"
        app:layout_constraintEnd_toEndOf="@+id/vp_app_set_list"
        app:layout_constraintLeft_toLeftOf="@+id/vp_app_set_list"
        app:layout_constraintRight_toRightOf="@+id/vp_app_set_list"
        app:layout_constraintStart_toStartOf="@+id/vp_app_set_list"
        app:layout_constraintTop_toTopOf="@+id/vp_app_set_list"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="18px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_error"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="20px"
        android:layout_marginBottom="10px"
        android:text="@string/multifunction_get_more"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintRight_toRightOf="0"/>
</cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
