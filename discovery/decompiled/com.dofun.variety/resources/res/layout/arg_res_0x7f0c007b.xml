<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="22px"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:adapt_calc_base_on="3">
    <cn.cardoor.variety.base.ui.adapt.AutoRecyclerView
        android:id="@+id/rv_feature"
        android:fadingEdge="vertical"
        android:fadingEdgeLength="16dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="12px"
        android:requiresFadingEdge="vertical"
        app:layout_constraintBottom_toTopOf="@+id/line_dividing"
        app:layout_constraintTop_toTopOf="0"
        app:layout_goneMarginBottom="0px"/>
    <cn.cardoor.variety.base.ui.adapt.AutoView
        android:id="@+id/line_dividing"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="6px"
        android:layout_marginBottom="10px"
        android:layerType="software"
        app:adapt_calc_base_on="3"
        app:bl_shape="2"
        app:bl_stroke_color="#4dffffff"
        app:bl_stroke_dashGap="8px"
        app:bl_stroke_dashWidth="10px"
        app:bl_stroke_width="2px"
        app:layout_constraintBottom_toTopOf="@+id/tv_linkage"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="16px"
        android:textColor="@android:color/white"
        android:gravity="center_vertical"
        android:id="@+id/tv_linkage"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12px"
        android:drawablePadding="18px"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toTopOf="@+id/tv_support_version"
        app:layout_goneMarginBottom="0dp"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="16px"
        android:textColor="@android:color/white"
        android:gravity="center_vertical"
        android:id="@+id/tv_support_version"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawableLeft="@mipmap/arg_res_0x7f0e001a"
        android:drawablePadding="18px"
        android:drawableStart="@mipmap/arg_res_0x7f0e001a"
        app:adapt_calc_base_on="3"
        app:layout_constraintBottom_toBottomOf="0"
        app:startDrawableHeight="20px"
        app:startDrawableWidth="20px"/>
</cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
