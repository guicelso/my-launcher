<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/fl_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_back"
        android:background="@mipmap/arg_res_0x7f0e0069"
        android:layout_width="44px"
        android:layout_height="44px"
        android:layout_marginLeft="38px"
        android:layout_marginTop="22px"
        app:is_square="true"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28px"
        app:layout_constraintEnd_toStartOf="@+id/rv_coupon_themes"
        app:layout_constraintRight_toLeftOf="@+id/rv_coupon_themes"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <androidx.constraintlayout.helper.widget.Layer
        android:id="@+id/layer_bg"
        android:background="#0affffff"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:constraint_referenced_ids="rv_coupon_themes,rg_coupon_themes"/>
    <com.dofun.variety.ui.BottomIndicatorRadioGroup
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/rg_coupon_themes"
        android:paddingTop="28px"
        android:paddingBottom="20px"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checkedButton="@+id/rb_coupon_themes"
        app:adapt_calc_base_on="5"
        app:layout_constraintEnd_toEndOf="@+id/rv_coupon_themes"
        app:layout_constraintLeft_toLeftOf="@+id/rv_coupon_themes"
        app:layout_constraintRight_toRightOf="@+id/rv_coupon_themes"
        app:layout_constraintStart_toStartOf="@+id/rv_coupon_themes"
        app:layout_constraintTop_toTopOf="0">
        <cn.cardoor.variety.base.ui.adapt.AutoRadioButton
            android:textSize="24px"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/rb_coupon_themes"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/theme"/>
    </com.dofun.variety.ui.BottomIndicatorRadioGroup>
    <cn.cardoor.variety.base.ui.adapt.AutoRecyclerView
        android:id="@+id/rv_coupon_themes"
        android:fadingEdge="vertical"
        android:fadingEdgeLength="20dp"
        android:layout_width="294px"
        android:layout_height="0dp"
        android:requiresFadingEdge="vertical"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintTop_toBottomOf="@+id/rg_coupon_themes"/>
    <cn.cardoor.variety.base.ui.adapt.AutoViewPager
        android:id="@+id/vp_img"
        android:layout_width="0dp"
        android:layout_height="360px"
        android:layout_marginLeft="58px"
        android:layout_marginTop="32px"
        android:layout_marginRight="58px"
        app:layout_constraintEnd_toStartOf="@+id/rv_coupon_themes"
        app:layout_constraintRight_toLeftOf="@+id/rv_coupon_themes"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <com.dofun.overseasvariety.view.DotView
        android:id="@+id/dotView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20px"
        app:layout_constraintBottom_toTopOf="@+id/tv_pay"
        app:layout_constraintEnd_toEndOf="@+id/vp_img"
        app:layout_constraintStart_toStartOf="@+id/vp_img"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="26px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_pay"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="34px"
        android:layout_marginBottom="30px"
        android:minWidth="200px"
        android:minHeight="60px"
        app:adapt_calc_base_on="5"
        app:bl_corners_radius="86dp"
        app:bl_enabled_solid_color="@color/arg_res_0x7f060045"
        app:bl_unEnabled_solid_color="#a9a9a9"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="@+id/vp_img"
        app:layout_constraintStart_toStartOf="@+id/vp_img"/>
    <com.dofun.overseasvariety.view.AutoDelTextView
        android:textSize="24px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/del_tv_original_price"
        android:paddingLeft="7px"
        android:paddingRight="7px"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="7px"
        app:delColor="@color/arg_res_0x7f0602b8"
        app:delShowing="true"
        app:delStrokeWidth="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_pay"
        app:layout_constraintEnd_toStartOf="@+id/tv_pay"
        app:layout_constraintTop_toTopOf="@+id/tv_pay"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="7px"
        app:layout_constraintBottom_toBottomOf="@+id/tv_pay"
        app:layout_constraintEnd_toStartOf="@+id/del_tv_original_price"
        app:layout_constraintRight_toLeftOf="@+id/del_tv_original_price"
        app:layout_constraintTop_toTopOf="@+id/tv_pay"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="20px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_count_down"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:fitTypeface="false"
        app:layout_constraintBottom_toBottomOf="@+id/tv_pay"
        app:layout_constraintEnd_toStartOf="@+id/rv_coupon_themes"
        app:layout_constraintLeft_toRightOf="@+id/tv_pay"
        app:layout_constraintRight_toLeftOf="@+id/rv_coupon_themes"
        app:layout_constraintStart_toEndOf="@+id/tv_pay"
        app:layout_constraintTop_toTopOf="@+id/tv_pay"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="26px"
        android:textColor="#ba7f11"
        android:gravity="center"
        android:id="@+id/tv_open_vip"
        android:background="@drawable/arg_res_0x7f080289"
        android:paddingLeft="6px"
        android:paddingTop="6px"
        android:paddingRight="6px"
        android:paddingBottom="6px"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30px"
        android:maxWidth="200px"
        android:minWidth="160px"
        android:minHeight="60px"
        android:text="@string/arg_res_0x7f1002f8"
        app:adapt_calc_base_on="5"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="@+id/vp_img"
        app:layout_constraintLeft_toLeftOf="@+id/vp_img"
        app:layout_constraintRight_toRightOf="@+id/vp_img"
        app:layout_constraintStart_toStartOf="@+id/vp_img"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_feedback"
        android:visibility="@integer/arg_res_0x7f0a0009"
        android:layout_width="34px"
        android:layout_height="34px"
        android:layout_marginRight="62px"
        android:src="@mipmap/arg_res_0x7f0e000c"
        android:scaleType="fitXY"
        app:is_square="true"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintEnd_toStartOf="@+id/rv_coupon_themes"
        app:layout_constraintTop_toTopOf="@+id/tv_title"/>
    <androidx.constraintlayout.helper.widget.Layer
        android:id="@+id/group_coupon_pay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_pay,del_tv_original_price,tv_count,tv_count_down"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="@+id/vp_img"
        app:layout_constraintStart_toStartOf="@+id/vp_img"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_coupon"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="rg_coupon_themes,rv_coupon_themes,layer_bg"/>
</androidx.constraintlayout.widget.ConstraintLayout>
