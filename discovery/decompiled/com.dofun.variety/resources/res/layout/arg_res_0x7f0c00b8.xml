<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_theme_img"
        android:layout_width="300px"
        android:layout_height="170px"
        android:scaleType="fitXY"
        app:adapt_calc_base_on="3"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_current_use"
        android:visibility="invisible"
        android:layout_width="300px"
        android:layout_height="170px"
        android:src="@drawable/arg_res_0x7f080253"
        app:adapt_calc_base_on="3"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_theme_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4px"
        android:lines="1"
        app:adapt_calc_base_on="3"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/iv_theme_img"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_choose"
        android:background="@drawable/arg_res_0x7f08022b"
        android:visibility="invisible"
        android:duplicateParentState="true"
        android:layout_width="32px"
        android:layout_height="32px"
        android:layout_margin="8px"
        app:adapt_calc_base_on="3"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
</androidx.constraintlayout.widget.ConstraintLayout>
