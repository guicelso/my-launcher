<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.user.view.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#111827"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <cn.cardoor.user.view.AutoPressImageView
        android:id="@+id/account_back"
        android:layout_width="60px"
        android:layout_height="60px"
        android:layout_marginLeft="61px"
        android:layout_marginTop="37px"
        android:src="@drawable/arg_res_0x7f080079"/>
    <cn.cardoor.user.view.AutoTextView
        android:textSize="28px"
        android:textStyle="bold"
        android:textColor="@color/arg_res_0x7f060034"
        android:id="@+id/account_logout_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="53px"
        android:text="@string/arg_res_0x7f100036"
        android:layout_centerHorizontal="true"/>
    <cn.cardoor.user.view.AutoLinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/overseas_logout_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true">
        <cn.cardoor.user.view.AutoImageView
            android:layout_width="125px"
            android:layout_height="170px"
            android:src="@drawable/arg_res_0x7f080086"/>
        <cn.cardoor.user.view.AutoTextView
            android:textSize="24px"
            android:textColor="@color/arg_res_0x7f060034"
            android:paddingLeft="24px"
            android:paddingRight="24px"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24px"
            android:text="@string/arg_res_0x7f100039"/>
    </cn.cardoor.user.view.AutoLinearLayout>
    <cn.cardoor.user.view.AutoLinearLayout
        android:orientation="vertical"
        android:id="@+id/mainland_logout_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true">
        <cn.cardoor.user.view.AutoTextView
            android:textSize="24px"
            android:textColor="#a5a5a5"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/account_logout_desc"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/arg_res_0x7f100038"
            android:layout_below="@+id/account_logout_title"/>
        <cn.cardoor.user.view.AutoLinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/account_logout_icon1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30px">
            <cn.cardoor.user.view.AutoImageView
                android:layout_width="80px"
                android:layout_height="80px"
                android:src="@drawable/arg_res_0x7f08007f"
                app:is_square="true"/>
            <cn.cardoor.user.view.AutoImageView
                android:layout_width="80px"
                android:layout_height="80px"
                android:layout_marginLeft="96px"
                android:src="@drawable/arg_res_0x7f08007a"
                app:is_square="true"/>
            <cn.cardoor.user.view.AutoImageView
                android:layout_width="80px"
                android:layout_height="80px"
                android:layout_marginLeft="96px"
                android:src="@drawable/arg_res_0x7f08007e"
                app:is_square="true"/>
            <cn.cardoor.user.view.AutoImageView
                android:layout_width="80px"
                android:layout_height="80px"
                android:layout_marginLeft="96px"
                android:src="@drawable/arg_res_0x7f08007c"
                app:is_square="true"/>
        </cn.cardoor.user.view.AutoLinearLayout>
        <cn.cardoor.user.view.AutoLinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/account_logout_icon2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="50px"
            app:is_square="true">
            <cn.cardoor.user.view.AutoImageView
                android:layout_width="80px"
                android:layout_height="80px"
                android:src="@drawable/arg_res_0x7f080080"
                app:is_square="true"/>
            <cn.cardoor.user.view.AutoImageView
                android:layout_width="80px"
                android:layout_height="80px"
                android:layout_marginLeft="96px"
                android:src="@drawable/arg_res_0x7f08007d"
                app:is_square="true"/>
            <cn.cardoor.user.view.AutoImageView
                android:layout_width="80px"
                android:layout_height="80px"
                android:layout_marginLeft="96px"
                android:src="@drawable/arg_res_0x7f080081"
                app:is_square="true"/>
            <cn.cardoor.user.view.AutoImageView
                android:layout_width="80px"
                android:layout_height="80px"
                android:layout_marginLeft="96px"
                android:src="@drawable/arg_res_0x7f08007b"
                app:is_square="true"/>
        </cn.cardoor.user.view.AutoLinearLayout>
    </cn.cardoor.user.view.AutoLinearLayout>
    <cn.cardoor.user.view.AutoLinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="37px"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <cn.cardoor.user.view.AutoPressTextView
            android:textSize="24px"
            android:textColor="@color/arg_res_0x7f060034"
            android:gravity="center"
            android:id="@+id/account_logout_btn"
            android:background="@drawable/arg_res_0x7f080092"
            android:layout_width="178px"
            android:layout_height="53px"
            android:text="@string/arg_res_0x7f100037"/>
        <cn.cardoor.user.view.AutoPressTextView
            android:textSize="24px"
            android:textColor="@color/arg_res_0x7f060034"
            android:gravity="center"
            android:id="@+id/account_logout_think_btn"
            android:background="@drawable/arg_res_0x7f080091"
            android:layout_width="178px"
            android:layout_height="53px"
            android:layout_marginLeft="57px"
            android:text="@string/arg_res_0x7f10003d"/>
    </cn.cardoor.user.view.AutoLinearLayout>
</cn.cardoor.user.view.AutoRelativeLayout>
