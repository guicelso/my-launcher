<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="680px"
    android:layout_height="wrap_content">
    <cn.cardoor.variety.base.ui.adapt.AutoLinearLayout
        android:id="@+id/line"
        android:background="#ff7300"
        android:layout_width="2px"
        android:layout_height="30px"
        android:layout_marginLeft="24px"
        android:layout_marginTop="24px"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="#4a4a4a"
        android:id="@+id/tv_theme_pay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="7px"
        android:text="@string/arg_res_0x7f10037e"
        app:layout_constraintBottom_toBottomOf="@+id/line"
        app:layout_constraintStart_toEndOf="@+id/line"
        app:layout_constraintTop_toTopOf="@+id/line"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="#9b9b9b"
        android:id="@+id/tv_qrcode_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10px"
        android:layout_marginTop="20px"
        android:text="@string/arg_res_0x7f1000d3"
        app:layout_constraintEnd_toStartOf="@+id/tv_theme_price"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="2"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_theme_pay"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="#ffff7300"
        android:id="@+id/tv_theme_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20px"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toEndOf="@+id/tv_qrcode_desc"
        app:layout_constraintTop_toBottomOf="@+id/tv_theme_pay"/>
    <include
        android:id="@+id/layout_pay_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/arg_res_0x7f0c00c2"/>
    <ProgressBar
        android:id="@+id/pb"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintTop_toTopOf="0"
        style="@android:style/Widget.Holo.Light.ProgressBar.Large"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="25px"
        android:textColor="#acacac"
        android:id="@+id/fl_error"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/arg_res_0x7f1001c6"
        android:drawableTop="@mipmap/arg_res_0x7f0e0056"
        android:drawablePadding="25px"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_close"
        android:background="@mipmap/arg_res_0x7f0e0009"
        android:layout_width="44px"
        android:layout_height="44px"
        android:layout_marginTop="20px"
        android:layout_marginRight="20px"
        app:is_square="true"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintTop_toTopOf="0"/>
</cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
