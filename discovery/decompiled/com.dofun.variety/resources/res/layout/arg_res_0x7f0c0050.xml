<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/fl_state_container"
    android:layout_width="900px"
    android:layout_height="460px"
    app:bl_corners_radius="20dp"
    app:bl_solid_color="@android:color/white">
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="#4a4a4a"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20px"
        android:text="@string/arg_res_0x7f10031b"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="30px"
        android:textColor="#4a4a4a"
        android:id="@+id/tv_car_brand_and_series"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20px"
        android:layout_marginTop="12px"
        app:layout_constraintEnd_toStartOf="@+id/tv_change"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toLeftOf="@+id/tv_change"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        app:layout_goneMarginStart="40px"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_change"
        android:paddingLeft="50px"
        android:paddingTop="12px"
        android:paddingRight="50px"
        android:paddingBottom="12px"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="40px"
        android:text="@string/arg_res_0x7f10020e"
        app:adapt_calc_base_on="3"
        app:bl_corners_radius="60dp"
        app:bl_solid_color="@color/arg_res_0x7f060035"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintTop_toTopOf="@+id/tv_car_brand_and_series"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="3"
        app:constraint_referenced_ids="tv_car_brand_and_series,tv_change"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="#4a4a4a"
        android:id="@+id/tv_car_model"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/tv_change"
        app:layout_constraintLeft_toLeftOf="@+id/tv_car_brand_and_series"
        app:layout_constraintRight_toRightOf="@+id/tv_change"
        app:layout_constraintStart_toStartOf="@+id/tv_car_brand_and_series"
        app:layout_constraintTop_toBottomOf="@+id/barrier1"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_close"
        android:background="@mipmap/arg_res_0x7f0e0009"
        android:layout_width="30px"
        android:layout_height="30px"
        android:layout_margin="14px"
        app:adapt_calc_base_on="3"
        app:is_square="true"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="22px"
        android:textColor="#4a4a4a"
        android:id="@+id/tv_count_down"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/iv_close"
        app:layout_constraintEnd_toStartOf="@+id/iv_close"
        app:layout_constraintTop_toTopOf="@+id/iv_close"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="3"
        app:constraint_referenced_ids="tv_car_model"/>
    <cn.cardoor.variety.base.ui.adapt.AutoFrameLayout
        android:id="@+id/ads_layout"
        android:layout_width="0dp"
        android:layout_height="118px"
        android:layout_marginLeft="40px"
        android:layout_marginTop="12px"
        android:layout_marginRight="40px"
        app:adapt_calc_base_on="5"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0">
        <com.dofun.variety.theme.widget.ad.AdBanner
            android:id="@+id/ads_banner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </cn.cardoor.variety.base.ui.adapt.AutoFrameLayout>
    <cn.cardoor.variety.base.ui.adapt.AutoRecyclerView
        android:scrollbarSize="4dp"
        android:scrollbarThumbVertical="@drawable/arg_res_0x7f08024c"
        android:scrollbarStyle="outsideOverlay"
        android:id="@+id/rv_models_resource"
        android:visibility="invisible"
        android:scrollbars="vertical"
        android:fadingEdge="vertical"
        android:fadingEdgeLength="20dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="40px"
        android:layout_marginTop="4px"
        android:layout_marginRight="40px"
        android:requiresFadingEdge="vertical"
        app:layout_constraintBottom_toTopOf="@+id/ads_layout"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/barrier2"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_retry"
        android:paddingLeft="40px"
        android:paddingTop="12px"
        android:paddingRight="40px"
        android:paddingBottom="12px"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20px"
        android:text="@string/arg_res_0x7f1002ff"
        app:bl_corners_radius="60dp"
        app:bl_solid_color="@color/arg_res_0x7f060035"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toLeftOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toStartOf="0"/>
</cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
