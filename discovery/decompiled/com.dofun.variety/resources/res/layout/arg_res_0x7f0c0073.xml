<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/factory_line"
        android:background="#1affffff"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoImageView
        android:id="@+id/iv_back"
        android:layout_width="44px"
        android:layout_height="44px"
        android:layout_marginLeft="62px"
        android:src="@drawable/arg_res_0x7f080233"
        app:layout_constraintBottom_toBottomOf="@+id/factory_line"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="32px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_factory_scan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/arg_res_0x7f10030a"
        app:layout_constraintBottom_toBottomOf="@+id/factory_line"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="@+id/factory_line"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="26px"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_import"
        android:paddingLeft="12px"
        android:paddingRight="12px"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="50px"
        android:minWidth="160px"
        android:minHeight="50px"
        android:text="@string/arg_res_0x7f1003c1"
        app:adapt_calc_base_on="3"
        app:bl_corners_radius="100dp"
        app:bl_stroke_color="@android:color/white"
        app:bl_stroke_width="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/factory_line"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintTop_toTopOf="@+id/factory_line"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_sales_mode_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50px"
        android:layout_marginTop="10px"
        android:text="1. 销售模式开关"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/factory_line"/>
    <com.dofun.overseasvariety.view.SwitchView
        android:id="@+id/sales_mode_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20px"
        app:layout_constraintStart_toStartOf="@+id/tv_sales_mode_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_sales_mode_title"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_sales_mode_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50px"
        android:text="开启"
        app:layout_constraintBottom_toBottomOf="@+id/sales_mode_switch"
        app:layout_constraintStart_toEndOf="@+id/sales_mode_switch"
        app:layout_constraintTop_toTopOf="@+id/sales_mode_switch"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_sales_mode_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="80px"
        android:text="开启销售模式后，设备会弹窗提醒保修激活。"
        app:layout_constraintStart_toEndOf="@+id/tv_sales_mode_status"
        app:layout_constraintTop_toTopOf="@+id/tv_sales_mode_status"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="3"
        app:constraint_referenced_ids="sales_mode_switch,tv_sales_mode_status,tv_sales_mode_desc"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="@android:color/white"
        android:id="@+id/tv_scan_device_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26px"
        android:text="2. 扫码入库设备"
        app:layout_constraintStart_toStartOf="@+id/tv_sales_mode_title"
        app:layout_constraintTop_toBottomOf="@+id/barrier"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="24px"
        android:textColor="@android:color/white"
        android:gravity="center_horizontal"
        android:id="@+id/tv_scan_device"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20px"
        android:text="@string/arg_res_0x7f10012c"
        android:drawablePadding="10px"
        app:layout_constraintStart_toStartOf="@+id/tv_scan_device_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_scan_device_title"/>
    <cn.cardoor.variety.base.ui.adapt.AutoTextView
        android:textSize="22px"
        android:textColor="@android:color/white"
        android:id="@+id/desc"
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50px"
        android:layout_marginRight="50px"
        android:text="@string/arg_res_0x7f10030c"
        android:lineSpacingExtra="4px"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintLeft_toRightOf="@+id/tv_scan_device"
        app:layout_constraintRight_toRightOf="0"
        app:layout_constraintStart_toEndOf="@+id/tv_scan_device"
        app:layout_constraintTop_toTopOf="@+id/tv_scan_device"/>
</androidx.constraintlayout.widget.ConstraintLayout>
