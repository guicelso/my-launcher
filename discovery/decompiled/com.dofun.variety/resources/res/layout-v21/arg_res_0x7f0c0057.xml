<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="680px"
        android:minHeight="430px"
        app:adapt_calc_base_on="3"
        app:bl_corners_radius="12dp"
        app:bl_solid_color="@android:color/white">
        <cn.cardoor.variety.base.ui.adapt.AutoImageView
            android:id="@+id/close"
            android:background="@mipmap/arg_res_0x7f0e0009"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12px"
            app:adapt_calc_base_on="3"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintTop_toTopOf="0"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="30px"
            android:textColor="@android:color/black"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20px"
            app:adapt_calc_base_on="3"
            app:layout_constraintBottom_toTopOf="@+id/divider"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toTopOf="0"
            app:layout_constraintVertical_chainStyle="0"/>
        <cn.cardoor.variety.base.ui.adapt.AutoFrameLayout
            android:id="@+id/divider"
            android:background="@android:color/black"
            android:layout_width="1dp"
            android:layout_height="240px"
            android:layout_marginTop="40px"
            android:layout_marginBottom="40px"
            app:adapt_calc_base_on="3"
            app:layout_constraintBottom_toTopOf="@+id/tv_save"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="28px"
            android:gravity="center"
            android:id="@+id/tv_save"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30px"
            android:minWidth="190px"
            android:minHeight="50px"
            android:text="@string/arg_res_0x7f100309"
            app:adapt_calc_base_on="3"
            app:bl_corners_radius="80dp"
            app:bl_solid_color="#00a2f9"
            app:layout_constraintBottom_toBottomOf="0"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toBottomOf="@+id/divider"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="24px"
            android:textColor="@android:color/black"
            android:id="@+id/tv_headlamp_start_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/arg_res_0x7f10018e"
            app:layout_constraintBottom_toTopOf="@+id/tp_start_time_picker"
            app:layout_constraintEnd_toStartOf="@+id/divider"
            app:layout_constraintStart_toStartOf="0"/>
        <cn.cardoor.variety.base.ui.adapt.AutoTextView
            android:textSize="24px"
            android:textColor="@android:color/black"
            android:id="@+id/tv_headlamp_end_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/arg_res_0x7f10018c"
            app:adapt_calc_base_on="3"
            app:layout_constraintBottom_toTopOf="@+id/tp_end_time_picker"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintStart_toEndOf="@+id/divider"/>
        <TimePicker
            android:theme="@style/arg_res_0x7f1102bc"
            android:id="@+id/tp_start_time_picker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="80px"
            android:layout_marginRight="80px"
            android:layout_marginStart="80px"
            android:layout_marginEnd="80px"
            android:timePickerMode="spinner"
            app:layout_constraintBottom_toBottomOf="0"
            app:layout_constraintEnd_toStartOf="@+id/divider"
            app:layout_constraintStart_toStartOf="0"
            app:layout_constraintTop_toTopOf="0"/>
        <TimePicker
            android:theme="@style/arg_res_0x7f1102bc"
            android:id="@+id/tp_end_time_picker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="80px"
            android:layout_marginRight="80px"
            android:layout_marginStart="80px"
            android:layout_marginEnd="80px"
            android:timePickerMode="spinner"
            app:layout_constraintBottom_toBottomOf="0"
            app:layout_constraintEnd_toEndOf="0"
            app:layout_constraintStart_toEndOf="@+id/divider"
            app:layout_constraintTop_toTopOf="0"/>
    </cn.cardoor.variety.base.ui.adapt.AutoConstraintLayout>
</FrameLayout>
