<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:layout_width="@dimen/arg_res_0x7f070303"
        android:layout_height="@dimen/arg_res_0x7f070302"
        layout="@layout/arg_res_0x7f0c010e"/>
    <LinearLayout
        android:layout_gravity="top"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/arg_res_0x7f070303">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/notification_main_column_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/arg_res_0x7f070302">
            <FrameLayout
                android:id="@+id/notification_main_column"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"/>
            <FrameLayout
                android:id="@+id/right_side"
                android:paddingTop="@dimen/arg_res_0x7f070307"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp">
                <ViewStub
                    android:layout_gravity="end|top"
                    android:id="@+id/time"
                    android:visibility="gone"
                    android:layout="@layout/arg_res_0x7f0c0113"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <ViewStub
                    android:layout_gravity="end|top"
                    android:id="@+id/chronometer"
                    android:visibility="gone"
                    android:layout="@layout/arg_res_0x7f0c0112"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textAppearance="@style/arg_res_0x7f110208"
                    android:layout_gravity="end|bottom"
                    android:id="@+id/info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:singleLine="true"/>
            </FrameLayout>
        </LinearLayout>
        <ImageView
            android:id="@+id/action_divider"
            android:background="#29000000"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/actions"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-8dp"/>
    </LinearLayout>
</FrameLayout>
