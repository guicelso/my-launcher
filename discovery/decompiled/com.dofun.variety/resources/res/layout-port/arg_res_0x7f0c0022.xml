<?xml version="1.0" encoding="utf-8"?>
<cn.cardoor.user.view.AutoRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#111827"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <cn.cardoor.user.view.AutoTextView
        android:textSize="28px"
        android:textStyle="bold"
        android:textColor="@color/arg_res_0x7f060034"
        android:id="@+id/account_login_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50px"
        android:text="@string/arg_res_0x7f100033"
        android:layout_centerHorizontal="true"/>
    <cn.cardoor.user.view.AutoRelativeLayout
        android:id="@+id/account_email_rl"
        android:layout_width="284px"
        android:layout_height="wrap_content"
        android:layout_marginTop="116px"
        android:layout_centerHorizontal="true">
        <cn.cardoor.user.view.AutoTextView
            android:textSize="16px"
            android:textColor="@color/arg_res_0x7f060034"
            android:id="@+id/email_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/arg_res_0x7f10002a"/>
        <cn.cardoor.user.view.AutoEditText
            android:textSize="18px"
            android:textColor="@color/arg_res_0x7f060034"
            android:id="@+id/email_et"
            android:background="@drawable/arg_res_0x7f080089"
            android:paddingLeft="17px"
            android:layout_width="match_parent"
            android:layout_height="42px"
            android:layout_marginTop="10px"
            android:maxLines="1"
            android:maxLength="32"
            android:layout_below="@+id/email_tv"
            android:inputType="textEmailAddress"
            android:imeOptions="actionNext"/>
        <cn.cardoor.user.view.AutoTextView
            android:textSize="16px"
            android:textColor="@color/arg_res_0x7f060034"
            android:id="@+id/verification_code_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16px"
            android:text="@string/arg_res_0x7f100052"
            android:layout_below="@+id/email_et"/>
        <cn.cardoor.user.view.AutoEditText
            android:textSize="18px"
            android:textColor="@color/arg_res_0x7f060034"
            android:id="@+id/verification_code_et"
            android:background="@drawable/arg_res_0x7f080089"
            android:paddingLeft="17px"
            android:layout_width="200px"
            android:layout_height="42px"
            android:layout_marginTop="10px"
            android:maxLines="1"
            android:maxLength="6"
            android:layout_below="@+id/verification_code_tv"
            android:layout_alignLeft="@+id/email_et"
            android:imeOptions="actionDone"/>
        <cn.cardoor.user.view.AutoPressTextView
            android:textSize="16px"
            android:textColor="@color/arg_res_0x7f060034"
            android:gravity="center"
            android:id="@+id/verification_code_get_tv"
            android:background="@drawable/arg_res_0x7f08008b"
            android:layout_width="match_parent"
            android:layout_height="42px"
            android:layout_marginLeft="6px"
            android:text="@string/arg_res_0x7f10004c"
            android:maxLines="1"
            android:layout_toRightOf="@+id/verification_code_et"
            android:layout_alignTop="@+id/verification_code_et"/>
        <cn.cardoor.user.view.AutoPressTextView
            android:textSize="16px"
            android:textColor="@color/arg_res_0x7f060034"
            android:gravity="center"
            android:id="@+id/email_login"
            android:background="@drawable/arg_res_0x7f08008e"
            android:layout_width="match_parent"
            android:layout_height="42px"
            android:layout_marginTop="30px"
            android:text="@string/arg_res_0x7f100033"
            android:maxLines="1"
            android:layout_below="@+id/verification_code_et"
            android:layout_centerHorizontal="true"/>
        <cn.cardoor.user.view.AutoTextView
            android:textSize="18px"
            android:textColor="#ff3a3a"
            android:gravity="center"
            android:id="@+id/email_read_agreement_first_tv"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="70px"
            android:layout_marginTop="6px"
            android:text="@string/arg_res_0x7f100045"
            android:maxLines="3"
            android:layout_below="@+id/email_login"/>
    </cn.cardoor.user.view.AutoRelativeLayout>
    <cn.cardoor.user.view.AutoRelativeLayout
        android:id="@+id/account_qr_code_rl"
        android:layout_width="200px"
        android:layout_height="200px"
        android:layout_marginTop="116px"
        android:layout_centerHorizontal="true">
        <cn.cardoor.user.view.AutoProgressBar
            android:id="@+id/pb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            style="@android:style/Widget.Holo.Light.ProgressBar.Large"/>
        <cn.cardoor.user.view.AutoImageView
            android:id="@+id/account_login_qr_code"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <cn.cardoor.user.view.AutoImageView
            android:id="@+id/ar_code_logo"
            android:visibility="gone"
            android:layout_width="24px"
            android:layout_height="24px"
            android:src="@drawable/arg_res_0x7f080082"
            android:layout_centerInParent="true"/>
        <cn.cardoor.user.view.AutoTextView
            android:textSize="20px"
            android:textColor="@color/arg_res_0x7f060034"
            android:gravity="center"
            android:id="@+id/account_read_first"
            android:background="#c5000000"
            android:paddingLeft="30px"
            android:paddingRight="30px"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/arg_res_0x7f100045"/>
    </cn.cardoor.user.view.AutoRelativeLayout>
    <cn.cardoor.user.view.AutoLinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/account_refresh_qr_code_ll"
        android:background="#c5000000"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignLeft="@+id/account_qr_code_rl"
        android:layout_alignTop="@+id/account_qr_code_rl"
        android:layout_alignRight="@+id/account_qr_code_rl"
        android:layout_alignBottom="@+id/account_qr_code_rl">
        <cn.cardoor.user.view.AutoImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/arg_res_0x7f080087"/>
        <cn.cardoor.user.view.AutoTextView
            android:textSize="24px"
            android:textColor="@color/arg_res_0x7f060034"
            android:gravity="center_horizontal"
            android:id="@+id/account_load_qr_core_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2px"
            android:text="@string/arg_res_0x7f10003e"/>
        <cn.cardoor.user.view.AutoTextView
            android:textSize="20px"
            android:textColor="#6c6c6c"
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4px"
            android:text="@string/arg_res_0x7f100046"/>
    </cn.cardoor.user.view.AutoLinearLayout>
    <cn.cardoor.user.view.AutoTextView
        android:textSize="20px"
        android:textColor="#6c6c6c"
        android:gravity="top|center_horizontal"
        android:id="@+id/account_login_desc"
        android:paddingLeft="20px"
        android:paddingRight="20px"
        android:layout_width="match_parent"
        android:layout_height="100px"
        android:layout_marginTop="16px"
        android:text="@string/arg_res_0x7f100040"
        android:maxLines="4"
        android:layout_below="@+id/account_qr_code_rl"
        android:lineSpacingExtra="4px"/>
    <cn.cardoor.user.view.AutoRelativeLayout
        android:id="@+id/account_agreement_rl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/account_login_desc"
        android:layout_centerHorizontal="true">
        <CheckBox
            android:id="@+id/account_agreement_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:layout_centerVertical="true"
            android:scaleX="0.5"
            android:scaleY="0.5"/>
        <cn.cardoor.user.view.AutoTextView
            android:textSize="14px"
            android:textColor="@color/arg_res_0x7f060034"
            android:gravity="center"
            android:id="@+id/account_agreement_agree"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/arg_res_0x7f100021"
            android:layout_toRightOf="@+id/account_agreement_check"
            android:layout_centerVertical="true"/>
    </cn.cardoor.user.view.AutoRelativeLayout>
    <cn.cardoor.user.view.AutoPressTextView
        android:textSize="20px"
        android:textColor="@color/arg_res_0x7f060034"
        android:gravity="center"
        android:id="@+id/change_login_type"
        android:background="@drawable/arg_res_0x7f08008a"
        android:paddingLeft="36px"
        android:paddingRight="36px"
        android:layout_width="wrap_content"
        android:layout_height="42px"
        android:layout_marginTop="28px"
        android:text="@string/arg_res_0x7f100024"
        android:maxLines="1"
        android:layout_below="@+id/account_agreement_rl"
        android:layout_centerHorizontal="true"/>
    <cn.cardoor.user.view.AutoImageView
        android:id="@+id/account_marketing_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="42px"
        android:layout_marginTop="40px"
        android:layout_marginRight="42px"
        android:layout_marginBottom="35px"
        android:scaleType="centerInside"
        android:layout_below="@+id/change_login_type"/>
</cn.cardoor.user.view.AutoRelativeLayout>
