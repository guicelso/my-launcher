<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceScreen
        android:title="@string/volte_registration"
        android:key="volte_registration">
        <PreferenceScreen
            android:title="@string/volte_impi_impu_setting"
            android:key="volte_impi_impu_setting">
            <PreferenceScreen
                android:title="@string/volte_impi_impu_sub_setting"
                android:key="volte_impi_impu_sub_setting"/>
        </PreferenceScreen>
        <PreferenceScreen
            android:title="@string/volte_pcscf_setting"
            android:key="volte_pcscf_setting">
            <ListPreference
                android:entries="@array/volte_ip_setting"
                android:title="@string/volte_ip_setting"
                android:key="volte_ip_setting"
                android:summary=""
                android:dialogTitle="@string/volte_ip_setting"
                android:entryValues="@array/volte_ip_setting_value"/>
            <EditTextPreference
                android:maxLength="4"
                android:numeric="integer"
                android:title="@string/volte_mut_length"
                android:key="volte_mut_length"
                android:summary="please input data"/>
        </PreferenceScreen>
        <com.sprd.engineermode.EMSwitchPreference
            android:title="@string/volte_subscribe_setting_switch"
            android:key="volte_subscribe_setting_switch"
            android:summaryOn="Open"
            android:summaryOff="Close"/>
        <PreferenceScreen
            android:title="@string/volte_sigcomp_setting"
            android:key="volte_sigcomp_setting">
            <com.sprd.engineermode.EMSwitchPreference
                android:title="@string/volte_sigcomp_setting_switch"
                android:key="volte_sigcomp_setting_switch"
                android:summaryOn="Open"
                android:summaryOff="Close"/>
            <ListPreference
                android:entries="@array/volte_sigcomp_algorithm"
                android:title="@string/volte_sigcomp_algorithm"
                android:key="volte_sigcomp_algorithm"
                android:summary=""
                android:dialogTitle="@string/volte_sigcomp_algorithm"
                android:entryValues="@array/volte_sigcomp_algorithm_value"/>
        </PreferenceScreen>
        <Preference
            android:title="@string/volte_ipsec_setting"
            android:key="volte_ipsec_setting">
            <intent
                android:targetPackage="com.sprd.engineermode"
                android:action="android.intent.action.MAIN"
                android:targetClass="com.sprd.engineermode.telephony.volte.IPSecSettingActivity"/>
        </Preference>
        <EditTextPreference
            android:maxLength="6"
            android:numeric="integer"
            android:title="@string/volte_expires_time_setting"
            android:key="volte_expires_time_setting"
            android:summary="please input data"/>
    </PreferenceScreen>
    <PreferenceScreen
        android:title="@string/volte_call"
        android:key="volte_call">
        <PreferenceScreen
            android:title="@string/volte_voice_code_type"
            android:key="volte_code_way">
            <PreferenceCategory android:title="@string/volte_voice_code_type">
                <Preference
                    android:title="@string/volte_voice_code_type"
                    android:key="volte_voice_code"/>
            </PreferenceCategory>
            <PreferenceCategory android:title="@string/volte_evs_primary">
                <ListPreference
                    android:entries="@array/evs_primary_bandwidth"
                    android:title="@string/min_bandwidth"
                    android:key="min_bandwidth"
                    android:dialogTitle="@string/min_bandwidth"
                    android:entryValues="@array/evs_primary_bandwidth_value"/>
                <ListPreference
                    android:entries="@array/evs_primary_bandwidth"
                    android:title="@string/max_bandwidth"
                    android:key="max_bandwidth"
                    android:dialogTitle="@string/max_bandwidth"
                    android:entryValues="@array/evs_primary_bandwidth_value"/>
                <ListPreference
                    android:entries="@array/evs_primary_bitrate"
                    android:title="@string/min_rate"
                    android:key="min_bitrate"
                    android:dialogTitle="@string/min_rate"
                    android:entryValues="@array/evs_primary_bitrate_value"/>
                <ListPreference
                    android:entries="@array/evs_primary_bitrate"
                    android:title="@string/max_rate"
                    android:key="max_bitrate"
                    android:dialogTitle="@string/max_rate"
                    android:entryValues="@array/evs_primary_bitrate_value"/>
                <ListPreference
                    android:entries="@array/evs_primary_bitrate"
                    android:title="@string/default_encode_rate"
                    android:key="default_encode_bitrate"
                    android:dialogTitle="@string/default_encode_rate"
                    android:entryValues="@array/evs_primary_bitrate_value"/>
            </PreferenceCategory>
            <PreferenceCategory android:title="EVS Channel Aware">
                <ListPreference
                    android:entries="@array/channel_aware_mode"
                    android:title="@string/aware_mode_title"
                    android:key="channel_aware_mode"
                    android:dialogTitle="@string/aware_mode_title"
                    android:entryValues="@array/channel_aware_mode_value"/>
                <ListPreference
                    android:entries="@array/channel_aware_bandwidth"
                    android:title="@string/aware_bandwidth_title"
                    android:key="channel_aware_bandwidth"
                    android:dialogTitle="@string/aware_bandwidth_title"
                    android:entryValues="@array/channel_aware_bandwidth_value"/>
            </PreferenceCategory>
            <PreferenceCategory android:title="EVS AMR-WB IO">
                <Preference
                    android:title="@string/rate_set"
                    android:key="evs_rate_set"/>
                <ListPreference
                    android:entries="@array/evs_wb_default_bitrate"
                    android:title="@string/default_encode_rate"
                    android:key="evs_io_default_bitrate"
                    android:dialogTitle="@string/default_encode_rate"
                    android:entryValues="@array/evs_wb_default_bitrate_value"/>
            </PreferenceCategory>
            <PreferenceCategory android:title="AMR-WB">
                <Preference
                    android:title="@string/rate_set"
                    android:key="wb_rate_set"/>
                <ListPreference
                    android:entries="@array/evs_wb_default_bitrate"
                    android:title="@string/default_encode_rate"
                    android:key="wb_default_bitrate"
                    android:dialogTitle="@string/default_encode_rate"
                    android:entryValues="@array/evs_wb_default_bitrate_value"/>
            </PreferenceCategory>
            <PreferenceCategory android:title="AMR-NB">
                <Preference
                    android:title="@string/rate_set"
                    android:key="nb_rate_set"/>
                <ListPreference
                    android:entries="@array/nb_default_bitrate"
                    android:title="@string/default_encode_rate"
                    android:key="nb_default_bitrate"
                    android:dialogTitle="@string/default_encode_rate"
                    android:entryValues="@array/nb_default_bitrate_value"/>
            </PreferenceCategory>
        </PreferenceScreen>
        <PreferenceScreen
            android:title="@string/volte_precondition_setting"
            android:key="volte_precondition_setting">
            <com.sprd.engineermode.EMSwitchPreference
                android:title="@string/volte_precondition_setting_switch"
                android:key="volte_precondition_setting_switch"
                android:summaryOn="Support"
                android:summaryOff="NotSupport"/>
            <EditTextPreference
                android:numeric="integer"
                android:title="@string/volte_tqos_time_setting"
                android:key="volte_tqos_time_setting"
                android:summary="please input data"/>
            <EditTextPreference
                android:numeric="integer"
                android:title="@string/volte_tcall_time_setting"
                android:key="volte_tcall_time_setting"
                android:summary="please input data"/>
            <EditTextPreference
                android:numeric="integer"
                android:title="@string/volte_treg_time_setting"
                android:key="volte_treg_time_setting"
                android:summary="please input data"/>
            <EditTextPreference
                android:numeric="integer"
                android:title="@string/volte_pqos_time_setting"
                android:key="volte_pqos_time_setting"
                android:summary="please input data"/>
        </PreferenceScreen>
        <EditTextPreference
            android:maxLength="6"
            android:numeric="integer"
            android:title="@string/session_timer"
            android:key="session_timer"/>
        <EditTextPreference
            android:maxLength="6"
            android:numeric="integer"
            android:title="@string/sip_force_mt_session_timer"
            android:key="force_mt_session_timer"/>
    </PreferenceScreen>
    <com.sprd.engineermode.EMSwitchPreference
        android:title="P-CSCF"
        android:key="pcscf_set"/>
    <Preference
        android:title="@string/plmn"
        android:key="key_plmn">
        <intent
            android:targetPackage="com.android.phone"
            android:action="android.intent.action.MAIN"
            android:targetClass="com.unisoc.phone.callsettings.VoLTEConfigSettings"/>
    </Preference>
</PreferenceScreen>
