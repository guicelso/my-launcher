<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TableLayout
        android:id="@+id/tablelayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="1">
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <TextView
                android:textSize="18dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bt_rx_channel"/>
            <EditText
                android:id="@+id/tx_mode_channel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:hint="0~78"
                android:singleLine="true"
                android:maxLength="2"
                android:digits="1234567890"/>
        </TableRow>
        <TableRow android:layout_marginTop="10dp">
            <TextView
                android:textSize="18dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bt_tx_mode"/>
            <Spinner
                android:id="@+id/bt_tx_mode_cw"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"/>
        </TableRow>
    </TableLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="90dp">
        <Button
            android:textSize="18dp"
            android:id="@+id/tx_mode_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bt_start"
            android:layout_weight="1"/>
        <Button
            android:textSize="18dp"
            android:id="@+id/tx_mode_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bt_stop"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
