<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:preference="http://schemas.android.com/apk/res/com.sprd.engineermode" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/black"
            android:gravity="center_vertical"
            android:background="@drawable/slogui_ab_background_overlay"
            android:paddingLeft="10dp"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="@string/ylog_settings_title"/>
        <com.sprd.engineermode.debuglog.ylogui.SettingPreferenceView
            android:id="@+id/ap_setting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            preference:title="@string/ap_setting"/>
        <View
            android:background="@color/gray"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <com.sprd.engineermode.debuglog.ylogui.SettingPreferenceView
            android:id="@+id/modem_setting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            preference:title="@string/modem_setting"/>
        <View
            android:background="@color/gray"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <com.sprd.engineermode.debuglog.ylogui.SettingPreferenceView
            android:id="@+id/connectivity_setting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            preference:title="@string/connectivity_setting"/>
        <View
            android:background="@color/gray"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <com.sprd.engineermode.debuglog.ylogui.SettingPreferenceView
            android:id="@+id/other_setting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            preference:title="@string/other_setting"/>
        <View
            android:background="@color/gray"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
    </LinearLayout>
</ScrollView>
