<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/imsi_input_notice"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/imsi_nums"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/imsi_input"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Spinner
                android:entries="@array/imsi_input_types"
                android:id="@+id/sp_imsi_input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_weight="1"/>
            <EditText
                android:id="@+id/imsi_nums"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:maxLength="6"
                android:numeric="integer"
                android:layout_weight="1"
                android:inputType="number"/>
        </LinearLayout>
        <TextView
            android:id="@+id/tv_gid1"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gid1"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
        <EditText
            android:id="@+id/et_gid1"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:maxLength="6"
            android:numeric="integer"
            android:inputType="number"/>
        <TextView
            android:id="@+id/tv_gid2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gid2"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
        <EditText
            android:id="@+id/et_gid2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:maxLength="6"
            android:numeric="integer"
            android:inputType="number"/>
        <TextView
            android:id="@+id/tv_psw"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/password_input_notice"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
        <EditText
            android:id="@+id/et_psw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:maxLength="9"
            android:numeric="integer"
            android:inputType="numberPassword"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">
            <Button
                android:id="@+id/simlockadd_btn_lock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/simlock_lock"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/simlockadd_btn_cancel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/simlock_cancel"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
