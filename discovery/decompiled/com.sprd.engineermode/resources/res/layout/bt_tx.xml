<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="1">
            <TableRow
                android:id="@+id/tablerow_pattern"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <TextView
                    android:textSize="18dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bt_tx_pattern"/>
                <Spinner
                    android:id="@+id/bt_tx_pattern"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"/>
            </TableRow>
            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <TextView
                    android:textSize="18dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bt_tx_channel"/>
                <EditText
                    android:id="@+id/bt_tx_channel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:hint="255 or 0~78"
                    android:singleLine="true"
                    android:maxLength="3"
                    android:digits="1234567890"/>
            </TableRow>
            <TableRow
                android:id="@+id/tablerow_pac_type"
                android:layout_marginTop="10dp">
                <TextView
                    android:textSize="18dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bt_tx_pac_type"/>
                <Spinner
                    android:id="@+id/bt_tx_pac_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"/>
            </TableRow>
            <TableRow
                android:id="@+id/tablerow_pac_len"
                android:layout_marginTop="10dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="18dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bt_tx_pac_len"/>
                    <TextView
                        android:textSize="10dp"
                        android:id="@+id/bt_tx_pac_len_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <EditText
                    android:id="@+id/bt_tx_pac_len"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:singleLine="true"
                    android:maxLength="4"
                    android:digits="1234567890"/>
            </TableRow>
            <TableRow
                android:visibility="gone"
                android:layout_marginTop="10dp">
                <TextView
                    android:textSize="18dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bt_tx_power_type"/>
                <Spinner
                    android:id="@+id/bt_tx_power_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"/>
            </TableRow>
            <TableRow
                android:id="@+id/tablerow_power_value"
                android:layout_marginTop="10dp">
                <TextView
                    android:textSize="18dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bt_tx_power_value"/>
                <EditText
                    android:id="@+id/bt_tx_power_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:hint="0~33"
                    android:singleLine="true"
                    android:maxLength="2"
                    android:digits="1234567890"/>
            </TableRow>
            <TableRow
                android:id="@+id/tablerow_pac_cnt"
                android:layout_marginTop="10dp">
                <TextView
                    android:textSize="18dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bt_tx_pac_cnt"/>
                <EditText
                    android:id="@+id/bt_tx_pac_cnt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:text="0"
                    android:hint="0~65535"
                    android:singleLine="true"
                    android:maxLength="5"
                    android:digits="1234567890"/>
            </TableRow>
            <TableRow android:layout_marginTop="10dp">
                <TextView
                    android:textSize="18dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bt_tx_mode"/>
                <Spinner
                    android:id="@+id/bt_tx_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"/>
            </TableRow>
        </TableLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:textSize="18dp"
                android:id="@+id/bt_tx_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bt_start"
                android:layout_weight="1"/>
            <Button
                android:textSize="18dp"
                android:id="@+id/bt_tx_stop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bt_stop"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
