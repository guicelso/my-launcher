<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/tv_email_mmc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/select_sim_type"/>
    <Spinner
        android:entries="@array/sim_types"
        android:id="@+id/sp_email_simtype"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:id="@+id/tv_email_addrs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/select_email_addrs"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <EditText
            android:id="@+id/et_email_addrs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:numeric="integer"
            android:layout_weight="1"
            android:inputType="number"/>
        <TextView
            android:id="@+id/tv_email_addrs_suffix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_email_addrs"
            android:layout_weight="1"/>
    </LinearLayout>
    <TextView
        android:id="@+id/tv_email_psw"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/select_email_psw"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <EditText
            android:id="@+id/et_email_psw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:numeric="integer"
            android:layout_weight="1"
            android:inputType="numberPassword"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
