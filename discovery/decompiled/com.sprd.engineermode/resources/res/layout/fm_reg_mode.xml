<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/fm_address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fm_address"/>
        <EditText
            android:id="@+id/fm_address_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLength="8"
            android:digits="0123456789abcdefABCDEF"
            android:inputType="text"
            android:labelFor="@+id/fm_address_edit"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/fm_reg_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fm_reg_val"/>
        <EditText
            android:id="@+id/fm_reg_val_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLength="8"
            android:digits="0123456789abcdefABCDEF"
            android:inputType="text"
            android:labelFor="@+id/fm_reg_val_edit"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="?android:attr/buttonBarStyle">
        <Button
            android:id="@+id/read_reg_btn"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/read_reg"
            android:layout_weight="1"
            style="?android:attr/buttonBarButtonStyle"/>
        <Button
            android:id="@+id/write_reg_btn"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/write_reg"
            android:layout_weight="1"
            style="?android:attr/buttonBarButtonStyle"/>
    </LinearLayout>
</LinearLayout>
