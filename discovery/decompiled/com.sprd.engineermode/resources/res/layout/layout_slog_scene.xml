<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="16sp"
        android:gravity="center"
        android:background="@drawable/slogui_ab_background_overlay"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:text="@string/slog_select_scene"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="100dp">
        <Button
            android:textSize="16sp"
            android:gravity="center"
            android:id="@+id/btn_slog_normal_scene"
            android:background="@drawable/slog_scene_selecter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="15dp"
            android:text="@string/slog_normal_scene"
            android:layout_weight="1"/>
        <Button
            android:textSize="16sp"
            android:gravity="center"
            android:id="@+id/btn_slog_data_scene"
            android:background="@drawable/slog_scene_selecter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="15dp"
            android:text="@string/slog_data_scene"
            android:layout_weight="1"/>
        <Button
            android:textSize="16sp"
            android:gravity="center"
            android:id="@+id/btn_slog_voice_scene"
            android:background="@drawable/slog_scene_selecter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="15dp"
            android:text="@string/slog_voice_scene"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="100dp">
        <Button
            android:textSize="16sp"
            android:gravity="center"
            android:id="@+id/btn_slog_modem_scene"
            android:background="@drawable/slog_scene_selecter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="15dp"
            android:text="@string/slog_modem_scene"
            android:layout_weight="1"/>
        <Button
            android:textSize="16sp"
            android:gravity="center"
            android:id="@+id/btn_slog_sim_scene"
            android:background="@drawable/slog_scene_selecter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="15dp"
            android:text="@string/slog_sim_scene"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="100dp">
        <Button
            android:textSize="16sp"
            android:gravity="center"
            android:id="@+id/btn_slog_wcn_scene"
            android:background="@drawable/slog_scene_selecter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="15dp"
            android:text="@string/slog_wcn_scene"
            android:layout_weight="1"/>
        <Button
            android:textSize="16sp"
            android:gravity="center"
            android:id="@+id/btn_slog_custom_scene"
            android:background="@drawable/slog_scene_selecter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="15dp"
            android:text="@string/slog_custom_scene"
            android:layout_weight="1"/>
        <Button
            android:textSize="16sp"
            android:gravity="center"
            android:background="@drawable/slog_scene_selecter"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="15dp"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
