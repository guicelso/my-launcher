                    android:layout_width="35dp"
                    android:layout_height="40dp"
                    android:hint="2"
                    android:maxLength="2"
                    android:inputType="number"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="#000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/coulometer_month"/>
                <EditText
                    android:textSize="15sp"
                    android:id="@+id/time3_day_edit_end"
                    android:saveEnabled="true"
                    android:layout_width="35dp"
                    android:layout_height="40dp"
                    android:hint="1"
                    android:maxLength="2"
                    android:inputType="number"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="#000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/coulometer_day"/>
                <EditText
                    android:textSize="15sp"
                    android:id="@+id/time3_hour_edit_end"
                    android:saveEnabled="true"
                    android:layout_width="35dp"
                    android:layout_height="40dp"
                    android:hint="1"
                    android:maxLength="2"
                    android:inputType="number"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="#000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/coulometer_hour"/>
                <EditText
                    android:textSize="15sp"
                    android:id="@+id/time3_minute_edit_end"
                    android:saveEnabled="true"
                    android:layout_width="35dp"
                    android:layout_height="40dp"
                    android:hint="1"
                    android:maxLength="2"
                    android:inputType="number"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="#000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/coulometer_minute"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/slot3_btn_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:layout_below="@+id/LinearLayout3_time_end">
                <Button
                    android:id="@+id/time3_begin_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/coulometer_start"
                    android:layout_weight="1"/>
                <Button
                    android:id="@+id/time3_result_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/coulometer_result"
                    android:layout_weight="1"/>
            </LinearLayout>
            <CheckBox
                android:textColor="#000000"
                android:id="@+id/checkbox3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:text="@string/coulometer_notice"
                android:layout_below="@+id/slot3_btn_layout"/>
        </RelativeLayout>
    </LinearLayout>
</ScrollView>
