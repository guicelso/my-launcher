<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="1">
            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp">
                <TextView
                    android:textSize="18dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wifi_eut_type"/>
                <Spinner
                    android:id="@+id/wifi_eut_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"/>
            </TableRow>
            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp">
                <TextView
                    android:textSize="18dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wifi_eut_addr"/>
                <EditText
                    android:id="@+id/wifi_eut_addr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:singleLine="true"
                    android:digits="1234567890abcdef"/>
            </TableRow>
            <TableRow android:layout_marginTop="15dp">
                <TextView
                    android:textSize="18dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wifi_eut_length"/>
                <EditText
                    android:enabled="false"
                    android:id="@+id/wifi_eut_length"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:singleLine="true"/>
            </TableRow>
            <TableRow android:layout_marginTop="15dp">
                <TextView
                    android:textSize="18dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wifi_eut_value"/>
                <EditText
                    android:id="@+id/wifi_eut_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:singleLine="true"
                    android:digits="1234567890"/>
            </TableRow>
        </TableLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:textSize="18dp"
                android:id="@+id/wifi_reg_read"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wifi_tx_read"
                android:layout_weight="1"/>
            <Button
                android:textSize="18dp"
                android:id="@+id/wifi_reg_write"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wifi_tx_write"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
