<?xml version="1.0" encoding="utf-8"?>
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reselect_lte_tablelayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:stretchColumns="*">
    <TableRow
        android:id="@+id/reselect_lte_tableRow1"
        android:paddingLeft="5dp"
        android:paddingTop="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:layout_gravity="center"
            android:id="@+id/reselect_lte_label00"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:layout_gravity="center"
            android:id="@+id/reselect_lte_label01"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/success_number"/>
        <TextView
            android:layout_gravity="center"
            android:id="@+id/reselect_lte_label02"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fail_number"/>
        <TextView
            android:layout_gravity="center"
            android:id="@+id/reselect_lte_label03"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pass_ratio"/>
        <TextView
            android:layout_gravity="center"
            android:id="@+id/reselect_lte_label04"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/delay_time"/>
    </TableRow>
</TableLayout>
