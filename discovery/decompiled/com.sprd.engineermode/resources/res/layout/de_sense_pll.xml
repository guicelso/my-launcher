<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:screenOrientation="portrait"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/de_sense_pll_tv_address"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/de_sense_pll_0x"/>
        <EditText
            android:id="@+id/de_sense_pll_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:maxLength="8"
            android:digits="1234567890abcdef"/>
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/de_sense_pll_tv_data"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/de_sense_pll_0x"/>
        <EditText
            android:id="@+id/de_sense_pll_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:maxLength="8"
            android:digits="1234567890abcdef"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/de_sense_pll_number"/>
        <EditText
            android:id="@+id/de_sense_pll_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/de_sense_pll_numberDefault"
            android:singleLine="true"
            android:digits="1234567890"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/de_sense_pll_tv_result"
            android:layout_weight="0.5"/>
        <TextView
            android:id="@+id/de_sense_pll_result"
            android:background="@drawable/textview_bar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="5dp"
            android:layout_weight="8.4"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <Button
                android:id="@+id/de_sense_pll_read"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/de_sense_pll_bt_read"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/de_sense_pll_write"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/de_sense_pll_bt_write"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
