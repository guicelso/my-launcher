<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/audio_hbound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/audio_hbound"/>
        <EditText
            android:id="@+id/audio_hbound_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLength="3"
            android:inputType="number"
            android:labelFor="@+id/audio_hbound_edit"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/audio_lbound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/audio_lbound"/>
        <EditText
            android:id="@+id/audio_lbound_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLength="3"
            android:inputType="number"
            android:labelFor="@+id/audio_lbound_edit"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/audio_power_th"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/audio_power_th"/>
        <EditText
            android:id="@+id/audio_power_th_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLength="3"
            android:inputType="number"
            android:labelFor="@+id/audio_power_th_edit"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/audio_phyt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/audio_phyt"/>
        <EditText
            android:id="@+id/audio_phyt_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLength="2"
            android:inputType="number"
            android:labelFor="@+id/audio_phyt_edit"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/audio_snr_th"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/audio_snr_th"/>
        <EditText
            android:id="@+id/audio_snr_th_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLength="2"
            android:inputType="number"
            android:labelFor="@+id/audio_snr_th_edit"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="?android:attr/buttonBarStyle">
        <Button
            android:id="@+id/get_audio_btn"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/get_para"
            android:layout_weight="1"
            style="?android:attr/buttonBarButtonStyle"/>
        <Button
            android:id="@+id/set_audio_btn"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/set_para"
            android:layout_weight="1"
            style="?android:attr/buttonBarButtonStyle"/>
    </LinearLayout>
</LinearLayout>
