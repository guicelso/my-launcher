<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <EditText
        android:configChanges="orientation|keyboardHidden"
        android:gravity="top"
        android:id="@+id/ua_editor"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="1dp"
        android:layout_marginTop="1dp"
        android:layout_marginRight="1dp"
        android:layout_marginBottom="1dp"
        android:lines="8"
        android:maxLength="256"
        android:windowSoftInputMode="stateHidden"/>
    <RadioGroup
        android:id="@+id/ua_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:checkedButton="@+id/ENC_WBXML">
        <RadioButton
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:id="@+id/default_ua"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ua_default"/>
        <RadioButton
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:id="@+id/other_ua"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ua_other"/>
        <RadioButton
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:id="@+id/custom_ua"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ua_custom"/>
    </RadioGroup>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp">
        <Button
            android:id="@+id/btn_ok"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:text="@string/ok"/>
        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:text="@string/cancel"/>
    </LinearLayout>
</LinearLayout>
